+/* This API renders the base level/layer only, as before. Keep its surface
+ * identity with the texture, just as the sampler view is already cached.
+ * Recreating it at every draw makes Gallium dirty the entire framebuffer and
+ * all FD6 draw state even when the actual render target did not change.
+ * Commands and the framebuffer retain their own references through the fence. */
+static struct pipe_surface *
+rwa_render_surface(struct rwa_texture *texture)
+{
+   if (!texture->render_surface)
+      texture->render_surface=texture->device->pipe->create_surface(texture->device->pipe,
+         texture->res,&(struct pipe_surface){.format=texture->res->format});
+   return texture->render_surface;
+}
