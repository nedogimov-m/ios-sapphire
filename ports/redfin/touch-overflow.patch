+/* Caller rechecks the permanent UFS lease, GIC/GPIO and HID before this leaf.
+ * Only this open, successfully sensed session can issue the exact clear frame.
+ * At most eight per boot. No retry after a transport failure or IC reset. */
+int
+redfin_touch_spi_events_clear(void)
+{
+ if(!redfin_spi_event_open || !redfin_spi_event_sensing || !redfin_spi_verified_se ||
+    !redfin_spi_verified_hz || redfin_spi_event_context.se!=redfin_spi_verified_se ||
+    redfin_spi_event_context.dead || __atomic_load_n(&redfin_spi_scan_active,__ATOMIC_ACQUIRE)) return ENOTSUP;
+ if(redfin_spi_event_clears>=8) return EOVERFLOW;
+ redfin_spi_event_clears++;
+ uint8_t frame[8];
+ if(redfin_touch_clear_frame(frame)!=sizeof(frame)) return EINVAL;
+ int error=redfin_spi_transfer(&redfin_spi_event_context,frame,NULL,sizeof(frame));
+ printf("REDFIN TOUCH CLEAR: attempt=%u result=%d\n",redfin_spi_event_clears,error);
+ if(error) redfin_touch_spi_events_close();
+ return error;
+}
