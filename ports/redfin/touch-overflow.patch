+/* Recover only the queue, once per caller attempt. Release held fingers before
+ * clearing; discard at most four bounded batches until an actual empty reply.
+ * A transport/ownership failure, reset, corrupt packet or persistent overflow
+ * remains fatal. Held stale contacts stay suppressed until their UP. */
+static inline int
+redfin_events_recover(struct redfin_events_state *s, const struct redfin_events_ops *ops)
+{
+ if(!s || !ops || !ops->read || !ops->clear) return EINVAL;
+ redfin_events_release_all(s,ops->emit,ops->context);
+ s->synchronized=false;s->startup_reset=false;
+ int error=ops->clear(ops->context);
+ if(error) return error;
+ for(unsigned batch=0;batch<4;batch++) {
+  error=redfin_events_batch(s,ops,false);
+  if(error) return error;
+  if(s->synchronized) { s->recoveries++;return 0; }
+ }
+ return EBUSY;
+}
