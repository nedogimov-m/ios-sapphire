+     __atomic_load_n(&rf_smp_progress[cpu],__ATOMIC_ACQUIRE)!=RF_SMP_ROUNDS ||
+     __atomic_load_n(&rf_smp_ack[cpu],__ATOMIC_ACQUIRE)!=(((uint64_t)RF_SMP_ROUNDS<<2)|((1-cpu)+2))) return -116;
+ }
