+/* Acquire snapshots, no owner stealing or counter reset. SMP callers must
+ * first stop workers and drain IRQ observers; a busy/unknown logger fails. */
+int redfin_log_smp_quiescent(void);
+int
+redfin_log_smp_quiescent(void)
+{
+ for(unsigned sample=0;sample<2;sample++) {
