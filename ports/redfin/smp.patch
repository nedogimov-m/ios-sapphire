+ if(!rf_smp_wait32(&rf_smp_drained[0],1,0) || !rf_smp_wait32(&rf_smp_drained[1],1,0)) return -114;
+ __atomic_store_n(&rf_smp_phase,RF_SMP_DONE,__ATOMIC_RELEASE);
+ if(__atomic_load_n(&rf_smp_fault,__ATOMIC_ACQUIRE)) return -115;
