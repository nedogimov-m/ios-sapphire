+ return true;
+}
+static void rf_smp_secondary(void *arg __unused,wait_result_t result __unused)
+{
+ thread_bind(cpu_to_processor(1));thread_block(THREAD_CONTINUE_NULL);
+ if(!rf_smp_worker(1)) __atomic_store_n(&rf_smp_fault,1,__ATOMIC_RELEASE);
+ thread_terminate(current_thread());
+}
+int redfin_smp_prove(void)
+{
+ if(!rf_smp_unchanged() || __atomic_load_n(&rf_smp_started,__ATOMIC_ACQUIRE)!=2 ||
+    __atomic_load_n(&rf_smp_phase,__ATOMIC_ACQUIRE)!=RF_SMP_IDLE) return -110;
