+ kprintf("REDFIN SMP2: bootid=0x%016llx cpu0 timer=%llu progress=%llu self=%u cross=%llu "
+  "cpu6 timer=%llu progress=%llu self=%u cross=%llu log_busy=0 log_reentrant=0 "
+  "worker_exited=1 irq_drained=1 tlb=untested\n",
