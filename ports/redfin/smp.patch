diff --git a/osfmk/arm64/redfin_smp.c b/osfmk/arm64/redfin_smp.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/redfin_smp.c
@@ -0,0 +1,352 @@
+/* Isolated CPU0+CPU6 md0 experiment. No bootarg is return-to-bootloader proof.
+ * CPU0 owns startup, diagnostics and watchdog; CPU6 only joins this kernel once.
+ * IRQ observers do bounded atomic loads/stores, never allocation/logging/waiting.
+ * This proves specified IRQ/timer/progress facts, not TLB shootdowns or full SMP.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <kern/ast.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <mach/mach_time.h>
+#include <mach/thread_act.h>
+#include <pexpert/pexpert.h>
+
+#define RF_SMP_ARGS 608u
+#define RF_SMP_ROUNDS 32u
+#define RF_SMP_POLLS 20000u
+#define RF_SMP_SGI 2u
+#define RF_SMP_TARGET 0x600ULL
+#define RF_SMP_ON 0xc4000003u
+#define RF_SMP_AFFINITY 0xc4000004u
+static char rf_smp_frozen[RF_SMP_ARGS];
+static unsigned rf_smp_frozen_bytes;
+static uint64_t rf_smp_boot_id;
+static uint32_t rf_smp_prepared,rf_smp_started,rf_smp_selected;
+/* phase ACTIVE permits IRQ facts, DRAIN acknowledges the final SGI only. */
+enum { RF_SMP_IDLE,RF_SMP_ACTIVE,RF_SMP_DRAIN,RF_SMP_DONE };
+static uint32_t rf_smp_phase,rf_smp_fault;
+static uint64_t rf_smp_request[2],rf_smp_ack[2],rf_smp_timers[2],rf_smp_progress[2];
+static uint32_t rf_smp_ready[2],rf_smp_finished[2],rf_smp_drained[2];
+static uint64_t rf_smp_deadline;
+extern int redfin_smp_return_ready(void);
+extern int redfin_log_smp_quiescent(void);
+extern void redfin_shutdown_watchdog_tick(unsigned);
+extern unsigned char redfin_smp_secondary_entry[],redfin_smp_secondary_entry_end[];
+extern vm_offset_t ml_static_vtop(vm_offset_t);
+int redfin_smp_mode(void);
+int redfin_smp_sgi_selected(void);
+int redfin_smp_topology_valid(void);
+void redfin_smp_prepare(void);
+int redfin_smp_start(unsigned,vm_offset_t);
+void redfin_smp_irq(unsigned);
+int redfin_smp_prove(void);
+
+enum { RF_SMP_MPIDR,RF_SMP_EL,RF_SMP_MIDR,RF_SMP_MMFR0,RF_SMP_CTR,RF_SMP_SCTLR };
+/* REDFIN_SMP_HW_BEGIN */
+static uint64_t rf_smp_reg(unsigned n)
+{
+ switch(n) {
+ case RF_SMP_MPIDR:return __builtin_arm_rsr64("MPIDR_EL1");
+ case RF_SMP_EL:return __builtin_arm_rsr64("CurrentEL");
+ case RF_SMP_MIDR:return __builtin_arm_rsr64("MIDR_EL1");
+ case RF_SMP_MMFR0:return __builtin_arm_rsr64("ID_AA64MMFR0_EL1");
+ case RF_SMP_CTR:return __builtin_arm_rsr64("CTR_EL0");
+ default:return __builtin_arm_rsr64("SCTLR_EL1");
+ }
+}
+static int32_t rf_smp_psci(uint32_t fn,uint64_t a,uint64_t b,uint64_t c)
+{
+ register uint64_t x0 __asm__("x0")=fn,x1 __asm__("x1")=a;
+ register uint64_t x2 __asm__("x2")=b,x3 __asm__("x3")=c;
+ __asm__ volatile("smc #0" : "+r"(x0),"+r"(x1),"+r"(x2),"+r"(x3) : :
+  "x4","x5","x6","x7","x8","x9","x10","x11","x12","x13","x14","x15",
+  "x16","x17","cc","memory");
+ return (int32_t)x0;
+}
+static void rf_smp_send(unsigned logical)
+{
+ uint64_t physical=logical?RF_SMP_TARGET:0;
+ uint64_t sgi=((physical>>8)<<16)|((uint64_t)RF_SMP_SGI<<24)|1;
+ __builtin_arm_dsb(DSB_ISHST);
+ __builtin_arm_wsr64("ICC_SGI1R_EL1",sgi);
+ __builtin_arm_isb(ISB_SY);
+}
+static bool rf_smp_entry_ok(vm_offset_t entry)
+{
+ vm_offset_t first=ml_static_vtop((vm_offset_t)redfin_smp_secondary_entry);
+ vm_offset_t last=ml_static_vtop((vm_offset_t)redfin_smp_secondary_entry_end);
+ return entry==first && last>first && last-first<=512 && last<=0x200000000ULL;
+}
+static void rf_smp_barrier(void) { __builtin_arm_dsb(DSB_SY); }
+static void rf_smp_pause(void) { delay(50); }
+static void rf_smp_round_delay(void) { delay(1000); }
+/* REDFIN_SMP_HW_END */
+
+static bool rf_smp_space(char c) { return c==' ' || c=='\t' || c=='\r' || c=='\n'; }
+static bool rf_smp_word(const char *a,unsigned n,const char *b)
+{ return strlen(b)==n && !memcmp(a,b,n); }
+static unsigned rf_smp_bytes(const char *args)
+{
+ if(!args) return 0;
+ for(unsigned i=0;i<RF_SMP_ARGS;i++) if(!args[i]) return i+1;
+ return 0;
+}
+static bool rf_smp_present(const char *args,unsigned bytes)
+{
+ if(!bytes) return false;
+ for(unsigned p=0;p<bytes-1;) {
+  if(rf_smp_space(args[p])) { p++;continue; }
+  unsigned s=p;while(p<bytes-1 && !rf_smp_space(args[p])) p++;
+  unsigned k=s;while(k<p && args[k]!='=') k++;
+  if(rf_smp_word(args+s,k-s,"redfinsmp")) return true;
+ }
+ return false;
+}
+/* A complete allowlist, deliberately narrower than normal UP bring-up. */
+static bool rf_smp_flags(const char *args,unsigned bytes,uint64_t *boot_id)
+{
+ static const char *tokens[]={"debug=0xc","serial=3","cpus=2","keepsyms=1","-noprogress",
+  "rd=md0","sweettouch=0","sweetkeys=0","sweetusb=0","sweetcpufreq=0","sweetbattery=0",
+  "modem=0","wifi=0","gpu=0","redfinsmp=1","redfinshim=1","redfinspmi=0","redfinreturn=0"};
+ uint32_t seen=0;bool nonce_seen=false,spam_seen=false;uint64_t boot_nonce=0;
+ if(!args || !bytes || bytes>RF_SMP_ARGS || args[bytes-1]) return false;
+ for(unsigned p=0;p<bytes-1;) {
+  if(!args[p]) return false;
+  if(rf_smp_space(args[p])) { p++;continue; }
+  unsigned s=p;while(p<bytes-1 && !rf_smp_space(args[p])) p++;
+  unsigned n=p-s;bool known=false;
+  for(unsigned i=0;i<sizeof(tokens)/sizeof(tokens[0]);i++) {
+   if(!rf_smp_word(args+s,n,tokens[i])) continue;
+   if(seen&(1u<<i)) return false;
+   seen|=1u<<i;known=true;break;
+  }
+  if(known) continue;
+  if(rf_smp_word(args+s,n,"-enable_kprintf_spam")) {
+   if(spam_seen) return false;
+   spam_seen=true;continue;
+  }
+  if(n==31 && !memcmp(args+s,"redfinbootid=0x",15)) {
+   if(nonce_seen) return false;
+   uint64_t nonce=0;
+   /* Fifteen prefix bytes and sixteen lowercase hex digits. */
+   for(unsigned j=15;j<31;j++) {
+    unsigned d=(unsigned)(args[s+j]-'0');
+    if(d>9) { if(args[s+j]<'a' || args[s+j]>'f') return false;d=(unsigned)(args[s+j]-'a'+10); }
+    nonce=(nonce<<4)|d;
+   }
+   if(!nonce) return false;
+   boot_nonce=nonce;nonce_seen=true;continue;
+  }
+  return false;
+ }
+ if(seen!=((1u<<(sizeof(tokens)/sizeof(tokens[0])))-1) || !nonce_seen) return false;
+ if(boot_id) *boot_id=boot_nonce;
+ return true;
+}
+int redfin_smp_mode(void)
+{
+ const char *args=PE_boot_args();unsigned bytes=rf_smp_bytes(args);
+ if(!bytes) panic("REDFIN SMP: unterminated boot args");
+ if(!rf_smp_present(args,bytes)) return 0;
+ if(!rf_smp_flags(args,bytes,NULL)) panic("REDFIN SMP: rejected frozen boot args");
+ __atomic_store_n(&rf_smp_selected,1,__ATOMIC_RELEASE);
+ return 1;
+}
+int redfin_smp_sgi_selected(void)
+{ return __atomic_load_n(&rf_smp_selected,__ATOMIC_ACQUIRE)==1; }
+int redfin_smp_topology_valid(void)
+{
+ const ml_topology_info_t *t=ml_get_topology_info();
+ if(!t || t->version!=CPU_TOPOLOGY_VERSION || t->num_cpus!=2 || t->max_cpu_id!=1 || t->num_clusters!=1 ||
+    t->max_cluster_id || t->max_die_id || !t->cpus || !t->clusters ||
+    t->boot_cpu!=&t->cpus[0] || t->boot_cluster!=&t->clusters[0] ||
+    t->clusters[0].cluster_id || t->clusters[0].cluster_type!=CLUSTER_TYPE_SMP ||
+    t->clusters[0].num_cpus!=2 || t->clusters[0].first_cpu_id || t->clusters[0].cpu_mask!=3) return 0;
+ for(unsigned i=0;i<2;i++) {
+  const ml_topology_cpu_t *c=&t->cpus[i];
+  if(c->cpu_id!=i || c->phys_id!=(i?RF_SMP_TARGET:0) || c->cluster_id || c->die_id ||
+     c->cluster_type!=CLUSTER_TYPE_SMP || c->die_cluster_id || c->cluster_core_id!=i ||
+     c->l2_cache_id!=i || c->l3_cache_id || c->l2_cache_size || c->l3_cache_size) return 0;
+ }
+ return 1;
+}
+static bool rf_smp_boot_cpu(void)
+{
+ uint64_t ctr=rf_smp_reg(RF_SMP_CTR),midr=rf_smp_reg(RF_SMP_MIDR);
+ unsigned granule=(unsigned)((rf_smp_reg(RF_SMP_MMFR0)>>20)&15);
+ return PAGE_SIZE==16384 && rf_smp_reg(RF_SMP_EL)==4 &&
+  !(rf_smp_reg(RF_SMP_MPIDR)&0xff00ffffffULL) &&
+  ((midr>>24)&255)==0x51 && ((midr>>4)&0xfff)==0x805 &&
+  (ctr&15)==4 && ((ctr>>16)&15)==4 && (granule==1 || granule==2) &&
+  (rf_smp_reg(RF_SMP_SCTLR)&5)==5;
+}
+static bool rf_smp_unchanged(void)
+{
+ const char *args=PE_boot_args();
+ return args && rf_smp_frozen_bytes && rf_smp_bytes(args)==rf_smp_frozen_bytes &&
+  !memcmp(args,rf_smp_frozen,rf_smp_frozen_bytes) && redfin_smp_topology_valid() && rf_smp_boot_cpu();
+}
+void redfin_smp_prepare(void)
+{
+ if(!redfin_smp_mode() || !redfin_smp_topology_valid()) panic("REDFIN SMP: topology refused");
+ thread_bind(cpu_to_processor(0));thread_block(THREAD_CONTINUE_NULL);
+ if(!rf_smp_boot_cpu()) panic("REDFIN SMP: coordinator not physical CPU0");
+ uint32_t expected=0;
+ if(!__atomic_compare_exchange_n(&rf_smp_prepared,&expected,1,true,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))
+  panic("REDFIN SMP: preparation repeated");
+ rf_smp_frozen_bytes=rf_smp_bytes(PE_boot_args());
+ memcpy(rf_smp_frozen,PE_boot_args(),rf_smp_frozen_bytes);
+ if(!rf_smp_flags(rf_smp_frozen,rf_smp_frozen_bytes,&rf_smp_boot_id)) panic("REDFIN SMP: frozen flags changed");
+}
+int redfin_smp_start(unsigned logical,vm_offset_t entry)
+{
+ uint32_t expected=0;
