+  (unsigned long long)__atomic_load_n(&rf_smp_timers[0],__ATOMIC_ACQUIRE),
+  (unsigned long long)__atomic_load_n(&rf_smp_progress[0],__ATOMIC_ACQUIRE),
+  __atomic_load_n(&rf_smp_ready[0],__ATOMIC_ACQUIRE),
+  (unsigned long long)__atomic_load_n(&rf_smp_ack[0],__ATOMIC_ACQUIRE),
+  (unsigned long long)__atomic_load_n(&rf_smp_timers[1],__ATOMIC_ACQUIRE),
+  (unsigned long long)__atomic_load_n(&rf_smp_progress[1],__ATOMIC_ACQUIRE),
+  __atomic_load_n(&rf_smp_ready[1],__ATOMIC_ACQUIRE),
+  (unsigned long long)__atomic_load_n(&rf_smp_ack[1],__ATOMIC_ACQUIRE));
