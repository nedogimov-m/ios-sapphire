+static int rf_smp_local(void)
+{
+ uint64_t affinity=rf_smp_reg(RF_SMP_MPIDR)&0xff00ffffffULL;
+ return affinity==0?0:(affinity==RF_SMP_TARGET?1:-1);
+}
+/* kind0 means a completed architected timer IRQ, kind1 our dedicated SGI2. */
+void redfin_smp_irq(unsigned kind)
+{
+ uint32_t phase=__atomic_load_n(&rf_smp_phase,__ATOMIC_ACQUIRE);
+ if(phase!=RF_SMP_ACTIVE && phase!=RF_SMP_DRAIN) return;
+ int cpu=rf_smp_local();
+ if(cpu<0) { __atomic_store_n(&rf_smp_fault,1,__ATOMIC_RELEASE);return; }
+ if(phase==RF_SMP_DRAIN) {
+  if(kind==1) __atomic_store_n(&rf_smp_drained[cpu],1,__ATOMIC_RELEASE);
+  return;
+ }
+ if(kind==0) {
+  uint64_t n=__atomic_load_n(&rf_smp_timers[cpu],__ATOMIC_RELAXED);
+  if(n==UINT64_MAX) __atomic_store_n(&rf_smp_fault,1,__ATOMIC_RELEASE);
+  else __atomic_store_n(&rf_smp_timers[cpu],n+1,__ATOMIC_RELEASE);
+ } else if(kind==1) {
+  uint64_t n=__atomic_load_n(&rf_smp_request[cpu],__ATOMIC_ACQUIRE);
+  uint64_t before=__atomic_load_n(&rf_smp_ack[cpu],__ATOMIC_RELAXED);
+  if(n==1 || ((n>>2)>=1 && (n>>2)<=RF_SMP_ROUNDS && (n&3)==(uint64_t)((1-cpu)+2))) {
+   if(n>before) __atomic_store_n(&rf_smp_ack[cpu],n,__ATOMIC_RELEASE);
+  }
+ }
+}
+static bool rf_smp_alive(unsigned cpu)
+{
+ if(rf_smp_local()!=(int)cpu || __atomic_load_n(&rf_smp_fault,__ATOMIC_ACQUIRE) ||
+    mach_absolute_time()>rf_smp_deadline) return false;
+ if(!cpu) redfin_shutdown_watchdog_tick(0);
+ return true;
+}
+static bool rf_smp_wait64(uint64_t *value,uint64_t expected,unsigned cpu)
+{
+ for(unsigned i=0;i<RF_SMP_POLLS;i++) {
+  if(!rf_smp_alive(cpu)) return false;
+  if(__atomic_load_n(value,__ATOMIC_ACQUIRE)==expected) return true;
+  rf_smp_pause();
+ }
+ return false;
+}
+static bool rf_smp_wait32(uint32_t *value,uint32_t expected,unsigned cpu)
+{
+ for(unsigned i=0;i<RF_SMP_POLLS;i++) {
+  if(!rf_smp_alive(cpu)) return false;
+  if(__atomic_load_n(value,__ATOMIC_ACQUIRE)==expected) return true;
+  rf_smp_pause();
+ }
+ return false;
+}
+static bool rf_smp_worker(unsigned cpu)
+{
+ if(!rf_smp_alive(cpu)) return false;
+ __atomic_store_n(&rf_smp_request[cpu],1,__ATOMIC_RELEASE);rf_smp_send(cpu);
+ if(!rf_smp_wait64(&rf_smp_ack[cpu],1,cpu)) return false;
+ __atomic_store_n(&rf_smp_ready[cpu],1,__ATOMIC_RELEASE);
+ if(!rf_smp_wait32(&rf_smp_ready[1-cpu],1,cpu)) return false;
+ for(unsigned round=1;round<=RF_SMP_ROUNDS;round++) {
+  uint64_t sequence=((uint64_t)round<<2)|(cpu+2);
+  __atomic_store_n(&rf_smp_request[1-cpu],sequence,__ATOMIC_RELEASE);rf_smp_send(1-cpu);
+  if(!rf_smp_wait64(&rf_smp_ack[1-cpu],sequence,cpu)) return false;
+  rf_smp_round_delay();
+  if(!rf_smp_alive(cpu)) return false;
+  __atomic_store_n(&rf_smp_progress[cpu],round,__ATOMIC_RELEASE);
+ }
