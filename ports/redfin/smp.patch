+ __atomic_store_n(&rf_smp_phase,RF_SMP_ACTIVE,__ATOMIC_RELEASE);
+ thread_t worker=THREAD_NULL;
+ kern_return_t kr=kernel_thread_start(rf_smp_secondary,NULL,&worker);
+ if(kr!=KERN_SUCCESS) return -111;
+ if(!rf_smp_worker(0) || !rf_smp_wait32(&rf_smp_finished[1],1,0)) { thread_deallocate(worker);return -112; }
