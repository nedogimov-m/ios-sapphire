diff --git a/osfmk/arm64/redfin_gui_profile.h b/osfmk/arm64/redfin_gui_profile.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/redfin_gui_profile.h
@@ -0,0 +1,112 @@
+/* Exact bounded GUI8 profile shared by the relocatable shim and XNU.
+ * Display/touch geometry and the fenced HFS root are checked by their drivers.
+ * No allocation, libc, device access or absolute pointer tables here. */
+#ifndef REDFIN_GUI_PROFILE_H
+#define REDFIN_GUI_PROFILE_H
+#include <stdbool.h>
+#include <stdint.h>
+static inline bool redfin_gui_token(const char *p,unsigned bytes,const char *s)
+{
+ unsigned n=0;while(s[n]) { if(n>=bytes || p[n]!=s[n]) return false;n++; }
+ return n==bytes;
+}
+static inline bool redfin_gui_profile(const char *args,unsigned bytes,uint64_t *boot_id)
+{
+ static const char required[][40]={
+  "debug=0xc",
+  "serial=3",
+  "cpus=8",
+  "keepsyms=1",
+  "-noprogress",
+  "rd=ufsroot0",
+  "sweettouch=0",
+  "sweetkeys=0",
+  "sweetusb=0",
+  "sweetcpufreq=0",
+  "sweetbattery=0",
+  "modem=0",
+  "wifi=0",
+  "gpu=0",
+  "unentitled_ios_sim_launch=1",
+  "ignition_level=1",
+  "wdt_test=no_user_checkin",
+  "launchd_unsecure_cache=1",
+  "wdt=-1",
+  "redfinfb=1",
+  "sweetfb_noconsole=1",
+  "redfinshutdown=180",
+  "redfintouch=2",
+  "redfinrail=1",
+  "redfintouchsetup=1",
+  "redfinrpmhtouch=1",
+  "redfintouchevents=1",
+  "redfinufs=3",
+  "redfinspmi=0",
+  "redfinreturn=0",
+  "redfinroot=1",
+  "ufsroot=userdata",
+  "ufsrw=1",
+  "rootrw=1",
+  "sweetlog=0",
+  "redfinsmp=1",
+  "redfinshim=1",
+  "redfingui=1",
+ };
+ const unsigned count=sizeof(required)/sizeof(required[0]);
+ _Static_assert(sizeof(required)/sizeof(required[0])<64,"GUI argument bitmap");
+ if(!args || !bytes || bytes>608 || args[bytes-1]) return false;
+ unsigned length=0;while(length<bytes && args[length]) length++;
+ if(!length || length==bytes) return false;
+ for(unsigned tail=length;tail<bytes;tail++) if(args[tail]) return false;
+ uint64_t seen=0,nonce=0;
+ bool nonce_seen=false,trace_seen=false,cadence_seen=false,screen_seen=false;
+ unsigned fit_mode=0;
+ for(unsigned pos=0;pos<length;) {
+  if(args[pos]==' ') { pos++;continue; }
+  unsigned start=pos;
+  while(pos<length && args[pos]!=' ') {
+   if((unsigned char)args[pos]<33 || (unsigned char)args[pos]>126) return false;
+   pos++;
+  }
+  unsigned n=pos-start;
+  bool known=false;
+  for(unsigned i=0;i<count;i++) if(redfin_gui_token(args+start,n,required[i])) {
+   if(seen&(1ULL<<i)) return false;
+   seen|=1ULL<<i;known=true;break;
+  }
+  if(known) continue;
+  if(redfin_gui_token(args+start,n,"redfinfit=1") || redfin_gui_token(args+start,n,"redfinfit=2")) {
+   if(fit_mode) return false;
+   fit_mode=(unsigned)(args[start+n-1]-'0');continue;
+  }
+  if(redfin_gui_token(args+start,n,"redfinscreen=1")) {
+   if(screen_seen) return false;
+   screen_seen=true;continue;
+  }
+  if(redfin_gui_token(args+start,n,"sweetfb_hz=10") ||
+     redfin_gui_token(args+start,n,"sweetfb_hz=30") ||
+     redfin_gui_token(args+start,n,"sweetfb_hz=60")) {
+   if(cadence_seen) return false;
+   cadence_seen=true;continue;
+  }
+  if(redfin_gui_token(args+start,n,"-enable_kprintf_spam")) {
+   if(trace_seen) return false;
+   trace_seen=true;continue;
+  }
+  if(n==31 && redfin_gui_token(args+start,15,"redfinbootid=0x")) {
+   if(nonce_seen) return false;
+   for(unsigned i=15;i<31;i++) {
+    unsigned digit=(unsigned)(args[start+i]-'0');
+    if(digit>9) { if(args[start+i]<'a' || args[start+i]>'f') return false;digit=(unsigned)(args[start+i]-'a'+10); }
+    nonce=(nonce<<4)|digit;
+   }
+   if(!nonce) return false;
+   nonce_seen=true;continue;
+  }
+  return false;
+ }
+ if(seen!=((1ULL<<count)-1) || !nonce_seen || !cadence_seen || (screen_seen && fit_mode!=2)) return false;
+ if(boot_id) *boot_id=nonce;
+ return true;
+}
+#endif /* REDFIN_GUI_PROFILE_H */
diff --git a/osfmk/arm64/redfin_gui_runtime.h b/osfmk/arm64/redfin_gui_runtime.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/redfin_gui_runtime.h
@@ -0,0 +1,73 @@
+/* GUI8 starts hardware work only after the complete SMP proof and publication.
+ * IRQ/HID callers use cached acquire loads, never the CPU0-only return verifier.
+ * Included by redfin_smp.c after its proof and frozen-argument primitives. */
+#ifndef REDFIN_GUI_RUNTIME_H
+#define REDFIN_GUI_RUNTIME_H
+extern int redfin_gui_publish_return(void);
+int redfin_gui_selected(void);
+int redfin_smp_verified(void);
+int redfin_gui_ready(void);
+int redfin_gui_cpu0(void);
+int redfin_gui_bind_worker(void);
+void redfin_smp_publish(void);
+void *redfin_gui_root_enter(void);
+void redfin_gui_root_leave(void *);
+
+int redfin_gui_selected(void)
+{ return __atomic_load_n(&rf_gui_selected,__ATOMIC_ACQUIRE)==1; }
+int redfin_smp_verified(void)
+{ return __atomic_load_n(&rf_smp_published,__ATOMIC_ACQUIRE)==1; }
+int redfin_gui_ready(void)
+{ return __atomic_load_n(&rf_gui_ready,__ATOMIC_ACQUIRE)==1; }
+int redfin_gui_cpu0(void)
+{ return redfin_gui_ready() && rf_smp_local()==0; }
+
+void redfin_smp_publish(void)
+{
+ if(!__atomic_load_n(&rf_smp_proved,__ATOMIC_ACQUIRE) || !rf_smp_unchanged())
+  panic("REDFIN GUI: SMP publication before successful proof");
+ __atomic_store_n(&rf_smp_published,1,__ATOMIC_RELEASE);
+}
+static void rf_gui_wait(void)
+{
+ uint64_t wake;
+ clock_interval_to_deadline(1,NSEC_PER_MSEC,&wake);
+ if(assert_wait_deadline((event_t)&rf_smp_published,THREAD_UNINT,wake)==THREAD_WAITING)
+  thread_block(THREAD_CONTINUE_NULL);
+}
+void *redfin_gui_root_enter(void)
+{
+ /* Root matching can reach this before the asynchronous CPU nubs start. */
+ (void)redfin_smp_mode();
+ if(!redfin_gui_selected()) return NULL;
+ uint64_t deadline;
+ nanoseconds_to_deadline(15*NSEC_PER_SEC,&deadline);
+ while(!redfin_smp_verified()) {
+  if(mach_absolute_time()>deadline) panic("REDFIN GUI: SMP completion timeout");
+  rf_gui_wait();
+ }
+ processor_t previous=thread_bind(cpu_to_processor(0));
+ thread_block(THREAD_CONTINUE_NULL);
+ uint64_t nonce=0;
+ if(rf_smp_count()!=8 || !rf_smp_unchanged() ||
+    !redfin_gui_profile(rf_smp_frozen,rf_smp_frozen_bytes,&nonce) || nonce!=rf_smp_boot_id ||
+    redfin_gui_publish_return()!=1) panic("REDFIN GUI: cached shim return unavailable");
+ __atomic_store_n(&rf_gui_ready,1,__ATOMIC_RELEASE);
+ kprintf("REDFIN GUI8: SMP verified; CPU0 owns root/touch; shim return cached\n");
+ return (void *)previous;
+}
+void redfin_gui_root_leave(void *previous)
+{
+ if(!redfin_gui_selected()) return;
+ if(!redfin_gui_cpu0()) panic("REDFIN GUI: root hardware owner changed");
+ thread_bind((processor_t)previous);
+ thread_block(THREAD_CONTINUE_NULL);
+}
+int redfin_gui_bind_worker(void)
+{
+ if(!redfin_gui_selected() || !redfin_gui_ready()) return 0;
+ thread_bind(cpu_to_processor(0));
+ thread_block(THREAD_CONTINUE_NULL);
+ return redfin_gui_cpu0();
+}
+#endif /* REDFIN_GUI_RUNTIME_H */
