+/* REDFIN_FINAL_TEST_BEGIN: one retained opt-in service, finite capture budget. */
+static AppleCLCD *redfin_capture_fb;
+static bool
+redfin_capture_publish(AppleCLCD *fb)
+{
+	if (!fb->fRedfinCopyOnly || fb->fRedfinCaptureLock == NULL || fb->fRedfinCaptures != 0) return false;
+	/* One permanent reference pins the complete service and lock until reboot. */
+	fb->retain();
+	AppleCLCD *expected = NULL;
+	if (__atomic_compare_exchange_n(&redfin_capture_fb, &expected, fb, false,
+	    __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return true;
+	fb->release();
+	return false;
+}
+static uint32_t
+redfin_capture_early(AppleCLCD *fb)
+{
+	/* Caller holds the dedicated lock after a completed positive CPU copy. */
+	if (fb->fRedfinCaptureLock == NULL) return 0;
+	++fb->fRedfinPositivePresents;
+	if (fb->fRedfinFinalDone || fb->fRedfinCaptures >= 2) return 0;
+	if (fb->fRedfinCaptures == 0 || fb->fRedfinPositivePresents >= 5) return ++fb->fRedfinCaptures;
+	return 0;
+}
+extern "C" void
+redfin_fb_capture_final(void)
+{
+	AppleCLCD *fb = __atomic_load_n(&redfin_capture_fb, __ATOMIC_ACQUIRE);
+	if (fb == NULL || fb->fRedfinCaptureLock == NULL) return;
+	/* A stalled renderer must not consume the shutdown watchdog fallback. */
+	unsigned attempt = 0;
+	while (!IOLockTryLock(fb->fRedfinCaptureLock)) {
+		if (++attempt >= 250) {
+			IOLog("REDFIN FB: final snapshot skipped: capture lock busy\n");
+			return;
+		}
+		IOSleep(1);
+	}
+	if (fb->fRedfinFinalDone || fb->fRedfinCaptures >= 3) {
+		IOLockUnlock(fb->fRedfinCaptureLock);
+		return;
+	}
+	fb->fRedfinFinalDone = true; /* suppress later early captures even on failure */
+	IOLog("REDFIN FB: final snapshot present %llu positive %llu powerOff %u\n",
+	    fb->fRedfinFrames, fb->fRedfinPositivePresents,
+	    (unsigned)__atomic_load_n(&fb->fPowerOff, __ATOMIC_RELAXED));
+	if (fb->fRedfinPositivePresents != 0) {
+		uint32_t frame = ++fb->fRedfinCaptures; /* reserve once before allocation */
+		__builtin_arm_dsb(0xf);
+		fb->captureRedfin(frame, fb->fRedfinFrames); /* no invented present */
+	}
+	IOLockUnlock(fb->fRedfinCaptureLock);
+}
+/* REDFIN_FINAL_TEST_END */
+
