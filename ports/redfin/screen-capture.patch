+/* REDFIN_SCREEN_TEST_BEGIN: fixed RGB thumbnail, no register accesses. */
+#define REDFIN_SCREEN_WIDTH 120u
+#define REDFIN_SCREEN_HEIGHT 260u
+#define REDFIN_SCREEN_BYTES (REDFIN_SCREEN_WIDTH * REDFIN_SCREEN_HEIGHT * 3u)
+#define REDFIN_SCREEN_CHUNK_BYTES 144u
+#define REDFIN_SCREEN_CHUNKS (REDFIN_SCREEN_BYTES / REDFIN_SCREEN_CHUNK_BYTES)
+static void
+redfin_screen_sample(const volatile uint8_t *pixels, uint8_t *rgb)
+{
+	for (uint32_t y = 0; y < REDFIN_SCREEN_HEIGHT; y++) {
+		for (uint32_t x = 0; x < REDFIN_SCREEN_WIDTH; x++) {
+			/* Centers of 9x9 blocks in the observed 1080x2340 BGRA buffer. */
+			const volatile uint8_t *p = pixels + (y * 9u + 4u) * 4320u + (x * 9u + 4u) * 4u;
+			*rgb++ = p[2]; *rgb++ = p[1]; *rgb++ = p[0];
+		}
+	}
+}
+static uint32_t
+redfin_screen_crc32(const uint8_t *bytes, uint32_t count)
+{
+	uint32_t crc = 0xffffffffu;
+	for (uint32_t i = 0; i < count; i++) {
+		crc ^= bytes[i];
+		for (unsigned bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+	}
+	return ~crc;
+}
+static void
+redfin_screen_base64(const uint8_t *bytes, char out[193])
+{
+	static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	unsigned j = 0;
+	for (unsigned i = 0; i < REDFIN_SCREEN_CHUNK_BYTES; i += 3) {
+		uint32_t n = (uint32_t)bytes[i] << 16 | (uint32_t)bytes[i + 1] << 8 | bytes[i + 2];
+		out[j++] = alphabet[(n >> 18) & 63]; out[j++] = alphabet[(n >> 12) & 63];
+		out[j++] = alphabet[(n >> 6) & 63]; out[j++] = alphabet[n & 63];
+	}
+	out[j] = 0;
+}
+/* REDFIN_SCREEN_TEST_END */
+
