+/* Snapshot before logging: framebuffer workloop is sleepable and fLock is not held. */
+void
+AppleCLCD::captureRedfin(uint32_t frame, uint64_t present)
+{
+	if (!fRedfinCopyOnly || frame < 1 || frame > 3 || !fPixels ||
+	    !redfin_fb_geometry(fPhys, 0x02300000ULL, fWidth, fHeight, fRowBytes, fLogicalW, fLogicalH)) return;
+	uint8_t *rgb = (uint8_t *)IOMallocData(REDFIN_SCREEN_BYTES);
+	if (rgb == NULL) {
+		IOLog("REDFIN FB: thumbnail allocation failed\n");
+		return;
+	}
+	redfin_screen_sample((const volatile uint8_t *)fPixels, rgb);
+	uint32_t crc = redfin_screen_crc32(rgb, REDFIN_SCREEN_BYTES);
+	IOLog("[REDFIN SCREEN v1 BEGIN frame=%u present=%llu width=120 height=260 format=RGB8 raw=93600 b64=124800 chunks=650]\n",
+	    frame, present);
+	for (uint32_t sequence = 0; sequence < REDFIN_SCREEN_CHUNKS; sequence++) {
+		char encoded[193];
+		redfin_screen_base64(rgb + sequence * REDFIN_SCREEN_CHUNK_BYTES, encoded);
+		IOLog("[REDFIN SCREEN v1 DATA frame=%u seq=%u] %s\n", frame, sequence, encoded);
+	}
+	IOLog("[REDFIN SCREEN v1 END frame=%u chunks=650 raw=93600 crc32=%08x]\n", frame, crc);
+	IOFreeData(rgb, REDFIN_SCREEN_BYTES);
+}
