diff --git a/src/compiler/air/air_metal.h b/src/compiler/air/air_metal.h
--- a/src/compiler/air/air_metal.h
+++ b/src/compiler/air/air_metal.h
@@ -61,6 +61,12 @@
  * ordinary case when the kernel was booted without gpu=1. */
