+/* A command buffer owns the recursive frontend mutex across this scope. A
+ * completed callback is never delivered until this real fence has succeeded. */
+static int
+command_scope_finish(void *opaque, char *why, size_t why_size)
+{
+   return finish_or_say_why(opaque, true, "Metal commands", why, why_size);
+}
+
+int
+rwa_commands_begin(struct rwa_device *device, char *why, size_t why_size)
+{
+   int error=redfin_metal_scope_begin(&device->command_scope);
+   if (error) say(why,why_size,"Metal command scope is already active or retired");
+   return error;
+}
+
+int
+rwa_commands_end(struct rwa_device *device, char *why, size_t why_size)
+{
+   int error=redfin_metal_scope_end(&device->command_scope,command_scope_finish,device,why,why_size);
+   if (!error) device->pipe->set_framebuffer_state(device->pipe,&(struct pipe_framebuffer_state){0});
+   else if (why && why_size && !why[0]) say(why,why_size,"Metal command scope retired after a failed completion");
+   return error;
+}
+
+
 /* What the shader calls a texture slot, in the words a Metal programmer wrote it in,
  * so that a refusal about a mismatch names both sides in one vocabulary.
  */
