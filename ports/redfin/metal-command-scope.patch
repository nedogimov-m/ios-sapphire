 void rwa_device_close(struct rwa_device *device);
+
+/* Opt-in Metal command-buffer scope. Caller serializes the entire scope.
+ * Raster-only draws can share the final real fence; ordinary calls and all
+ * compute/memory-writing shaders retain their immediate completion. */
+int rwa_commands_begin(struct rwa_device *device,char *why,size_t why_size);
+int rwa_commands_end(struct rwa_device *device,char *why,size_t why_size);
 
 /* What the driver should call the GPU, as Mesa knows it ("Adreno 7c+ Gen 3"). Never NULL. */
 const char *rwa_device_name(struct rwa_device *device);
