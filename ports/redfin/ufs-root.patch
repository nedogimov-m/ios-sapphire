+/* REDFIN_ROOT_GUARD_TEST_BEGIN: permanent read-only SCSI allowlist. */
+static bool
+redfin_root_read_allowed(const uint8_t *cdb, unsigned cdb_len, uint32_t len,
+    bool write, uint8_t lun, uint64_t blocks)
+{
+	if (!cdb || write || lun || blocks < 3 || blocks > UINT32_MAX || len > BOUNCE_SIZE)
+		return false;
+	if (cdb_len == 6 && cdb[0] == 0x00 && !len) {
+		for (unsigned i = 1; i < 6; i++) if (cdb[i]) return false;
+		return true;
+	}
+	if (cdb_len == 6 && cdb[0] == 0x12 && len == 36)
+		return !cdb[1] && !cdb[2] && !cdb[3] && cdb[4] == 36 && !cdb[5];
+	if (cdb_len == 10 && cdb[0] == 0x25 && len == 8) {
+		for (unsigned i = 1; i < 10; i++) if (cdb[i]) return false;
+		return true;
+	}
+	if (cdb_len != 10 || cdb[0] != 0x28 || cdb[1] || cdb[6] || cdb[9]) return false;
+	uint64_t lba = (uint32_t)cdb[2] << 24 | (uint32_t)cdb[3] << 16 |
+	    (uint32_t)cdb[4] << 8 | cdb[5];
+	uint32_t count = (uint32_t)cdb[7] << 8 | cdb[8];
+	return count && count <= BOUNCE_SIZE / UFS_BLOCK && len == count * UFS_BLOCK &&
+	    lba < blocks && count <= blocks - lba;
+}
+/* REDFIN_ROOT_GUARD_TEST_END */
 
