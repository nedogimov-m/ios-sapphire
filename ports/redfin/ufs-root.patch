+/* REDFIN_GPT_TEST_BEGIN: pure bounds/CRC validators, no MMIO or disk writes. */
+struct redfin_gpt {
+	uint64_t blocks, alternate, first, last, entries;
+	uint32_t count, entry_size, array_bytes, header_crc, entries_crc;
+};
+
+static uint32_t
+redfin_gpt_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	       (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t
+redfin_gpt_le64(const uint8_t *p)
+{
+	return redfin_gpt_le32(p) | (uint64_t)redfin_gpt_le32(p + 4) << 32;
+}
+
+static uint32_t
+redfin_gpt_crc(const uint8_t *p, uint32_t size, bool header)
+{
+	uint32_t crc = UINT32_MAX;
+	for (uint32_t i = 0; i < size; i++) {
+		crc ^= header && i >= 16 && i < 20 ? 0 : p[i];
+		for (unsigned bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ (0xedb88320U & (0U - (crc & 1)));
+	}
+	return ~crc;
+}
+
+static int
+redfin_gpt_capacity(uint32_t last, uint32_t block, uint64_t *blocks)
+{
+	if (!blocks) return EINVAL;
+	*blocks = 0;
+	/* READ CAPACITY(10) saturation requires READ CAPACITY(16), not a guess. */
+	if (block != UFS_BLOCK || last == UINT32_MAX || last < 2) return EINVAL;
+	*blocks = (uint64_t)last + 1;
+	return 0;
+}
+
+static int
+redfin_gpt_header(const uint8_t *b, unsigned bytes, uint64_t blocks,
+    struct redfin_gpt *out)
+{
+	if (!b || !out || bytes < 92 || blocks < 3 || blocks > UINT32_MAX) return EINVAL;
+	for (unsigned i = 0; i < 8; i++)
+		if (b[i] != (uint8_t)"EFI PART"[i]) return EINVAL;
+	uint32_t size = redfin_gpt_le32(b + 12);
+	if (redfin_gpt_le32(b + 8) != 0x10000 || size < 92 || size > UFS_BLOCK ||
+	    size > bytes || redfin_gpt_le32(b + 20) || redfin_gpt_le64(b + 24) != 1)
+		return EINVAL;
+	struct redfin_gpt g;
+	g.blocks = blocks;
+	g.alternate = redfin_gpt_le64(b + 32);
+	g.first = redfin_gpt_le64(b + 40);
+	g.last = redfin_gpt_le64(b + 48);
+	g.entries = redfin_gpt_le64(b + 72);
+	g.count = redfin_gpt_le32(b + 80);
+	g.entry_size = redfin_gpt_le32(b + 84);
+	g.header_crc = redfin_gpt_le32(b + 16);
+	g.entries_crc = redfin_gpt_le32(b + 88);
+	if (g.alternate != blocks - 1 || g.first < 2 || g.first > g.last ||
+	    g.last >= g.alternate || g.entries < 2 || g.entries >= g.first ||
+	    g.entry_size < 128 || g.entry_size > UFS_BLOCK || (g.entry_size & 7) ||
+	    !g.count || g.count > BOUNCE_SIZE / g.entry_size) return EINVAL;
+	g.array_bytes = g.count * g.entry_size; /* Division bound above prevents overflow. */
+	uint64_t array_blocks = ((uint64_t)g.array_bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+	if (array_blocks > g.first - g.entries ||
+	    redfin_gpt_crc(b, size, true) != g.header_crc) return EINVAL;
+	*out = g;
+	return 0;
+}
+
+static bool
+redfin_gpt_name(const uint8_t *entry, const char *want)
+{
+	for (unsigned i = 0; i < 36; i++) {
+		unsigned c = entry[56 + 2 * i] | (unsigned)entry[57 + 2 * i] << 8;
+		if (c > 127 || c != (uint8_t)want[i]) return false;
+		if (!c) return true;
+	}
+	return !want[36];
+}
+
+static int
+redfin_gpt_partition(const uint8_t *b, unsigned bytes, const struct redfin_gpt *g,
+    const char *want, uint64_t *first, uint64_t *count)
+{
+	if (!b || !g || !want || !*want || !first || !count ||
+	    g->entry_size < 128 || g->entry_size > UFS_BLOCK || (g->entry_size & 7) ||
+	    !g->count || g->count > BOUNCE_SIZE / g->entry_size ||
+	    g->array_bytes != g->count * g->entry_size || g->array_bytes > bytes ||
+	    redfin_gpt_crc(b, g->array_bytes, false) != g->entries_crc) return EINVAL;
+	bool found = false;
+	uint64_t selected_first = 0, selected_count = 0;
+	for (uint32_t i = 0; i < g->count; i++) {
+		const uint8_t *e = b + i * g->entry_size;
+		bool used = false;
+		for (unsigned j = 0; j < 16; j++) used |= e[j] != 0;
+		if (!used) continue;
+		uint64_t begin = redfin_gpt_le64(e + 32), end = redfin_gpt_le64(e + 40);
+		if (begin < g->first || end > g->last || begin > end || end >= g->blocks)
+			return EINVAL;
+		/* All used entries must be disjoint, including partitions not selected. */
+		for (uint32_t j = 0; j < i; j++) {
+			const uint8_t *other = b + j * g->entry_size;
+			bool other_used = false;
+			for (unsigned k = 0; k < 16; k++) other_used |= other[k] != 0;
+			if (other_used && begin <= redfin_gpt_le64(other + 40) &&
+			    redfin_gpt_le64(other + 32) <= end) return EINVAL;
+		}
+		if (!redfin_gpt_name(e, want)) continue;
+		if (found) return EINVAL;
+		found = true;
+		selected_first = begin;
+		selected_count = end - begin + 1;
+	}
+	if (!found) return ENOENT;
+	*first = selected_first;
+	*count = selected_count;
+	return 0;
+}
+/* REDFIN_GPT_TEST_END */
+
+/* Selected only by redfinroot=1; redfin.patch still disables full init. */
+static int
+redfin_ufs_find_partition(const char *want)
+{
+	uint32_t rw = 0, rootrw = 0;
+	(void)PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	(void)PE_parse_boot_argn("rootrw", &rootrw, sizeof(rootrw));
+	if (rw || rootrw || su.writable || su.lun != 0) return EROFS;
+	static const uint8_t capacity[10] = {0x25};
+	int error = ufs_scsi(capacity, sizeof(capacity), 8, false);
+	if (error) return error;
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t blocks;
+	uint32_t last = (uint32_t)b[0] << 24 | (uint32_t)b[1] << 16 | (uint32_t)b[2] << 8 | b[3];
+	uint32_t block = (uint32_t)b[4] << 24 | (uint32_t)b[5] << 16 | (uint32_t)b[6] << 8 | b[7];
+	if ((error = redfin_gpt_capacity(last, block, &blocks))) return error;
+	if (redfin_ufs_root_read_only && blocks != redfin_ufs_root_blocks) return EIO;
+	if ((error = ufs_read_blocks(1, 1))) return error;
+	struct redfin_gpt g;
+	if ((error = redfin_gpt_header(b, UFS_BLOCK, blocks, &g))) return error;
+	uint32_t array_blocks = (g.array_bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+	if ((error = ufs_read_blocks(g.entries, array_blocks))) return error;
+	uint64_t first, count;
+	if ((error = redfin_gpt_partition(b, array_blocks * UFS_BLOCK, &g, want, &first, &count)))
+		return error;
+	/* Commit partition bounds only after capacity and both CRCs are validated. */
+	gpt_alt = g.alternate; gpt_hcrc = g.header_crc; gpt_ecrc = g.entries_crc;
+	/* Legacy watch checks backup only when this is nonzero. No backup claim. */
+	gpt_bhcrc = 0;
+	su.first_block = first;
+	su.nblocks = count;
+	return 0;
+}
