+	    !compatible || bytes != sizeof(expected) || memcmp(compatible,expected,sizeof(expected)) ||
+	    !redfin_hid_cells(display,"redfin,abl-copy-only",marker,1) ||
+	    !redfin_hid_cells(display,"width",width,1) || !redfin_hid_cells(display,"height",height,1) ||
+	    !redfin_hid_cells(display,"canvas-width",cw,1) || !redfin_hid_cells(display,"canvas-height",ch,1) ||
+	    !redfin_hid_cells(touch,"touch-size",size,2)) return false;
+	return redfin_touch_geometry_make(1080,2340,1125,2436,out);
+}
+/* REDFIN_HID_PROFILE_END */
+
 bool
 SweetHIDTouch::start(IOService *provider)
 {
@@ -438,14 +478,43 @@
 	fLogicalH = native ? 2400 : 2436;
 	fOffX = ((fLogicalW - 1080) / 2) & ~3;           /* as SweetFramebuffer.cpp */
 	fOffY = (fLogicalH - 2400) / 2;
+	fPanelW = 1080; fPanelH = 2400; fRedfinGeometry = false;
+	struct redfin_touch_geometry geometry;
+	if (redfin_hid_profile(&geometry)) {
+		fPanelW = geometry.panel_w; fPanelH = geometry.panel_h;
+		fLogicalW = geometry.logical_w; fLogicalH = geometry.logical_h;
+		fOffX = geometry.off_x; fOffY = geometry.off_y;
