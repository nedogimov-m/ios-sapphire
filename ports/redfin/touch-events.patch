+
+bool
+SweetHIDTouch::redfinConsumerReady(void)
+{
+	if (!fRedfinGeometry || !_clientLock || !_clients) return false;
+	bool ready = false;
+	IOLockLock(_clientLock);
+	for (unsigned i = 0; i < _clients->getCount(); i++) {
+		IOHIDEventServiceClient *client = (IOHIDEventServiceClient *)_clients->getObject(i);
+		if (client && client->action) { ready = true; break; }
+	}
+	IOLockUnlock(_clientLock);
+	return ready;
+}
+extern "C" bool
