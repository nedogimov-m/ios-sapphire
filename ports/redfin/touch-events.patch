+
+bool
+redfin_touch_spi_identity_ready(void)
+{
+	return redfin_spi_verified_se && redfin_spi_verified_hz && !redfin_spi_event_open;
+}
+void
+redfin_touch_spi_events_close(void)
+{
+	if (redfin_spi_event_open) {
+		/* Only this session's own in-flight command may be cancelled. */
+		if (redfin_spi_event_context.command_owned)
+			(void)redfin_spi_failed(&redfin_spi_event_context, EIO);
+		redfin_spi_wr(&redfin_spi_event_context, 0xe1c, 0);
+		redfin_spi_wr(&redfin_spi_event_context, 0x614, 0);
+		redfin_spi_event_context.dead = true;
+		redfin_spi_event_open = false;
+	}
+	redfin_spi_verified_se = 0;
+	redfin_spi_verified_hz = 0;
+}
+int
+redfin_touch_spi_events_begin(bool gic_irq_masked)
+{
+	uint32_t enabled = 0;
+	(void)PE_parse_boot_argn("redfintouchevents", &enabled, sizeof(enabled));
+	if (enabled != 1 || !gic_irq_masked || !redfin_touch_spi_identity_ready()) return ENOTSUP;
+	redfin_spi_event_context = (struct redfin_spi){redfin_spi_verified_se,0,0,false,false};
+	int error = redfin_spi_prepare(&redfin_spi_event_context);
+	if (error) { redfin_touch_spi_events_close(); return error; }
+	redfin_spi_event_open = true;
+	return 0;
+}
+int
+redfin_touch_spi_event_read(unsigned reg, unsigned count, uint8_t *out)
+{
+	if (!redfin_spi_event_open) return ENXIO;
+	if (!((reg == 0x55 && count == 1) || (reg == 0x60 && count == 8) ||
+	    (reg == 0x61 && count >= 8 && count <= 248 && count % 8 == 0))) {
+		redfin_touch_spi_events_close();
+		return EINVAL;
+	}
+	int error = redfin_spi_read(&redfin_spi_event_context,reg,count,out);
+	if (error) redfin_touch_spi_events_close();
+	return error;
 }
 #endif
diff --git a/bsd/dev/redfin_touch_events.h b/bsd/dev/redfin_touch_events.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_touch_events.h
@@ -0,0 +1,111 @@
+/* SEC event state: no MMIO, no IOKit, no IC writes. Source sec_ts.c
+ * 0701b191882dc408104ad8af9e2f5eb2bf34c297: read_event/handle_coord_event.
+ */
+#ifndef REDFIN_TOUCH_EVENTS_H
+#define REDFIN_TOUCH_EVENTS_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/errno.h>
+#include "redfin_touch_protocol.h"
+struct redfin_events_state {
+	uint16_t down, suppressed;
+	uint16_t x[10], y[10];
+	bool synchronized, startup_reset;
+	unsigned contacts, releases;
+};
+typedef void (*redfin_events_emit)(void *, unsigned, int, unsigned, unsigned);
+struct redfin_events_ops {
+	int (*read)(void *, unsigned, unsigned, uint8_t *);
+	redfin_events_emit emit;
+	void *context;
+};
+static inline void
+redfin_events_release_all(struct redfin_events_state *s, redfin_events_emit emit, void *ctx)
+{
+	for (unsigned i = 0; i < 10; i++) if (s->down & (1u << i)) {
+		if (emit) emit(ctx,i,0,s->x[i],s->y[i]);
+		s->releases++;
+	}
+	s->down = s->suppressed = 0;
+}
+static inline int
+redfin_events_accept(struct redfin_events_state *s, const uint8_t event[8], bool deliver,
+    redfin_events_emit emit, void *ctx)
+{
+	if (!event[0]) return 0;
+	if ((event[7] & 63u) > 31) return EOVERFLOW;
+	unsigned kind = event[0] & 3u;
+	if (kind == 1) {
+		unsigned type = (event[0] >> 2) & 15u;
+		if (type == 1) return EIO; /* core error, queue full, ESD or unknown error. */
+		if (type == 2 && event[1] == 0) {
+			if (s->synchronized || !s->startup_reset ||
+			    (event[2] != 0x10 && event[2] != 0x40)) return EIO;
+			s->startup_reset = false; /* Permit one queued initial reset, never watchdog0x20. */
+		}
+		return 0;
+	}
+	if (kind != 0) return 0; /* Gesture/empty event types do not create fingers. */
+	struct redfin_touch_contact c;
+	if (redfin_touch_decode(event,8,&c) != 1) return EINVAL;
+	uint16_t bit = (uint16_t)(1u << c.finger);
+	if (c.action == 3) {
+		if (s->down & bit) {
+			if (emit) emit(ctx,c.finger,0,s->x[c.finger],s->y[c.finger]);
+			s->releases++;
+		}
+		s->down &= (uint16_t)~bit;
+		s->suppressed &= (uint16_t)~bit;
+		return 0;
+	}
+	bool finger = c.type == 0 || c.type == 3 || c.type == 6;
+	if (!deliver || !finger) {
+		if (s->down & bit) {
+			if (emit) emit(ctx,c.finger,0,s->x[c.finger],s->y[c.finger]);
+			s->releases++;
+			s->down &= (uint16_t)~bit;
+		}
+		s->suppressed |= bit; /* Unsupported/palm contact stays suppressed until UP. */
+		return 0;
+	}
+	if (s->suppressed & bit) return 0;
+	/* A MOVE whose DOWN was dropped before registration cannot start a gesture. */
+	if (c.action == 2 && !(s->down & bit)) return 0;
+	if (!(s->down & bit)) s->contacts++;
+	s->down |= bit;
+	s->x[c.finger] = (uint16_t)c.x;
+	s->y[c.finger] = (uint16_t)c.y;
+	if (emit) emit(ctx,c.finger,1,c.x,c.y);
+	return 0;
+}
+/* One controller batch, at most32 events. Read/check the whole batch before
+ * emitting anything, so a corrupt trailing packet cannot create partial DOWNs.
+ */
+static inline int
+redfin_events_batch(struct redfin_events_state *s, const struct redfin_events_ops *ops, bool deliver)
+{
+	if (!s || !ops || !ops->read || (deliver && !s->synchronized)) return EINVAL;
+	uint8_t events[32 * 8] = {0};
+	int error = ops->read(ops->context,0x60,8,events);
+	if (error) return error;
+	if (!events[0]) {
+		if (!deliver) { s->synchronized = true; s->startup_reset = false; }
+		return 0;
+	}
+	unsigned remaining = events[7] & 63u;
+	if (remaining > 31) return EOVERFLOW;
+	if (remaining) {
+		error = ops->read(ops->context,0x61,remaining * 8,events + 8);
+		if (error) return error;
+	}
+	struct redfin_events_state next = *s;
+	for (unsigned i = 0; i <= remaining; i++) {
+		if (!events[i * 8]) return EINVAL; /* A declared queued event must be nonempty. */
+		error = redfin_events_accept(&next,events + i * 8,deliver,NULL,NULL);
+		if (error) return error;
+	}
+	for (unsigned i = 0; i <= remaining; i++)
+		(void)redfin_events_accept(s,events + i * 8,deliver,ops->emit,ops->context);
+	return 0;
+}
+#endif
diff --git a/iokit/Kernel/arm/hid/RedfinTouchGeometry.h b/iokit/Kernel/arm/hid/RedfinTouchGeometry.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/hid/RedfinTouchGeometry.h
@@ -0,0 +1,27 @@
+#ifndef REDFIN_TOUCH_GEOMETRY_H
+#define REDFIN_TOUCH_GEOMETRY_H
+#include <stdint.h>
+struct redfin_touch_geometry { int panel_w,panel_h,logical_w,logical_h,off_x,off_y; };
+static inline bool
+redfin_touch_geometry_make(unsigned pw,unsigned ph,unsigned cw,unsigned ch,struct redfin_touch_geometry *out)
+{
+	if (!out || pw != 1080 || ph != 2340 || cw != 1125 || ch != 2436) return false;
+	*out = {1080,2340,1125,2436,20,48};
+	return true;
+}
+static inline int
+redfin_touch_axis_clamp(int value,int dimension)
+{
+	return value < 0 ? 0 : value >= dimension ? dimension - 1 : value;
+}
+static inline int32_t
+redfin_touch_axis_normalize(int value,int offset,int logical)
+{
+	return (int32_t)(((int64_t)(value + offset) << 16) / logical);
+}
+static inline bool
+redfin_touch_edge(int x,int y,int width,int height,int border)
+{
+	return x < border || x > width - 1 - border || y < border || y > height - 1 - border;
+}
+#endif
diff --git a/bsd/dev/redfin_touch_events.c b/bsd/dev/redfin_touch_events.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_touch_events.c
@@ -0,0 +1,157 @@
+/* Opt-in bounded event worker; no startup hook and no IC write command.
+ * Requires the same boot's successful SEC ID, retained power/clocks/ownership,
+ * and a registered Redfin HID consumer. Event read/checksum lives in SPI backend.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "redfin_touch_events.h"
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern bool redfin_touch_spi_identity_ready(void);
+extern int redfin_touch_spi_events_begin(bool);
+extern int redfin_touch_spi_event_read(unsigned,unsigned,uint8_t *);
+extern void redfin_touch_spi_events_close(void);
+extern bool sweet_hid_redfin_touch_ready(void);
+extern void sweet_hid_touch(int,int,int,int);
+int redfin_touch_events_start(void);
+static bool redfin_events_attempted;
+static vm_offset_t redfin_events_gpio,redfin_events_gic;
+static unsigned redfin_events_seconds;
+static int redfin_events_sleep;
+static bool redfin_events_delivery_failed;
+static uint32_t
+redfin_events_rd(vm_offset_t base,unsigned offset)
+{
+	uint32_t value = *(volatile const uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+static bool
+redfin_events_owned(void)
+{
+	/* INTID633 must stay disabled at the distributor; IRQ9 stays GPIO input. */
+	return !(redfin_events_rd(redfin_events_gic,0x14c) & (1u << 25)) &&
+	    !(redfin_events_rd(redfin_events_gpio,0x1000) & 0x23cu);
+}
+static void
+redfin_events_wait(unsigned ms)
+{
+	uint64_t wake;
+	clock_interval_to_deadline(ms,NSEC_PER_MSEC,&wake);
+	if (assert_wait_deadline((event_t)&redfin_events_sleep,THREAD_UNINT,wake) == THREAD_WAITING)
+		thread_block(THREAD_CONTINUE_NULL);
+}
+static int
+redfin_events_read(void *ctx,unsigned reg,unsigned count,uint8_t *out)
+{
+	(void)ctx;
+	if (!redfin_events_owned()) return EBUSY;
+	if (!sweet_hid_redfin_touch_ready()) return EPIPE;
+	return redfin_touch_spi_event_read(reg,count,out);
+}
+static void
+redfin_events_emit_hid(void *ctx,unsigned finger,int down,unsigned x,unsigned y)
+{
+	(void)ctx;
+	/* UP also clears SweetHID's state if its consumer just disappeared. */
+	if (down && !sweet_hid_redfin_touch_ready()) { redfin_events_delivery_failed = true; return; }
+	sweet_hid_touch((int)finger,down,(int)x,(int)y);
+}
+static void
+redfin_events_worker(void *arg,wait_result_t wait)
+{
+	(void)arg; (void)wait;
+	struct redfin_events_state state = {0};
+	state.startup_reset = true;
+	redfin_events_delivery_failed = false;
+	const struct redfin_events_ops ops = {redfin_events_read,redfin_events_emit_hid,NULL};
+	uint64_t deadline;
+	clock_interval_to_deadline(redfin_events_seconds,NSEC_PER_SEC,&deadline);
+	int error = 0;
+	unsigned ticks = 0,batches = 0;
+	/* No SPI events consumed and no DOWN emitted before a real callback consumer. */
+	while (!sweet_hid_redfin_touch_ready()) {
+		if (mach_absolute_time() >= deadline) { error = ETIMEDOUT; goto done; }
+		redfin_events_wait(100);
+	}
+	if (!redfin_events_owned()) { error = EBUSY; goto done; }
+	error = redfin_touch_spi_events_begin(true);
+	if (error) goto done;
+	uint8_t boot = 0;
+	error = redfin_events_read(NULL,0x55,1,&boot);
+	if (error || boot != 0x20) { if (!error) error = ENOTSUP; goto done; }
+	/* Discard pre-registration contacts; require an empty queue within4 batches.
+	 * A held old contact stays suppressed until UP; an unknown MOVE is ignored. */
+	for (unsigned i = 0; i < 4 && !state.synchronized; i++) {
+		if (mach_absolute_time() >= deadline) { error = ETIMEDOUT; goto done; }
+		error = redfin_events_batch(&state,&ops,false);
+		if (error) goto done;
+	}
+	if (!state.synchronized) { error = EBUSY; goto done; }
+	printf("REDFIN TOUCH EVENTS: consumer ready, synchronized, bounded %us session\n",redfin_events_seconds);
+	while (mach_absolute_time() < deadline) {
+		if (!sweet_hid_redfin_touch_ready()) { error = EPIPE; break; }
+		if (!redfin_events_owned()) { error = EBUSY; break; }
+		if (!(redfin_events_rd(redfin_events_gpio,0x1004) & 1) || state.down || (ticks++ % 13) == 0) {
+			error = redfin_events_batch(&state,&ops,true);
+			if (error) break;
+			if (redfin_events_delivery_failed) { error = EPIPE; break; }
+			batches++;
+		}
+		redfin_events_wait(8);
+	}
+done:
+	redfin_events_release_all(&state,redfin_events_emit_hid,NULL);
+	redfin_touch_spi_events_close();
+	printf("REDFIN TOUCH EVENTS: stopped error=%d batches=%u contacts=%u releases=%u\n",
+	    error,batches,state.contacts,state.releases);
+	(void)thread_terminate(current_thread());
+	__builtin_unreachable();
+}
+static int
+redfin_events_contract(void)
+{
+	DTEntry node;
+	const char *compat = NULL;
+	const uint32_t *size = NULL,*gpios = NULL;
+	const char expected[] = "redfin,sec-touch";
+	unsigned n = 0;
+	if (SecureDTLookupEntry(NULL,"/redfin-touch",&node) != kSuccess ||
+	    SecureDTGetProperty(node,"compatible",(const void **)&compat,&n) != kSuccess ||
+	    !compat || n != sizeof(expected) || memcmp(compat,expected,sizeof(expected)) ||
+	    SecureDTGetProperty(node,"touch-size",(const void **)&size,&n) != kSuccess ||
+	    !size || n != 8 || size[0] != 1080 || size[1] != 2340 ||
+	    SecureDTGetProperty(node,"touch-gpios",(const void **)&gpios,&n) != kSuccess ||
+	    !gpios || n != 12 || gpios[0] != 8 || gpios[1] != 9 || gpios[2] != 35) return ENXIO;
+	return 0;
+}
+int
+redfin_touch_events_start(void)
+{
+	uint32_t enabled = 0,seconds = 120;
+	(void)PE_parse_boot_argn("redfintouchevents",&enabled,sizeof(enabled));
+	(void)PE_parse_boot_argn("redfintouchsecs",&seconds,sizeof(seconds));
+	if (enabled != 1 || redfin_events_attempted || !redfin_touch_spi_identity_ready()) return ENOTSUP;
+	if (seconds < 1 || seconds > 300) return EINVAL;
+	redfin_events_attempted = true;
+	int error = redfin_events_contract();
+	if (error) return error;
+	redfin_events_gpio = ml_io_map(0xf508000,0x4000);
+	redfin_events_gic = ml_io_map(0x17a00000,0x10000);
+	if (!redfin_events_gpio || !redfin_events_gic) return ENOMEM;
+	if (!redfin_events_owned()) return EBUSY;
+	redfin_events_seconds = seconds;
+	thread_t thread;
+	kern_return_t result = kernel_thread_start(redfin_events_worker,NULL,&thread);
+	if (result != KERN_SUCCESS) return EIO;
+	thread_deallocate(thread);
+	return 0;
+}
+#endif
