 #define RF_SPI_PACK1 0x000ffefeu
 struct redfin_spi { vm_offset_t se; unsigned tx_depth, rx_depth; bool dead, command_owned; };
 static bool redfin_spi_attempted;
+/* Proof is created only by this boot's successful ID and invalidated on close. */
+static vm_offset_t redfin_spi_verified_se;
+static unsigned redfin_spi_verified_hz;
+static struct redfin_spi redfin_spi_event_context;
+static bool redfin_spi_event_open;
+bool redfin_touch_spi_identity_ready(void);
+int redfin_touch_spi_events_begin(bool gic_irq_masked);
+int redfin_touch_spi_event_read(unsigned reg, unsigned count, uint8_t *out);
+void redfin_touch_spi_events_close(void);
 
 static uint32_t
 redfin_spi_rd(struct redfin_spi *s, unsigned offset)
@@ -186,6 +195,55 @@
 	redfin_spi_wr(&context, 0x614, 0);
 	if (error) return error;
