-	return redfin_touch_spi_event_read(reg,count,out);
+    int error = 0;
+    /* Native SEC allows three malformed completed replies, separated by1ms.
+     * Only discarded resynchronization reads may repeat; no uncertain live
+     * coordinate batch is replayed or delivered by these extra attempts. */
+    for (unsigned attempt = 0; attempt < 3; ++attempt) {
