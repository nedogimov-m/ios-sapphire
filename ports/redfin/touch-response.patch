--- a/bsd/dev/redfin_touch_spi.c
+++ b/bsd/dev/redfin_touch_spi.c
@@ -11,6 +11,7 @@
 #include <sys/systm.h>
 #include <sys/errno.h>
 #include <kern/clock.h>
