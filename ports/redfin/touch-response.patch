+        if (!sweet_hid_redfin_touch_ready()) return EPIPE;
+        error = redfin_touch_spi_event_read(reg,count,out);
+        if (error != EILSEQ || !redfin_events_resyncing) return error;
+        if (attempt < 2) redfin_events_wait(1);
+    }
+    return error;
