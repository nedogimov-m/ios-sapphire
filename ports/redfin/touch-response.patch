 #include <pexpert/pexpert.h>
 #include "redfin_touch_protocol.h"
 #include "redfin_touch_sensing.h"
@@ -256,19 +257,59 @@
 }
 
 static int
-redfin_spi_read(struct redfin_spi *s, unsigned reg, unsigned count, uint8_t *out)
+redfin_spi_read_transaction(struct redfin_spi *s, unsigned reg, unsigned count, uint8_t *out)
 {
 	uint8_t request[8], response[256];
 	unsigned bytes = redfin_touch_response_size(reg, count);
 	if (!out || !bytes || !redfin_touch_read_request(reg, count, request)) return EINVAL;
 	int error = redfin_spi_transfer(s, request, NULL, sizeof(request));
 	if (error) return error;
-	delay(redfin_touch_read_delay(reg));
+	uint64_t gap_started = mach_absolute_time();
+	unsigned settle = redfin_touch_read_delay(reg);
+    /* Native SEC uses a scheduled wait with this minimum. A tight busy wait
+     * on an idle/waking controller needs margin; keep the existing 500us
+     * READ_ALL_EVENT floor for both event commands after sensing starts. */
+    if (s == &redfin_spi_event_context && redfin_spi_event_open && redfin_spi_event_sensing &&
+        (reg == 0x60 || reg == 0x61) && settle < 500) settle = 500;
+	delay(settle);
+	uint64_t gap_finished = mach_absolute_time();
 	error = redfin_spi_transfer(s, NULL, response, bytes);
 	if (error) return error;
-	if (!redfin_touch_response_valid(reg, count, response, bytes)) return redfin_spi_failed(s, EIO);
+	if (!redfin_touch_response_valid(reg, count, response, bytes)) {
+        /* Both CS phases completed, the host is idle and no bytes were
+         * delivered. Native SEC retries malformed replies; consumed events
+         * cannot be replayed, so the HID worker instead drops/resynchronizes
+         * its queue. GENI errors/timeouts and non-event reads stay fatal. */
+        uint8_t checksum = 0;
+        for (unsigned i = 0; i < 7u + count; ++i) checksum = (uint8_t)(checksum + response[i]);
+        uint64_t gap_ns = 0;
+        absolutetime_to_nanoseconds(gap_finished-gap_started,&gap_ns);
+        printf("REDFIN TOUCH RESPONSE: reg=%#x count=%u header=%02x:%02x:%02x:%02x:%02x:%02x:%02x checksum=%02x/%02x gap_us=%llu\n",
+            reg, count, response[0], response[1], response[2], response[3], response[4], response[5], response[6],
+            checksum, response[7u + count],(unsigned long long)(gap_ns/1000));
+        if (s == &redfin_spi_event_context && redfin_spi_event_open && redfin_spi_event_sensing &&
+            !s->dead && !s->command_owned && (reg == 0x60 || reg == 0x61) &&
+            !(redfin_spi_rd(s, 0x40) & 0x1001) &&
+            !(redfin_spi_rd(s, 0x800) & 0x0fffffff) &&
+            !(redfin_spi_rd(s, 0x804) & 0x01ffffff) &&
+            !(redfin_spi_rd(s, 0x610) & ~RF_SPI_STATUS_EVENTS)) return EILSEQ;
+        return redfin_spi_failed(s, EIO);
+    }
 	memcpy(out, response + 7, count);
 	return 0;
+}
+
+static int
+redfin_spi_read(struct redfin_spi *s, unsigned reg, unsigned count, uint8_t *out)
+{
+    /* A polled SEC exchange is two CS phases plus the settle interval.
+     * Keep an unrelated CPU0 worker from stretching that interval or an RX
+     * FIFO pause. IRQs remain enabled. All GENI loops are already bounded. */
+    bool critical = s == &redfin_spi_event_context && redfin_spi_event_open;
+    if (critical) disable_preemption();
+    int error = redfin_spi_read_transaction(s,reg,count,out);
+    if (critical) enable_preemption();
+    return error;
 }
 
