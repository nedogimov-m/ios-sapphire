@@ -346,7 +387,7 @@
 		return EINVAL;
 	}
 	int error = redfin_spi_read(&redfin_spi_event_context,reg,count,out);
-	if (error) redfin_touch_spi_events_close();
+	if (error && error != EILSEQ) redfin_touch_spi_events_close();
 	return error;
 }
 
