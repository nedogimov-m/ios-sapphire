+/* Owns the supplied reference. These raw buffer aliases are never sampled
+ * or bound as framebuffers. The paired AIR pays real fences across aliases. */
+static struct pipe_resource *
+redfin_buffer_from_bo(struct pipe_screen *screen,struct fd_bo *bo)
+{
+   uint32_t size=bo?fd_bo_size(bo):0;
+   if(!size){if(bo)fd_bo_del(bo);return NULL;}
+   const struct pipe_resource shape={.target=PIPE_BUFFER,.format=PIPE_FORMAT_R8_UINT,
+      .width0=size,.height0=1,.depth0=1,.array_size=1,
+      .bind=PIPE_BIND_SHADER_BUFFER|PIPE_BIND_CONSTANT_BUFFER|PIPE_BIND_INDEX_BUFFER|PIPE_BIND_VERTEX_BUFFER,.usage=PIPE_USAGE_DEFAULT};
+   struct fd_resource *rsc=alloc_resource_struct(screen,&shape);
+   if(!rsc){fd_bo_del(bo);return NULL;}
+   rsc->internal_format=PIPE_FORMAT_R8_UINT;
+   fd_resource_layout_init(&rsc->b.b);
+   fdl_layout_buffer(&rsc->layout,size);
+   tc_buffer_disable_cpu_storage(&rsc->b.b);
+   fd_resource_set_bo(rsc,bo);rsc->b.is_shared=true;rsc->valid=true;
+   util_range_add(&rsc->b.b,&rsc->valid_buffer_range,0,size);
+   return &rsc->b.b;
+}
+struct pipe_resource *
+redfin_freedreno_import_buffer(struct pipe_screen *screen,unsigned surface)
+{
+   if(!is_a6xx(fd_screen(screen))||!surface)return NULL;
+   struct winsys_handle handle={.type=WINSYS_HANDLE_TYPE_FD,.handle=surface,
+      .modifier=DRM_FORMAT_MOD_LINEAR};
+   struct fd_bo *bo=fd_screen_bo_from_handle(screen,&handle);
+   /* Retain a real CPU mapping of these original pages. The existing Darwin
+    * clientMemoryForType path then records CPU writers and pays cache
+    * maintenance on EVERY native submit, even without an IOSurface seed bump.
+    * This map is owned/unmapped by the imported BO; it never copies pixels. */
+   if(!bo)return NULL;
+   if(!fd_bo_map(bo)){fd_bo_del(bo);return NULL;}
+   return redfin_buffer_from_bo(screen,bo);
+}
+struct pipe_resource *
+redfin_freedreno_buffer_alias(struct pipe_screen *screen,struct pipe_resource *source,
+    unsigned *pitch,unsigned *offset)
+{
+   if(!source||source->screen!=screen||!pitch||!offset||!is_a6xx(fd_screen(screen))||
+      source->target!=PIPE_TEXTURE_2D||source->last_level||source->array_size!=1||source->nr_samples>1)return NULL;
+   struct fd_resource *rsc=fd_resource(source);
+   if(!rsc->bo||fd_resource_tile_mode(source,0)||fd_resource_ubwc_enabled(rsc,0))return NULL;
+   uint64_t start=fd_resource_offset(rsc,0,0);
+   if(start>UINT32_MAX)return NULL;
+   struct pipe_resource *buffer=redfin_buffer_from_bo(screen,fd_bo_ref(rsc->bo));
+   if(buffer){*pitch=fd_resource_pitch(rsc,0);*offset=(unsigned)start;}
+   return buffer;
+}
+struct pipe_resource *
+redfin_freedreno_texture_alias(struct pipe_screen *pscreen,struct pipe_resource *source,
+    const struct pipe_resource *shape,unsigned offset,unsigned pitch)
+{
+   if(!source||source->screen!=pscreen||source->target!=PIPE_BUFFER||!shape||
+      shape->target!=PIPE_TEXTURE_2D||shape->last_level||shape->array_size!=1||shape->nr_samples>1||
+      !is_a6xx(fd_screen(pscreen))||!shape->width0||!shape->height0||!pitch)return NULL;
+   unsigned cpp=util_format_get_blocksize(shape->format);
+   if(!cpp||cpp>16||(cpp&(cpp-1))||util_format_is_compressed(shape->format)||util_format_is_depth_or_stencil(shape->format))return NULL;
+   struct fd_resource *parent=fd_resource(source);
+   uint64_t bytes=(uint64_t)pitch*shape->height0;
+   if(!parent->bo||offset>source->width0||bytes>source->width0-offset||bytes>UINT32_MAX||
+      ((fd_bo_get_iova(parent->bo)+offset)&63u)||
+      (uint64_t)shape->width0*util_format_get_blocksize(shape->format)>pitch)return NULL;
+   struct fd_resource *rsc=alloc_resource_struct(pscreen,shape);
+   if(!rsc)return NULL;
+   struct pipe_resource *resource=&rsc->b.b;
+   rsc->internal_format=shape->format;rsc->b.is_shared=true;
+   fd_resource_layout_init(resource);fd_resource_set_bo(rsc,fd_bo_ref(parent->bo));
+   rsc->layout.layer_first=true;rsc->layout.pitch0=pitch;
+   struct fdl_slice *slice=fd_resource_slice(rsc,0);slice->offset=offset;slice->size0=(unsigned)bytes;
+   rsc->layout.pitchalign=MAX2(fdl_cpp_shift(&rsc->layout)+util_logbase2(fd_screen(pscreen)->info->gmem_align_w),6);
+   if(fd_resource_pitch(rsc,0)!=pitch||fd_screen(pscreen)->layout_resource_for_modifier(rsc,DRM_FORMAT_MOD_LINEAR)<0) {
+      fd_resource_destroy(pscreen,resource);return NULL;
+   }
+   rsc->valid=true;return resource;
+}
+int
+redfin_freedreno_gpu_blit(struct pipe_context *pipe,const struct pipe_blit_info *info)
+{
+   if(!pipe||!info||!info->src.resource||!info->dst.resource||
+      info->src.resource->screen!=pipe->screen||info->dst.resource->screen!=pipe->screen||
+      !is_a6xx(fd_context(pipe)->screen))return -1;
+   fd_context_access_begin(fd_context(pipe));
+   bool emitted=fd_context(pipe)->blit&&fd_context(pipe)->blit(fd_context(pipe),info);
+   fd_context_access_end(fd_context(pipe));
+   return emitted?0:-1; /* deliberately no generic CPU fallback */
+}
+int
+redfin_freedreno_gpu_fill(struct pipe_context *pipe,struct pipe_resource *resource,
+    unsigned offset,unsigned bytes,uint8_t value)
+{
+   if(!pipe||!resource||resource->screen!=pipe->screen||!is_a6xx(fd_context(pipe)->screen)||
+      !pipe->clear_buffer||resource->target!=PIPE_BUFFER||offset>resource->width0||bytes>resource->width0-offset)return -1;
+   if(!bytes)return 0;
+   fd_context_access_begin(fd_context(pipe));
+   /* FD6's one-byte clear has no alignment fallback and preserves byte guards. */
+   pipe->clear_buffer(pipe,resource,offset,bytes,&value,1);
+   fd_context_access_end(fd_context(pipe));
+   return 0;
+}
+int
+redfin_freedreno_alias_written(struct pipe_context *pipe,struct pipe_resource *resource)
+{
+   if(!pipe||!resource||resource->screen!=pipe->screen||!is_a6xx(fd_context(pipe)->screen))return -1;
+   /* Private AIR uses context_create(flags=0), holds its recursive frontend
+    * gate, and has paid the real fence. There is no threaded-context worker. */
+   fd_context_access_begin(fd_context(pipe));
+   fd_resource(resource)->valid=true;
+   fd_context_all_dirty(fd_context(pipe));
+   fd_context_access_end(fd_context(pipe));
+   return 0;
+}
+
 bool
 fd_render_condition_check(struct pipe_context *pctx)
 {
