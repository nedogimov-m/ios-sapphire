+/* SPDX-License-Identifier: MIT
+ * Redfin native Wi-Fi prerequisites and separately gated retained power/AOP
+ * experiment. The default path maps read-only. redfinwifipower=1 additionally
+ * requires its exact native lease, live source contract and cold DRV2 handoff.
+ * Neither path invokes PAS, loads firmware, writes SMEM or accesses media.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include "redfin_wifi_native_probe.h"
+#include "../../../bsd/dev/redfin_wifi_aop.h"
+#include "../../../bsd/dev/redfin_rpmh.h"
+#include "../../bsddev/redfin_wifi_smem.h"
+#include "redfin_wifi_bw.h"
+
+extern "C" int redfin_spmi_return_ready(void);
+extern "C" void redfin_wifi_fw_source_probe(void);
+extern "C" void redfin_wifi_fw_start(void);
+
+struct wf_map {
+    IOMemoryDescriptor *memory;
+    IOMemoryMap *mapping;
+};
+struct wf_context { uintptr_t base; bool active; };
+
+static bool wf_property(DTEntry entry, const char *key, void *out, unsigned bytes)
+{
+    const void *raw = NULL;
+    unsigned length = 0;
+    if (SecureDTGetProperty(entry, key, &raw, &length) != kSuccess || !raw || length != bytes)
+        return false;
+    memcpy(out, raw, bytes);
+    return true;
+}
+
+static bool wf_identity(void)
+{
+    DTEntry root;
+    const char *raw = NULL;
+    unsigned bytes = 0;
+    bool redfin = false, lito = false;
+    if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+        SecureDTGetProperty(root, "compatible", (const void **)&raw, &bytes) != kSuccess ||
+        !raw || !bytes || bytes > 256 || raw[bytes - 1]) return false;
+    for (unsigned at = 0; at < bytes;) {
+        unsigned end = at;
+        while (end < bytes && raw[end]) ++end;
+        if (end == bytes || at == end) return false;
+        if (end - at == 13 && !memcmp(raw + at, "google,redfin", 13)) redfin = true;
+        if (end - at == 11 && !memcmp(raw + at, "qcom,sm7250", 11)) lito = true;
+        at = end + 1;
+    }
+    return redfin && lito;
+}
+
+static bool wf_zero_arg(const char *key, bool required)
+{
+    int value = -1;
+    bool present = PE_parse_boot_argn(key, &value, sizeof(value));
+    return present ? value == 0 : !required;
+}
+
+static bool wf_platform(uint64_t ranges[6])
+{
+    const uint64_t expected[6] = {RF_WIFI_AOP_PHYSICAL, RF_WIFI_AOP_BYTES,
+        REDFIN_SMEM_PHYSICAL, REDFIN_SMEM_BYTES, UINT64_C(0x80860000), RF_CMDDB_BYTES};
+    const uint32_t witness[12] = {1, 4, 384, 384, 3, 435, 428, 1, 0, 0x00020002, 1, 3};
+    uint32_t proof = 0, source[12] = {};
+    uint64_t ram_base = 0, ram_bytes = 0, boot_id = 0;
+    int cpus = 0, spmi = 0, returned = 0, wifi_mode = 0;
+    char root[16] = {};
+    DTEntry entry, chosen;
+    if (!wf_identity() ||
+        !PE_parse_boot_argn("cpus", &cpus, sizeof(cpus)) || cpus != 1 ||
+        !PE_parse_boot_argn("redfinwifi", &wifi_mode, sizeof(wifi_mode)) || wifi_mode != 2 ||
+        !PE_parse_boot_argn("rd", root, sizeof(root)) || root[sizeof(root) - 1] || strcmp(root, "md0") ||
+        !PE_parse_boot_argn("redfinspmi", &spmi, sizeof(spmi)) || spmi != 1 ||
+        !PE_parse_boot_argn("redfinreturn", &returned, sizeof(returned)) || returned != 1 ||
+        !PE_parse_boot_argn("redfinbootid", &boot_id, sizeof(boot_id)) || !boot_id ||
+        !redfin_spmi_return_ready() || !wf_zero_arg("modem", true) ||
+        !wf_zero_arg("wifi", true) || !wf_zero_arg("gpu", true) ||
+        !wf_zero_arg("sweetusb", true) || !wf_zero_arg("redfingui", false) ||
+        !wf_zero_arg("redfinsmp", false) ||
+        SecureDTLookupEntry(NULL, "/redfin-wifi-native", &entry) != kSuccess ||
+        !wf_property(entry, "reg", ranges, sizeof(expected)) || memcmp(ranges, expected, sizeof(expected)) ||
+        !wf_property(entry, "live-fdt-verified", &proof, sizeof(proof)) || proof != 1 ||
+        !wf_property(entry, "source-contract", source, sizeof(source)) || memcmp(source, witness, sizeof(source)) ||
+        SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        !wf_property(chosen, "dram-base", &ram_base, sizeof(ram_base)) ||
+        !wf_property(chosen, "dram-size", &ram_bytes, sizeof(ram_bytes)) ||
+        !ram_base || !ram_bytes || ((ram_base | ram_bytes) & 0x3fffULL) ||
+        ram_base > (1ULL << 36) || ram_bytes > (1ULL << 36) - ram_base)
+        return false;
+    for (unsigned i = 0; i < 6; i += 2)
+        if (ranges[i] < ram_base + ram_bytes && ram_base < ranges[i] + ranges[i + 1]) return false;
+    return true;
+}
+
+static int wf_check(void *opaque)
+{
+    const wf_context *context = (const wf_context *)opaque;
+    return context && context->active && context->base && redfin_spmi_return_ready() ? 0 : ENXIO;
+}
+
+static int wf_read32(void *opaque, uint32_t offset, uint32_t *out)
+{
+    wf_context *context = (wf_context *)opaque;
+    if (!out || offset % 4u || offset > RF_WIFI_AOP_BYTES - 4u || wf_check(context)) return EINVAL;
+    *out = *(const volatile uint32_t *)(context->base + offset);
+#if defined(__aarch64__) || defined(__arm64__)
+    __asm__ volatile("dmb oshld" ::: "memory");
+#else
+    __asm__ volatile("" ::: "memory"); /* Host fake-MMIO harness only. */
+#endif
+    return 0;
+}
+
+static int wf_selector(const rf_cmddb_resource *resource, uint32_t wanted)
+{
+    int selected = -1;
+    bool padding = false;
+    if (!resource->level_count || resource->level_count > RF_CMDDB_MAX_LEVELS || resource->levels[0]) return -1;
+    for (unsigned i = 1; i < resource->level_count; ++i) {
+        uint32_t value = resource->levels[i];
+        if (!value) { padding = true; continue; }
+        if (padding || value <= resource->levels[i - 1]) return -1;
+        if (selected < 0 && value >= wanted) selected = (int)i;
+    }
+    return selected;
+}
+
+/* Native DRV2 ACTIVE transaction/ARC selector design follows the reviewed
+ * Google msm 500b3a2059c1eec0fec08ec56add06320ea901a8 rpmh-rsc.c,
+ * rpmh-regulator.c, clk-rpmh.c and the existing Redfin CX experiment. No
+ * SW_COLLAPSE, GPU/GMU register, TCSR, PAS or firmware operation is included.
+ * Highest legal selectors preserve every validated inherited resource floor.
+ * Votes and AOP on remain held until platform reset, including partial failure.
+ */
+enum { WFP_AOP, WFP_IPCC, WFP_RSC, WFP_GCC, WFP_GIC, WFP_DB, WFP_MAPS };
+enum { WFP_MAPPING = 1, WFP_PREFLIGHT, WFP_ARC, WFP_AOP_ON, WFP_FINISHED };
+static const uint64_t wf_power_ranges[12] = {
+    RF_WIFI_AOP_PHYSICAL, RF_WIFI_AOP_BYTES, RF_WIFI_AOP_IPCC_PHYSICAL, 0x1000,
+    UINT64_C(0x18220000), 0x10000, UINT64_C(0x00100000), 0x1f0000,
+    UINT64_C(0x17a00000), 0x4000, UINT64_C(0x80860000), RF_CMDDB_BYTES};
+static const uint32_t wf_power_witness[16] = {
+    1, 2, 0, 1, 37, 261, 0x71004, 0x30000, 7, 416, 0x30060, 6, 384, 0x300a0, 3, 0};
+static const uint32_t wf_arc_address[3] = {0x30000, 0x30060, 0x300a0};
+static const uint32_t wf_arc_selector[3] = {7, 6, 3};
+struct wf_slot {
+    uint32_t idle, control, enabled, wait;
+    uint32_t command[16][3];
+};
+struct wf_power_context {
+    wf_map maps[WFP_MAPS];
+    uintptr_t base[WFP_MAPS];
+    char args[608];
+    unsigned arg_bytes;
+    thread_t owner;
+    bool active, poisoned, firmware;
+    unsigned phase, stores, notifications, held, target, step, polls;
+    uint32_t id, config, commands, irq_enable, irq, command_status;
+    wf_slot inherited[8];
+    uint32_t own_control, own_enabled, own_wait, own_command[3];
+    rf_cmddb_resource resource[3];
+    rf_wifi_aop_session aop;
+    rf_wifi_bcm bcm[RF_WIFI_BW_COUNT];
+    uint32_t bandwidth[RF_WIFI_BW_COUNT], bandwidth_held;
+};
+static wf_power_context wf_power;
+
+static bool wf_power_args(const char *args, unsigned bytes, unsigned firmware = 0)
+{
+    const char *const required[] = {
+        "debug=0xc", "serial=3", "cpus=1", "keepsyms=1", "-noprogress", "rd=md0",
+        "sweettouch=0", "sweetkeys=0", "sweetusb=0", "sweetcpufreq=0", "sweetbattery=0",
+        "modem=0", "wifi=0", "gpu=0", "redfinwifi=2", "redfinwifinative=1",
+        firmware == 3 ? "redfinwififw=3" : firmware ? "redfinwififw=2" : "redfinwifipower=1", "redfinspmi=1", "redfinreturn=1"};
+    uint32_t seen = 0;
+    bool nonce_seen = false, trace_seen = false;
+    if (!args || !bytes || bytes > sizeof(wf_power.args) || args[bytes - 1]) return false;
+    for (unsigned at = 0; at < bytes - 1;) {
+        if (args[at] == ' ') { ++at; continue; }
+        unsigned first = at;
+        while (at < bytes - 1 && args[at] != ' ') {
+            if ((unsigned char)args[at] < 33 || (unsigned char)args[at] > 126) return false;
+            ++at;
+        }
+        unsigned length = at - first;
+        bool known = false;
+        for (unsigned i = 0; i < sizeof(required) / sizeof(required[0]); ++i) {
+            if (strlen(required[i]) != length || memcmp(args + first, required[i], length)) continue;
+            if (seen & (1u << i)) return false;
+            seen |= 1u << i; known = true; break;
+        }
+        if (known) continue;
+        if (length == sizeof("-enable_kprintf_spam") - 1 &&
+            !memcmp(args + first, "-enable_kprintf_spam", length)) {
+            if (trace_seen) return false;
+            trace_seen = true; continue;
+        }
+        if (length != 31 || memcmp(args + first, "redfinbootid=0x", 15) || nonce_seen) return false;
+        uint64_t nonce = 0;
+        for (unsigned i = 15; i < 31; ++i) {
+            unsigned digit = (unsigned)(args[first + i] - '0');
+            if (digit > 9) {
+                if (args[first + i] < 'a' || args[first + i] > 'f') return false;
+                digit = (unsigned)(args[first + i] - 'a' + 10);
+            }
+            nonce = (nonce << 4) | digit;
+        }
+        if (!nonce) return false;
+        nonce_seen = true;
+    }
+    return seen == ((1u << (sizeof(required) / sizeof(required[0]))) - 1u) && nonce_seen;
+}
+
+static bool wf_power_platform(void)
+{
+    uint64_t observed[12] = {}, ram_base = 0, ram_bytes = 0;
+    uint32_t witness[16] = {}, verified = 0;
+    DTEntry entry, chosen;
+    return SecureDTLookupEntry(NULL, "/redfin-wifi-power", &entry) == kSuccess &&
+        wf_property(entry, "reg", observed, sizeof(observed)) &&
+        !memcmp(observed, wf_power_ranges, sizeof(observed)) &&
+        wf_property(entry, "source-contract", witness, sizeof(witness)) &&
+        !memcmp(witness, wf_power_witness, sizeof(witness)) &&
+        wf_property(entry, "live-fdt-verified", &verified, sizeof(verified)) && verified == 1 &&
+        SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+        wf_property(chosen, "dram-base", &ram_base, sizeof(ram_base)) && ram_base == UINT64_C(0x180000000) &&
+        wf_property(chosen, "dram-size", &ram_bytes, sizeof(ram_bytes)) && ram_bytes == UINT64_C(0x80000000);
+}
+
+static bool wf_start_platform(void)
+{
+    const uint32_t expected[11] = {1, 4, 2, 435, 428, 3, 1, 125, 129, 512, 6};
+    const uint64_t bandwidth[4] = {393600000, 3936000000, 0, UINT64_C(8171520000)};
+    const uint64_t reg[8] = {UINT64_C(0x80900000), 0x200000, 0x1f40000, 0x20000,
+        0x408000, 0x1000, 0x8c000000, 0x11800000};
+    static const char names[] = "CE0\0SN6\0SN0\0SH0\0MC0\0ACV";
+    uint32_t actual[11] = {}; uint64_t rates[4] = {}, ranges[8] = {}; char keys[sizeof(names)] = {};
+    DTEntry node;
+    return SecureDTLookupEntry(NULL, "/redfin-wifi-start", &node) == kSuccess &&
+        wf_property(node, "source-contract", actual, sizeof(actual)) && !memcmp(actual, expected, sizeof(actual)) &&
+        wf_property(node, "bandwidth", rates, sizeof(rates)) && !memcmp(rates, bandwidth, sizeof(rates)) &&
+        wf_property(node, "reg", ranges, sizeof(ranges)) && !memcmp(ranges, reg, sizeof(ranges)) &&
+        wf_property(node, "bcm-names", keys, sizeof(keys)) && !memcmp(keys, names, sizeof(keys));
+}
+
+static int wf_power_check(void *opaque)
+{
+    wf_power_context *context = (wf_power_context *)opaque;
+    const char *args = PE_boot_args();
+    bool valid = context == &wf_power && context->active && !context->poisoned &&
+        context->owner && current_thread() == context->owner && context->arg_bytes && args &&
+        !memcmp(args, context->args, context->arg_bytes) &&
+        __builtin_arm_rsr64("CurrentEL") == 4 &&
+        !(__builtin_arm_rsr64("MPIDR_EL1") & UINT64_C(0xff00ffffff)) &&
+        redfin_spmi_return_ready() == 1 && (!context->firmware || wf_start_platform());
+    if (valid) for (unsigned i = 0; i < WFP_MAPS; ++i) {
+        if (!context->maps[i].mapping || !context->base[i] ||
+            context->maps[i].mapping->getVirtualAddress() != context->base[i] ||
+            context->maps[i].mapping->getLength() != wf_power_ranges[2u * i + 1u]) { valid = false; break; }
+    }
+    if (!valid && context == &wf_power) context->poisoned = true;
+    return valid ? 0 : EPERM;
+}
+
+static int wf_power_read(wf_power_context *context, unsigned unit, uint32_t offset, uint32_t *out)
+{
+    if (!out || unit >= WFP_MAPS || unit == WFP_IPCC || offset % 4u ||
+        offset > wf_power_ranges[2u * unit + 1u] - 4u || wf_power_check(context)) return EINVAL;
+    *out = *(const volatile uint32_t *)(context->base[unit] + offset);
+#if defined(__aarch64__) || defined(__arm64__)
+    __asm__ volatile("dmb oshld" ::: "memory");
+#else
+    __asm__ volatile("" ::: "memory");
+#endif
+    return 0;
+}
+
+static uint32_t wf_power_word(wf_power_context *context, unsigned unit, uint32_t offset)
+{
+    uint32_t value = UINT32_MAX;
+    if (wf_power_read(context, unit, offset, &value)) context->poisoned = true;
+    return value;
+}
+
+static bool wf_power_tables(wf_power_context *context, bool capture)
+{
+    static const uint8_t names[3][8] = {"cx.lvl", "mss.lvl", "xo.lvl"};
+    static const uint16_t levels[3][16] = {
+        {0, 16, 64, 128, 192, 256, 384, 416},
+        {0, 64, 128, 192, 256, 320, 384}, {0, 32, 80, 128}};
+    if (wf_power_check(context)) return false;
+    for (unsigned i = 0; i < 3; ++i) {
+        rf_cmddb_resource resource = {};
+        if (rf_cmddb_lookup((const volatile uint8_t *)context->base[WFP_DB], RF_CMDDB_BYTES,
+            names[i], RF_CMDDB_ARC, &resource) != RF_CMDDB_OK || resource.type != RF_CMDDB_ARC ||
+            resource.address != wf_arc_address[i] || resource.aux_version != 0x1000 ||
+            resource.aux_bytes != 32 || resource.level_count != 16 ||
+            memcmp(resource.levels, levels[i], sizeof(levels[i]))) return false;
+        if (capture) context->resource[i] = resource;
+        else if (resource.priority[0] != context->resource[i].priority[0] ||
+            resource.priority[1] != context->resource[i].priority[1]) return false;
+    }
+    if (context->firmware) for (unsigned i = 0; i < RF_WIFI_BW_COUNT; ++i) {
+        rf_wifi_bcm resource = {};
+        if (rf_wifi_bcm_lookup((const volatile uint8_t *)context->base[WFP_DB], i, &resource)) {
+            if (capture) {
+                rf_cmddb_resource raw = {};
+                unsigned status = rf_cmddb_lookup((const volatile uint8_t *)context->base[WFP_DB], RF_CMDDB_BYTES,
+                    rf_wifi_bcm_names[i], RF_CMDDB_BCM, &raw);
+                IOLog("REDFIN WIFI POWER: BCM %.8s rejected status=%u addr=%#x aux-version=%#x aux-bytes=%u\n",
+                    rf_wifi_bcm_names[i], status, raw.address, raw.aux_version, raw.aux_bytes);
+            }
+            return false;
+        }
+        if (capture) {
+            context->bcm[i] = resource;
+            context->bandwidth[i] = rf_wifi_bcm_vote(&resource, i);
+            if (!context->bandwidth[i]) return false;
+            for (unsigned j = 0; j < i; ++j) if (context->bcm[j].address == resource.address) return false;
+            IOLog("REDFIN WIFI POWER: BCM %.8s addr=%#x unit=%u width=%u VCD=%u vote=%#x\n",
+                rf_wifi_bcm_names[i], resource.address, resource.unit, resource.width, resource.vcd,
+                context->bandwidth[i]);
+        } else if (memcmp(&context->bcm[i], &resource, sizeof(resource))) return false;
+    }
+    return !wf_power_check(context);
+}
+
+static bool wf_power_irqs(wf_power_context *context, bool initial)
+{
+    const unsigned irq[2] = {37, 261};
+    for (unsigned i = 0; i < 2; ++i) {
+        unsigned bank = 4u * (irq[i] / 32u);
+        uint32_t mask = 1u << (irq[i] % 32u);
+        uint32_t enabled = wf_power_word(context, WFP_GIC, 0x100u + bank);
+        uint32_t pending = wf_power_word(context, WFP_GIC, 0x200u + bank);
+        uint32_t active = wf_power_word(context, WFP_GIC, 0x300u + bank);
+        if (enabled == UINT32_MAX || pending == UINT32_MAX || active == UINT32_MAX ||
+            ((enabled | active | (initial && i == 0 ? pending : 0u)) & mask)) return false;
+    }
+    return !wf_power_check(context);
+}
+
+static bool wf_power_snapshot(wf_power_context *context, bool compare, bool skip_own)
+{
+    for (unsigned tcs = skip_own ? 1u : 0u; tcs < 8; ++tcs) {
+        unsigned at = 0xd00u + 0x2a0u * tcs;
+        wf_slot current = {};
+        current.idle = wf_power_word(context, WFP_RSC, at + 0x18u);
+        current.control = wf_power_word(context, WFP_RSC, at + 0x14u);
+        current.enabled = wf_power_word(context, WFP_RSC, at + 0x1cu);
+        current.wait = wf_power_word(context, WFP_RSC, at + 0x10u);
+        if (!current.idle || current.idle == UINT32_MAX || current.control == UINT32_MAX ||
+            ((current.enabled | current.wait) & ~((1u << context->commands) - 1u)) ||
+            (tcs < 2 && (current.control || current.enabled || current.wait))) return false;
+        for (unsigned command = 0; command < context->commands; ++command) {
+            if (!(current.enabled & (1u << command))) continue;
+            for (unsigned word = 0; word < 3; ++word)
+                current.command[command][word] = wf_power_word(context, WFP_RSC, at + 0x30u + 0x14u * command + 4u * word);
+            uint32_t message = current.command[command][0], address = current.command[command][1];
+            uint32_t data = current.command[command][2];
+            for (unsigned resource = 0; resource < 3; ++resource) {
+                if ((address & ~3u) == wf_arc_address[resource] &&
+                    (address != wf_arc_address[resource] || !(message & (1u << 16)) || data > wf_arc_selector[resource]))
+                    return false;
+            }
+            if (context->firmware) for (unsigned resource = 0; resource < RF_WIFI_BW_COUNT; ++resource) {
+                if ((address & ~3u) != context->bcm[resource].address) continue;
+                uint32_t held = 0;
+                if (address != context->bcm[resource].address || !(message & (1u << 16)) ||
+                    rf_wifi_bcm_floor(resource, context->bandwidth[resource], data, &held)) return false;
+                if (compare && held != context->bandwidth[resource]) return false;
+                if (!compare) context->bandwidth[resource] = held;
+            }
+        }
+        if (compare && memcmp(&current, &context->inherited[tcs], sizeof(current))) return false;
+        if (!compare) context->inherited[tcs] = current;
+    }
+    return !wf_power_check(context);
+}
+
+static uint32_t wf_power_address(wf_power_context *context, unsigned target)
+{ return target < 3 ? wf_arc_address[target] : context->bcm[target - 3].address; }
+static uint32_t wf_power_data(wf_power_context *context, unsigned target)
+{ return target < 3 ? wf_arc_selector[target] : context->bandwidth[target - 3]; }
+
+static bool wf_power_rsc_guard(wf_power_context *context)
+{
+    uint32_t irq = wf_power_word(context, WFP_RSC, 0xd04u);
+    return !wf_power_check(context) && wf_power_irqs(context, false) &&
+        wf_power_word(context, WFP_RSC, 0) == context->id &&
+        wf_power_word(context, WFP_RSC, 0xcu) == context->config &&
+        wf_power_word(context, WFP_RSC, 0xd00u) == context->irq_enable &&
+        irq != UINT32_MAX && !(irq & ~1u) &&
+        ((context->phase == WFP_ARC && context->step >= 8 && context->step < 13) || !irq) &&
+        (wf_power_word(context, WFP_GCC, 0x71004u) & 0x80000001u) == 1 &&
+        wf_power_snapshot(context, true, true) &&
+        wf_power_word(context, WFP_RSC, 0xd14u) == context->own_control &&
+        wf_power_word(context, WFP_RSC, 0xd1cu) == context->own_enabled &&
+        wf_power_word(context, WFP_RSC, 0xd10u) == context->own_wait &&
+        wf_power_word(context, WFP_RSC, 0xd30u) == context->own_command[0] &&
+        wf_power_word(context, WFP_RSC, 0xd34u) == context->own_command[1] &&
+        wf_power_word(context, WFP_RSC, 0xd38u) == context->own_command[2] && !wf_power_check(context);
+}
+
+static int wf_power_store(wf_power_context *context, unsigned unit, uint32_t offset, uint32_t value)
+{
+    if (unit >= WFP_MAPS || offset % 4u || offset > wf_power_ranges[2u * unit + 1u] - 4u ||
+        wf_power_check(context) || !wf_power_rsc_guard(context) || !wf_power_tables(context, false)) return EPERM;
+    if (unit == WFP_RSC) {
+        if (context->phase != WFP_ARC || context->target >= (context->firmware ? 3 + RF_WIFI_BW_COUNT : 3) || context->step >= 13) return EPERM;
+        static const uint32_t offsets[13] = {
+            0xd30, 0xd34, 0xd38, 0xd10, 0xd1c, 0xd14, 0xd14, 0xd14, 0xd14, 0xd14, 0xd1c, 0xd10, 0xd08};
+        const uint32_t values[13] = {0x10108, wf_power_address(context, context->target), wf_power_data(context, context->target),
+            1, 1, 0, 1u << 16, (1u << 16) | (1u << 24), 1u << 16, 0, 0, 0, 1};
+        if (offset != offsets[context->step] || value != values[context->step]) return EPERM;
+    } else {
+        if (context->phase != WFP_AOP_ON || context->held != 7 || !wf_power_tables(context, false)) return EPERM;
+        if (unit == WFP_IPCC) {
+            if (offset != RF_WIFI_AOP_IPCC_SEND || value != RF_WIFI_AOP_IPCC_ID) return EPERM;
+        } else if (unit == WFP_AOP) {
+            uint32_t box = context->aop.baseline.word[14];
+            bool control = (offset == 0x10 || offset == 0x18 || offset == 0x24 || offset == 0x2c) && value == RF_WIFI_AOP_UP;
+            bool payload = context->aop.open && box >= 64 && box <= RF_WIFI_AOP_BYTES - 68u &&
+                ((offset == box && value == RF_WIFI_AOP_MESSAGE_BYTES) || (offset > box && offset < box + 68u));
+            if (!control && !payload) return EPERM;
+        } else return EPERM;
+    }
+    ++context->stores;
+#if defined(__aarch64__) || defined(__arm64__)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+    *(volatile uint32_t *)(context->base[unit] + offset) = value;
+#if defined(__aarch64__) || defined(__arm64__)
+    __asm__ volatile("dsb osh" ::: "memory");
+#else
+    __asm__ volatile("" ::: "memory");
+#endif
+    if (unit == WFP_RSC) {
+        if (offset == 0xd14) context->own_control = value;
+        if (offset == 0xd1c) context->own_enabled = value;
+        if (offset == 0xd10) context->own_wait = value;
+        if (offset >= 0xd30 && offset <= 0xd38) context->own_command[(offset - 0xd30) / 4u] = value;
+        ++context->step;
+    }
+    if (unit == WFP_IPCC) ++context->notifications;
+    return 0;
+}
+
+static int wf_power_pause(void *opaque, uint32_t microseconds)
+{
+    wf_power_context *context = (wf_power_context *)opaque;
+    if (!microseconds || microseconds > 1000 || wf_power_check(context) || !wf_power_rsc_guard(context)) return EPERM;
+    IODelay(microseconds);
+    return wf_power_check(context);
+}
+
+static bool wf_power_sync(wf_power_context *context, uint32_t offset, uint32_t value)
+{
+    if (wf_power_store(context, WFP_RSC, offset, value)) return false;
+    for (unsigned poll = 0; poll < 100; ++poll) {
+        if (wf_power_check(context)) return false;
+        if (wf_power_word(context, WFP_RSC, offset) == value) return true;
+        /* A failed readback may not authorize another typed write or retry. */
+        IODelay(1);
+    }
+    return false;
+}
+
+static int wf_power_vote(wf_power_context *context, unsigned target)
+{
+    if (target >= (context->firmware ? 3 + RF_WIFI_BW_COUNT : 3) || !wf_power_tables(context, false) || !wf_power_rsc_guard(context) ||
+        wf_power_word(context, WFP_RSC, 0xd04u) || !wf_power_word(context, WFP_RSC, 0xd18u)) return EBUSY;
+    context->target = target; context->step = 0;
+    if (!wf_power_sync(context, 0xd30, 0x10108) || !wf_power_sync(context, 0xd34, wf_power_address(context, target)) ||
+        !wf_power_sync(context, 0xd38, wf_power_data(context, target)) || !wf_power_sync(context, 0xd10, 1) ||
+        !wf_power_sync(context, 0xd1c, 1) || !wf_power_sync(context, 0xd14, 0) ||
+        !wf_power_sync(context, 0xd14, 1u << 16) ||
+        wf_power_store(context, WFP_RSC, 0xd14, (1u << 16) | (1u << 24))) return EIO;
+    bool complete = false;
+    for (unsigned poll = 0; poll <= 1000; ++poll) {
+        if (!wf_power_rsc_guard(context)) return EBUSY;
+        context->irq = wf_power_word(context, WFP_RSC, 0xd04u);
+        context->command_status = wf_power_word(context, WFP_RSC, 0xd3cu);
+        uint32_t idle = wf_power_word(context, WFP_RSC, 0xd18u);
+        ++context->polls;
+        if (context->irq == UINT32_MAX || context->command_status == UINT32_MAX || idle == UINT32_MAX) return EIO;
+        if ((context->irq & 1u) && idle && (context->command_status & 0x10100u) == 0x10100u) { complete = true; break; }
+        if (poll == 1000 || wf_power_pause(context, 100)) break;
+    }
+    if (!complete) return ETIMEDOUT;
+    if (target < 3) context->held |= 1u << target;
+    else context->bandwidth_held |= 1u << (target - 3);
+    if (target < 3)
+        IOLog("REDFIN WIFI POWER: ARC address=%#x selector=%u held=1 polls=%u IRQ=%#x CMD=%#x\n",
+            wf_arc_address[target], wf_arc_selector[target], context->polls, context->irq, context->command_status);
+    else IOLog("REDFIN WIFI POWER: BCM address=%#x value=%#x held=1 polls=%u IRQ=%#x CMD=%#x\n",
+        wf_power_address(context, target), wf_power_data(context, target), context->polls, context->irq, context->command_status);
+    if (!wf_power_sync(context, 0xd14, 1u << 16) || !wf_power_sync(context, 0xd14, 0) ||
+        !wf_power_sync(context, 0xd1c, 0) || !wf_power_sync(context, 0xd10, 0) ||
+        wf_power_store(context, WFP_RSC, 0xd08, 1) || wf_power_word(context, WFP_RSC, 0xd04u) ||
+        !wf_power_rsc_guard(context) || !wf_power_tables(context, false)) return EIO;
+    return 0;
+}
+
+static int wf_power_aop_read(void *opaque, uint32_t offset, uint32_t *out)
+{ return wf_power_read((wf_power_context *)opaque, WFP_AOP, offset, out); }
+static int wf_power_aop_write(void *opaque, uint32_t offset, uint32_t value)
+{ return wf_power_store((wf_power_context *)opaque, WFP_AOP, offset, value); }
+static int wf_power_aop_notify(void *opaque)
+{ return wf_power_store((wf_power_context *)opaque, WFP_IPCC, RF_WIFI_AOP_IPCC_SEND, RF_WIFI_AOP_IPCC_ID); }
+
+static int wf_power_run(wf_power_context *context)
+{
+    context->phase = WFP_PREFLIGHT;
+    if (!wf_power_tables(context, true)) return ENXIO;
+    if ((wf_power_word(context, WFP_GCC, 0x71004u) & 0x80000001u) != 1 || !wf_power_irqs(context, true)) return EBUSY;
+    context->id = wf_power_word(context, WFP_RSC, 0);
+    context->config = wf_power_word(context, WFP_RSC, 0xcu);
+    context->commands = (context->config >> 27) & 31u;
+    unsigned major = (context->id >> 16) & 255u, tcs_count = (context->config >> 12) & 63u;
+    context->irq_enable = wf_power_word(context, WFP_RSC, 0xd00u);
+    IOLog("REDFIN WIFI POWER: DRV2 id=%#x config=%#x commands=%u TCS=%u IRQ_enable=%#x\n",
+        context->id, context->config, context->commands, tcs_count, context->irq_enable);
+    if ((major != 1 && major != 2) || context->config == UINT32_MAX || tcs_count < 8 || tcs_count > 9 ||
+        !context->commands || context->commands > 16 || context->irq_enable == UINT32_MAX ||
+        !(context->irq_enable & 1u) || wf_power_word(context, WFP_RSC, 0xd04u) ||
+        !wf_power_snapshot(context, false, false) || !wf_power_snapshot(context, true, false)) return EBUSY;
+    context->own_control = context->inherited[0].control;
+    context->own_enabled = context->inherited[0].enabled; context->own_wait = context->inherited[0].wait;
+    for (unsigned word = 0; word < 3; ++word)
+        context->own_command[word] = wf_power_word(context, WFP_RSC, 0xd30u + 4u * word);
+    const rf_wifi_aop_ops operations = {context, wf_power_check, wf_power_aop_read,
+        wf_power_aop_write, wf_power_aop_notify, wf_power_pause};
+    rf_wifi_aop_snapshot aop = {};
+    int error = rf_wifi_aop_observe(&operations, &aop);
+    if (error || aop.tx_length || aop.rx_length || aop.word[3] != RF_WIFI_AOP_UP) return EBUSY;
+    bool opened = true, closed = true;
+    static const uint8_t all[8] = {3, 4, 5, 6, 9, 10, 11, 12}, cold[6] = {5, 6, 9, 10, 11, 12};
+    for (unsigned i = 0; i < sizeof(all); ++i) opened &= aop.word[all[i]] == RF_WIFI_AOP_UP;
+    for (unsigned i = 0; i < sizeof(cold); ++i) closed &= aop.word[cold[i]] == RF_WIFI_AOP_DOWN;
+    if ((!opened && !closed) || !wf_power_tables(context, false) || !wf_power_rsc_guard(context)) return EBUSY;
+    context->phase = WFP_ARC;
+    for (unsigned i = 0; i < 3; ++i) {
+        error = wf_power_vote(context, i);
+        if (error) return error;
+    }
+    if (context->firmware) for (unsigned i = 0; i < RF_WIFI_BW_COUNT; ++i) {
+        error = wf_power_vote(context, i + 3);
+        if (error) return error;
+    }
+    context->phase = WFP_AOP_ON;
+    error = rf_wifi_aop_open(&context->aop, &operations);
+    if (!error) error = rf_wifi_aop_load_state(&context->aop, &operations, 1);
+    IOLog("REDFIN WIFI POWER: AOP status=%d open=%u load_state=%u stores=%u notifications=%u pending=%u\n",
+        error, context->aop.open, context->aop.load_state, context->aop.stores,
+        context->aop.notifications, wf_power_word(context, WFP_AOP, aop.word[14]));
+    if (!error && (!wf_power_rsc_guard(context) || !wf_power_tables(context, false))) error = EBUSY;
+    return error;
+}
+
+static int wf_power_acquire(bool firmware)
+{
+    wf_power_context *context = &wf_power;
+    const char *args = PE_boot_args();
+    unsigned bytes = 0;
+    if (args) while (bytes < sizeof(context->args) && args[bytes]) ++bytes;
+    int mode = 0;
+    if (firmware && (!PE_parse_boot_argn("redfinwififw", &mode, sizeof(mode)) || (mode != 2 && mode != 3))) return EPERM;
+    if (context->arg_bytes || !args || bytes == sizeof(context->args) ||
+        !wf_power_args(args, bytes + 1u, firmware ? (unsigned)mode : 0) || !wf_power_platform() || (firmware && !wf_start_platform())) {
+        IOLog("REDFIN WIFI POWER: refused exact args/live-FDT/RAM contract before mapping\n"); return EPERM;
+    }
+    context->firmware = firmware;
+    memcpy(context->args, args, bytes + 1u); context->arg_bytes = bytes + 1u;
+    context->owner = current_thread(); context->phase = WFP_MAPPING;
+    bool mapped = true;
+    for (unsigned i = 0; i < WFP_MAPS; ++i) {
+        bool writable = i == WFP_AOP || i == WFP_IPCC || i == WFP_RSC;
+        context->maps[i].memory = IOMemoryDescriptor::withPhysicalAddress(wf_power_ranges[2u * i],
+            wf_power_ranges[2u * i + 1u], writable ? kIODirectionInOut : kIODirectionIn);
+        IOOptionBits options = (writable ? 0 : kIOMapReadOnly) |
+            (i == WFP_DB ? kIOMapWriteCombineCache : kIOMapInhibitCache);
+        context->maps[i].mapping = context->maps[i].memory ? context->maps[i].memory->map(options) : NULL;
+        if (!context->maps[i].mapping || !context->maps[i].mapping->getVirtualAddress() ||
+            context->maps[i].mapping->getLength() != wf_power_ranges[2u * i + 1u]) { mapped = false; break; }
+        context->base[i] = (uintptr_t)context->maps[i].mapping->getVirtualAddress();
+    }
+    context->active = mapped;
+    int error = mapped && !wf_power_check(context) ? wf_power_run(context) : ENXIO;
+    if (error) context->poisoned = true;
+    return error;
+}
+
+extern "C" int redfin_wifi_power_start(void)
+{
+    int error = wf_power_acquire(true);
+    IOLog("REDFIN WIFI POWER: firmware result=%d phase=%u ARC=%#x BCM=%#x stores=%u quarantine=%u\n",
+        error, wf_power.phase, wf_power.held, wf_power.bandwidth_held, wf_power.stores, wf_power.poisoned);
+    return error;
+}
+
+extern "C" int redfin_wifi_power_held(void)
+{
+    wf_power_context *context = &wf_power;
+    /* The retained worker sealed its one RSC writer after completion. Children
+     * recheck the exact owner/profile/maps and our ACTIVE slot, without walking
+     * the complete immutable CMD-DB directory for every copy/readback chunk.
+     * Full inherited-table/CMD-DB audits run at phase boundaries and checkpoints.
+     */
+    return context->firmware && context->held == 7 &&
+        context->bandwidth_held == (1u << RF_WIFI_BW_COUNT) - 1u &&
+        context->phase == WFP_AOP_ON && context->aop.load_state == 1 &&
+        !wf_power_check(context) && wf_power_word(context, WFP_RSC, 0) == context->id &&
+        wf_power_word(context, WFP_RSC, 0xcu) == context->config &&
+        wf_power_word(context, WFP_RSC, 0xd04u) == 0 &&
+        wf_power_word(context, WFP_RSC, 0xd14u) == 0 &&
+        wf_power_word(context, WFP_RSC, 0xd1cu) == 0 &&
+        wf_power_word(context, WFP_RSC, 0xd10u) == 0 ? 0 : EPERM;
+}
+
+extern "C" int redfin_wifi_power_audit(void)
+{
+    return !redfin_wifi_power_held() && wf_power_tables(&wf_power, false) &&
+        wf_power_rsc_guard(&wf_power) ? 0 : EPERM;
+}
+
+static void wf_power_probe(void)
+{
+    wf_power_context *context = &wf_power;
+    int error = wf_power_acquire(false);
+    if (!context->arg_bytes) return;
+    IOLog("REDFIN WIFI POWER: result=%d phase=%u held_mask=%#x writes=%u kicks=%u quarantined=%u; retained until reset; PAS/SMEM/firmware untouched\n",
+        error, context->phase, context->held, context->stores, context->notifications, context->poisoned);
+    context->active = false; context->phase = WFP_FINISHED;
+    for (unsigned i = 0; i < WFP_MAPS; ++i) {
+        OSSafeReleaseNULL(context->maps[i].mapping);
+        OSSafeReleaseNULL(context->maps[i].memory);
+    }
+}
+
+extern "C" void redfin_wifi_native_observe(void)
+{
+    int enabled = 0;
+    if (!PE_parse_boot_argn("redfinwifinative", &enabled, sizeof(enabled)) || enabled != 1) return;
+    static uint32_t attempted;
+    if (__atomic_exchange_n(&attempted, 1, __ATOMIC_RELAXED)) return;
+    uint64_t ranges[6] = {};
+    if (!wf_platform(ranges)) {
+        IOLog("REDFIN WIFI NATIVE: refused md0/UP/identity/return/live-FDT contract\n");
+        return;
+    }
+    int source = 0;
+    if (PE_parse_boot_argn("redfinwififw", &source, sizeof(source)) && source) {
+        if (source == 1) redfin_wifi_fw_source_probe();
+        else if (source == 2 || source == 3) redfin_wifi_fw_start();
+        else IOLog("REDFIN WIFI FW: refused unsupported source mode\n");
+        return;
+    }
+    int power = 0;
+    if (PE_parse_boot_argn("redfinwifipower", &power, sizeof(power)) && power) {
+        if (power != 1) IOLog("REDFIN WIFI POWER: refused unsupported power mode\n");
+        else wf_power_probe();
+        return;
+    }
+    wf_map maps[3] = {};
+    bool mapped = true;
+    for (unsigned i = 0; i < 3; ++i) {
+        maps[i].memory = IOMemoryDescriptor::withPhysicalAddress(ranges[2 * i], ranges[2 * i + 1], kIODirectionIn);
+        IOOptionBits options = kIOMapReadOnly | (i == 0 ? kIOMapInhibitCache : kIOMapWriteCombineCache);
+        maps[i].mapping = maps[i].memory ? maps[i].memory->map(options) : NULL;
+        if (!maps[i].mapping || !maps[i].mapping->getVirtualAddress() ||
+            maps[i].mapping->getLength() != ranges[2 * i + 1]) { mapped = false; break; }
+    }
+    if (!mapped || !redfin_spmi_return_ready()) {
+        IOLog("REDFIN WIFI NATIVE: read-only mapping/return check failed\n");
+    } else {
+        wf_context context = {(uintptr_t)maps[0].mapping->getVirtualAddress(), true};
+        const rf_wifi_aop_ops operations = {&context, wf_check, wf_read32, NULL, NULL, NULL};
+        uint32_t raw[16] = {};
+        int captured = 0;
+        for (unsigned i = 0; i < 16; ++i) {
+            captured = wf_read32(&context, i * 4u, &raw[i]);
+            if (captured) break;
+        }
+        IOLog("REDFIN WIFI NATIVE: AOP raw status=%d magic=%#x version=%u features=%#x reserved=%#x\n",
+            captured, raw[0], raw[1], raw[2], raw[15]);
+        IOLog("REDFIN WIFI NATIVE: AOP ucore link=%#x ack=%#x channel=%#x ack=%#x box=%#x bytes=%u\n",
+            raw[3], raw[4], raw[5], raw[6], raw[8], raw[7]);
+        IOLog("REDFIN WIFI NATIVE: AOP mcore link=%#x ack=%#x channel=%#x ack=%#x box=%#x bytes=%u\n",
+            raw[9], raw[10], raw[11], raw[12], raw[14], raw[13]);
+        rf_wifi_aop_snapshot snapshot = {};
+        int observed = captured ? RF_WIFI_AOP_PLATFORM : rf_wifi_aop_observe(&operations, &snapshot);
+        IOLog("REDFIN WIFI NATIVE: AOP observation status=%d pending_tx=%u pending_rx=%u (no channel open/message/kick)\n",
+            observed, snapshot.tx_length, snapshot.rx_length);
+        if (observed != RF_WIFI_AOP_PLATFORM && redfin_spmi_return_ready()) {
+            redfin_smem_report smem = {};
+            enum redfin_smem_status smem_status = redfin_smem_inspect(
+                (const volatile uint8_t *)maps[1].mapping->getVirtualAddress(), REDFIN_SMEM_BYTES, &smem);
+            IOLog("REDFIN WIFI NATIVE: SMEM status=%u partitions=%u modem=%u offset=%#x bytes=%#x items=%u cached_uninspected=%u GLINK=%u tx=%u rx=%u\n",
+                (unsigned)smem_status, smem.partitions, smem.modem_partition, smem.partition_offset,
+                smem.partition_bytes, smem.uncached_items, smem.cached_uninspected, smem.descriptor,
+                smem.tx_pending, smem.rx_pending);
+            if (redfin_spmi_return_ready()) {
+                static const uint8_t names[3][8] = {"xo.lvl", "cx.lvl", "mss.lvl"};
+                for (unsigned i = 0; i < 3; ++i) {
+                    if (!redfin_spmi_return_ready()) break;
+                    rf_cmddb_resource resource = {};
+                    enum rf_cmddb_status status = rf_cmddb_lookup(
+                        (const volatile uint8_t *)maps[2].mapping->getVirtualAddress(), RF_CMDDB_BYTES,
+                        names[i], RF_CMDDB_ARC, &resource);
+                    IOLog("REDFIN WIFI NATIVE: resource %.8s status=%u type=%u address=%#x aux_version=%#x aux_bytes=%u levels=%u TURBO_selector=%d\n",
+                        (const char *)names[i], (unsigned)status, resource.type, resource.address,
+                        resource.aux_version, resource.aux_bytes, resource.level_count,
+                        status == RF_CMDDB_OK && i ? wf_selector(&resource, 384) : -1);
+                    char values[128] = {};
+                    unsigned used = 0;
+                    for (unsigned level = 0; level < resource.level_count && level < RF_CMDDB_MAX_LEVELS; ++level) {
+                        int written = snprintf(values + used, sizeof(values) - used, "%s%u",
+                            level ? "," : "", resource.levels[level]);
+                        if (written < 0 || (unsigned)written >= sizeof(values) - used) break;
+                        used += (unsigned)written;
+                    }
+                    IOLog("REDFIN WIFI NATIVE: %.8s raw_AUX=[%s] (consumer levels; no physical power proof or vote)\n",
+                        (const char *)names[i], values);
+                }
+            }
+        }
+        context.active = false;
+        IOLog("REDFIN WIFI NATIVE: read-only observation finished; no PAS/power/SMEM writes or notifications\n");
+    }
+    for (unsigned i = 0; i < 3; ++i) {
+        OSSafeReleaseNULL(maps[i].mapping);
+        OSSafeReleaseNULL(maps[i].memory);
+    }
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_bw.h b/iokit/Kernel/arm/redfin_wifi_bw.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_bw.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: MIT
+ * Redfin PIL bandwidth: native Google msm 500b3a2059c1eec0fec08ec56add06320ea901a8,
+ * msm_bus_{arb,fabric}_rpmh.c and the live Lito bus graph. No hardware writes.
+ * Include after the existing bounded redfin_rpmh.h CMD-DB parser.
+ */
+#ifndef REDFIN_WIFI_BW_H
+#define REDFIN_WIFI_BW_H
+#ifdef __cplusplus
+#define RF_WIFI_BW_ZERO {}
+#else
+#define RF_WIFI_BW_ZERO {0}
+#endif
+#define RF_WIFI_BW_COUNT 6u
+struct rf_wifi_bcm {
+    uint32_t address, priority[2], unit;
+    uint16_t width, version;
+    uint8_t vcd, reserved;
+    uint16_t padding;
+};
+static const uint8_t rf_wifi_bcm_names[RF_WIFI_BW_COUNT][8] = {
+    "CE0", "SN6", "SN0", "SH0", "MC0", "ACV"};
+
+static inline int rf_wifi_bcm_lookup(const volatile uint8_t *db, unsigned index,
+    struct rf_wifi_bcm *out)
+{
+    if (!db || !out || index >= RF_WIFI_BW_COUNT) return -1;
+    struct rf_cmddb_resource resource = RF_WIFI_BW_ZERO;
+    if (rf_cmddb_lookup(db, RF_CMDDB_BYTES, rf_wifi_bcm_names[index], RF_CMDDB_BCM,
+        &resource) != RF_CMDDB_OK || !resource.address || resource.address % 4u ||
+        resource.aux_bytes != 8u) return -1;
+    unsigned matches = 0;
+    struct rf_wifi_bcm value = RF_WIFI_BW_ZERO;
+    for (unsigned i = 0; i < 8; ++i) {
+        const volatile uint8_t *h = db + 8u + i * 16u;
+        unsigned type = rf_cmddb_u16(h), count = rf_cmddb_u16(h + 6u);
+        if (!type) break;
+        uint32_t entries = RF_CMDDB_HEADER + rf_cmddb_u16(h + 2u);
+        uint32_t aux = RF_CMDDB_HEADER + rf_cmddb_u16(h + 4u);
+        if (count > RF_CMDDB_MAX_ENTRIES ||
+            !rf_cmddb_range(entries, count * RF_CMDDB_ENTRY, RF_CMDDB_BYTES)) return -1;
+        for (unsigned j = 0; j < count; ++j) {
+            const volatile uint8_t *entry = db + entries + j * RF_CMDDB_ENTRY;
+            unsigned same = 1;
+            for (unsigned k = 0; k < 8; ++k) same &= entry[k] == rf_wifi_bcm_names[index][k];
+            if (!same) continue;
+            if (++matches != 1 || rf_cmddb_u32(entry + 16u) != resource.address ||
+                rf_cmddb_u16(entry + 20u) != 8u) return -1;
+            uint32_t at = aux + rf_cmddb_u16(entry + 22u);
+            if (!rf_cmddb_range(at, 8, RF_CMDDB_BYTES)) return -1;
+            value.address = resource.address;
+            value.priority[0] = resource.priority[0]; value.priority[1] = resource.priority[1];
+            value.version = resource.aux_version;
+            value.unit = rf_cmddb_u32(db + at); value.width = rf_cmddb_u16(db + at + 4u);
+            value.vcd = db[at + 6u]; value.reserved = db[at + 7u];
+        }
+    }
+    if (matches != 1 || (index != 5 && (!value.unit || !value.width)) ||
+        value.vcd >= 16 || value.reserved) return -1;
+    *out = value;
+    return 0;
+}
+
+static inline uint64_t rf_wifi_bw_div(uint64_t value, uint64_t divisor)
+{ return value / divisor + (value % divisor != 0); }
+
+static inline uint32_t rf_wifi_bcm_vote(const struct rf_wifi_bcm *bcm, unsigned index)
+{
+    /* Native SCM crypto client: AB=393.6 MB/s, IB=3936 MB/s. Native modem
+     * LLCC->EBI request: AB=0, IB=8,171,520 KB/s. Shared MC0 uses both clients.
+     * Widths and aggregation ports are checked against the live bus graph.
+     */
+    static const uint8_t width[RF_WIFI_BW_COUNT] = {8, 16, 16, 16, 4, 4};
+    static const uint8_t ports[RF_WIFI_BW_COUNT] = {1, 1, 1, 2, 2, 2};
+    if (!bcm || index >= RF_WIFI_BW_COUNT) return 0;
+    if (index == 5) return 0x60000008u; /* Native APPS ACV bit; preserve other bits below. */
+    if (!bcm->unit || !bcm->width) return 0;
+    uint64_t ib = index == 4 ? UINT64_C(8171520000) : UINT64_C(3936000000);
+    uint64_t x = rf_wifi_bw_div(UINT64_C(393600000) * bcm->width,
+        (uint64_t)width[index] * ports[index]);
+    uint64_t y = rf_wifi_bw_div(ib * bcm->width, width[index]);
+    x = rf_wifi_bw_div(x, bcm->unit); y = rf_wifi_bw_div(y, bcm->unit);
+    if (x > 0x3fff) x = 0x3fff;
+    if (y > 0x3fff) y = 0x3fff;
+    return 0x60000000u | (uint32_t)(x << 14) | (uint32_t)y;
+}
+
+static inline int rf_wifi_bcm_floor(unsigned index, uint32_t desired, uint32_t inherited,
+    uint32_t *out)
+{
+    if (!out || index >= RF_WIFI_BW_COUNT || (inherited & ~0x6fffffffu) ||
+        ((inherited & 0x0fffffffu) && !(inherited & 0x20000000u)) ||
+        (desired & 0x60000000u) != 0x60000000u) return -1;
+    uint32_t x = (desired >> 14) & 0x3fff, y = desired & 0x3fff;
+    uint32_t old_x = (inherited >> 14) & 0x3fff, old_y = inherited & 0x3fff;
+    if (index == 5) {
+        if (x || old_x) return -1;
+        y |= old_y;
+    } else {
+        if (x < old_x) x = old_x;
+        if (y < old_y) y = old_y;
+    }
+    *out = 0x60000000u | (x << 14) | y;
+    return 0;
+}
+#endif
