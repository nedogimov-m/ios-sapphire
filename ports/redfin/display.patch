+/* REDFIN_FB_TEST_BEGIN: observed Pixel 5 splash contract, absolute addresses. */
+static bool
+redfin_fb_geometry(uint64_t physical, uint64_t reserved, uint32_t width,
+    uint32_t height, uint32_t stride, uint32_t canvas_width, uint32_t canvas_height)
+{
+	/* HARDWARE.md: REDFIN DIAGNOSTICS demonstrated this buffer on the unit.
+	 * The extent is the live FDT cont_splash_region, outside XNU's RAM bank.
+	 * Do not turn a display property into an arbitrary physical mapping.
+	 */
+	if (physical != 0xa0000000ULL || reserved != 0x02300000ULL ||
+	    width != 1080 || height != 2340 || stride != 4320 ||
+	    canvas_width != 1125 || canvas_height != 2436) return false;
+	uint64_t bytes = (uint64_t)stride * height;
+	uint64_t mapped = (bytes + 0x3fffULL) & ~0x3fffULL;
+	return bytes <= 0xffffc000ULL && mapped <= reserved &&
+	    !(physical & 0x3fffULL) && physical <= UINT64_MAX - mapped;
+}
+/* REDFIN_FB_TEST_END */
+
+static bool
+redfin_fb_data(IOService *provider, const char *key, void *value, unsigned bytes)
+{
+	OSData *data = OSDynamicCast(OSData, provider->getProperty(key));
+	if (data == NULL || data->getLength() != bytes) return false;
+	memcpy(value, data->getBytesNoCopy(), bytes);
+	return true;
+}
