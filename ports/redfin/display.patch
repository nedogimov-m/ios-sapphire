+/* No register mappings or modem/GPU initialization in this backend. */
+bool
+AppleCLCD::startRedfinCopy(IOService *provider)
+{
+	uint32_t marker = 0, width = 0, height = 0, stride = 0, cw = 0, ch = 0;
+	uint64_t framebuffer[2] = {};
+	char format[5] = {};
+	if (provider == NULL ||
+	    !redfin_fb_data(provider, "redfin,abl-copy-only", &marker, sizeof(marker)) || marker != 1 ||
+	    !redfin_fb_data(provider, "redfin,framebuffer", framebuffer, sizeof(framebuffer)) ||
+	    !redfin_fb_data(provider, "width", &width, sizeof(width)) ||
+	    !redfin_fb_data(provider, "height", &height, sizeof(height)) ||
+	    !redfin_fb_data(provider, "stride", &stride, sizeof(stride)) ||
+	    !redfin_fb_data(provider, "canvas-width", &cw, sizeof(cw)) ||
+	    !redfin_fb_data(provider, "canvas-height", &ch, sizeof(ch)) ||
+	    !redfin_fb_data(provider, "pixel-format", format, sizeof(format)) ||
+	    memcmp(format, "BGRA", sizeof(format)) ||
+	    !redfin_fb_geometry(framebuffer[0], framebuffer[1], width, height, stride, cw, ch)) {
+		IOLog("REDFIN FB: rejected missing or unverified linear display contract\n");
+		return false;
+	}
+	if (!IOService::start(provider)) return false;
+	fRedfinCopyOnly = true;
+	fRedfinFrames = 0;
+	fPhys = framebuffer[0]; fWidth = width; fHeight = height; fRowBytes = stride;
+	fLogicalW = cw; fLogicalH = ch;
+	fOffX = ((int32_t)(cw - width) / 2) & ~3;
+	fOffY = (int32_t)(ch - height) / 2;
+	fVig0 = fCtl0 = fIntf1 = NULL;
+	fDsi = NULL; fDsiBuf = NULL; fDsiBufPhys = 0;
+	fBlLock = NULL; fBlCall = NULL; fBlLevel = fBlSent = 0;
+	fFlip[0] = fFlip[1] = NULL; fFlipPhys[0] = fFlipPhys[1] = 0; fFlipIdx = 0;
+	fFadeOrig = NULL; fCons = NULL; fConsPhys = 0; fConsShown = false;
+	fLastVA = NULL; fLastStride = 0; fLastSurf = NULL;
+	fScanPhys = 0; fScanStride = fBootSrc = fBootStride = fIntfFrames = 0;
+	fPowerOff = false; fFadeStep = 0; fVsyncCount = fSwapID = 0;
+	fDirty = false; fConsolePaused = false; fMap = NULL;
+	fSurface = NULL; fPixels = 0; fVsync = NULL;
+	bzero(fPending, sizeof(fPending));
+	bzero(fPendHold, sizeof(fPendHold)); bzero(fShowHold, sizeof(fShowHold));
+	bzero(fRetireHold, sizeof(fRetireHold));
+	fLock = IOLockAlloc();
+	fClients = OSArray::withCapacity(4);
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fLock == NULL || fClients == NULL || fWorkLoop == NULL) {
+		OSSafeReleaseNULL(fClients); OSSafeReleaseNULL(fWorkLoop);
+		if (fLock != NULL) { IOLockFree(fLock); fLock = NULL; }
+		return false;
+	}
+	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
+		OSSafeReleaseNULL(fVsync); OSSafeReleaseNULL(fWorkLoop); OSSafeReleaseNULL(fClients);
+		IOLockFree(fLock); fLock = NULL;
+		return false;
+	}
+	fSurface = sweet_surface_create_physical(fPhys, width, height, stride, SWEET_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
+	if (fPixels == 0) {
+		fWorkLoop->removeEventSource(fVsync);
+		OSSafeReleaseNULL(fVsync); OSSafeReleaseNULL(fWorkLoop); OSSafeReleaseNULL(fClients);
+		OSSafeReleaseNULL(fSurface);
+		IOLockFree(fLock); fLock = NULL;
+		return false;
+	}
+	/* This is a software notification clock, not measured hardware vblank. */
+	uint32_t hz = 5;
+	(void)PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
+	if (hz < 1 || hz > 10) hz = 5;
+	fFlushTicks = 60 / hz;
+	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	setProperty("external", false);
+	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	setProperty("redfin-copy-only", true);
+	/* No Metal plug-in or register access; avoid QuartzCore's 30 s poll. */
+	IOAcceleratorES *accel = OSTypeAlloc(IOAcceleratorES);
+	if (accel != NULL && accel->init()) {
+		accel->setName("sgx");
+		if (accel->attach(this)) accel->registerService();
+	}
+	OSSafeReleaseNULL(accel);
+	registerService();
+	IOLog("REDFIN FB: AppleCLCD CPU-copy %ux%u stride %u at %#llx, canvas %ux%u, %u Hz copies\n",
+	    width, height, stride, fPhys, cw, ch, hz);
+	return true;
+}
