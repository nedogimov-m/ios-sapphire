+/* REDFIN_PERIPHERAL_START_TEST_BEGIN */
+static void
+redfin_peripherals_observe(void)
+{
+ static uint32_t boot_id_reported;
+ if (!__atomic_exchange_n(&boot_id_reported, 1, __ATOMIC_RELAXED)) {
+  uint64_t boot_id = 0;
+  if (PE_parse_boot_argn("redfinbootid", &boot_id, sizeof(boot_id)) && boot_id)
+   IOLog("REDFIN BOOT ID: %016llx\n", (unsigned long long)boot_id);
+ }
+ uint32_t modes[6] = {}, cpus = 0;
+ const char *names[] = {"redfintouch", "redfinusb", "redfinwifi", "redfingpu", "redfinrpmh", "redfinrail"};
+ bool any = false;
+ for (unsigned i = 0; i < 6; i++) {
+  (void)PE_parse_boot_argn(names[i], &modes[i], sizeof(modes[i]));
+  if (modes[i] > 1 && !((i == 0 || i == 1) && modes[i] == 2)) {
+   IOLog("REDFIN PERIPHERALS: unsupported mode; observers skipped\n");
+   return;
+  }
+  any |= modes[i] != 0;
+ }
+ if (!any) return;
+ if (!PE_parse_boot_argn("cpus", &cpus, sizeof(cpus)) || cpus != 1 ||
+     !redfin_spmi_return_ready()) {
+  IOLog("REDFIN PERIPHERALS: verified bootloader-return/UP policy unavailable; skipped\n");
+  return;
+ }
+ static uint32_t attempted;
+ if (__atomic_exchange_n(&attempted, 1, __ATOMIC_RELAXED)) return;
+ IOLog("REDFIN PERIPHERALS: bootloader return verified before observers\n");
+ if (modes[5]) IOLog("REDFIN RAIL: snapshot result=%d\n", redfin_touch_rail_observe());
+ if (modes[4]) IOLog("REDFIN RPMH: snapshot result=%d\n", redfin_rpmh_probe());
+ if (modes[0] == 1) IOLog("REDFIN TOUCH: host snapshot result=%d\n", redfin_touch_probe());
+ if (modes[0] == 2) IOLog("REDFIN TOUCH: initial ID result=%d\n", redfin_touch_start_initial());
+ if (modes[1]) redfin_usb_probe();
+ if (modes[2]) redfin_wifi_observe();
+ if (modes[3]) IOLog("REDFIN GPU: clock snapshot result=%d\n", redfin_gpu_probe());
+}
+/* REDFIN_PERIPHERAL_START_TEST_END */
+#endif
