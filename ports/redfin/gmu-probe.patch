diff --git a/bsd/dev/redfin_gmu_probe.c b/bsd/dev/redfin_gmu_probe.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_probe.c
@@ -0,0 +1,538 @@
+/* SPDX-License-Identifier: MIT */
+/* Exact md0/UP adapter for the separately proved, held-CX GMU TCM leaf. */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <machine/machine_routines.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include <arm/pmap_public.h>
+#include "redfin_gmu_probe.h"
+#include "redfin_gmu_tcm.h"
+#include "redfin_gpu_smmu.h"
+#include "redfin_gpu_context.h"
+#include "redfin_gmu_mapping.h"
+#include "redfin_gmu_start.h"
+#include "redfin_rpmh.h"
+
+extern int redfin_spmi_return_ready(void);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+static bool gm_attempted;
+
+struct gm_binding { const void *live, *expected; unsigned bytes; };
+struct gm_context {
+    vm_offset_t base[3], gic, smmu, cb;
+    const char *parent_args;
+    void *parent_context;
+    redfin_gmu_parent_valid_fn parent_valid;
+    unsigned args_bytes;
+    char args[608];
+    struct gm_binding bindings[24];
+    uint64_t breadcrumbs;
+    unsigned binding_count, dtcm_writes, smmu_reads, smmu_guard, smmu_breadcrumbs;
+    unsigned smmu_mode, cb_reads, cb_breadcrumbs;
+    bool active, smmu_requested, smmu_ready;
+};
+static bool gm_memory_contract(struct gm_context *);
+static int gm_memory_run(struct gm_context *, const struct rf_gs_snapshot *, const struct rf_gc_snapshot *);
+static bool gm_start_contract(struct gm_context *);
+static int gm_start_run(struct gm_context *);
+
+static const uint64_t gm_reg[] = {
+    0x00100000, 0x1f0000, 0x03d90000, 0x9000,
+    0x03d6a000, 0x30000, 0x17a00000, 0x4000
+};
+static const uint64_t gm_dram_base = 0x180000000ULL, gm_dram_size = 0x80000000ULL;
+static const uint32_t gm_chip = 0x06020001;
+static const uint32_t gm_clock[] = {200000000, 31, 0x4000, 2, 6, 2, 0x71028, 3, 3, 0xf03, 0x103};
+static const uint32_t gm_tcm[] = {2, 0x10004000, 0x7000, 2, 1, 1000};
+static const uint32_t gm_parent[] = {0x30000, 64, 65535, 7, 416};
+static const uint32_t gm_irqs[] = {336, 337};
+static const uint64_t gm_smmu_reg[] = {0x03da0000, 0x10000};
+static const uint32_t gm_smmu_streams[] = {4, 0x400, 5, 0x400};
+static const uint32_t gm_smmu_format[] = {0x1000, 0x8000, 128, 8, 39, 36};
+static const uint32_t gm_smmu_clocks[][4] = {
+    {RF_GT_GCC, 0x7100c, 0x80000001u, 1},
+    {RF_GT_GCC, 0x71018, 0x80000001u, 1},
+    {RF_GT_GPUCC, 0x1078, 1, 1}, /* Native AHB HALT_DELAY: enable bit only. */
+    {RF_GT_GPUCC, 0x5000, 0x80000001u, 1}
+};
+static const uint32_t gm_smmu_irqs[] = {705, 710, 711, 712, 713, 714, 715, 716, 717};
+static const uint32_t gm_cb_policy[] = {1, 0x8000, RF_GC_MAP_BYTES, RF_GC_BANKS, 0x1000, RF_GC_WORDS};
+
+static bool
+gm_property(struct gm_context *context, const char *path, const char *key,
+    const void *expected, unsigned size)
+{
+    DTEntry node;
+    const void *raw = NULL;
+    unsigned bytes = 0;
+    if (SecureDTLookupEntry(NULL, path, &node) != kSuccess ||
+        SecureDTGetProperty(node, key, &raw, &bytes) != kSuccess ||
+        !raw || bytes != size || memcmp(raw, expected, size))
+        return false;
+    if (context) {
+        if (context->binding_count >= sizeof(context->bindings) / sizeof(context->bindings[0]))
+            return false;
+        struct gm_binding *binding = &context->bindings[context->binding_count++];
+        binding->live = raw;
+        binding->expected = expected;
+        binding->bytes = bytes;
+    }
+    return true;
+}
+
+static bool
+gm_contract(struct gm_context *context, unsigned mode)
+{
+    bool base = gm_property(context, "/chosen", "dram-base", &gm_dram_base, sizeof(gm_dram_base)) &&
+        gm_property(context, "/chosen", "dram-size", &gm_dram_size, sizeof(gm_dram_size)) &&
+        gm_property(context, "/redfin-gmu", "reg", gm_reg, sizeof(gm_reg)) &&
+        gm_property(context, "/redfin-gmu", "chip-id", &gm_chip, sizeof(gm_chip)) &&
+        gm_property(context, "/redfin-gmu", "clock-policy", gm_clock, sizeof(gm_clock)) &&
+        gm_property(context, "/redfin-gmu", "tcm-policy", gm_tcm, sizeof(gm_tcm)) &&
+        gm_property(context, "/redfin-gmu", "cx-parent", gm_parent, sizeof(gm_parent)) &&
+        gm_property(context, "/redfin-gmu", "gic-intids", gm_irqs, sizeof(gm_irqs));
+    if (!base || !mode)
+        return base;
+    return gm_property(context, "/redfin-gpu-smmu", "reg", gm_smmu_reg, sizeof(gm_smmu_reg)) &&
+        gm_property(context, "/redfin-gpu-smmu", "chip-id", &gm_chip, sizeof(gm_chip)) &&
+        gm_property(context, "/redfin-gpu-smmu", "stream-map", gm_smmu_streams, sizeof(gm_smmu_streams)) &&
+        gm_property(context, "/redfin-gpu-smmu", "format-policy", gm_smmu_format, sizeof(gm_smmu_format)) &&
+        gm_property(context, "/redfin-gpu-smmu", "clock-policy", gm_smmu_clocks, sizeof(gm_smmu_clocks)) &&
+        gm_property(context, "/redfin-gpu-smmu", "gic-intids", gm_smmu_irqs, sizeof(gm_smmu_irqs)) &&
+        (mode < 2 || gm_property(context, "/redfin-gpu-smmu", "context-policy",
+            gm_cb_policy, sizeof(gm_cb_policy))) &&
+        (mode < 3 || gm_memory_contract(context)) &&
+        (mode != 4 || gm_start_contract(context));
+}
+
+int
+redfin_gmu_probe_contract(const char *frozen_args, unsigned args_bytes)
+{
+    const char *live = PE_boot_args();
+    unsigned mode = 0;
+    if (!redfin_gmu_args_mode(frozen_args, args_bytes, &mode) || !live ||
+        memcmp(live, frozen_args, args_bytes))
+        return ENOTSUP;
+    return gm_contract(NULL, mode) ? 0 : ENXIO;
+}
+
+static uint32_t
+gm_read32(vm_offset_t address)
+{
+    uint32_t value = *(volatile const uint32_t *)address;
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+static void
+gm_write32(vm_offset_t address, uint32_t value)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)address = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+gm_valid(void *argument)
+{
+    struct gm_context *context = argument;
+    const char *live = PE_boot_args();
+    if (!context || !context->active || !context->args_bytes || !context->parent_args ||
+        !context->parent_context || !context->parent_valid || !live ||
+        memcmp(live, context->args, context->args_bytes) ||
+        memcmp(context->parent_args, context->args, context->args_bytes) ||
+        __builtin_arm_rsr64("CurrentEL") != 4 ||
+        (__builtin_arm_rsr64("MPIDR_EL1") & 0xff00ffffffULL) ||
+        redfin_spmi_return_ready() != 1 || !context->parent_valid(context->parent_context))
+        return false;
+    for (unsigned i = 0; i < context->binding_count; i++) {
+        const struct gm_binding *binding = &context->bindings[i];
+        if (memcmp(binding->live, binding->expected, binding->bytes))
+            return false;
+    }
+    if (context->base[RF_GT_GCC] &&
+        (gm_read32(context->base[RF_GT_GCC] + 0x71004) & 0x80000001u) != 1)
+        return false;
+    if (context->base[RF_GT_GPUCC] &&
+        ((gm_read32(context->base[RF_GT_GPUCC] + 0x106c) & 3u) ||
+         !(gm_read32(context->base[RF_GT_GPUCC] + 0x1540) & 0x80000000u)))
+        return false;
+    if (context->gic) {
+        const uint32_t mask = 3u << 16;
+        if ((gm_read32(context->gic + 0x128) | gm_read32(context->gic + 0x228) |
+                gm_read32(context->gic + 0x328)) & mask)
+            return false;
+        if (context->smmu_requested &&
+            ((gm_read32(context->gic + 0x158) | gm_read32(context->gic + 0x258) |
+                gm_read32(context->gic + 0x358)) & 0x3fc2u))
+            return false;
+    }
+    return true;
+}
+
+/* One message per first register access; no polling-loop log stream. */
+static bool
+gm_breadcrumb(struct gm_context *context, unsigned unit, uint32_t at, bool writing)
+{
+    unsigned index;
+    if (unit == RF_GT_GCC) {
+        switch (at) {
+        case 0: index = 0; break;
+        case 4: index = 1; break;
+        case 0xc: index = 2; break;
+        case 0x40: index = 3; break;
+        case 0x71028: index = 4; break;
+        case 0x52010: index = 5; break;
+        case 0x52000: index = 6; break;
+        case 0x71154: index = 7; break;
+        case 0x7100c: index = 8; break;
+        case 0x71018: index = 9; break;
+        default: return false;
+        }
+    } else if (unit == RF_GT_GPUCC) {
+        switch (at) {
+        case 0x1120: index = 10; break;
+        case 0x1124: index = 11; break;
+        case 0x1078: index = 12; break;
+        case 0x5000: index = 13; break;
+        case 0x1098: index = 14; break;
+        case 0x100c: index = 15; break;
+        case 0x1064: index = 16; break;
+        default: return false;
+        }
+    } else if (unit == RF_GT_GMU) {
+        switch (at) {
+        case 0x14000: index = 17; break;
+        case 0x14070: index = 18; break;
+        case 0x14600: index = 19; break;
+        case 0x14220: index = 20; break;
+        case 0x7000: index = 21; break;
+        case 0x7004: index = 22; break;
+        default: return false;
+        }
+    } else {
+        return false;
+    }
+    if (writing)
+        index += 32;
+    uint64_t bit = UINT64_C(1) << index;
+    if (context->breadcrumbs & bit)
+        return false;
+    context->breadcrumbs |= bit;
+    printf("REDFIN GMU ACCESS: unit=%u offset=%#x first-%s\n", unit, at, writing ? "write" : "read");
+    return true;
+}
+
+static int
+gm_read(void *argument, unsigned unit, uint32_t at, uint32_t *value)
+{
+    struct gm_context *context = argument;
+    if (!value || unit >= 3 || !context->base[unit] || !rf_gt_allowed(unit, at, false))
+        return EINVAL;
+    if (!gm_valid(context))
+        return ECANCELED;
+    if (gm_breadcrumb(context, unit, at, false) && !gm_valid(context))
+        return ECANCELED;
+    *value = gm_read32(context->base[unit] + at);
+    return 0;
+}
+
+static int
+gm_write(void *argument, unsigned unit, uint32_t at, uint32_t value)
+{
+    struct gm_context *context = argument;
+    if (unit >= 3 || !context->base[unit] || !rf_gt_allowed(unit, at, true) ||
+        (unit == RF_GT_GMU && at == 0x14000 && value != 1))
+        return EINVAL;
+    if (!gm_valid(context))
+        return ECANCELED;
+    bool logged = gm_breadcrumb(context, unit, at, true);
+    if (unit == RF_GT_GMU && (at == 0x7000 || at == 0x7004)) {
+        if (context->dtcm_writes++ == 2) {
+            printf("REDFIN GMU STEP: DTCM restore begins; reset held\n");
+            logged = true;
+        }
+    }
+    if (logged && !gm_valid(context))
+        return ECANCELED;
+    gm_write32(context->base[unit] + at, value);
+    return 0;
+}
+
+static void
+gm_delay(void *argument, unsigned microseconds)
+{
+    (void)argument;
+    delay((int)microseconds); /* Leaf delays are bounded to at most 1000us. */
+}
+
+static uint64_t
+gm_time_ns(void *argument)
+{
+    uint64_t nanoseconds;
+    (void)argument;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+    return nanoseconds;
+}
+
+static bool
+gm_smmu_valid(void *argument)
+{
+    struct gm_context *context = argument;
+    struct rf_gt_report source = {0};
+    uint32_t value;
+    if (!context)
+        return false;
+    context->smmu_guard = 1;
+    if (!context->smmu_requested || !context->smmu_ready || !gm_valid(context))
+        return false;
+    const struct rf_gt_ops ops = {.context = context, .valid = gm_valid, .read = gm_read};
+    context->smmu_guard = 2;
+    if (rf_gt_source_live(&ops, &source, true))
+        return false;
+    context->smmu_guard = 3;
+    if (gm_read(context, RF_GT_GCC, 0x71028, &value) || (value & 3u) != 3)
+        return false;
+    for (unsigned i = 0; i < sizeof(gm_smmu_clocks) / sizeof(gm_smmu_clocks[0]); i++) {
+        const uint32_t *clock = gm_smmu_clocks[i];
+        if (gm_read(context, clock[0], clock[1], &value) || (value & clock[2]) != clock[3])
+            return false;
+    }
+    context->smmu_guard = 4;
+    if (gm_read(context, RF_GT_GMU, 0x14000, &value) || value != 1 ||
+        gm_read(context, RF_GT_GMU, 0x14070, &value) || value != 0 ||
+        gm_read(context, RF_GT_GMU, 0x14600, &value) || value != 0)
+        return false;
+    context->smmu_guard = 5;
+    return true;
+}
+
+static bool
+gm_smmu_step(struct gm_context *context, unsigned bit, const char *phase, uint32_t at)
+{
+    if (context->smmu_breadcrumbs & (1u << bit))
+        return false;
+    context->smmu_breadcrumbs |= 1u << bit;
+    printf("REDFIN SMMU ACCESS: phase=%s first-offset=%#x; global-only\n", phase, at);
+    return true;
+}
+
+static uint32_t
+gm_scalar_read(vm_offset_t address)
+{
+    uint32_t raw;
+    __asm__ volatile("ldr %w0, [%1]" : "=r"(raw) : "r"(address) : "memory");
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return raw;
+}
+
+static int
+gm_smmu_read(void *argument, uint32_t at, uint32_t *value)
+{
+    struct gm_context *context = argument;
+    static const struct rf_gs_snapshot limits = {
+        .page_bytes = 0x1000, .global_bytes = 0x8000,
+        .streams = RF_GS_MAX_STREAMS, .contexts = RF_GS_MAX_CONTEXTS
+    };
+    if (!context || !value || !context->smmu || !rf_gs_read_allowed(at, &limits))
+        return EINVAL;
+    if (!gm_smmu_valid(context))
+        return ECANCELED;
+    bool logged = false;
+    if (at == 0x20)
+        logged = context->smmu_reads ? gm_smmu_step(context, 4, "recheck", at) :
+            gm_smmu_step(context, 0, "ids", at);
+    else if (at == 0)
+        logged = gm_smmu_step(context, 1, "globals", at);
+    else if (at == 0x800)
+        logged = gm_smmu_step(context, 2, "routes", at);
+    else if (at == 0x1000)
+        logged = gm_smmu_step(context, 3, "gr1-metadata", at);
+    if (logged && !gm_smmu_valid(context))
+        return ECANCELED;
+    /* Explicit scalar LDR for HYP-intercepted globals; never a CB page. */
+    *value = gm_scalar_read(context->smmu + at);
+    context->smmu_reads++;
+    return 0;
+}
+
+static int
+gm_cb_read(void *argument, unsigned bank, uint32_t at, uint32_t *value)
+{
+    struct gm_context *context = argument;
+    if (!context || !context->cb || context->smmu_mode < 2 ||
+        !value || !rf_gc_allowed(bank, at))
+        return EINVAL;
+    if (!gm_smmu_valid(context))
+        return ECANCELED;
+    if (!(context->cb_breadcrumbs & (1u << bank))) {
+        context->cb_breadcrumbs |= 1u << bank;
+        printf("REDFIN GPU CONTEXT ACCESS: bank=%u first-offset=%#x; read-only\n", bank, at);
+        if (!gm_smmu_valid(context))
+            return ECANCELED;
+    }
+    *value = gm_scalar_read(context->cb + bank * 0x1000 + at);
+    context->cb_reads++;
+    return 0;
+}
+
+#include "redfin_gmu_memory.inc"
+#include "redfin_gmu_start.inc"
+
+static int
+gm_cb_run(struct gm_context *context, const struct rf_gs_snapshot *global)
+{
+    struct rf_gc_snapshot snapshot = {0};
+    int result = ECANCELED;
+    if (context->smmu_mode >= 2 && global->stable && global->map_format_supported &&
+        !global->error && global->stage == 4 && global->contexts >= RF_GC_BANKS &&
+        !global->stage2_contexts && gm_smmu_valid(context)) {
+        printf("REDFIN GPU CONTEXT STEP: stable globals; inspect CB0/1, no table dereference\n");
+        if (gm_smmu_valid(context)) {
+            context->cb = ml_io_map(RF_GS_PHYS + 0x8000, RF_GC_MAP_BYTES);
+            if (!context->cb) {
+                result = ENOMEM;
+            } else {
+                const struct rf_gc_ops ops = {context, gm_smmu_valid, gm_cb_read};
+                result = rf_gc_snapshot_run(&ops, global, &snapshot);
+            }
+        }
+    }
+    printf("REDFIN GPU CONTEXT: result=%d stage=%u reads=%u completed=%u stable=%u disabled=%#x faults=%#x changed=%u/%#x; no writes/ownership\n",
+        result, snapshot.stage, snapshot.reads, context->cb_reads, snapshot.stable,
+        snapshot.disabled_mask, snapshot.fault_mask, snapshot.changed_bank, snapshot.changed_offset);
+    for (unsigned bank = 0; bank < RF_GC_BANKS; bank++) {
+        const uint32_t *w = snapshot.words[bank];
+        printf("REDFIN GPU CONTEXT BANK: bank=%u SCTLR=%#x TCR2=%#x TTBR0=%#x/%#x TCR=%#x CONTEXTID=%#x MAIR=%#x/%#x FSR=%#x FAR=%#x/%#x FSYNR=%#x\n",
+            bank, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11]);
+    }
+    if (!result && context->smmu_mode >= 3) result = gm_memory_run(context, global, &snapshot);
+    if (!result && context->smmu_mode == 4) result = gm_start_run(context);
+    return result;
+}
+
+static int
+gm_smmu_run(struct gm_context *context, const struct rf_gt_report *gmu)
+{
+    struct rf_gs_snapshot snapshot = {0};
+    int result = EPERM;
+    if (!gmu->error && gmu->stage == RF_GT_DONE && gmu->reset_held && gmu->source_200m &&
+        gmu->counter_live && gmu->dtcm_restored && !gmu->dtcm_dirty) {
+        context->smmu_ready = true;
+        printf("REDFIN SMMU STEP: fresh GMU DONE; recheck held parent/source/reset/IRQs\n");
+        if (!gm_smmu_valid(context)) {
+            result = ECANCELED;
+        } else {
+            context->smmu = ml_io_map(RF_GS_PHYS, RF_GS_BYTES / 2);
+            if (!context->smmu) {
+                result = ENOMEM;
+            } else {
+                const struct rf_gs_ops ops = {context, gm_smmu_valid, gm_smmu_read};
+                result = rf_gs_snapshot_run(&ops, gm_chip, &snapshot);
+            }
+        }
+    }
+    printf("REDFIN SMMU: result=%d stage=%u guard=%u reads=%u completed=%u stable=%u format=%u changed=%#x; no CB/write/table ownership\n",
+        result, snapshot.stage, context->smmu_guard, snapshot.reads, context->smmu_reads,
+        snapshot.stable, snapshot.map_format_supported, snapshot.changed_offset);
+    printf("REDFIN SMMU IDS: complete=%u IDR=%#x/%#x/%#x/%#x page=%#x global=%#x streams=%u contexts=%u stage2=%u bits=%u/%u/%u/%u\n",
+        context->smmu_reads >= 4, snapshot.id0, snapshot.id1, snapshot.id2, snapshot.id7,
+        snapshot.page_bytes, snapshot.global_bytes, snapshot.streams, snapshot.contexts,
+        snapshot.stage2_contexts, snapshot.sid_bits, snapshot.input_bits,
+        snapshot.output_bits, snapshot.virtual_bits);
+    if (snapshot.stage >= 3) {
+        printf("REDFIN SMMU GLOBAL: first-pass CR0=%#x GFSR=%#x syndrome=%#x/%#x/%#x\n",
+            snapshot.control, snapshot.fault, snapshot.syndrome[0], snapshot.syndrome[1], snapshot.syndrome[2]);
+        for (unsigned i = 0; i < snapshot.streams && i < RF_GS_MAX_STREAMS; i++)
+            printf("REDFIN SMMU ROUTE: first-pass slot=%u SMR=%#x S2CR=%#x\n", i, snapshot.smr[i], snapshot.s2cr[i]);
+        for (unsigned i = 0; i < snapshot.contexts && i < RF_GS_MAX_CONTEXTS; i++)
+            printf("REDFIN SMMU GR1: first-pass bank=%u CBAR=%#x CBA2R=%#x\n", i, snapshot.cbar[i], snapshot.cba2r[i]);
+    }
+    if (snapshot.stable)
+        printf("REDFIN SMMU ANALYSIS: stream4=%u/%u stream5=%u/%u unreferenced=%#x malformed=%u; unreferenced is not owned\n",
+            snapshot.gmu_matches[0], snapshot.gmu_slot[0], snapshot.gmu_matches[1], snapshot.gmu_slot[1],
+            snapshot.unreferenced_mask, snapshot.malformed_routes);
+    if (!result && context->smmu_mode >= 2)
+        result = gm_cb_run(context, &snapshot);
+    return result;
+}
+
+int
+redfin_gmu_probe(const char *frozen_args, unsigned args_bytes,
+    void *held_cx_context, redfin_gmu_parent_valid_fn held_cx_valid)
+{
+    static struct gm_context context;
+    struct rf_gt_report report = {0};
+    int result;
+    if (__atomic_exchange_n(&gm_attempted, true, __ATOMIC_ACQ_REL))
+        return EBUSY;
+    memset(&context, 0, sizeof(context));
+    result = redfin_gmu_probe_contract(frozen_args, args_bytes);
+    if (result)
+        return result;
+    if (!held_cx_context || !held_cx_valid)
+        return EINVAL;
+    context.parent_args = frozen_args;
+    context.parent_context = held_cx_context;
+    context.parent_valid = held_cx_valid;
+    context.args_bytes = args_bytes;
+    memcpy(context.args, frozen_args, args_bytes);
+    if (!redfin_gmu_args_mode(frozen_args, args_bytes, &context.smmu_mode))
+        return ENOTSUP;
+    context.smmu_requested = context.smmu_mode != 0;
+    context.active = true;
+    if (!gm_contract(&context, context.smmu_mode) || !gm_valid(&context))
+        return EPERM;
+    context.base[RF_GT_GCC] = ml_io_map(0x100000, 0x1f0000);
+    if (!context.base[RF_GT_GCC])
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    context.base[RF_GT_GPUCC] = ml_io_map(0x3d90000, 0x9000);
+    if (!context.base[RF_GT_GPUCC])
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    context.gic = ml_io_map(0x17a00000, 0x4000);
+    if (!context.gic)
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    context.base[RF_GT_GMU] = ml_io_map(0x3d6a000, 0x30000);
+    if (!context.base[RF_GT_GMU])
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    const struct rf_gt_ops ops = {&context, gm_valid, gm_read, gm_write, gm_delay, gm_time_ns};
+    printf("REDFIN GMU STEP: clock preflight begins; CM3 release is forbidden\n");
+    result = rf_gt_run(&ops, gm_chip, &report);
+    if (!context.smmu_requested || result)
+        context.active = false;
+    printf("REDFIN GMU: result=%d stage=%u reads=%u writes=%u polls=%u source200=%u counter=%u restored=%u dirty=%u; no firmware/DMA/GX\n",
+        result, report.stage, report.reads, report.writes, report.polls, report.source_200m,
+        report.counter_live, report.dtcm_restored, report.dtcm_dirty);
+    printf("REDFIN GMU CLOCK: MODE=%#x L=%#x USER=%#x ALPHA=%#x MISC=%#x source=%#x/%#x branch=%#x/%#x CX=%#x HW=%#x GX=%#x\n",
+        report.pll_mode, report.pll_l, report.pll_user, report.pll_alpha, report.misc,
+        report.source_before, report.source_after, report.gmu_clock_before,
+        report.gmu_clock_after, report.cx, report.cx_hw, report.gx);
+    printf("REDFIN GMU RESET: before=%#x after=%#x asserted=%u INIT=%#x HFI=%#x counter=%#x/%#x delta=%u elapsed-ns=%llu\n",
+        report.reset_before, report.reset_after, report.reset_held, report.result_before,
+        report.hfi_before, report.counter_before, report.counter_after, report.counter_delta,
+        (unsigned long long)report.counter_elapsed_ns);
+    printf("REDFIN GMU TCM: saved=%#x/%#x pattern=%#x/%#x restored=%#x/%#x\n",
+        report.saved[0], report.saved[1], report.pattern_read[0], report.pattern_read[1],
+        report.restored[0], report.restored[1]);
+    if (context.smmu_requested && !result)
+        result = gm_smmu_run(&context, &report);
+    context.active = false;
+    return result;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/redfin_gmu_probe.h b/bsd/dev/redfin_gmu_probe.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_probe.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: MIT */
+/* Synchronous Redfin reset-held GMU probe; no standalone power authority. */
+#ifndef REDFIN_GMU_PROBE_H
+#define REDFIN_GMU_PROBE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+typedef bool (*redfin_gmu_parent_valid_fn)(void *);
+
+/*
+ * bytes includes the NUL; every word and the nonzero boot nonce is unique.
+ * Optional redfinsmmu=1 reads globals; =2 reads CB0/1; =3 prepares the
+ * explicitly bound reset-held firmware/memory mapping contract; =4 additionally
+ * runs the separate native PDC/RSC/CM3/HFI contract.
+ * A rejected argument list leaves the optional selection output unchanged.
+ */
+static inline bool
+redfin_gmu_args_mode(const char *args, unsigned bytes, unsigned *smmu_mode)
+{
+    static const char *const required[] = {
+        "debug=0xc", "serial=3", "cpus=1", "keepsyms=1", "-noprogress", "rd=md0",
+        "sweettouch=0", "sweetkeys=0", "sweetusb=0", "sweetcpufreq=0", "sweetbattery=0",
+        "modem=0", "wifi=0", "gpu=0", "redfingpu=2", "redfingpupower=1",
+        "redfinrpmh=1", "redfinspmi=1", "redfinreturn=1", "redfingmu=1"
+    };
+    uint32_t seen = 0;
+    bool nonce_seen = false, trace_seen = false, smmu_seen = false;
+    unsigned mode = 0;
+    unsigned at = 0;
+    if (!args || !bytes || bytes > 608 || args[bytes - 1])
+        return false;
+    while (at < bytes - 1) {
+        unsigned first, n, i;
+        bool known = false;
+        if (args[at] == ' ') { at++; continue; }
+        first = at;
+        while (at < bytes - 1 && args[at] != ' ') {
+            if ((unsigned char)args[at] < 33 || (unsigned char)args[at] > 126)
+                return false;
+            at++;
+        }
+        n = at - first;
+        for (i = 0; i < sizeof(required) / sizeof(required[0]); i++) {
+            unsigned length = 0;
+            while (required[i][length]) length++;
+            if (length != n) continue;
+            unsigned j;
+            for (j = 0; j < n && args[first + j] == required[i][j]; j++) {}
+            if (j != n) continue;
+            if (seen & (1u << i)) return false;
+            seen |= 1u << i;
+            known = true;
+            break;
+        }
+        if (known) continue;
+        static const char smmu[] = "redfinsmmu=";
+        if (n == sizeof(smmu)) {
+            for (i = 0; i < sizeof(smmu) - 1 && args[first + i] == smmu[i]; i++) {}
+            if (i == sizeof(smmu) - 1 && args[first + i] >= '1' && args[first + i] <= '4') {
+                if (smmu_seen) return false;
+                smmu_seen = true;
+                mode = (unsigned)(args[first + i] - '0');
+                continue;
+            }
+        }
+        static const char trace[] = "-enable_kprintf_spam";
+        if (n == sizeof(trace) - 1) {
+            for (i = 0; i < n && args[first + i] == trace[i]; i++) {}
+            if (i == n) {
+                if (trace_seen) return false;
+                trace_seen = true;
+                continue;
+            }
+        }
+        static const char prefix[] = "redfinbootid=0x";
+        if (n == 31) {
+            for (i = 0; i < sizeof(prefix) - 1 && args[first + i] == prefix[i]; i++) {}
+            if (i == sizeof(prefix) - 1) {
+                uint64_t nonce = 0;
+                if (nonce_seen) return false;
+                for (; i < n; i++) {
+                    unsigned digit = (unsigned)(args[first + i] - '0');
+                    if (digit > 9) {
+                        if (args[first + i] < 'a' || args[first + i] > 'f') return false;
+                        digit = (unsigned)(args[first + i] - 'a' + 10);
+                    }
+                    nonce = (nonce << 4) | digit;
+                }
+                if (!nonce) return false;
+                nonce_seen = true;
+                continue;
+            }
+        }
+        return false;
+    }
+    if (seen != (1u << (sizeof(required) / sizeof(required[0]))) - 1 || !nonce_seen)
+        return false;
+    if (smmu_mode)
+        *smmu_mode = mode;
+    return true;
+}
+
+static inline bool
+redfin_gmu_args_select(const char *args, unsigned bytes, bool *smmu_requested)
+{
+    unsigned mode;
+    if (!redfin_gmu_args_mode(args, bytes, &mode))
+        return false;
+    if (smmu_requested)
+        *smmu_requested = mode != 0;
+    return true;
+}
+
+static inline bool
+redfin_gmu_args_valid(const char *args, unsigned bytes)
+{
+    return redfin_gmu_args_select(args, bytes, NULL);
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Read-only DT/argument validation before the parent's first power write.
+ * A selected SMMU mode additionally requires its complete exact ADT leaf.
+ */
+int redfin_gmu_probe_contract(const char *frozen_args, unsigned args_bytes);
+
+/*
+ * Call only after successful RF_GP_OK/parent_held/cx_on in the same exact mode.
+ * The parent's callback must revalidate that owned result and its original
+ * frozen argument/context lifetime. No callback or argument is retained after
+ * this synchronous function returns. It never releases the parent's ARC vote.
+ * A selected read-only SMMU snapshot runs only after this call's successful
+ * reset-held TCM leaf and fresh parent/source/reset/IRQ proofs; no SMMU
+ * write, table install or firmware start is provided. Mode2 additionally
+ * reads only CB0/1 after that stable snapshot and its separate exact policy.
+ * Mode3 adds owned memory/firmware preparation; mode4 explicitly authorizes
+ * native PDC/RSC, one CM3 reset release and a bounded HFI version exchange.
+ */
+int redfin_gmu_probe(const char *frozen_args, unsigned args_bytes,
+    void *held_cx_context, redfin_gmu_parent_valid_fn held_cx_valid);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* REDFIN_GMU_PROBE_H */
diff --git a/bsd/dev/redfin_gmu_tcm.h b/bsd/dev/redfin_gmu_tcm.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_tcm.h
@@ -0,0 +1,402 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Lito-only, reset-held GMU clock/counter/TCM experiment. References: GMU.md.
+ * This does not start CM3, configure SMMU/GX/PDC/RSC, or load firmware.
+ * The caller must own a bounded single-CPU md0 session, fresh CX power and
+ * its held ARC floor, exclusive GCC/GPUCC/GMU clock access and reset return.
+ * As in native Lito, clock the CSR path before reading reset; all TCM access
+ * requires reset==1 and this module never writes a reset release.
+ * Added votes/clocks stay held until that platform reset. Only the two DTCM
+ * words and the RCG's initial force-enable bit are restored here.
+ */
+#ifndef REDFIN_GMU_TCM_H
+#define REDFIN_GMU_TCM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/errno.h>
+
+enum { RF_GT_GCC, RF_GT_GPUCC, RF_GT_GMU };
+enum {
+    RF_GT_PREFLIGHT = 1, RF_GT_BUS_CLOCKS, RF_GT_RESET, RF_GT_SOURCE,
+    RF_GT_CORE_CLOCK, RF_GT_COUNTER, RF_GT_SAVE, RF_GT_PATTERN,
+    RF_GT_RESTORE, RF_GT_DONE
+};
+
+struct rf_gt_ops {
+    void *context;
+    /* Recheck the exact A620/UP/md0/power/clock/return lifetime each time. */
+    bool (*valid)(void *);
+    /* Ordered 32-bit Device MMIO; return positive errno on failure. */
+    int (*read)(void *, unsigned, uint32_t, uint32_t *);
+    int (*write)(void *, unsigned, uint32_t, uint32_t);
+    /* Bounded busy wait in microseconds; no thread sleep or rescheduling. */
+    void (*delay)(void *, unsigned);
+    /* CPU monotonic time; no Device MMIO or scheduling in this callback. */
+    uint64_t (*time_ns)(void *);
+};
+
+struct rf_gt_report {
+    uint32_t stage, error, reads, writes, polls;
+    uint32_t pll_mode, pll_l, pll_user, pll_alpha;
+    uint32_t pll_vote_before, feed_before, misc, cx, cx_hw, gx;
+    uint32_t rcg_before, source_before, gmu_clock_before;
+    uint32_t reset_before, result_before, hfi_before;
+    uint32_t reset_after, source_after, gmu_clock_after;
+    uint32_t counter_before, counter_after, counter_delta;
+    uint32_t saved[2], pattern_read[2], restored[2];
+    uint64_t counter_elapsed_ns;
+    bool reset_held, source_200m, counter_live, dtcm_dirty, dtcm_restored;
+};
+
+/* Narrow callback allowlist; the adapter must enforce its own bound lease. */
+static inline bool
+rf_gt_allowed(unsigned unit, uint32_t at, bool writing)
+{
+    if (unit == RF_GT_GCC) {
+        switch (at) {
+        case 0x52010: case 0x52000: case 0x71154: case 0x7100c: case 0x71018: case 0x71028:
+            return true;
+        case 0: case 4: case 0xc: case 0x40: case 0x71004:
+            return !writing;
+        default: return false;
+        }
+    }
+    if (unit == RF_GT_GPUCC) {
+        switch (at) {
+        case 0x1078: case 0x109c: case 0x5000: case 0x1120: case 0x1124: case 0x1098:
+            return true;
+        case 0x106c: case 0x1540: case 0x100c: case 0x1064:
+            return !writing;
+        default: return false;
+        }
+    }
+    if (unit == RF_GT_GMU) {
+        switch (at) {
+        case 0x14000: case 0x7000: case 0x7004:
+            return true;
+        case 0x14070: case 0x14600: case 0x14220:
+            return !writing;
+        default: return false;
+        }
+    }
+    return false;
+}
+
+static inline int
+rf_gt_rd(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t *value)
+{
+    if (!rf_gt_allowed(unit, at, false))
+        return EINVAL;
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    r->reads++;
+    return ops->read(ops->context, unit, at, value);
+}
+
+static inline int
+rf_gt_wr(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t value)
+{
+    if (!rf_gt_allowed(unit, at, true) ||
+        (unit == RF_GT_GMU && at == 0x14000 && value != 1))
+        return EINVAL;
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    r->writes++;
+    return ops->write(ops->context, unit, at, value);
+}
+
+static inline int
+rf_gt_delay(const struct rf_gt_ops *ops, unsigned us)
+{
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    ops->delay(ops->context, us);
+    return ops->valid(ops->context) ? 0 : ECANCELED;
+}
+
+static inline int
+rf_gt_poll(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t mask, uint32_t expected, unsigned limit)
+{
+    uint32_t value;
+    unsigned i;
+    int error;
+    for (i = 0; i < limit; i++) {
+        error = rf_gt_rd(ops, r, unit, at, &value);
+        if (error)
+            return error;
+        r->polls++;
+        if ((value & mask) == expected)
+            return 0;
+        error = rf_gt_delay(ops, 1);
+        if (error)
+            return error;
+    }
+    return ETIMEDOUT;
+}
+
+static inline int
+rf_gt_update(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t mask, uint32_t value)
+{
+    uint32_t before, after;
+    int error = rf_gt_rd(ops, r, unit, at, &before);
+    if (error)
+        return error;
+    error = rf_gt_wr(ops, r, unit, at, (before & ~mask) | (value & mask));
+    if (error)
+        return error;
+    error = rf_gt_rd(ops, r, unit, at, &after);
+    if (error)
+        return error;
+    return (after & mask) == (value & mask) ? 0 : EIO;
+}
+
+static inline bool
+rf_gt_pll_identity(uint32_t mode, uint32_t l, uint32_t user, uint32_t alpha)
+{
+    /* Locked/active FSM, main/even outputs on, even postdivision /2.
+     * Bit2 is the unused third output; do not require or modify it. */
+    return (mode & 0xc0100000u) == 0xc0100000u && l == 31 &&
+        (user & 0xf03u) == 0x103u && alpha == 0x4000;
+}
+
+static inline int
+rf_gt_source_live(const struct rf_gt_ops *ops, struct rf_gt_report *r, bool running)
+{
+    uint32_t v[16];
+    static const struct { unsigned unit; uint32_t at; } registers[16] = {
+        {RF_GT_GCC, 0x71004}, {RF_GT_GPUCC, 0x106c},
+        {RF_GT_GCC, 0}, {RF_GT_GCC, 4}, {RF_GT_GCC, 0xc}, {RF_GT_GCC, 0x40},
+        {RF_GT_GCC, 0x52010}, {RF_GT_GCC, 0x52000},
+        {RF_GT_GPUCC, 0x1124}, {RF_GT_GPUCC, 0x1120},
+        {RF_GT_GPUCC, 0x1098}, {RF_GT_GPUCC, 0x109c},
+        {RF_GT_GPUCC, 0x100c}, {RF_GT_GPUCC, 0x1064}, {RF_GT_GPUCC, 0x1540},
+        {RF_GT_GCC, 0x71028}
+    };
+    unsigned i;
+    int error;
+    for (i = 0; i < 16; i++) {
+        error = rf_gt_rd(ops, r, registers[i].unit, registers[i].at, &v[i]);
+        if (error)
+            return error;
+    }
+    if ((v[0] & 0x80000001u) != 1 || (v[1] & 3u) || !(v[14] & 0x80000000u) ||
+        !rf_gt_pll_identity(v[2], v[3], v[4], v[5]) ||
+        !(v[6] & 1) || !(v[7] & 0x10000u) || (v[11] & 0x80000001u) != 1 ||
+        (v[12] & 0x80000001u) != 1 ||
+        (v[13] & 0x80000001u) != 0x80000000u || (v[15] & 3u) != 3u)
+        return EAGAIN;
+    if (!running && (v[10] & 0x80000001u) != 0x80000000u)
+        return EBUSY;
+    if (running && ((v[8] & 0x10371fu) != 0x602 ||
+            (v[9] & 0x80000001u) != 0 || (v[10] & 0x80000001u) != 1))
+        return EAGAIN;
+    return 0;
+}
+
+/* CSR access with fresh power/source proof; data access also verifies reset. */
+static inline int
+rf_gt_gmu_rd(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    uint32_t at, uint32_t *value, bool running, bool data)
+{
+    uint32_t reset;
+    if (!running)
+        return EINVAL;
+    int error = rf_gt_source_live(ops, r, running);
+    if (error)
+        return error;
+    if (data) {
+        error = rf_gt_rd(ops, r, RF_GT_GMU, 0x14000, &reset);
+        if (error)
+            return error;
+        if (reset != 1)
+            return EAGAIN;
+    }
+    return rf_gt_rd(ops, r, RF_GT_GMU, at, value);
+}
+
+static inline int
+rf_gt_gmu_wr(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    uint32_t at, uint32_t value, bool running, bool data)
+{
+    uint32_t reset;
+    if (!running)
+        return EINVAL;
+    int error = rf_gt_source_live(ops, r, running);
+    if (error)
+        return error;
+    if (data) {
+        error = rf_gt_rd(ops, r, RF_GT_GMU, 0x14000, &reset);
+        if (error)
+            return error;
+        if (reset != 1)
+            return EAGAIN;
+    }
+    return rf_gt_wr(ops, r, RF_GT_GMU, at, value);
+}
+
+static inline int
+rf_gt_branch(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, bool halt_delay)
+{
+    uint32_t before;
+    int error = rf_gt_rd(ops, r, unit, at, &before);
+    if (error)
+        return error;
+    error = rf_gt_wr(ops, r, unit, at, before | 1u);
+    if (error)
+        return error;
+    /* Native GPUCC AHB completion is a delay, not a reliable HALT bit. */
+    if (halt_delay)
+        return rf_gt_delay(ops, 10);
+    return rf_gt_poll(ops, r, unit, at, 0x80000001u, 1, 200);
+}
+
+static inline int
+rf_gt_run(const struct rf_gt_ops *ops, uint32_t chip, struct rf_gt_report *output)
+{
+    struct rf_gt_report r = {0};
+    uint32_t value, gmu_gx, cfg, command, reset;
+    uint64_t time_before, time_after, expected_ticks;
+    static const uint32_t pattern[2] = {0x62a00d01u, 0xa062f00du};
+    unsigned i;
+    int error = EINVAL, pattern_error = 0;
+
+    if (!output)
+        return EINVAL;
+    if (chip != 0x06020001u || !ops || !ops->valid || !ops->read ||
+        !ops->write || !ops->delay || !ops->time_ns)
+        goto done;
+    r.stage = RF_GT_PREFLIGHT;
+#define RF_GT_TRY(action) do { error = (action); if (error) goto done; } while (0)
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x71004, &value));
+    if ((value & 0x80000001u) != 1) { error = EAGAIN; goto done; }
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x106c, &r.cx));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1540, &r.cx_hw));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x100c, &r.gx));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1064, &gmu_gx));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1098, &r.gmu_clock_before));
+    if ((r.cx & 3u) || !(r.cx_hw & 0x80000000u) ||
+        (r.gx & 0x80000001u) != 1 ||
+        (gmu_gx & 0x80000001u) != 0x80000000u ||
+        (r.gmu_clock_before & 0x80000001u) != 0x80000000u) {
+        error = EBUSY; goto done;
+    }
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0, &r.pll_mode));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 4, &r.pll_l));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0xc, &r.pll_user));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x40, &r.pll_alpha));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x71028, &r.misc));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x52010, &r.pll_vote_before));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x52000, &r.feed_before));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1120, &r.rcg_before));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1124, &r.source_before));
+    if (!rf_gt_pll_identity(r.pll_mode, r.pll_l, r.pll_user, r.pll_alpha) ||
+        (r.rcg_before & 0xf1u)) {
+        error = EAGAIN; goto done;
+    }
+
+    r.stage = RF_GT_BUS_CLOCKS;
+    /* Native gcc_lito_probe disables the GPU GPLL0 active inputs before
+     * preparing its feeds. No shared PLL rate/output register is changed. */
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GCC, 0x71028, 3, 3));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GCC, 0x52010, 1, 1));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GCC, 0x52000, 0x10000, 0x10000));
+    RF_GT_TRY(rf_gt_delay(ops, 10)); /* Divided feed uses BRANCH_HALT_DELAY. */
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GCC, 0x71154, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GCC, 0x7100c, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GCC, 0x71018, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x109c, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x1078, true));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x5000, false));
+
+    r.stage = RF_GT_SOURCE;
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1120, 2, 2));
+    RF_GT_TRY(rf_gt_poll(ops, &r, RF_GT_GPUCC, 0x1120, 0x80000000u, 0, 500));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1124, 0x10371f, 0x602));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1120, &command));
+    RF_GT_TRY(rf_gt_wr(ops, &r, RF_GT_GPUCC, 0x1120, command | 1));
+    RF_GT_TRY(rf_gt_poll(ops, &r, RF_GT_GPUCC, 0x1120, 1, 0, 500));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1120, 2, r.rcg_before & 2u));
+
+    r.stage = RF_GT_CORE_CLOCK;
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1098, 0xff0, 0xff0));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x1098, false));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1124, &r.source_after));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1098, &r.gmu_clock_after));
+    RF_GT_TRY(rf_gt_source_live(ops, &r, true));
+    r.source_200m = true;
+
+    /* Native Lito enables the GMU clock before its CSR aperture answers.
+     * Inspect inherited state only after that proof; never release reset. */
+    r.stage = RF_GT_RESET;
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14000, &r.reset_before, true, false));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14070, &r.result_before, true, false));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14600, &r.hfi_before, true, false));
+    if (r.reset_before > 1 || r.result_before != 0 || r.hfi_before != 0) {
+        error = EBUSY; goto done;
+    }
+    RF_GT_TRY(rf_gt_gmu_wr(ops, &r, 0x14000, 1, true, false));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14000, &r.reset_after, true, false));
+    if (r.reset_after != 1) { error = EIO; goto done; }
+    r.reset_held = true;
+
+    r.stage = RF_GT_COUNTER;
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14220, &r.counter_before, true, true));
+    time_before = ops->time_ns(ops->context);
+    RF_GT_TRY(rf_gt_delay(ops, 1000));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14220, &r.counter_after, true, true));
+    time_after = ops->time_ns(ops->context);
+    r.counter_delta = r.counter_after - r.counter_before;
+    if (time_after <= time_before || time_after - time_before < 1000000 ||
+        time_after - time_before > 10000000) {
+        error = ETIMEDOUT; goto done;
+    }
+    r.counter_elapsed_ns = time_after - time_before;
+    expected_ticks = r.counter_elapsed_ns * 192u / 10000u;
+    if ((uint64_t)r.counter_delta * 5 < expected_ticks * 4 ||
+        (uint64_t)r.counter_delta * 5 > expected_ticks * 6) {
+        error = ETIMEDOUT; goto done;
+    }
+    r.counter_live = true;
+
+    r.stage = RF_GT_SAVE;
+    for (i = 0; i < 2; i++)
+        RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x7000 + 4*i, &r.saved[i], true, true));
+    r.stage = RF_GT_PATTERN;
+    for (i = 0; i < 2; i++) {
+        r.dtcm_dirty = true; /* A failed write may have partially completed. */
+        RF_GT_TRY(rf_gt_gmu_wr(ops, &r, 0x7000 + 4*i, pattern[i], true, true));
+    }
+    for (i = 0; i < 2; i++) {
+        RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x7000 + 4*i, &r.pattern_read[i], true, true));
+        if (r.pattern_read[i] != pattern[i])
+            pattern_error = EIO;
+    }
+    r.stage = RF_GT_RESTORE;
+    for (i = 0; i < 2; i++)
+        RF_GT_TRY(rf_gt_gmu_wr(ops, &r, 0x7000 + 4*i, r.saved[i], true, true));
+    for (i = 0; i < 2; i++) {
+        RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x7000 + 4*i, &r.restored[i], true, true));
+        if (r.restored[i] != r.saved[i]) { error = EIO; goto done; }
+    }
+    r.dtcm_dirty = false;
+    r.dtcm_restored = true;
+    if (pattern_error) { error = pattern_error; goto done; }
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14000, &reset, true, false));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1124, &cfg));
+    if (reset != 1 || (cfg & 0x10371fu) != 0x602) { error = EAGAIN; goto done; }
+    r.stage = RF_GT_DONE;
+    error = 0;
+done:
+#undef RF_GT_TRY
+    r.error = (uint32_t)error;
+    *output = r;
+    return error;
+}
+
+#endif /* REDFIN_GMU_TCM_H */
diff --git a/bsd/dev/redfin_gpu_smmu.h b/bsd/dev/redfin_gpu_smmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gpu_smmu.h
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * A620 GPU-SMMUv2 read-only global snapshot. Native Google msm and preferred
+ * HackiOS references are pinned in ../GPU-SMMU.md. No context-bank registers,
+ * TCU/TBU registers, fault acknowledgements, TLB operations or writes exist
+ * in this interface. A stable snapshot is not an ownership grant.
+ */
+#ifndef REDFIN_GPU_SMMU_H
+#define REDFIN_GPU_SMMU_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/errno.h>
+
+#define RF_GS_CHIP 0x06020001u
+#define RF_GS_PHYS 0x03da0000u
+#define RF_GS_BYTES 0x10000u
+#define RF_GS_MAX_STREAMS 128u
+#define RF_GS_MAX_CONTEXTS 8u
+
+struct rf_gs_ops {
+    void *context;
+    /* Held CX/clocks, reset-held GMU/GX, exact mode and IRQ/return lifetime. */
+    bool (*valid)(void *);
+    /* Ordered, explicit scalar LDR; positive errno, no implicit mappings. */
+    int (*read)(void *, uint32_t, uint32_t *);
+};
+
+struct rf_gs_snapshot {
+    uint32_t stage, error, reads, changed_offset;
+    uint32_t id0, id1, id2, id7, control, fault, syndrome[3];
+    uint32_t page_bytes, global_bytes, streams, contexts, stage2_contexts;
+    uint32_t sid_bits, input_bits, output_bits, virtual_bits;
+    uint32_t smr[RF_GS_MAX_STREAMS], s2cr[RF_GS_MAX_STREAMS];
+    uint32_t cbar[RF_GS_MAX_CONTEXTS], cba2r[RF_GS_MAX_CONTEXTS];
+    uint32_t references[RF_GS_MAX_CONTEXTS], active_references[RF_GS_MAX_CONTEXTS];
+    uint32_t gmu_matches[2], gmu_slot[2], unreferenced_mask;
+    uint32_t malformed_routes;
+    bool stable, map_format_supported;
+};
+
+static inline uint32_t
+rf_gs_address_bits(uint32_t code)
+{
+    static const uint32_t bits[] = {32, 36, 40, 42, 44, 48};
+    return code < sizeof(bits) / sizeof(bits[0]) ? bits[code] : 0;
+}
+
+static inline bool
+rf_gs_read_allowed(uint32_t at, const struct rf_gs_snapshot *s)
+{
+    switch (at) {
+    case 0: case 0x20: case 0x24: case 0x28: case 0x3c:
+    case 0x48: case 0x50: case 0x54: case 0x58:
+        return true;
+    default: break;
+    }
+    if (!s || (at & 3) || s->streams > RF_GS_MAX_STREAMS ||
+        s->contexts > RF_GS_MAX_CONTEXTS || s->page_bytes != 0x1000 ||
+        s->global_bytes != 0x8000)
+        return false;
+    if ((at >= 0x800 && at - 0x800 < s->streams * 4) ||
+        (at >= 0xc00 && at - 0xc00 < s->streams * 4))
+        return true;
+    /* GR1 metadata only; the first context's own page starts at +0x8000. */
+    return (at >= 0x1000 && at - 0x1000 < s->contexts * 4) ||
+        (at >= 0x1800 && at - 0x1800 < s->contexts * 4);
+}
+
+static inline int
+rf_gs_read(const struct rf_gs_ops *ops, struct rf_gs_snapshot *s,
+    uint32_t at, uint32_t *value)
+{
+    if (!rf_gs_read_allowed(at, s))
+        return EINVAL;
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    s->reads++;
+    return ops->read(ops->context, at, value);
+}
+
+static inline bool
+rf_gs_stream_matches(uint32_t smr, uint32_t stream)
+{
+    uint32_t mask = (smr >> 16) & 0x7fffu;
+    return (smr & 0x80000000u) && !((stream ^ (smr & 0x7fffu)) & ~mask & 0x7fffu);
+}
+
+static inline int
+rf_gs_compare(const struct rf_gs_ops *ops, struct rf_gs_snapshot *s,
+    uint32_t at, uint32_t previous)
+{
+    uint32_t now;
+    int error = rf_gs_read(ops, s, at, &now);
+    if (error)
+        return error;
+    if (now != previous) {
+        s->changed_offset = at;
+        return EAGAIN;
+    }
+    return 0;
+}
+
+static inline int
+rf_gs_snapshot_run(const struct rf_gs_ops *ops, uint32_t chip,
+    struct rf_gs_snapshot *s)
+{
+    unsigned i, which;
+    uint32_t reference_mask = 0;
+    int error = EINVAL;
+    if (!s)
+        return EINVAL;
+    *s = (struct rf_gs_snapshot){0};
+    if (chip != RF_GS_CHIP || !ops || !ops->valid || !ops->read)
+        goto done;
+#define RF_GS_TRY(action) do { error = (action); if (error) goto done; } while (0)
+    s->stage = 1;
+    RF_GS_TRY(rf_gs_read(ops, s, 0x20, &s->id0));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x24, &s->id1));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x28, &s->id2));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x3c, &s->id7));
+    s->page_bytes = (s->id1 & 0x80000000u) ? 0x10000u : 0x1000u;
+    s->global_bytes = s->page_bytes << (((s->id1 >> 28) & 7u) + 1);
+    s->streams = s->id0 & 0xffu;
+    s->contexts = s->id1 & 0xffu;
+    s->stage2_contexts = (s->id1 >> 16) & 0xffu;
+    s->sid_bits = (s->id0 >> 9) & 15u;
+    s->input_bits = rf_gs_address_bits(s->id2 & 15u);
+    s->output_bits = rf_gs_address_bits((s->id2 >> 4) & 15u);
+    s->virtual_bits = rf_gs_address_bits((s->id2 >> 8) & 15u);
+    if (!(s->id0 & (1u << 30)) || !(s->id0 & (1u << 27)) || (s->id0 & (1u << 8)) ||
+        s->page_bytes != 0x1000 || s->global_bytes != RF_GS_BYTES / 2 ||
+        !s->streams || s->streams > RF_GS_MAX_STREAMS ||
+        !s->contexts || s->contexts > RF_GS_MAX_CONTEXTS ||
+        s->stage2_contexts > s->contexts || !s->sid_bits)
+    { error = ENOTSUP; goto done; }
+    s->stage = 2;
+    RF_GS_TRY(rf_gs_read(ops, s, 0, &s->control));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x48, &s->fault));
+    for (i = 0; i < 3; i++)
+        RF_GS_TRY(rf_gs_read(ops, s, 0x50 + 4*i, &s->syndrome[i]));
+    for (i = 0; i < s->streams; i++) {
+        RF_GS_TRY(rf_gs_read(ops, s, 0x800 + 4*i, &s->smr[i]));
+        /* Include latent invalid-SMR references; none can imply a free bank. */
+        RF_GS_TRY(rf_gs_read(ops, s, 0xc00 + 4*i, &s->s2cr[i]));
+    }
+    for (i = 0; i < s->contexts; i++) {
+        RF_GS_TRY(rf_gs_read(ops, s, 0x1000 + 4*i, &s->cbar[i]));
+        RF_GS_TRY(rf_gs_read(ops, s, 0x1800 + 4*i, &s->cba2r[i]));
+    }
+    s->stage = 3;
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x20, s->id0));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x24, s->id1));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x28, s->id2));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x3c, s->id7));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0, s->control));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x48, s->fault));
+    for (i = 0; i < 3; i++)
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x50 + 4*i, s->syndrome[i]));
+    for (i = 0; i < s->streams; i++) {
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x800 + 4*i, s->smr[i]));
+        RF_GS_TRY(rf_gs_compare(ops, s, 0xc00 + 4*i, s->s2cr[i]));
+    }
+    for (i = 0; i < s->contexts; i++) {
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x1000 + 4*i, s->cbar[i]));
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x1800 + 4*i, s->cba2r[i]));
+    }
+    s->gmu_slot[0] = s->gmu_slot[1] = UINT32_MAX;
+    for (i = 0; i < s->streams; i++) {
+        uint32_t type = (s->s2cr[i] >> 16) & 3u, bank = s->s2cr[i] & 0xffu;
+        if (type == 3 || (s->smr[i] & 0x8000u) || (type == 0 && bank >= s->contexts))
+            s->malformed_routes++;
+        if (type == 0 && bank < s->contexts) {
+            s->references[bank]++;
+            reference_mask |= 1u << bank;
+            if (s->smr[i] & 0x80000000u)
+                s->active_references[bank]++;
+        }
+        for (which = 0; which < 2; which++) {
+            if (!rf_gs_stream_matches(s->smr[i], 4u + which))
+                continue;
+            s->gmu_matches[which]++;
+            s->gmu_slot[which] = i;
+        }
+    }
+    for (which = 0; which < 2; which++)
+        if (s->gmu_matches[which] != 1)
+            s->gmu_slot[which] = UINT32_MAX;
+    s->unreferenced_mask = ((1u << s->contexts) - 1u) & ~reference_mask;
+    s->map_format_supported = (s->id2 & (1u << 12)) && s->output_bits >= 36 &&
+        s->virtual_bits >= 39 && s->sid_bits >= 11 && !s->malformed_routes;
+    if (!ops->valid(ops->context)) { error = ECANCELED; goto done; }
+    s->stable = true;
+    s->stage = 4;
+    error = 0;
+done:
+#undef RF_GS_TRY
+    if (error)
+        s->map_format_supported = false;
+    s->error = (uint32_t)error;
+    return error;
+}
+
+#endif /* REDFIN_GPU_SMMU_H */
diff --git a/bsd/dev/redfin_gpu_context.h b/bsd/dev/redfin_gpu_context.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gpu_context.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Read-only context 0/1 observation after a fresh GPU-SMMU global snapshot.
+ * No context ownership, table dereference, store, fault ack or TLB operation.
+ * Native Lito protects CB5 and above; only these two low banks are addressed.
+ */
+#ifndef REDFIN_GPU_CONTEXT_H
+#define REDFIN_GPU_CONTEXT_H
+
+#include "redfin_gpu_smmu.h"
+
+#define RF_GC_BANKS 2u
+#define RF_GC_WORDS 12u
+#define RF_GC_MAP_BYTES 0x4000u /* XNU's mapping granule; access only CB0/1. */
+#define RF_GC_FAULT_BITS 0xc00001feu /* FSR.FORMAT[10:9] is status, not a fault. */
+
+static const uint32_t rf_gc_offsets[RF_GC_WORDS] = {
+    0, 0x10, 0x20, 0x24, 0x30, 0x34, 0x38, 0x3c, 0x58, 0x60, 0x64, 0x68
+};
+
+struct rf_gc_ops {
+    void *context;
+    bool (*valid)(void *);
+    int (*read)(void *, unsigned bank, uint32_t offset, uint32_t *);
+};
+
+struct rf_gc_snapshot {
+    uint32_t stage, reads, changed_bank, changed_offset, disabled_mask, fault_mask;
+    uint32_t words[RF_GC_BANKS][RF_GC_WORDS];
+    int error;
+    bool stable;
+};
+
+static inline bool
+rf_gc_allowed(unsigned bank, uint32_t at)
+{
+    if (bank >= RF_GC_BANKS)
+        return false;
+    for (unsigned i = 0; i < RF_GC_WORDS; i++)
+        if (at == rf_gc_offsets[i])
+            return true;
+    return false;
+}
+
+static inline int
+rf_gc_snapshot_run(const struct rf_gc_ops *ops, const struct rf_gs_snapshot *global,
+    struct rf_gc_snapshot *out)
+{
+    int error = EINVAL;
+    if (!out)
+        return error;
+    *out = (struct rf_gc_snapshot){0};
+    if (!ops || !ops->valid || !ops->read || !global)
+        goto done;
+    if (!global->stable || global->error || global->stage != 4 ||
+        !global->map_format_supported || global->page_bytes != 0x1000 ||
+        global->global_bytes != 0x8000 || global->contexts < RF_GC_BANKS ||
+        global->contexts > RF_GS_MAX_CONTEXTS || global->stage2_contexts)
+    { error = ENOTSUP; goto done; }
+    for (unsigned pass = 0; pass < 2; pass++) {
+        out->stage = pass + 1;
+        for (unsigned bank = 0; bank < RF_GC_BANKS; bank++) {
+            for (unsigned i = 0; i < RF_GC_WORDS; i++) {
+                uint32_t value;
+                if (!ops->valid(ops->context))
+                { error = ECANCELED; goto done; }
+                out->reads++;
+                error = ops->read(ops->context, bank, rf_gc_offsets[i], &value);
+                if (error)
+                    goto done;
+                if (!pass) {
+                    out->words[bank][i] = value;
+                } else if (out->words[bank][i] != value) {
+                    out->changed_bank = bank;
+                    out->changed_offset = rf_gc_offsets[i];
+                    error = EAGAIN;
+                    goto done;
+                }
+            }
+        }
+    }
+    if (!ops->valid(ops->context))
+    { error = ECANCELED; goto done; }
+    for (unsigned bank = 0; bank < RF_GC_BANKS; bank++) {
+        if (!(out->words[bank][0] & 1))
+            out->disabled_mask |= 1u << bank;
+        if (out->words[bank][8] & RF_GC_FAULT_BITS)
+            out->fault_mask |= 1u << bank;
+    }
+    out->stage = 3;
+    out->stable = true;
+    error = 0;
+done:
+    out->error = error;
+    return error;
+}
+
+#endif /* REDFIN_GPU_CONTEXT_H */
diff --git a/bsd/dev/redfin_gmu_mapping.h b/bsd/dev/redfin_gmu_mapping.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_mapping.h
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: MIT */
+/* Native A620 GMU kernel-stream context, while CM3/GX remain reset-held.
+ * Sources: preferred redwood_adreno.c space_on(); native arm-smmu.c and
+ * io-pgtable-arm.c at the pins in GPU-SMMU.md. No global reset/fault ack,
+ * foreign route update, context release or firmware execution is provided.
+ */
+#ifndef REDFIN_GMU_MAPPING_H
+#define REDFIN_GMU_MAPPING_H
+#include <string.h>
+#include "redfin_gpu_context.h"
+#include "redfin_gmu_pagetables.h"
+
+#define RF_GMM_BANK 1u
+#define RF_GMM_STEPS 16u
+#define RF_GMM_TCR 0x00802019u /* 39-bit/4KiB, NC walks, outer-shareable, EPD1. */
+#define RF_GMM_TCR2 0x00038011u /* 36-bit PA, ASID16, upstream SEP. */
+#define RF_GMM_SCTLR 0x1027u /* M/TRE/AFE/CFRE/ASIDPNE; no stall or IRQ. */
+#define RF_GMM_ID0_ATOSNS (1u << 26) /* Native ID0_ATOSNS: ATS1* not supported. */
+
+static inline bool rf_gmm_atos_supported(const struct rf_gs_snapshot *snapshot)
+{
+    return rf_gm_snapshot_format(snapshot) && !(snapshot->id0 & RF_GMM_ID0_ATOSNS);
+}
+
+struct rf_gmm_ops {
+    void *context;
+    int (*check)(void *);
+    int (*sample)(void *, struct rf_gs_snapshot *, struct rf_gc_snapshot *);
+    int (*read)(void *, unsigned block, uint32_t, uint32_t *);
+    int (*write)(void *, unsigned block, uint32_t, uint32_t);
+    int (*publish)(void *, const struct rf_gm_pt_plan *);
+    int (*delay)(void *, unsigned);
+};
+
+struct rf_gmm_lease {
+    unsigned attempted, owned, active, poisoned, slot, stores, polls;
+    unsigned ttbr1_valid;
+    unsigned step, block;
+    uint32_t offset, requested, observed;
+    struct rf_gs_snapshot expected, fresh;
+    struct rf_gc_snapshot banks, fresh_banks;
+};
+
+static inline bool rf_gmm_equal(const struct rf_gmm_lease *s)
+{
+    const struct rf_gs_snapshot *a = &s->expected, *b = &s->fresh;
+    return b->stable && b->stage == 4 && !b->error &&
+        a->id0 == b->id0 && a->id1 == b->id1 && a->id2 == b->id2 && a->id7 == b->id7 &&
+        a->control == b->control && a->fault == b->fault &&
+        !memcmp(a->syndrome, b->syndrome, sizeof(a->syndrome)) &&
+        !memcmp(a->smr, b->smr, sizeof(a->smr)) && !memcmp(a->s2cr, b->s2cr, sizeof(a->s2cr)) &&
+        !memcmp(a->cbar, b->cbar, sizeof(a->cbar)) && !memcmp(a->cba2r, b->cba2r, sizeof(a->cba2r)) &&
+        s->fresh_banks.stable && s->fresh_banks.stage == 3 && !s->fresh_banks.error &&
+        !memcmp(s->banks.words, s->fresh_banks.words, sizeof(s->banks.words));
+}
+
+static inline int rf_gmm_verify(struct rf_gmm_lease *s, const struct rf_gmm_ops *o)
+{
+    if (!s || !o || !o->check || !o->sample || !o->read || !o->write ||
+        !o->publish || !o->delay || s->poisoned) return EINVAL;
+    int error = o->check(o->context);
+    if (!error) error = o->sample(o->context, &s->fresh, &s->fresh_banks);
+    if (!error && !rf_gmm_equal(s)) error = EAGAIN;
+    for (unsigned i = 0; !error && i < 2; ++i) if (s->ttbr1_valid & (1u << i)) {
+        uint32_t value;
+        error = o->read(o->context, 1, 0x28 + 4u*i, &value);
+        if (!error && value) error = EAGAIN;
+    }
+    if (!error) error = o->check(o->context);
+    if (error) { s->poisoned = 1; s->active = 0; }
+    return error;
+}
+
+static inline int rf_gmm_step(const struct rf_gmm_lease *s, const struct rf_gm_pt_plan *p,
+    unsigned step, unsigned *block, uint32_t *at, uint32_t *value)
+{
+    if (!s || !s->owned || !p || step >= RF_GMM_STEPS || !block || !at || !value) return EINVAL;
+    *block = 1; *at = 0; *value = 0;
+    switch (step) {
+    case 0: break;
+    case 1: *block = 0; *at = 0x1804; *value = 1; break;
+    case 2: *block = 0; *at = 0x1004; *value = 0x1f300; break;
+    case 3: *at = 0x10; *value = RF_GMM_TCR2; break;
+    case 4: *at = 0x30; *value = RF_GMM_TCR; break;
+    case 5: *at = 0x20; *value = (uint32_t)p->root_physical; break;
+    case 6: *at = 0x24; *value = (uint32_t)(p->root_physical >> 32) | 0x10000; break;
+    case 7: *at = 0x28; break;
+    case 8: *at = 0x2c; break;
+    /* Native CONTEXTIDR is used only by AArch32 short descriptors. */
+    case 9: *at = 0x38; *value = p->mair0; break;
+    case 10: *at = 0x3c; break;
+    case 11: *at = 0x610; *value = RF_GMM_BANK; break;
+    case 12: *at = 0x7f0; *value = 1; break;
+    case 13: *value = RF_GMM_SCTLR; break;
+    case 14: *block = 0; *at = 0xc00 + 4u*s->slot; *value = RF_GMM_BANK; break;
+    default: *block = 0; *at = 0x800 + 4u*s->slot; *value = 0x84000005; break;
+    }
+    return 0;
+}
+
+static inline int rf_gmm_claim(struct rf_gmm_lease *s, const struct rf_gmm_ops *o,
+    const struct rf_gs_snapshot *initial, const struct rf_gc_snapshot *banks,
+    const struct rf_gm_pt_plan *plan, const struct rf_gm_memory_owner *owner)
+{
+    int error = EINVAL;
+    if (!s || !o || !o->check || !o->sample || !o->read || !o->write || !o->publish ||
+        !o->delay || !initial || !banks || !plan || !owner || !owner->valid || !owner->owns) return error;
+    if (s->attempted) return EBUSY;
+    s->attempted = 1;
+    if (!rf_gm_snapshot_format(initial) || initial->id0 != 0x4c017e05u ||
+        initial->id1 != 0x20000005u || initial->id2 != 0x5511u || initial->id7 != 0x24u ||
+        initial->fault || (initial->control & 9u) || initial->gmu_matches[0] || initial->gmu_matches[1] ||
+        initial->references[RF_GMM_BANK] || initial->cbar[RF_GMM_BANK] || initial->cba2r[RF_GMM_BANK] ||
+        !banks->stable || banks->stage != 3 || banks->error || banks->fault_mask ||
+        banks->disabled_mask != 3 || plan->granule != 0x1000 || plan->virtual_bits != 39 ||
+        plan->physical_bits != 36 || plan->mair0 != 0xf404ff44u ||
+        !rf_gm_memory_valid(&plan->tables) || plan->root_physical != plan->tables.physical ||
+        !plan->table_count || plan->table_count > RF_GM_PT_MAX_TABLES ||
+        plan->table_bytes != (uint64_t)plan->table_count * 4096 || plan->table_bytes > plan->tables.owned_bytes ||
+        !plan->extent_count || plan->extent_count > RF_GM_PT_MAX_EXTENTS) { error = EPERM; goto failed; }
+    s->slot = initial->streams;
+    for (unsigned i = 0; i < initial->streams; ++i)
+        if (!(initial->smr[i] & 0x80000000u)) { s->slot = i; break; }
+    if (s->slot == initial->streams) { error = ENOSPC; goto failed; }
+    if (!owner->valid(owner->context) || !owner->owns(owner->context, &plan->tables, RF_GM_PT_TABLE_POOL))
+        { error = EACCES; goto failed; }
+    for (unsigned i = 0; i < plan->extent_count; ++i)
+        if (!owner->valid(owner->context) || !owner->owns(owner->context, &plan->extents[i].memory, RF_GM_PT_DATA))
+            { error = EACCES; goto failed; }
+    s->expected = *initial; s->banks = *banks;
+    error = rf_gmm_verify(s, o); if (error) goto failed;
+    error = o->publish(o->context, plan); if (error) goto failed;
+    error = rf_gmm_verify(s, o); if (error) goto failed;
+    s->owned = 1;
+    for (unsigned step = 0; step < RF_GMM_STEPS; ++step) {
+        unsigned block; uint32_t at, value, got = 0;
+        error = rf_gmm_verify(s, o); if (error) goto failed;
+        error = rf_gmm_step(s, plan, step, &block, &at, &value); if (error) goto failed;
+        s->step = step; s->block = block; s->offset = at;
+        s->requested = value; s->observed = 0;
+        ++s->stores;
+        error = o->write(o->context, block, at, value); if (error) goto failed;
+        if (step == 11) continue; /* command register, no readable stored value */
+        if (step == 12) {
+            for (unsigned us = 0; us < 1000; ++us) {
+                error = o->check(o->context); if (error) goto failed;
+                ++s->polls; error = o->read(o->context, 1, 0x7f4, &got); if (error) goto failed;
+                s->observed = got;
+                if (!(got & 1)) break;
+                error = o->delay(o->context, 1); if (error) goto failed;
+            }
+            if (got & 1) { error = ETIMEDOUT; goto failed; }
+            continue;
+        }
+        error = o->check(o->context); if (error) goto failed;
+        error = o->read(o->context, block, at, &got); if (error) goto failed;
+        s->observed = got;
+        /* Native active fields only: TCR2 PASIZE/AS/SEP; TCR T0SZ,
+         * EPD0/IRGN0/ORGN0/SH0/TG0, A1 and EPD1; SCTLR M/E/CFRE/CFIE/
+         * CFCFG/HUPCF/MTCFG. AFE/TRE are AArch32 controls; ASIDPNE reads
+         * as zero on this SMMU. ASID16 and TTBR's ASID are checked separately.
+         * Keep every
+         * observed bit afterwards, including reserved and dormant fields,
+         * so a later unexplained change still revokes the lease. */
+        uint32_t mask = step == 2 ? 0x30000u : step == 3 ? 0x38017u :
+            step == 4 ? 0x00c0ffbfu : step == 13 ? 0x001001f1u :
+            step == 14 ? 0x030300ffu : UINT32_MAX;
+        if ((got & mask) != (value & mask)) { error = EIO; goto failed; }
+        if (step == 7 || step == 8) s->ttbr1_valid |= 1u << (step - 7);
+        if (!block) {
+            if (step == 1) {
+                s->expected.cba2r[1] = value;
+                s->banks.words[1][8] = (s->banks.words[1][8] & ~0x600u) | 0x400u;
+            } else if (step == 2) s->expected.cbar[1] = got;
+            else if (step == 14) s->expected.s2cr[s->slot] = got;
+            else s->expected.smr[s->slot] = value;
+        } else for (unsigned i = 0; i < RF_GC_WORDS; ++i)
+            if (rf_gc_offsets[i] == at) s->banks.words[1][i] = got;
+    }
+    error = rf_gmm_verify(s, o); if (error) goto failed;
+    s->active = 1;
+    return 0;
+failed:
+    s->poisoned = 1; s->active = 0;
+    return error;
+}
+#endif
diff --git a/bsd/dev/redfin_gmu_pagetables.h b/bsd/dev/redfin_gmu_pagetables.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_pagetables.h
@@ -0,0 +1,291 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * CPU-only A620 GMU 4KiB/LPAE table construction. No SMMU, route, TTBR, TLB,
+ * cache-publication or firmware-start operation is provided. Every memory
+ * object must already be exclusively allocated and unreachable by DMA.
+ * The ownership callbacks prove the host/physical pair and complete lifetime;
+ * a routing snapshot alone cannot do so. References: ../GPU-SMMU.md.
+ */
+#ifndef REDFIN_GMU_PAGETABLES_H
+#define REDFIN_GMU_PAGETABLES_H
+
+#include "redfin_gmu_firmware.h"
+#include "redfin_gpu_smmu.h"
+
+#define RF_GM_PT_MAX_TABLES 40u
+#define RF_GM_PT_MAX_EXTENTS (REDFIN_GMU_MAX_REGIONS - 2u)
+#define RF_GM_PT_RAM_BASE UINT64_C(0x180000000)
+#define RF_GM_PT_RAM_BYTES UINT64_C(0x80000000)
+
+struct rf_gm_memory {
+    void *host;
+    uint64_t physical, owned_bytes, token;
+    uint32_t gmu_address;
+};
+
+enum { RF_GM_PT_DATA = 1, RF_GM_PT_TABLE_POOL = 2 };
+struct rf_gm_memory_owner {
+    void *context;
+    bool (*valid)(void *);
+    bool (*owns)(void *, const struct rf_gm_memory *, unsigned);
+};
+
+struct rf_gm_pt_node {
+    uint32_t level, prefix, parent, slot;
+};
+
+struct rf_gm_pt_extent {
+    struct rf_gm_memory memory;
+    uint32_t mapped_bytes, permissions;
+};
+
+struct rf_gm_pt_plan {
+    uint32_t table_count, extent_count, mapped_pages, mapped_bytes;
+    uint32_t granule, virtual_bits, physical_bits, mair0;
+    uint64_t root_physical, table_bytes;
+    struct rf_gm_memory tables;
+    struct rf_gm_pt_node nodes[RF_GM_PT_MAX_TABLES];
+    struct rf_gm_pt_extent extents[RF_GM_PT_MAX_EXTENTS];
+};
+
+static inline bool
+rf_gm_memory_valid(const struct rf_gm_memory *memory)
+{
+    if (!memory)
+        return false;
+    uint64_t host = (uint64_t)(uintptr_t)memory->host;
+    return host && memory->token && !(memory->physical & 0xfffu) &&
+        memory->owned_bytes && !(memory->owned_bytes & 0xfffu) &&
+        memory->owned_bytes <= 0x200000u &&
+        memory->physical >= RF_GM_PT_RAM_BASE &&
+        memory->physical - RF_GM_PT_RAM_BASE < RF_GM_PT_RAM_BYTES &&
+        memory->owned_bytes <= RF_GM_PT_RAM_BYTES -
+            (memory->physical - RF_GM_PT_RAM_BASE) &&
+        memory->owned_bytes <= UINTPTR_MAX &&
+        host <= UINTPTR_MAX - memory->owned_bytes;
+}
+
+static inline bool
+rf_gm_overlaps(uint64_t first, uint64_t first_bytes,
+    uint64_t second, uint64_t second_bytes)
+{
+    if (!first_bytes || !second_bytes)
+        return false;
+    return first <= second ? second - first < first_bytes : first - second < second_bytes;
+}
+
+static inline bool
+rf_gm_host_alias(const struct rf_gm_memory *memory, const void *p, size_t bytes)
+{
+    return rf_gm_overlaps((uint64_t)(uintptr_t)memory->host, memory->owned_bytes,
+        (uint64_t)(uintptr_t)p, bytes);
+}
+
+static inline bool
+rf_gm_memory_alias(const struct rf_gm_memory *a, const struct rf_gm_memory *b)
+{
+    return a->token == b->token ||
+        rf_gm_overlaps(a->physical, a->owned_bytes, b->physical, b->owned_bytes) ||
+        rf_gm_overlaps((uint64_t)(uintptr_t)a->host, a->owned_bytes,
+            (uint64_t)(uintptr_t)b->host, b->owned_bytes);
+}
+
+static inline bool
+rf_gm_snapshot_format(const struct rf_gs_snapshot *s)
+{
+    return s && s->stable && s->error == 0 && s->stage == 4 && s->map_format_supported &&
+        s->page_bytes == 0x1000 && s->global_bytes == 0x8000 &&
+        s->streams && s->streams <= RF_GS_MAX_STREAMS &&
+        s->contexts && s->contexts <= RF_GS_MAX_CONTEXTS &&
+        s->streams == (s->id0 & 255u) && s->contexts == (s->id1 & 255u) &&
+        (s->id1 & 0xf0000000u) == 0x20000000u &&
+        s->stage2_contexts == ((s->id1 >> 16) & 255u) &&
+        s->stage2_contexts <= s->contexts &&
+        s->sid_bits == ((s->id0 >> 9) & 15u) &&
+        s->input_bits == rf_gs_address_bits(s->id2 & 15u) && s->input_bits &&
+        s->output_bits == rf_gs_address_bits((s->id2 >> 4) & 15u) &&
+        s->virtual_bits == rf_gs_address_bits((s->id2 >> 8) & 15u) &&
+        (s->id0 & (1u << 30)) && (s->id0 & (1u << 27)) && !(s->id0 & (1u << 8)) &&
+        (s->id2 & (1u << 12)) && rf_gs_address_bits((s->id2 >> 4) & 15u) >= 36 &&
+        rf_gs_address_bits((s->id2 >> 8) & 15u) >= 39 &&
+        ((s->id0 >> 9) & 15u) >= 11 && !s->malformed_routes;
+}
+
+static inline int
+rf_gm_pt_node_index(struct rf_gm_pt_plan *plan, uint32_t level,
+    uint32_t prefix, uint32_t parent, uint32_t slot, uint32_t *index)
+{
+    uint32_t i;
+    for (i = 0; i < plan->table_count; i++) {
+        if (plan->nodes[i].level == level && plan->nodes[i].prefix == prefix) {
+            if (plan->nodes[i].parent != parent || plan->nodes[i].slot != slot)
+                return EINVAL;
+            *index = i;
+            return 0;
+        }
+    }
+    if (plan->table_count == RF_GM_PT_MAX_TABLES)
+        return ENOSPC;
+    plan->nodes[i].level = level;
+    plan->nodes[i].prefix = prefix;
+    plan->nodes[i].parent = parent;
+    plan->nodes[i].slot = slot;
+    plan->table_count++;
+    *index = i;
+    return 0;
+}
+
+static inline void
+rf_gm_write_le64(uint8_t *destination, uint64_t value)
+{
+    for (unsigned i = 0; i < 8; i++)
+        destination[i] = (uint8_t)(value >> (8*i));
+}
+
+/*
+ * All malformed/denied inputs fail before touching the table pool. On a later
+ * lifetime revocation, stop writing immediately at the next bounded operation
+ * and leave output unchanged. The pool may then contain incomplete CPU-only
+ * tables: no success means no caller may publish/install them. The immutable
+ * firmware blob, memory metadata and callback state must not change during
+ * this call. Callback state must remain disjoint from the writable pool.
+ */
+static inline int
+rf_gm_pt_build(const struct rf_gs_snapshot *snapshot, uint32_t chip,
+    const void *image, size_t image_bytes, const struct rf_gm_memory *backing,
+    unsigned backing_count, const struct rf_gm_memory *table_pool,
+    const struct rf_gm_memory_owner *owner, struct rf_gm_pt_plan *output)
+{
+    struct redfin_gmu_fw_plan firmware;
+    struct rf_gm_pt_plan plan = {0};
+    struct rf_gm_memory pool;
+    uint64_t image_start = (uint64_t)(uintptr_t)image;
+    uint32_t i, j, l2, l3;
+    int error;
+    if (!output || !backing || !table_pool || !owner || !owner->valid || !owner->owns ||
+        backing_count > RF_GM_PT_MAX_EXTENTS || !image ||
+        image_bytes > UINTPTR_MAX || image_start > UINTPTR_MAX - image_bytes ||
+        (uintptr_t)output > UINTPTR_MAX - sizeof(*output))
+        return EINVAL;
+    if (!rf_gm_snapshot_format(snapshot))
+        return ENOTSUP;
+    error = redfin_gmu_fw_plan_make(chip, image, image_bytes, &firmware);
+    if (error)
+        return error;
+    if (backing_count != firmware.region_count - 2u)
+        return EINVAL;
+    pool = *table_pool;
+    if (pool.gmu_address != 0 || !rf_gm_memory_valid(&pool) ||
+        rf_gm_host_alias(&pool, image, image_bytes) ||
+        rf_gm_host_alias(&pool, snapshot, sizeof(*snapshot)) ||
+        rf_gm_host_alias(&pool, backing, backing_count * sizeof(*backing)) ||
+        rf_gm_host_alias(&pool, table_pool, sizeof(*table_pool)) ||
+        rf_gm_host_alias(&pool, owner, sizeof(*owner)) ||
+        rf_gm_host_alias(&pool, output, sizeof(*output)) ||
+        rf_gm_overlaps((uintptr_t)output, sizeof(*output), image_start, image_bytes) ||
+        rf_gm_overlaps((uintptr_t)output, sizeof(*output),
+            (uintptr_t)snapshot, sizeof(*snapshot)) ||
+        rf_gm_overlaps((uintptr_t)output, sizeof(*output),
+            (uintptr_t)backing, backing_count * sizeof(*backing)) ||
+        rf_gm_overlaps((uintptr_t)output, sizeof(*output),
+            (uintptr_t)table_pool, sizeof(*table_pool)) ||
+        rf_gm_overlaps((uintptr_t)output, sizeof(*output),
+            (uintptr_t)owner, sizeof(*owner)))
+        return EINVAL;
+    plan.extent_count = backing_count;
+    plan.granule = 0x1000;
+    plan.virtual_bits = 39;
+    plan.physical_bits = 36;
+    plan.mair0 = 0xf404ff44u;
+    plan.root_physical = pool.physical;
+    plan.tables = pool;
+    plan.table_count = 1;
+    plan.nodes[0].level = 1;
+    plan.nodes[0].parent = UINT32_MAX;
+
+    for (i = 0; i < backing_count; i++) {
+        const struct redfin_gmu_region *region = &firmware.regions[i + 2];
+        struct rf_gm_pt_extent *extent = &plan.extents[i];
+        for (j = 0; j < backing_count; j++)
+            if (backing[j].gmu_address == region->address)
+                break;
+        if (j == backing_count)
+            return EINVAL;
+        extent->memory = backing[j];
+        extent->mapped_bytes = region->mapped_bytes;
+        extent->permissions = region->permissions;
+        if (!rf_gm_memory_valid(&extent->memory) ||
+            extent->memory.owned_bytes < region->mapped_bytes ||
+            rf_gm_memory_alias(&pool, &extent->memory) ||
+            rf_gm_host_alias(&extent->memory, image, image_bytes) ||
+            rf_gm_host_alias(&extent->memory, output, sizeof(*output)))
+            return EINVAL;
+        for (j = 0; j < i; j++)
+            if (rf_gm_memory_alias(&plan.extents[j].memory, &extent->memory))
+                return EINVAL;
+        for (j = 0; j < region->mapped_bytes; j += 0x1000) {
+            uint32_t va = region->address + j;
+            error = rf_gm_pt_node_index(&plan, 2, va >> 30, 0, (va >> 30) & 511u, &l2);
+            if (error)
+                return error;
+            error = rf_gm_pt_node_index(&plan, 3, va >> 21, l2, (va >> 21) & 511u, &l3);
+            if (error)
+                return error;
+            plan.mapped_pages++;
+        }
+        plan.mapped_bytes += region->mapped_bytes;
+    }
+    plan.table_bytes = (uint64_t)plan.table_count * 0x1000;
+    if (plan.table_bytes > pool.owned_bytes)
+        return ENOSPC;
+    if (!owner->valid(owner->context))
+        return ECANCELED;
+    if (!owner->owns(owner->context, &pool, RF_GM_PT_TABLE_POOL))
+        return EACCES;
+    for (i = 0; i < plan.extent_count; i++) {
+        if (!owner->valid(owner->context))
+            return ECANCELED;
+        if (!owner->owns(owner->context, &plan.extents[i].memory, RF_GM_PT_DATA))
+            return EACCES;
+    }
+    /* All metadata is copied; revalidate the lifetime before the first write. */
+    if (!owner->valid(owner->context))
+        return ECANCELED;
+    for (i = 0; i < plan.table_count; i++) {
+        if (!owner->valid(owner->context))
+            return ECANCELED;
+        uint8_t *table = (uint8_t *)pool.host + i * 0x1000;
+        for (j = 0; j < 0x1000; j++)
+            table[j] = 0;
+    }
+    for (i = 1; i < plan.table_count; i++) {
+        const struct rf_gm_pt_node *node = &plan.nodes[i];
+        uint64_t descriptor = (pool.physical + (uint64_t)i * 0x1000) | 3u;
+        if (!owner->valid(owner->context))
+            return ECANCELED;
+        rf_gm_write_le64((uint8_t *)pool.host + node->parent * 0x1000 + node->slot * 8, descriptor);
+    }
+    for (i = 0; i < plan.extent_count; i++) {
+        const struct rf_gm_pt_extent *extent = &plan.extents[i];
+        for (j = 0; j < extent->mapped_bytes; j += 0x1000) {
+            uint32_t va = extent->memory.gmu_address + j;
+            uint64_t descriptor = extent->memory.physical + j;
+            /* Native RW/no-CACHE map: normal-NC, outer-shareable, AF, nG. */
+            descriptor |= (extent->permissions & REDFIN_GMU_PRIV) ? 0xe03u : 0xe43u;
+            for (l3 = 0; l3 < plan.table_count; l3++)
+                if (plan.nodes[l3].level == 3 && plan.nodes[l3].prefix == va >> 21)
+                    break;
+            if (l3 == plan.table_count)
+                return EINVAL;
+            if (!owner->valid(owner->context))
+                return ECANCELED;
+            rf_gm_write_le64((uint8_t *)pool.host + l3 * 0x1000 + ((va >> 12) & 511u) * 8, descriptor);
+        }
+    }
+    if (!owner->valid(owner->context))
+        return ECANCELED;
+    *output = plan;
+    return 0;
+}
+
+#endif /* REDFIN_GMU_PAGETABLES_H */
diff --git a/bsd/dev/redfin_gmu_firmware.h b/bsd/dev/redfin_gmu_firmware.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_firmware.h
@@ -0,0 +1,474 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Redfin A620v2 GMU firmware planning and the KGSL HFI v2 wire layout.
+ * Hardware protocol references are pinned in ../GMU.md. This header performs
+ * no MMIO, allocation, SMMU programming, power voting, or firmware start.
+ */
+#ifndef REDFIN_GMU_FIRMWARE_H
+#define REDFIN_GMU_FIRMWARE_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/errno.h>
+
+#define REDFIN_GMU_CHIP_ID 0x06020001u
+#define REDFIN_GMU_PHYS 0x03d6a000u
+#define REDFIN_GMU_REG_BYTES 0x30000u
+#define REDFIN_GMU_ITCM_ADDR 0u
+#define REDFIN_GMU_DTCM_ADDR 0x10004000u
+#define REDFIN_GMU_TCM_BYTES 0x4000u
+#define REDFIN_GMU_ITCM_MMIO 0x3000u
+#define REDFIN_GMU_DTCM_MMIO 0x7000u
+#define REDFIN_GMU_PAGE_BYTES 0x1000u
+#define REDFIN_GMU_MAX_FILE_BYTES 0x40000u
+#define REDFIN_GMU_MAX_DMA_BYTES 0x100000u
+#define REDFIN_GMU_MAX_RECORDS 64u
+#define REDFIN_GMU_MAX_REGIONS 20u
+#define REDFIN_GMU_MAX_PAYLOADS 32u
+
+/* These permission bits describe the plan, not an ARM SMMU descriptor. */
+#define REDFIN_GMU_READ 1u
+#define REDFIN_GMU_WRITE 2u
+#define REDFIN_GMU_PRIV 4u
+
+#define REDFIN_GMU_HFI_QUEUE_COUNT 4u
+#define REDFIN_GMU_HFI_QUEUE_WORDS 1024u
+#define REDFIN_GMU_HFI_TABLE_BYTES 216u
+#define REDFIN_GMU_HFI_QUEUE_OFFSET 224u
+#define REDFIN_GMU_HFI_REQUEST_BYTES 0x40e8u
+#define REDFIN_GMU_HFI_MAPPED_BYTES 0x5000u
+#define REDFIN_GMU_LOG_BYTES 0x1000u
+
+enum redfin_gmu_memory_kind {
+    REDFIN_GMU_ITCM = 0,
+    REDFIN_GMU_DTCM,
+    REDFIN_GMU_CACHE,
+    REDFIN_GMU_KERNEL,
+    REDFIN_GMU_HFI,
+    REDFIN_GMU_LOG
+};
+
+struct redfin_gmu_region {
+    uint32_t address;
+    uint32_t requested_bytes;
+    uint32_t mapped_bytes;
+    uint32_t kind;
+    uint32_t permissions;
+    uint32_t persistent;
+};
+
+struct redfin_gmu_payload {
+    uint32_t file_offset;
+    uint32_t address;
+    uint32_t bytes;
+    uint32_t region;
+};
+
+struct redfin_gmu_fw_plan {
+    uint32_t file_bytes;
+    uint32_t record_count;
+    uint32_t metadata_count;
+    uint32_t region_count;
+    uint32_t payload_count;
+    uint32_t initialized_bytes;
+    uint32_t dma_bytes;
+    /* core, core_dev, power, power_dev, HFI; DTCM byte offset 0x3fe0. */
+    uint32_t versions[5];
+    uint32_t hfi_address;
+    uint32_t log_address;
+    struct redfin_gmu_region regions[REDFIN_GMU_MAX_REGIONS];
+    struct redfin_gmu_payload payloads[REDFIN_GMU_MAX_PAYLOADS];
+};
+
+static inline uint32_t
+redfin_gmu_read_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+        (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline void
+redfin_gmu_write_le32(uint8_t *p, uint32_t value)
+{
+    p[0] = (uint8_t)value;
+    p[1] = (uint8_t)(value >> 8);
+    p[2] = (uint8_t)(value >> 16);
+    p[3] = (uint8_t)(value >> 24);
+}
+
+static inline int
+redfin_gmu_contains(uint32_t base, uint32_t size,
+    uint32_t address, uint32_t bytes)
+{
+    return bytes != 0 && address >= base && address - base < size &&
+        bytes <= size - (address - base);
+}
+
+static inline int
+redfin_gmu_domain(uint32_t address, uint32_t bytes)
+{
+    if (redfin_gmu_contains(REDFIN_GMU_ITCM_ADDR,
+            REDFIN_GMU_TCM_BYTES, address, bytes))
+        return REDFIN_GMU_ITCM;
+    if (redfin_gmu_contains(REDFIN_GMU_DTCM_ADDR,
+            REDFIN_GMU_TCM_BYTES, address, bytes))
+        return REDFIN_GMU_DTCM;
+    if (redfin_gmu_contains(0x4000u, 0xffc000u, address, bytes))
+        return REDFIN_GMU_CACHE;
+    if (redfin_gmu_contains(0x60000000u, 0x20000000u, address, bytes))
+        return REDFIN_GMU_KERNEL;
+    /* A620's current kernel firmware does not request a user-context map. */
+    return -1;
+}
+
+static inline int
+redfin_gmu_add_region(struct redfin_gmu_fw_plan *plan,
+    uint32_t address, uint32_t requested, uint32_t kind, uint32_t persistent)
+{
+    uint64_t rounded = ((uint64_t)requested + 0xfffu) & ~UINT64_C(0xfff);
+    uint64_t end = (uint64_t)address + rounded;
+    uint32_t i;
+    struct redfin_gmu_region *region;
+
+    if (!requested || (address & 0xfffu) || rounded > REDFIN_GMU_MAX_DMA_BYTES ||
+        end > UINT64_C(0x80000000) ||
+        redfin_gmu_domain(address, (uint32_t)rounded) !=
+        (kind == REDFIN_GMU_HFI || kind == REDFIN_GMU_LOG ?
+            REDFIN_GMU_KERNEL : (int)kind))
+        return EINVAL;
+    if (plan->region_count == REDFIN_GMU_MAX_REGIONS)
+        return ENOSPC;
+    if (rounded > REDFIN_GMU_MAX_DMA_BYTES - plan->dma_bytes)
+        return EFBIG;
+    for (i = 0; i < plan->region_count; i++) {
+        const struct redfin_gmu_region *previous = &plan->regions[i];
+        if ((uint64_t)address < (uint64_t)previous->address +
+                previous->mapped_bytes && previous->address < end)
+            return EINVAL;
+    }
+    region = &plan->regions[plan->region_count++];
+    region->address = address;
+    region->requested_bytes = requested;
+    region->mapped_bytes = (uint32_t)rounded;
+    region->kind = kind;
+    region->permissions = REDFIN_GMU_READ | REDFIN_GMU_WRITE |
+        (kind == REDFIN_GMU_HFI ? 0u : REDFIN_GMU_PRIV);
+    region->persistent = persistent;
+    plan->dma_bytes += (uint32_t)rounded;
+    return 0;
+}
+
+/*
+ * Validate the entire immutable blob before returning any usable write plan.
+ * Native preallocations in TCM refer to the two existing full TCM windows;
+ * they are not DMA allocations, and their requests may overlap. Non-TCM
+ * preallocations must be distinct. Data header type/value are opaque: the
+ * actual A650 image uses 0xefbeadde in both fields, and KGSL ignores them.
+ * No output is modified on error. A valid plan does not authenticate firmware.
+ */
+static inline int
+redfin_gmu_fw_plan_make(uint32_t chip, const void *image, size_t bytes,
+    struct redfin_gmu_fw_plan *output)
+{
+    const uint8_t *fw = (const uint8_t *)image;
+    struct redfin_gmu_fw_plan plan = {0};
+    uint32_t offset = 0, data_seen = 0, i, j, next_kernel = 0x60000000u;
+    int error;
+
+    if (!fw || !output || chip != REDFIN_GMU_CHIP_ID || bytes < 16 ||
+        bytes > REDFIN_GMU_MAX_FILE_BYTES || (bytes & 3u))
+        return EINVAL;
+    plan.file_bytes = (uint32_t)bytes;
+    plan.region_count = 2;
+    plan.regions[0].kind = REDFIN_GMU_ITCM;
+    plan.regions[0].address = REDFIN_GMU_ITCM_ADDR;
+    plan.regions[1].kind = REDFIN_GMU_DTCM;
+    plan.regions[1].address = REDFIN_GMU_DTCM_ADDR;
+    for (i = 0; i < 2; i++) {
+        plan.regions[i].requested_bytes = REDFIN_GMU_TCM_BYTES;
+        plan.regions[i].mapped_bytes = REDFIN_GMU_TCM_BYTES;
+        plan.regions[i].permissions = REDFIN_GMU_READ | REDFIN_GMU_WRITE;
+    }
+    while (offset < bytes) {
+        uint32_t address, size, type, value;
+        int kind;
+        if (bytes - offset < 16 || ++plan.record_count > REDFIN_GMU_MAX_RECORDS)
+            return EINVAL;
+        address = redfin_gmu_read_le32(fw + offset);
+        size = redfin_gmu_read_le32(fw + offset + 4);
+        type = redfin_gmu_read_le32(fw + offset + 8);
+        value = redfin_gmu_read_le32(fw + offset + 12);
+        offset += 16;
+        if (size == 0) {
+            if (data_seen)
+                return EINVAL;
+            plan.metadata_count++;
+            if (type >= 2 && type <= 6)
+                continue; /* Known optional metadata; versions come from DTCM. */
+            if (type != 1 && type != 7)
+                return ENOTSUP;
+            if ((address & 3u) || (value & 3u))
+                return EINVAL;
+            kind = redfin_gmu_domain(address, value);
+            if (kind < 0)
+                return EINVAL;
+            if (kind == REDFIN_GMU_ITCM || kind == REDFIN_GMU_DTCM)
+                continue;
+            error = redfin_gmu_add_region(&plan, address, value,
+                (uint32_t)kind, type == 7);
+            if (error)
+                return error;
+            if (kind == REDFIN_GMU_KERNEL && address +
+                    plan.regions[plan.region_count - 1].mapped_bytes > next_kernel)
+                next_kernel = address + plan.regions[plan.region_count - 1].mapped_bytes;
+            continue;
+        }
+        data_seen = 1;
+        if (size > bytes - offset || ((address | size) & 3u) ||
+            redfin_gmu_domain(address, size) < 0)
+            return EINVAL;
+        if (plan.payload_count == REDFIN_GMU_MAX_PAYLOADS)
+            return ENOSPC;
+        for (i = 0; i < plan.region_count; i++)
+            if (redfin_gmu_contains(plan.regions[i].address,
+                    plan.regions[i].requested_bytes, address, size))
+                break;
+        if (i == plan.region_count)
+            return EINVAL;
+        for (j = 0; j < plan.payload_count; j++) {
+            const struct redfin_gmu_payload *previous = &plan.payloads[j];
+            if ((uint64_t)address < (uint64_t)previous->address +
+                    previous->bytes && previous->address < (uint64_t)address + size)
+                return EINVAL;
+        }
+        plan.payloads[plan.payload_count].file_offset = offset;
+        plan.payloads[plan.payload_count].address = address;
+        plan.payloads[plan.payload_count].bytes = size;
+        plan.payloads[plan.payload_count++].region = i;
+        plan.initialized_bytes += size;
+        offset += size;
+    }
+    if (!plan.payload_count || !plan.metadata_count)
+        return EINVAL;
+    /* A partial/missing version tuple cannot determine the start/HFI ABI. */
+    for (i = 0; i < 5; i++) {
+        uint32_t address = REDFIN_GMU_DTCM_ADDR + 0x3fe0u + i * 4;
+        for (j = 0; j < plan.payload_count; j++) {
+            const struct redfin_gmu_payload *payload = &plan.payloads[j];
+            if (redfin_gmu_contains(payload->address, payload->bytes, address, 4)) {
+                plan.versions[i] = redfin_gmu_read_le32(fw + payload->file_offset +
+                    address - payload->address);
+                break;
+            }
+        }
+        if (j == plan.payload_count)
+            return EINVAL;
+    }
+    if ((plan.versions[4] >> 16) != 0x2000u)
+        return ENOTSUP;
+    plan.hfi_address = next_kernel;
+    error = redfin_gmu_add_region(&plan, next_kernel,
+        REDFIN_GMU_HFI_REQUEST_BYTES, REDFIN_GMU_HFI, 0);
+    if (error)
+        return error;
+    next_kernel += REDFIN_GMU_HFI_MAPPED_BYTES;
+    plan.log_address = next_kernel;
+    error = redfin_gmu_add_region(&plan, next_kernel,
+        REDFIN_GMU_LOG_BYTES, REDFIN_GMU_LOG, 0);
+    if (error)
+        return error;
+    *output = plan;
+    return 0;
+}
+
+/* Convert only a TCM payload into an offset inside the Redfin GMU aperture. */
+static inline int
+redfin_gmu_tcm_mmio(const struct redfin_gmu_region *region,
+    uint32_t offset, uint32_t bytes, uint32_t *aperture_offset)
+{
+    uint32_t base, address;
+    if (!region || !aperture_offset || ((offset | bytes) & 3u))
+        return EINVAL;
+    if (region->kind == REDFIN_GMU_ITCM) {
+        base = REDFIN_GMU_ITCM_MMIO;
+        address = REDFIN_GMU_ITCM_ADDR;
+    } else if (region->kind == REDFIN_GMU_DTCM) {
+        base = REDFIN_GMU_DTCM_MMIO;
+        address = REDFIN_GMU_DTCM_ADDR;
+    } else {
+        return EINVAL;
+    }
+    if (region->address != address || region->mapped_bytes != REDFIN_GMU_TCM_BYTES ||
+        !redfin_gmu_contains(0, REDFIN_GMU_TCM_BYTES, offset, bytes))
+        return EINVAL;
+    *aperture_offset = base + offset;
+    return 0;
+}
+
+/* Native KGSL selects the completion mask from the version loaded in DTCM. */
+static inline int
+redfin_gmu_started(uint32_t core_version, uint32_t result)
+{
+    return core_version <= 0x20010004u ? result == 0xbabefaceu :
+        (result & 0x1ffu) == 0x100u;
+}
+
+/*
+ * Host-memory construction only. Caller owns a zeroable, contiguous 20KiB
+ * view at this GMU IOVA; mapping, cache publication and reset ownership must
+ * be established separately. Counts reproduce the pinned native driver,
+ * including num_active_q=4 with the dispatch descriptor disabled.
+ */
+static inline int
+redfin_gmu_hfi_init(void *buffer, size_t bytes, uint32_t address, uint32_t version)
+{
+    uint8_t *p = (uint8_t *)buffer;
+    uint32_t i;
+    static const uint32_t priorities[4] = {10, 10, 40, 20};
+    if (!p || bytes != REDFIN_GMU_HFI_MAPPED_BYTES || (address & 0xfffu) ||
+        (version >> 16) != 0x2000u ||
+        !redfin_gmu_contains(0x60000000u, 0x20000000u, address, (uint32_t)bytes))
+        return EINVAL;
+    for (i = 0; i < bytes; i++)
+        p[i] = 0;
+    redfin_gmu_write_le32(p + 4, REDFIN_GMU_HFI_TABLE_BYTES / 4);
+    redfin_gmu_write_le32(p + 8, 6);
+    redfin_gmu_write_le32(p + 12, 12);
+    redfin_gmu_write_le32(p + 16, REDFIN_GMU_HFI_QUEUE_COUNT);
+    redfin_gmu_write_le32(p + 20, REDFIN_GMU_HFI_QUEUE_COUNT);
+    for (i = 0; i < REDFIN_GMU_HFI_QUEUE_COUNT; i++) {
+        uint8_t *q = p + 24 + 48 * i;
+        redfin_gmu_write_le32(q, i == 3 ? 0 : 1);
+        redfin_gmu_write_le32(q + 4, address + REDFIN_GMU_HFI_QUEUE_OFFSET + 4096 * i);
+        redfin_gmu_write_le32(q + 8, i | priorities[i] << 8);
+        redfin_gmu_write_le32(q + 12, REDFIN_GMU_HFI_QUEUE_WORDS);
+    }
+    return 0;
+}
+
+/* Pure v2 ring arithmetic; a caller publishes only after writing and fencing. */
+struct redfin_gmu_hfi_write {
+    uint32_t first_word;
+    uint32_t first_words;
+    uint32_t second_words;
+    uint32_t padding_words;
+    uint32_t next_write;
+};
+
+static inline int
+redfin_gmu_hfi_write_plan(uint32_t read, uint32_t write, uint32_t message_words,
+    struct redfin_gmu_hfi_write *output)
+{
+    struct redfin_gmu_hfi_write plan;
+    uint32_t padded, occupied, available;
+    if (!output || read >= 1024 || write >= 1024 || ((read | write) & 3u) ||
+        !message_words || message_words > 255)
+        return EINVAL;
+    padded = (message_words + 3u) & ~3u;
+    occupied = (write + 1024u - read) % 1024u;
+    available = 1024u - occupied;
+    /* Keep the producer/consumer equality unambiguously empty. */
+    if (padded >= available)
+        return ENOSPC;
+    plan.first_word = write;
+    plan.first_words = message_words < 1024u - write ? message_words : 1024u - write;
+    plan.second_words = message_words - plan.first_words;
+    plan.padding_words = padded - message_words;
+    plan.next_write = (write + padded) % 1024u;
+    *output = plan;
+    return 0;
+}
+
+static inline int
+redfin_gmu_hfi_command_header(uint32_t id, uint32_t words, uint32_t sequence,
+    uint32_t *output)
+{
+    if (!output || id > 255 || !words || words > 255 || !sequence || sequence > 4095)
+        return EINVAL;
+    *output = id | words << 8 | sequence << 20;
+    return 0;
+}
+
+/*
+ * A future hardware adapter may use this bounded transfer loop. Preflight and
+ * guard are read-only: they must prove current CX/clocks, held CM3 reset,
+ * image identity, every owned buffer/translation and exclusive lifetime.
+ * Initialize/zero DMA buffers and HFI before enabling their owned context.
+ * The immutable blob and callback storage must outlive the whole operation.
+ * Each write and verification is preceded by a fresh guard. A callback error
+ * stops immediately: no retry, firmware start, power down or unsafe rollback.
+ * After an attempted write, caller must keep reset asserted and all backing
+ * memory pinned until a proved context shutdown or platform reset.
+ */
+struct redfin_gmu_load_ops {
+    void *context;
+    int (*preflight)(void *, const struct redfin_gmu_fw_plan *);
+    int (*guard)(void *);
+    int (*write)(void *, const struct redfin_gmu_region *, uint32_t,
+        const uint8_t *, uint32_t);
+    int (*publish)(void *);
+    int (*verify)(void *, const struct redfin_gmu_region *, uint32_t,
+        const uint8_t *, uint32_t);
+};
+
+struct redfin_gmu_load_progress {
+    uint32_t attempted;
+    uint32_t completed;
+    uint32_t verified;
+};
+
+static inline int
+redfin_gmu_fw_load(uint32_t chip, const void *image, size_t bytes,
+    const struct redfin_gmu_load_ops *ops, struct redfin_gmu_load_progress *progress)
+{
+    struct redfin_gmu_fw_plan plan;
+    const uint8_t *fw = (const uint8_t *)image;
+    uint32_t i;
+    int error;
+    if (!progress)
+        return EINVAL;
+    progress->attempted = progress->completed = progress->verified = 0;
+    if (!ops || !ops->preflight || !ops->guard || !ops->write ||
+        !ops->publish || !ops->verify)
+        return EINVAL;
+    error = redfin_gmu_fw_plan_make(chip, image, bytes, &plan);
+    if (error)
+        return error;
+    error = ops->preflight(ops->context, &plan);
+    if (error)
+        return error;
+    for (i = 0; i < plan.payload_count; i++) {
+        const struct redfin_gmu_payload *payload = &plan.payloads[i];
+        const struct redfin_gmu_region *region = &plan.regions[payload->region];
+        error = ops->guard(ops->context);
+        if (error)
+            return error;
+        progress->attempted++;
+        error = ops->write(ops->context, region, payload->address - region->address,
+            fw + payload->file_offset, payload->bytes);
+        if (error)
+            return error;
+        progress->completed++;
+    }
+    error = ops->guard(ops->context);
+    if (error)
+        return error;
+    error = ops->publish(ops->context);
+    if (error)
+        return error;
+    for (i = 0; i < plan.payload_count; i++) {
+        const struct redfin_gmu_payload *payload = &plan.payloads[i];
+        const struct redfin_gmu_region *region = &plan.regions[payload->region];
+        error = ops->guard(ops->context);
+        if (error)
+            return error;
+        error = ops->verify(ops->context, region, payload->address - region->address,
+            fw + payload->file_offset, payload->bytes);
+        if (error)
+            return error;
+        progress->verified++;
+    }
+    return 0;
+}
+
+#endif /* REDFIN_GMU_FIRMWARE_H */
diff --git a/bsd/dev/redfin_gmu_memory.inc b/bsd/dev/redfin_gmu_memory.inc
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_memory.inc
@@ -0,0 +1,314 @@
+/* SPDX-License-Identifier: MIT */
+/* Reset-held A620 firmware, owned RAM and GMU kernel-stream translation.
+ * All allocations and installed state are retained until platform reset.
+ */
+extern int redfin_mpss_kernel_sha256(void *, const uint8_t *, size_t, uint8_t[32]);
+/* The BSD pmap view omits this machine-private declaration. */
+extern pmap_paddr_t kvtophys(vm_offset_t);
+static const uint32_t gm_memory_policy[] = {
+    5, 1, 5, 0x400, 39, 36, 0x100000, 0x28000, RF_GMM_TCR, RF_GMM_TCR2, RF_GMM_SCTLR
+};
+static struct {
+    struct gm_context *context;
+    struct redfin_gmu_fw_plan firmware;
+    struct rf_gm_pt_plan tables;
+    struct rf_gmm_lease lease;
+    struct rf_gm_memory data[RF_GM_PT_MAX_EXTENTS], pool;
+    unsigned count, allocations, translations, loaded, verified, atos_supported;
+    uint64_t allocated;
+    uint32_t bytes;
+    uint8_t digest[32], image[REDFIN_GMU_MAX_FILE_BYTES];
+    bool bound, retained, ready;
+} gm_memory;
+
+static bool gm_memory_contract(struct gm_context *context)
+{
+    DTEntry entry;
+    const void *image, *digest;
+    unsigned bytes, hash_bytes;
+    uint8_t actual[32];
+    struct redfin_gmu_fw_plan plan;
+    if (SecureDTLookupEntry(NULL, "/redfin-gmu", &entry) != kSuccess ||
+        SecureDTGetProperty(entry, "firmware", &image, &bytes) != kSuccess ||
+        SecureDTGetProperty(entry, "firmware-sha256", &digest, &hash_bytes) != kSuccess || hash_bytes != 32 ||
+        bytes < 16 || bytes > REDFIN_GMU_MAX_FILE_BYTES ||
+        !gm_property(context, "/redfin-gmu", "memory-policy", gm_memory_policy, sizeof(gm_memory_policy)) ||
+        redfin_mpss_kernel_sha256(NULL, image, bytes, actual) || memcmp(actual, digest, 32) ||
+        redfin_gmu_fw_plan_make(gm_chip, image, bytes, &plan)) return false;
+    if (!context) return true;
+    if (gm_memory.bound) return false;
+    memcpy(gm_memory.image, image, bytes); memcpy(gm_memory.digest, digest, 32);
+    gm_memory.bytes = bytes; gm_memory.firmware = plan; gm_memory.context = context;
+    gm_memory.bound = true;
+    return gm_property(context, "/redfin-gmu", "firmware", gm_memory.image, bytes) &&
+        gm_property(context, "/redfin-gmu", "firmware-sha256", gm_memory.digest, 32);
+}
+
+static bool gm_memory_valid(void *argument)
+{
+    return gm_memory.bound && argument == gm_memory.context && gm_smmu_valid(argument);
+}
+static bool gm_memory_same(const struct rf_gm_memory *a, const struct rf_gm_memory *b)
+{
+    return a->host == b->host && a->physical == b->physical && a->owned_bytes == b->owned_bytes &&
+        a->token == b->token && a->gmu_address == b->gmu_address;
+}
+static bool gm_memory_owns(void *argument, const struct rf_gm_memory *memory, unsigned use)
+{
+    if (!gm_memory_valid(argument) || !rf_gm_memory_valid(memory)) return false;
+    bool own = use == RF_GM_PT_TABLE_POOL && gm_memory_same(memory, &gm_memory.pool);
+    if (use == RF_GM_PT_DATA) for (unsigned i = 0; i < gm_memory.count; ++i)
+        if (gm_memory_same(memory, &gm_memory.data[i])) own = true;
+    if (!own) return false;
+    for (uint64_t i = 0; i < memory->owned_bytes; i += 4096)
+        if (kvtophys((vm_offset_t)memory->host + i) != memory->physical + i) return false;
+    return true;
+}
+static int gm_memory_allocate(struct rf_gm_memory *out, uint32_t address, uint32_t bytes, uint64_t token)
+{
+    vm_offset_t host = 0;
+    vm_size_t size = (bytes + PAGE_MASK) & ~PAGE_MASK;
+    if (!size || size > gm_memory_policy[6] ||
+        gm_memory.allocated + size > gm_memory_policy[6]) return EFBIG;
+    if (kmem_alloc_contig(kernel_map, &host, size, PAGE_MASK,
+            (ppnum_t)((RF_GM_PT_RAM_BASE + RF_GM_PT_RAM_BYTES - 1) >> PAGE_SHIFT), 0,
+            KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) return ENOMEM;
+    ++gm_memory.allocations; gm_memory.allocated += size;
+    *out = (struct rf_gm_memory){(void *)host, kvtophys(host), size, token, address};
+    return rf_gm_memory_valid(out) ? 0 : ERANGE;
+}
+static void gm_memory_clean(const struct rf_gm_memory *memory)
+{
+    for (uintptr_t at = (uintptr_t)memory->host; at < (uintptr_t)memory->host + memory->owned_bytes; at += 64)
+        __asm__ volatile("dc cvac, %0" :: "r"(at) : "memory");
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static int gm_memory_check(void *argument) { return gm_memory_valid(argument) ? 0 : ECANCELED; }
+static int gm_memory_sample(void *argument, struct rf_gs_snapshot *global, struct rf_gc_snapshot *banks)
+{
+    const struct rf_gs_ops gs = {argument, gm_smmu_valid, gm_smmu_read};
+    const struct rf_gc_ops gc = {argument, gm_smmu_valid, gm_cb_read};
+    int error = rf_gs_snapshot_run(&gs, gm_chip, global);
+    return error ? error : rf_gc_snapshot_run(&gc, global, banks);
+}
+static bool gm_memory_cb_offset(uint32_t at)
+{
+    return rf_gc_allowed(1, at) || at == 0x28 || at == 0x2c || at == 0x7f4 ||
+        at == 0x50 || at == 0x54 || at == 0x8f0;
+}
+static int gm_memory_read(void *argument, unsigned block, uint32_t at, uint32_t *out)
+{
+    struct gm_context *context = argument;
+    if (!out || block > 1 || !gm_memory_valid(argument)) return ECANCELED;
+    if (block) {
+        if (!gm_memory_cb_offset(at)) return EINVAL;
+        *out = gm_scalar_read(context->cb + 0x1000 + at);
+        return 0;
+    }
+    return gm_smmu_read(argument, at, out);
+}
+static void gm_memory_store(vm_offset_t address, uint32_t value)
+{
+    __asm__ volatile("dmb oshst\n\tmov w9, %w0\n\tstr w9, [%1]\n\tdsb osh" ::
+        "r"(value), "r"(address) : "x9", "memory");
+}
+static void gm_memory_store64(vm_offset_t address, uint64_t value)
+{
+    __asm__ volatile("dmb oshst\n\tmov x9, %0\n\tstr x9, [%1]\n\tdsb osh" ::
+        "r"(value), "r"(address) : "x9", "memory");
+}
+static int gm_memory_write(void *argument, unsigned block, uint32_t at, uint32_t value)
+{
+    struct gm_context *context = argument;
+    unsigned expected_block; uint32_t expected_at, expected_value;
+    if (!gm_memory.lease.stores || !gm_memory_valid(argument) ||
+        rf_gmm_step(&gm_memory.lease, &gm_memory.tables, gm_memory.lease.stores - 1,
+                    &expected_block, &expected_at, &expected_value) ||
+        block != expected_block || at != expected_at || value != expected_value) return EPERM;
+    gm_memory_store((block ? context->cb + 0x1000 : context->smmu) + at, value);
+    return 0;
+}
+static int gm_memory_publish(void *argument, const struct rf_gm_pt_plan *plan)
+{
+    if (plan != &gm_memory.tables || !gm_memory_owns(argument, &plan->tables, RF_GM_PT_TABLE_POOL)) return EPERM;
+    for (unsigned i = 0; i < gm_memory.count; ++i) {
+        if (!gm_memory_owns(argument, &gm_memory.data[i], RF_GM_PT_DATA)) return EPERM;
+        gm_memory_clean(&gm_memory.data[i]);
+    }
+    gm_memory_clean(&gm_memory.pool);
+    return gm_memory_check(argument);
+}
+static int gm_memory_delay(void *argument, unsigned microseconds)
+{
+    if (!gm_memory_valid(argument) || microseconds != 1) return ECANCELED;
+    delay(1); return 0;
+}
+
+/* TCM is local MMIO, not a table walk. Each word keeps the complete bound
+ * args/ADT/parent/CPU/IRQ/CX guard, running core clock and reset/INIT/HFI
+ * checks. Refresh the full PLL/source/SMMU-clock proof every 256 bytes as
+ * well; recursively taking that full proof for each word exceeds the
+ * bounded diagnostic window. This path changes no clock or master state. */
+static bool gm_memory_tcm_valid(struct gm_context *context)
+{
+    if (!context || !gm_memory.bound || context != gm_memory.context ||
+        !context->smmu_ready || !gm_valid(context)) return false;
+    return (gm_scalar_read(context->base[RF_GT_GPUCC] + 0x1098) & 0x80000001u) == 1 &&
+        gm_scalar_read(context->base[RF_GT_GMU] + 0x14000) == 1 &&
+        gm_scalar_read(context->base[RF_GT_GMU] + 0x14070) == 0 &&
+        gm_scalar_read(context->base[RF_GT_GMU] + 0x14600) == 0;
+}
+
+static int gm_memory_transfer(struct gm_context *context, bool tcm)
+{
+    for (unsigned p = 0; p < gm_memory.firmware.payload_count; ++p) {
+        const struct redfin_gmu_payload *payload = &gm_memory.firmware.payloads[p];
+        const struct redfin_gmu_region *region = &gm_memory.firmware.regions[payload->region];
+        const uint8_t *source = gm_memory.image + payload->file_offset;
+        uint32_t offset = payload->address - region->address;
+        if ((payload->region < 2) != tcm) continue;
+        if (!gm_memory_valid(context)) return ECANCELED;
+        printf("REDFIN GMU LOAD: payload=%u address=%#x bytes=%u tcm=%u\n",
+            p, payload->address, payload->bytes, tcm);
+        if (payload->region < 2) {
+            uint32_t mmio;
+            if (redfin_gmu_tcm_mmio(region, offset, payload->bytes, &mmio)) return EINVAL;
+            for (unsigned j = 0; j < payload->bytes; j += 4) {
+                if ((!(j & 0xffu) && !gm_memory_valid(context)) ||
+                    !gm_memory_tcm_valid(context)) return ECANCELED;
+                gm_memory_store(context->base[RF_GT_GMU] + mmio + j, redfin_gmu_read_le32(source + j));
+            }
+            ++gm_memory.loaded;
+            unsigned mismatches = 0;
+            for (unsigned j = 0; j < payload->bytes; j += 4) {
+                if ((!(j & 0xffu) && !gm_memory_valid(context)) ||
+                    !gm_memory_tcm_valid(context)) return ECANCELED;
+                uint32_t expected = redfin_gmu_read_le32(source + j);
+                uint32_t actual = gm_scalar_read(context->base[RF_GT_GMU] + mmio + j);
+                if (actual != expected) {
+                    if (mismatches < 4)
+                        printf("REDFIN GMU TCM MISMATCH: payload=%u address=%#x mmio=%#x expected=%#x actual=%#x\n",
+                            p, payload->address + j, mmio + j, expected, actual);
+                    ++mismatches;
+                }
+            }
+            printf("REDFIN GMU TCM VERIFIED: payload=%u words=%u mismatches=%u\n",
+                p, payload->bytes / 4, mismatches);
+            if (mismatches) return EIO;
+        } else {
+            struct rf_gm_memory *target = &gm_memory.data[payload->region - 2];
+            if (!gm_memory_owns(context, target, RF_GM_PT_DATA) || offset > target->owned_bytes ||
+                payload->bytes > target->owned_bytes - offset) return EPERM;
+            memcpy((uint8_t *)target->host + offset, source, payload->bytes);
+            ++gm_memory.loaded;
+            if (memcmp((uint8_t *)target->host + offset, source, payload->bytes)) return EIO;
+        }
+        ++gm_memory.verified;
+    }
+    if (tcm) return 0;
+    for (unsigned i = 0; i < gm_memory.count; ++i)
+        if (gm_memory.data[i].gmu_address == gm_memory.firmware.hfi_address)
+            return redfin_gmu_hfi_init(gm_memory.data[i].host, REDFIN_GMU_HFI_MAPPED_BYTES,
+                gm_memory.firmware.hfi_address, gm_memory.firmware.versions[4]);
+    return ENOENT;
+}
+
+static int gm_memory_translate(struct gm_context *context, const struct rf_gmm_ops *ops,
+    uint32_t address, uint64_t physical)
+{
+    if (!rf_gmm_atos_supported(&gm_memory.lease.expected)) return ENOTSUP;
+    int error = rf_gmm_verify(&gm_memory.lease, ops);
+    if (error) return error;
+    uint64_t request = address;
+    vm_offset_t ats = context->cb + 0x1000 + 0x800;
+    gm_memory_store64(ats, request);
+    uint32_t status = 1, low, high;
+    for (unsigned us = 0; us < 1000; ++us) {
+        error = gm_memory_read(context, 1, 0x8f0, &status); if (error) return error;
+        if (!(status & 1)) break;
+        error = gm_memory_delay(context, 1); if (error) return error;
+    }
+    if (status & 1) return ETIMEDOUT;
+    error = gm_memory_read(context, 1, 0x50, &low); if (error) return error;
+    error = gm_memory_read(context, 1, 0x54, &high); if (error) return error;
+    uint64_t translated = ((uint64_t)high << 32) | low;
+    printf("REDFIN GMU ATS: address=%#x PAR=%#llx expected=%#llx\n", address,
+        (unsigned long long)translated, (unsigned long long)physical);
+    if ((translated & 1) || (translated & 0x0000000ffffff000ULL) != physical) return EFAULT;
+    ++gm_memory.translations;
+    return rf_gmm_verify(&gm_memory.lease, ops);
+}
+
+static int gm_memory_run(struct gm_context *context, const struct rf_gs_snapshot *global,
+    const struct rf_gc_snapshot *banks)
+{
+    uint64_t started = gm_time_ns(context);
+    int error = gm_memory_check(context);
+    struct rf_gm_memory_owner owner = {context, gm_memory_valid, gm_memory_owns};
+    struct rf_gmm_ops ops = {context, gm_memory_check, gm_memory_sample, gm_memory_read,
+        gm_memory_write, gm_memory_publish, gm_memory_delay};
+    unsigned stage = 0;
+    if (error) goto done;
+    stage = 1; gm_memory.count = gm_memory.firmware.region_count - 2;
+    printf("REDFIN GMU MEMORY STEP: bound firmware=%u payloads=%u extents=%u; allocate private zeroed RAM\n",
+        gm_memory.bytes, gm_memory.firmware.payload_count, gm_memory.count);
+    for (unsigned i = 0; i < gm_memory.count; ++i) {
+        const struct redfin_gmu_region *r = &gm_memory.firmware.regions[i + 2];
+        error = gm_memory_allocate(&gm_memory.data[i], r->address, r->mapped_bytes, i + 1); if (error) goto done;
+    }
+    error = gm_memory_allocate(&gm_memory.pool, 0, RF_GM_PT_MAX_TABLES * 4096, 0x100); if (error) goto done;
+    stage = 2;
+    error = rf_gm_pt_build(global, gm_chip, gm_memory.image, gm_memory.bytes,
+        gm_memory.data, gm_memory.count, &gm_memory.pool, &owner, &gm_memory.tables); if (error) goto done;
+    printf("REDFIN GMU MEMORY STEP: tables=%u pages=%u root=%#llx; initialize owned RAM and HFI\n",
+        gm_memory.tables.table_count, gm_memory.tables.mapped_pages,
+        (unsigned long long)gm_memory.tables.root_physical);
+    stage = 3; error = gm_memory_transfer(context, false); if (error) goto done;
+    stage = 4;
+    printf("REDFIN GMU MEMORY STEP: owned RAM/HFI initialized; publish CB1 and stream5\n");
+    error = rf_gmm_claim(&gm_memory.lease, &ops, global, banks, &gm_memory.tables, &owner); if (error) goto done;
+    gm_memory.retained = true; stage = 5;
+    gm_memory.atos_supported = rf_gmm_atos_supported(global);
+    if (!gm_memory.atos_supported)
+        printf("REDFIN GMU ATS UNAVAILABLE: IDR0=%#x ATOSNS=1; no ATS request, hardware translation not proved\n",
+            global->id0);
+    for (unsigned i = 0; gm_memory.atos_supported && i < gm_memory.tables.extent_count; ++i) {
+        const struct rf_gm_pt_extent *r = &gm_memory.tables.extents[i];
+        error = gm_memory_translate(context, &ops, r->memory.gmu_address, r->memory.physical); if (error) goto done;
+        error = gm_memory_translate(context, &ops, r->memory.gmu_address + r->mapped_bytes - 4096,
+            r->memory.physical + r->mapped_bytes - 4096); if (error) goto done;
+    }
+    stage = 6;
+    /* Native a6xx_gmu_fw_start enables TCM retention before loading TCM.
+     * Context readback precedes TCM, as upstream steps13/14. ATS is optional
+     * on hardware that implements it; a GMU/HFI run must prove real DMA.
+     * CM3 remains held; no firmware fetch or HFI execution is allowed. */
+    error = gm_memory_check(context); if (error) goto done;
+    printf("REDFIN GMU TCM RETENTION: before=%#x requested=1\n",
+        gm_scalar_read(context->base[RF_GT_GMU] + 0x14730));
+    error = gm_memory_check(context); if (error) goto done;
+    gm_memory_store(context->base[RF_GT_GMU] + 0x14730, 1);
+    error = gm_memory_check(context); if (error) goto done;
+    uint32_t retention = gm_scalar_read(context->base[RF_GT_GMU] + 0x14730);
+    printf("REDFIN GMU TCM RETENTION: observed=%#x\n", retention);
+    if (retention != 1) { error = EIO; goto done; }
+    error = gm_memory_transfer(context, true); if (error) goto done;
+    error = rf_gmm_verify(&gm_memory.lease, &ops); if (error) goto done;
+    stage = 7; gm_memory.ready = true;
+done:
+    if (gm_memory.lease.attempted)
+        printf("REDFIN GMU MEMORY LEASE: step=%u block=%u offset=%#x requested=%#x observed=%#x poisoned=%u; CB1 SCTLR=%#x TCR2=%#x TTBR=%#x/%#x TCR=%#x FSR=%#x\n",
+            gm_memory.lease.step, gm_memory.lease.block, gm_memory.lease.offset,
+            gm_memory.lease.requested, gm_memory.lease.observed, gm_memory.lease.poisoned,
+            gm_memory.lease.fresh_banks.words[1][0], gm_memory.lease.fresh_banks.words[1][1],
+            gm_memory.lease.fresh_banks.words[1][2], gm_memory.lease.fresh_banks.words[1][3],
+            gm_memory.lease.fresh_banks.words[1][4], gm_memory.lease.fresh_banks.words[1][8]);
+    printf("REDFIN GMU MEMORY: result=%d stage=%u firmware=%u payloads=%u loaded=%u verified=%u allocations=%u bytes=%llu tables=%u pages=%u bank=1 slot=%u stores=%u atos-supported=%u translations=%u retained=%u elapsed-ns=%llu; CM3 reset held, no GX/firmware execution\n",
+        error, stage, gm_memory.bytes, gm_memory.firmware.payload_count, gm_memory.loaded,
+        gm_memory.verified, gm_memory.allocations,
+        (unsigned long long)gm_memory.allocated, gm_memory.tables.table_count, gm_memory.tables.mapped_pages,
+        gm_memory.lease.slot, gm_memory.lease.stores, gm_memory.atos_supported,
+        gm_memory.translations, gm_memory.allocations != 0,
+        (unsigned long long)(gm_time_ns(context) - started));
+    return error;
+}
diff --git a/bsd/dev/redfin_gmu_start.inc b/bsd/dev/redfin_gmu_start.inc
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_start.inc
@@ -0,0 +1,348 @@
+/* SPDX-License-Identifier: MIT */
+/* Explicit mode4 only. Reset-held preparation and ownership must pass first.
+ * Local GMU interrupts are masked; response queues are polled. No IRQ enable,
+ * foreign route, GX request, PAS call, GPU submission or power release.
+ */
+static const uint64_t gm_start_ranges[] = {
+    0x03de0000,0x1000,0x0b290000,0x10000,0x0b490000,0x10000,
+    0x03d0f000,0x1000,0x80860000,0x20000
+};
+static const uint32_t gm_start_policy[] = {1,2,0,0x06020100,500,1,0,0};
+static struct {
+    struct gm_context *context;
+    struct rf_gb_config config;
+    struct rf_gb_report report;
+    vm_offset_t base[RF_GB_UNITS], db, hfi, log;
+    struct rf_gm_memory *hfi_memory, *log_memory;
+    struct rf_cmddb_resource resources[4];
+    unsigned phase, audited, messages, sent, received;
+    bool bound, entered;
+} gm_start;
+
+static bool gm_start_contract(struct gm_context *context)
+{
+    if (!gm_property(context,"/redfin-gmu","start-ranges",gm_start_ranges,sizeof(gm_start_ranges)) ||
+        !gm_property(context,"/redfin-gmu","start-policy",gm_start_policy,sizeof(gm_start_policy))) return false;
+    if (context) { if(gm_start.bound)return false;gm_start.context=context;gm_start.bound=true; }
+    return true;
+}
+
+/* Keep every original bound args/ADT/parent/CPU/CX/GIC constraint. The
+ * separate lifecycle gate changes only the reset/INIT/HFI expectations. */
+static bool gm_start_base_valid(void *argument)
+{
+    struct gm_context *c=argument;
+    if(!c || c!=gm_start.context || !gm_start.bound || !gm_memory.ready ||
+        !gm_memory.retained || c->smmu_mode!=4 || !c->smmu_ready ||
+        !gm_memory.lease.active || gm_memory.lease.poisoned || !gm_valid(c))return false;
+    if((gm_scalar_read(c->base[RF_GT_GPUCC]+0x1098)&0x80000001u)!=1 ||
+        (gm_scalar_read(c->base[RF_GT_GPUCC]+0x100c)&0x80000001u)!=1 ||
+        (gm_scalar_read(c->base[RF_GT_GPUCC]+0x1064)&0x80000001u)!=0x80000000u)return false;
+    return true;
+}
+static int gm_start_guard(void *argument,unsigned phase)
+{
+    struct gm_context *c=argument;
+    if(phase>RF_GB_HFI_LIVE || !gm_start_base_valid(c))return ECANCELED;
+    gm_start.phase=phase;
+    uint32_t reset=gm_scalar_read(c->base[RF_GT_GMU]+0x14000);
+    uint32_t init=gm_scalar_read(c->base[RF_GT_GMU]+0x14070);
+    uint32_t hfi=gm_scalar_read(c->base[RF_GT_GMU]+0x14600);
+    if(reset!=(phase==RF_GB_HELD?1u:0u))return EAGAIN;
+    if(phase==RF_GB_HELD && (init || hfi))return EAGAIN;
+    if(phase!=RF_GB_HELD && gm_start.config.core_version>0x20010004u && (init&0xe00u))return EIO;
+    if(phase>=RF_GB_FW_LIVE && !redfin_gmu_started(gm_start.config.core_version,init))return EIO;
+    if(phase<RF_GB_HFI_WAIT && (hfi&1u))return EAGAIN;
+    if(phase==RF_GB_HFI_LIVE && !(hfi&1u))return EIO;
+    if(phase!=RF_GB_HELD) {
+        if(gm_scalar_read(c->base[RF_GT_GMU]+0x24c14)&0x29u)return EIO;
+        if((gm_scalar_read(c->base[RF_GT_GMU]+0x1464c)&7u)!=7u ||
+            (gm_scalar_read(c->base[RF_GT_GMU]+0x24c18)&0x29u)!=0x29u)return EAGAIN;
+        if(gm_scalar_read(c->cb+0x1058)&RF_GC_FAULT_BITS)return EFAULT;
+    }
+    return 0;
+}
+
+static bool gm_start_read_allowed(unsigned unit,uint32_t at)
+{
+    if(unit>=RF_GB_UNITS || (at&3u))return false;
+    for(unsigned i=0;i<gm_start.report.program_count;++i) {
+        const struct rf_gb_store *w=&gm_start.report.program[i];
+        if(unit==w->unit && at==w->at)return true;
+    }
+    if(unit==RF_GB_RSC)return at==0x10 || at==0x404 || at==0xd18 || at==0xfb8 || at==0xd14 || at==0xfb4;
+    if(unit==RF_GB_GBIF)return at==0x114 || at==0x118;
+    if(unit!=RF_GB_GMU)return false;
+    switch(at) {
+    case 0x14000:case 0x14070:case 0x14600:case 0x14604:case 0x14648:case 0x24c14:
+    case 0x143a0:case 0x24c1c:case 0x24c20:case 0x24c4c:case 0x14404:case 0xafdc:
+        return true;
+    default:return at>=0xafe0 && at<=0xaff0;
+    }
+}
+static int gm_start_read(void *argument,unsigned unit,uint32_t at,uint32_t *value)
+{
+    if(!value || !gm_start_base_valid(argument) || !gm_start_read_allowed(unit,at) ||
+        !gm_start.base[unit])return EPERM;
+    *value=gm_scalar_read(gm_start.base[unit]+at);return 0;
+}
+static int gm_start_write(void *argument,unsigned unit,uint32_t at,uint32_t value)
+{
+    if(!gm_start_base_valid(argument) || unit>=RF_GB_UNITS || !gm_start.base[unit])return ECANCELED;
+    const struct rf_gb_report *s=&gm_start.report;
+    bool allowed=s->last_unit==unit && s->last_offset==at && s->wanted==value;
+    if(!allowed)return EPERM;
+    allowed=false;
+    for(unsigned i=0;i<s->program_count;++i) {
+        const struct rf_gb_store *w=&s->program[i];
+        if(w->unit==unit && w->at==at && w->value==value)allowed=true;
+    }
+    if(unit==RF_GB_GMU) {
+        if(at==0x14000 && value==0 && s->released && s->phase==RF_GB_FW_WAIT)allowed=true;
+        if(at==0x14618 && value==1 && s->firmware && s->phase==RF_GB_HFI_WAIT)allowed=true;
+        if(at==0x24c1c && (value==0 || value==2) && s->phase==RF_GB_HELD)allowed=true;
+    }
+    if(!allowed)return EPERM;
+    if(unit!=RF_GB_GMU || (at!=0x14000 && at!=0x14618))
+        if(gm_start_guard(argument,s->phase))return ECANCELED;
+    printf("REDFIN GMU START WRITE: step=%u unit=%u offset=%#x value=%#x\n",s->stores,unit,at,value);
+    if(!gm_start_base_valid(argument))return ECANCELED;
+    gm_memory_store(gm_start.base[unit]+at,value);return 0;
+}
+
+/* Read-only complete SMMU audit without recursively taking the reset-held
+ * source proof at every word. It still guards each MMIO access. */
+static bool gm_start_sample_valid(void *argument)
+{ return gm_start_guard(argument,gm_start.phase)==0; }
+static int gm_start_global(void *argument,uint32_t at,uint32_t *value)
+{
+    struct gm_context *c=argument;
+    if(!value || !rf_gs_read_allowed(at,&gm_memory.lease.expected) || !gm_start_sample_valid(c))return EPERM;
+    *value=gm_scalar_read(c->smmu+at);return 0;
+}
+static int gm_start_bank(void *argument,unsigned bank,uint32_t at,uint32_t *value)
+{
+    struct gm_context *c=argument;
+    if(!value || !rf_gc_allowed(bank,at) || !gm_start_sample_valid(c))return EPERM;
+    *value=gm_scalar_read(c->cb+0x1000*bank+at);return 0;
+}
+static int gm_start_audit(void *argument,unsigned phase)
+{
+    struct gm_context *c=argument;
+    int error=gm_start_guard(c,phase);
+    if(error)return error;
+    struct rf_gt_report clock={0};
+    const struct rf_gt_ops source={.context=c,.valid=gm_valid,.read=gm_read};
+    error=rf_gt_source_live(&source,&clock,true);if(error)return error;
+    for(unsigned i=0;i<sizeof(gm_smmu_clocks)/sizeof(gm_smmu_clocks[0]);++i) {
+        const uint32_t *w=gm_smmu_clocks[i];
+        if((gm_scalar_read(c->base[w[0]]+w[1])&w[2])!=w[3])return EAGAIN;
+    }
+    const struct rf_gs_ops go={c,gm_start_sample_valid,gm_start_global};
+    const struct rf_gc_ops bo={c,gm_start_sample_valid,gm_start_bank};
+    error=rf_gs_snapshot_run(&go,gm_chip,&gm_memory.lease.fresh);
+    if(!error)error=rf_gc_snapshot_run(&bo,&gm_memory.lease.fresh,&gm_memory.lease.fresh_banks);
+    if(!error && !rf_gmm_equal(&gm_memory.lease))error=EAGAIN;
+    if(!error && (gm_scalar_read(c->cb+0x1028) || gm_scalar_read(c->cb+0x102c)))error=EAGAIN;
+    if(error){gm_memory.lease.poisoned=1;gm_memory.lease.active=0;return error;}
+    ++gm_start.audited;
+    printf("REDFIN GMU START AUDIT: phase=%u complete=%u FSR=%#x\n",phase,gm_start.audited,
+        gm_memory.lease.fresh_banks.words[1][8]);
+    return gm_start_guard(c,phase);
+}
+static int gm_start_delay(void *argument,unsigned us)
+{
+    if(us!=100 || !gm_start_base_valid(argument))return ECANCELED;
+    delay(100);return 0;
+}
+
+static uint32_t gm_start_hfi_word(uint32_t at)
+{ return gm_scalar_read(gm_start.hfi+at); }
+static void gm_start_hfi_store(uint32_t at,uint32_t value)
+{ gm_memory_store(gm_start.hfi+at,value); }
+static int gm_start_hfi_shape(void *argument)
+{
+    int error=gm_start_guard(argument,RF_GB_HFI_LIVE);if(error)return error;
+    static const uint32_t header[]={0,54,6,12,4,4};
+    static const uint32_t priority[]={10,10,40,20};
+    for(unsigned i=1;i<6;++i)if(gm_start_hfi_word(4*i)!=header[i])return EPROTO;
+    for(unsigned q=0;q<4;++q) {
+        uint32_t at=24+48*q;
+        if(gm_start_hfi_word(at)!=(q==3?0u:1u) ||
+            gm_start_hfi_word(at+4)!=gm_start.config.hfi_address+0xe0+4096*q ||
+            gm_start_hfi_word(at+8)!=(q|(priority[q]<<8)) ||
+            gm_start_hfi_word(at+12)!=1024 || gm_start_hfi_word(at+16))return EPROTO;
+        uint32_t read=gm_start_hfi_word(at+40),write=gm_start_hfi_word(at+44);
+        if(read>=1024 || write>=1024 || ((read|write)&3u))return EPROTO;
+    }
+    return gm_start_guard(argument,RF_GB_HFI_LIVE);
+}
+static int gm_start_receive(void *argument,unsigned q,uint32_t request,uint32_t *version)
+{
+    if(q!=1 && q!=2)return EINVAL;
+    int error=gm_start_hfi_shape(argument);if(error)return error;
+    uint32_t base=24+48*q,read=gm_start_hfi_word(base+40),write=gm_start_hfi_word(base+44);
+    if(read==write)return ENOENT;
+    uint32_t at=0xe0+4096*q;
+    uint32_t first=gm_start_hfi_word(at+4*read),count=(first>>8)&255u;
+    uint32_t available=(write+1024-read)%1024,padded=(count+3u)&~3u;
+    if(!count || padded>available || padded>=1024 || gm_start.messages>=16)return EPROTO;
+    uint32_t words[255];
+    for(unsigned i=0;i<count;++i)words[i]=gm_start_hfi_word(at+4*((read+i)%1024));
+    ++gm_start.messages;
+    printf("REDFIN GMU HFI RECEIVE: queue=%u count=%u header=%#x word1=%#x word2=%#x word3=%#x\n",
+        q,count,words[0],count>1?words[1]:0,count>2?words[2]:0,count>3?words[3]:0);
+    if((words[0]&255u)==100u)return EIO;
+    error=gm_start_guard(argument,RF_GB_HFI_LIVE);if(error)return error;
+    gm_start_hfi_store(base+40,(read+padded)%1024);
+    if(q==1 && ((words[0]>>16)&15u)==1) {
+        error=rf_gb_version_ack(words,count,request,0x20000000,version);
+        if(!error)++gm_start.received;
+        return error;
+    }
+    return ENOMSG;
+}
+static int gm_start_exchange(void *argument,uint32_t *version)
+{
+    int error=gm_start_hfi_shape(argument);if(error)return error;
+    if(gm_start.sent || gm_start_hfi_word(64) || gm_start_hfi_word(68))return EBUSY;
+    for(unsigned i=0;i<16;++i) {
+        bool pending=false;
+        for(unsigned q=1;q<=2;++q) {
+            uint32_t unused=0;
+            error=gm_start_receive(argument,q,UINT32_MAX,&unused);
+            if(error==ENOMSG){pending=true;continue;}
+            if(error!=ENOENT)return error;
+        }
+        if(!pending)break;
+        if(i==15)return EPROTO;
+    }
+    uint32_t request;
+    error=redfin_gmu_hfi_command_header(1,2,1,&request);if(error)return error;
+    uint32_t command[]={request,0x20000000,0xfafafafa,0xfafafafa};
+    for(unsigned i=0;i<4;++i) {
+        error=gm_start_guard(argument,RF_GB_HFI_LIVE);if(error)return error;
+        gm_start_hfi_store(0xe0+4*i,command[i]);
+    }
+    error=gm_start_guard(argument,RF_GB_HFI_LIVE);if(error)return error;
+    gm_start_hfi_store(68,4);
+    ++gm_start.sent;
+    error=gm_start_guard(argument,RF_GB_HFI_LIVE);if(error)return error;
+    gm_memory_store(gm_start.base[RF_GB_GMU]+0x14650,1);
+    printf("REDFIN GMU HFI SENT: request=%#x supported=0x20000000 sequence=1\n",request);
+    uint64_t first=gm_time_ns(argument);
+    for(unsigned i=0;i<5000 && gm_time_ns(argument)-first<RF_GB_WAIT_NS;++i) {
+        error=gm_start_receive(argument,1,request,version);
+        if(!error) {
+            if(gm_start_hfi_word(64)!=4)return EPROTO;
+            error=gm_start_guard(argument,RF_GB_HFI_LIVE);if(error)return error;
+            gm_memory_store(gm_start.base[RF_GB_GMU]+0x14644,1);
+            return 0;
+        }
+        if(error!=ENOENT && error!=ENOMSG)return error;
+        error=gm_start_receive(argument,2,request,version);
+        if(error!=ENOENT && error!=ENOMSG)return error;
+        error=gm_start_delay(argument,100);if(error)return error;
+    }
+    return ETIMEDOUT;
+}
+
+static int gm_start_resources(struct gm_context *context)
+{
+    static const uint8_t names[4][8]={"xo.lvl","cx.lvl","mx.lvl","vrm.soc"};
+    for(unsigned i=0;i<4;++i) {
+        if(!gm_start_base_valid(context))return ECANCELED;
+        enum rf_cmddb_status e=rf_cmddb_lookup((volatile const uint8_t *)gm_start.db,
+            RF_CMDDB_BYTES,names[i],i==3?RF_CMDDB_VRM:RF_CMDDB_ARC,&gm_start.resources[i]);
+        if(i==3 && e==RF_CMDDB_MISSING)continue;
+        if(e!=RF_CMDDB_OK)return ENXIO;
+    }
+    gm_start.config=(struct rf_gb_config){
+        .chip=gm_chip,.core_version=gm_memory.firmware.versions[0],
+        .hfi_version=gm_memory.firmware.versions[4],.hfi_address=gm_memory.firmware.hfi_address,
+        .log_address=gm_memory.firmware.log_address,.xo=gm_start.resources[0].address,
+        .cx=gm_start.resources[1].address,.mx=gm_start.resources[2].address,.vrm=gm_start.resources[3].address
+    };
+    printf("REDFIN GMU START RESOURCES: xo=%#x cx=%#x mx=%#x vrm=%#x core=%#x hfi=%#x\n",
+        gm_start.config.xo,gm_start.config.cx,gm_start.config.mx,gm_start.config.vrm,
+        gm_start.config.core_version,gm_start.config.hfi_version);
+    return rf_gb_config_valid(&gm_start.config)?0:ENOTSUP;
+}
+static int gm_start_memory(struct gm_context *context)
+{
+    for(unsigned i=0;i<gm_memory.count;++i) {
+        struct rf_gm_memory *memory=&gm_memory.data[i];
+        if(memory->gmu_address==gm_start.config.hfi_address)gm_start.hfi_memory=memory;
+        if(memory->gmu_address==gm_start.config.log_address)gm_start.log_memory=memory;
+    }
+    struct rf_gm_memory *objects[]={gm_start.hfi_memory,gm_start.log_memory};
+    for(unsigned i=0;i<2;++i) {
+        struct rf_gm_memory *m=objects[i];
+        if(!m || !gm_memory_owns(context,m,RF_GM_PT_DATA))return EACCES;
+        for(uintptr_t at=(uintptr_t)m->host;at<(uintptr_t)m->host+m->owned_bytes;at+=64)
+            __asm__ volatile("dc civac, %0"::"r"(at):"memory");
+        __asm__ volatile("dsb osh":::"memory");
+        vm_offset_t mapped=ml_io_map_wcomb(m->physical,m->owned_bytes);
+        if(!mapped)return ENOMEM;
+        if(i)gm_start.log=mapped;else gm_start.hfi=mapped;
+    }
+    /* Only the uncached view is used after CM3 can write. */
+    return 0;
+}
+static void gm_start_diagnostic(struct gm_context *context)
+{
+    if(!gm_start_base_valid(context))return;
+    const uint32_t offsets[]={0x14000,0x14070,0x14600,0x14604,0x14648,0x24c14,0x24c4c,0xafdc,0x14404};
+    for(unsigned i=0;i<sizeof(offsets)/sizeof(offsets[0]);++i)
+        printf("REDFIN GMU START STATE: offset=%#x value=%#x\n",offsets[i],
+            gm_scalar_read(gm_start.base[RF_GB_GMU]+offsets[i]));
+    printf("REDFIN GMU START FAULT: FSR=%#x FAR=%#x/%#x FSYNR=%#x GFSR=%#x\n",
+        gm_scalar_read(context->cb+0x1058),gm_scalar_read(context->cb+0x1060),
+        gm_scalar_read(context->cb+0x1064),gm_scalar_read(context->cb+0x1068),
+        gm_scalar_read(context->smmu+0x48));
+    if(gm_start.hfi)
+        for(unsigned q=0;q<4;++q)printf("REDFIN GMU START QUEUE: q=%u status=%#x read=%u write=%u\n",
+            q,gm_start_hfi_word(24+48*q),gm_start_hfi_word(64+48*q),gm_start_hfi_word(68+48*q));
+    if(gm_start.log)
+        for(unsigned i=0;i<16;i+=4)printf("REDFIN GMU START LOG: at=%#x words=%#x/%#x/%#x/%#x\n",4*i,
+            gm_scalar_read(gm_start.log+4*i),gm_scalar_read(gm_start.log+4*i+4),
+            gm_scalar_read(gm_start.log+4*i+8),gm_scalar_read(gm_start.log+4*i+12));
+}
+static int gm_start_run(struct gm_context *context)
+{
+    int error=EPERM;
+    if(!gm_start.bound || gm_start.entered || context!=gm_start.context ||
+        !gm_memory.ready || gm_memory.loaded!=gm_memory.firmware.payload_count ||
+        gm_memory.verified!=gm_memory.firmware.payload_count)return error;
+    gm_start.entered=true;gm_start.base[RF_GB_GMU]=context->base[RF_GT_GMU];
+    gm_start.base[RF_GB_RSC]=ml_io_map(0x03de0000,0x4000);
+    gm_start.base[RF_GB_PDC]=ml_io_map(0x0b290000,0x10000);
+    gm_start.base[RF_GB_SEQ]=ml_io_map(0x0b490000,0x10000);
+    gm_start.base[RF_GB_GBIF]=ml_io_map(0x03d0f000,0x1000);
+    gm_start.db=ml_io_map_wcomb(0x80860000,RF_CMDDB_BYTES);
+    if(!gm_start_base_valid(context))return ECANCELED;
+    for(unsigned i=0;i<RF_GB_UNITS;++i)if(!gm_start.base[i])return ENOMEM;
+    if(!gm_start.db)return ENOMEM;
+    uint64_t started=gm_time_ns(context);
+    error=gm_start_resources(context);if(error)goto done;
+    error=gm_start_memory(context);if(error)goto done;
+    const struct rf_gb_ops ops={context,gm_start_guard,gm_start_read,gm_start_write,
+        gm_start_audit,gm_start_exchange,gm_start_delay,gm_time_ns};
+    printf("REDFIN GMU START: native A620 cold PDC/RSC/CM3/HFI begins; no GX request\n");
+    error=rf_gb_run(&gm_start.report,&gm_start.config,&ops);
+done:
+    gm_start_diagnostic(context);
+    printf("REDFIN GMU START RESULT: result=%d stage=%u phase=%u stores=%u polls=%u released=%u firmware=%u hfi=%u sent=%u received=%u ack=%u version=%#x elapsed-ns=%llu\n",
+        error,gm_start.report.stage,gm_start.report.phase,gm_start.report.stores,gm_start.report.polls,
+        gm_start.report.released,gm_start.report.firmware,gm_start.report.hfi,gm_start.sent,gm_start.received,
+        gm_start.report.ack,gm_start.report.version,(unsigned long long)(gm_time_ns(context)-started));
+    printf("REDFIN GMU START LAST: unit=%u offset=%#x wanted=%#x observed=%#x audits=%u; allocations retained until reset\n",
+        gm_start.report.last_unit,gm_start.report.last_offset,gm_start.report.wanted,
+        gm_start.report.observed,gm_start.audited);
+    printf("REDFIN GMU START CACHED SMMU: error=%d stable=%u FSR=%#x FAR=%#x/%#x FSYNR=%#x GFSR=%#x poisoned=%u\n",
+        gm_memory.lease.fresh_banks.error,gm_memory.lease.fresh_banks.stable,
+        gm_memory.lease.fresh_banks.words[1][8],gm_memory.lease.fresh_banks.words[1][9],
+        gm_memory.lease.fresh_banks.words[1][10],gm_memory.lease.fresh_banks.words[1][11],
+        gm_memory.lease.fresh.fault,gm_memory.lease.poisoned);
+    return error;
+}
diff --git a/bsd/dev/redfin_gmu_start.h b/bsd/dev/redfin_gmu_start.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_start.h
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: MIT */
+/* A620 cold GMU/PDC/RSC start and a fresh HFI v2 version exchange.
+ * Native msm500b3a2059c1eec0fec08ec56add06320ea901a8; preferred upstream
+ * redwood_adreno.c steps15/16. No GX request, performance tables or GPU CP.
+ */
+#ifndef REDFIN_GMU_START_H
+#define REDFIN_GMU_START_H
+#include <stdbool.h>
+#include <string.h>
+#include "redfin_gmu_firmware.h"
+
+enum { RF_GB_GMU, RF_GB_RSC, RF_GB_PDC, RF_GB_SEQ, RF_GB_GBIF, RF_GB_UNITS };
+enum { RF_GB_HELD, RF_GB_FW_WAIT, RF_GB_FW_LIVE, RF_GB_HFI_WAIT, RF_GB_HFI_LIVE };
+#define RF_GB_MAX_STORES 96u
+#define RF_GB_WAIT_NS UINT64_C(500000000)
+
+struct rf_gb_config {
+    uint32_t chip, core_version, hfi_version, hfi_address, log_address;
+    uint32_t xo, cx, mx, vrm, rpmh;
+};
+struct rf_gb_store { uint32_t unit, at, value, mask; };
+struct rf_gb_report {
+    unsigned attempted, stage, phase, stores, polls, released, firmware, hfi, ack;
+    uint32_t last_unit, last_offset, wanted, observed, init, hfi_status, version;
+    uint32_t rsc_status, rsc_busy, tcs[4];
+    struct rf_gb_store program[RF_GB_MAX_STORES];
+    unsigned program_count;
+    int error;
+};
+struct rf_gb_ops {
+    void *context;
+    int (*guard)(void *, unsigned phase);
+    int (*read)(void *, unsigned unit, uint32_t at, uint32_t *);
+    int (*write)(void *, unsigned unit, uint32_t at, uint32_t value);
+    int (*audit)(void *, unsigned phase);
+    int (*exchange)(void *, uint32_t *version);
+    int (*delay)(void *, unsigned us);
+    uint64_t (*time_ns)(void *);
+};
+
+static inline bool rf_gb_config_valid(const struct rf_gb_config *c)
+{
+    return c && c->chip == 0x06020001u && c->core_version &&
+        (c->hfi_version >> 28) == 2 && c->hfi_address == 0x60001000u &&
+        c->log_address == 0x60006000u && c->xo && c->cx && c->mx &&
+        !((c->xo | c->cx | c->mx | c->vrm) & 3u) &&
+        (c->xo >> 16) == 3 && (c->cx >> 16) == 3 && (c->mx >> 16) == 3 &&
+        c->xo != c->cx && c->xo != c->mx && c->cx != c->mx &&
+        (!c->vrm || ((c->vrm >> 16) == 4 && c->vrm <= UINT32_MAX - 4));
+}
+
+static inline int rf_gb_add(struct rf_gb_report *r, unsigned unit, uint32_t at,
+    uint32_t value, uint32_t mask)
+{
+    if (r->program_count == RF_GB_MAX_STORES) return ENOSPC;
+    r->program[r->program_count++] = (struct rf_gb_store){unit, at, value, mask};
+    return 0;
+}
+
+static inline int rf_gb_program(const struct rf_gb_config *c, struct rf_gb_report *r)
+{
+    static const uint32_t rsc_code[] = {0xeaaae5a0,0xe1a1ebab,0xa2e0a581,0xecac82e2,0x0020edad};
+    static const uint32_t pdc_code[] = {0xfebea1e1,0xa5a4a3a2,0x8382a6e0,0xbce3e284,0x002081fc};
+    int error;
+    if (!r || !rf_gb_config_valid(c)) return EINVAL;
+    r->program_count = 0;
+#define RF_GB_ADD(u,a,v,m) do { error=rf_gb_add(r,u,a,v,m); if(error)return error; } while(0)
+    RF_GB_ADD(RF_GB_GMU,0x24c18,UINT32_MAX,0x29); /* Native GMU_AO_INT_MASK. */
+    RF_GB_ADD(RF_GB_GMU,0x1464c,UINT32_MAX,7); /* Native HFI_IRQ_MASK. */
+    RF_GB_ADD(RF_GB_GMU,0x24c10,UINT32_MAX,0); /* Owned local interrupt W1C. */
+    RF_GB_ADD(RF_GB_GMU,0x14644,UINT32_MAX,0);
+    RF_GB_ADD(RF_GB_RSC,0x10,1u<<24,0); /* Disable SDE gating, status/command. */
+    RF_GB_ADD(RF_GB_RSC,0x2c,1,0xff);
+    for (unsigned i=0;i<3;++i) {
+        RF_GB_ADD(RF_GB_RSC,0x38+8*i,i==2?0x80000000u:0,UINT32_MAX);
+        /* Native writes zero, but these hidden destinations are hard-wired
+         * on Redfin (e.g. CMD0 reads 0x82204514). Do not require zero. */
+        RF_GB_ADD(RF_GB_RSC,0x34+8*i,0,0);
+    }
+    RF_GB_ADD(RF_GB_RSC,0x400,0,0xffff);
+    RF_GB_ADD(RF_GB_RSC,0x20,0x4520,0xffff);
+    RF_GB_ADD(RF_GB_RSC,0x24,0x4510,0xffff);
+    RF_GB_ADD(RF_GB_RSC,0x28,0x4514,0xffff);
+    for (unsigned i=0;i<5;++i) RF_GB_ADD(RF_GB_RSC,0x600+4*i,rsc_code[i],UINT32_MAX);
+    for (unsigned i=0;i<5;++i) RF_GB_ADD(RF_GB_SEQ,4*i,pdc_code[i],UINT32_MAX);
+    for (unsigned group=0;group<2;++group) {
+        uint32_t base=4u*(group?0x15d6:0x1572);
+        RF_GB_ADD(RF_GB_PDC,base+4,7,0xffff);
+        RF_GB_ADD(RF_GB_PDC,base+8,0,0xffff);
+        RF_GB_ADD(RF_GB_PDC,base,0,0x1010000);
+        uint32_t addresses[4]={c->mx,c->cx,c->xo,c->vrm?c->vrm+4:0};
+        uint32_t values[4]={group?2u:1u,group?2u:0u,group?3u:0u,group?1u:0u};
+        for (unsigned cmd=0;cmd<(c->vrm?4u:3u);++cmd) {
+            RF_GB_ADD(RF_GB_PDC,base+12+16*cmd,0x10108,0x3ffff);
+            RF_GB_ADD(RF_GB_PDC,base+16+16*cmd,addresses[cmd],UINT32_MAX);
+            RF_GB_ADD(RF_GB_PDC,base+20+16*cmd,values[cmd],UINT32_MAX);
+        }
+    }
+    RF_GB_ADD(RF_GB_PDC,0x4520,0,0xffff);
+    RF_GB_ADD(RF_GB_PDC,0x4500,0x80000001,0x80000001);
+    /* A620 vetoes FAL10; the A642L-only FALNEXT register is not used. */
+    RF_GB_ADD(RF_GB_GMU,0x143c0,1,1);
+    RF_GB_ADD(RF_GB_GMU,0x14070,0,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x14004,2,3);
+    RF_GB_ADD(RF_GB_GMU,0x14614,c->hfi_address,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x14610,1,1);
+    RF_GB_ADD(RF_GB_GMU,0x24c44,0x80a008a0,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x140b4,0x4052,0xffff);
+    RF_GB_ADD(RF_GB_GBIF,0x114,0,7);
+    RF_GB_ADD(RF_GB_GMU,0x14404,0,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x14608,0x06020100,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x14400,c->log_address,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x1303c,1,1);
+    RF_GB_ADD(RF_GB_GMU,0x13000,1,1);
+    RF_GB_ADD(RF_GB_GMU,0x13004,1,1);
+    RF_GB_ADD(RF_GB_GMU,0x14300,0x09c40400,UINT32_MAX);
+    RF_GB_ADD(RF_GB_GMU,0x143a0,c->rpmh|0xf11u,0xf11);
+#undef RF_GB_ADD
+    return 0;
+}
+
+static inline int rf_gb_read(struct rf_gb_report *s,const struct rf_gb_ops *o,
+    unsigned unit,uint32_t at,uint32_t *value)
+{
+    int error=o->guard(o->context,s->phase);
+    if(!error)error=o->read(o->context,unit,at,value);
+    return error;
+}
+static inline int rf_gb_write(struct rf_gb_report *s,const struct rf_gb_ops *o,
+    unsigned unit,uint32_t at,uint32_t value,uint32_t mask)
+{
+    int error=o->guard(o->context,s->phase);
+    if(error)return error;
+    s->last_unit=unit;s->last_offset=at;s->wanted=value;s->observed=0;
+    ++s->stores;
+    error=o->write(o->context,unit,at,value);
+    if(error || !mask)return error;
+    error=rf_gb_read(s,o,unit,at,&s->observed);
+    if(!error && ((s->observed^value)&mask))error=EIO;
+    return error;
+}
+static inline int rf_gb_poll(struct rf_gb_report *s,const struct rf_gb_ops *o,
+    unsigned unit,uint32_t at,uint32_t wanted,uint32_t mask,uint32_t *out)
+{
+    uint64_t first=o->time_ns(o->context);
+    for(unsigned i=0;i<5000;++i) {
+        int error=rf_gb_read(s,o,unit,at,out);if(error)return error;
+        ++s->polls;
+        if((*out&mask)==wanted)return 0;
+        if(o->time_ns(o->context)-first>=RF_GB_WAIT_NS)return ETIMEDOUT;
+        error=o->delay(o->context,100);if(error)return error;
+    }
+    return ETIMEDOUT;
+}
+
+static inline int rf_gb_run(struct rf_gb_report *s,struct rf_gb_config *c,const struct rf_gb_ops *o)
+{
+    int error=EINVAL;
+    if(!s || !c || !o || !o->guard || !o->read || !o->write || !o->audit ||
+        !o->exchange || !o->delay || !o->time_ns)return error;
+    if(s->attempted)return EBUSY;
+    s->attempted=1;s->phase=RF_GB_HELD;s->stage=1;
+    if(!rf_gb_config_valid(c))goto done;
+#define RF_GB_TRY(x) do {error=(x);if(error)goto done;} while(0)
+    RF_GB_TRY(o->guard(o->context,s->phase));
+    RF_GB_TRY(o->audit(o->context,s->phase));
+    RF_GB_TRY(rf_gb_read(s,o,RF_GB_RSC,0x10,&s->rsc_status));
+    RF_GB_TRY(rf_gb_read(s,o,RF_GB_RSC,0x404,&s->rsc_busy));
+    if(s->rsc_busy){error=EBUSY;goto done;}
+    /* A620's separate RSC resource is 4KiB: TCS0/1 only. The generic
+     * native helper also names TCS2/3 beyond this resource; do not follow. */
+    for(unsigned i=0;i<2;++i) {
+        RF_GB_TRY(rf_gb_read(s,o,RF_GB_RSC,4u*(0x346+0xa8*i),&s->tcs[i]));
+        uint32_t control;
+        RF_GB_TRY(rf_gb_read(s,o,RF_GB_RSC,4u*(0x346+0xa8*i)-4,&control));
+        if(control&(1u<<16)){error=EBUSY;goto done;}
+    }
+    RF_GB_TRY(rf_gb_read(s,o,RF_GB_GMU,0x143a0,&c->rpmh));
+    RF_GB_TRY(rf_gb_program(c,s));
+    /* Apply masking before a possible inherited RSC wake; no GIC enables. */
+    for(unsigned i=0;i<4;++i) {
+        struct rf_gb_store *w=&s->program[i];
+        RF_GB_TRY(rf_gb_write(s,o,w->unit,w->at,w->value,w->mask));
+    }
+    if(s->rsc_status&(1u<<16)) {
+        uint32_t ack;
+        RF_GB_TRY(rf_gb_write(s,o,RF_GB_GMU,0x24c1c,2,3));
+        RF_GB_TRY(rf_gb_poll(s,o,RF_GB_GMU,0x24c20,2,2,&ack));
+        RF_GB_TRY(rf_gb_poll(s,o,RF_GB_RSC,0x404,0,UINT32_MAX,&s->rsc_busy));
+        RF_GB_TRY(rf_gb_write(s,o,RF_GB_GMU,0x24c1c,0,3));
+    }
+    s->stage=2;
+    for(unsigned i=4;i<s->program_count;++i) {
+        struct rf_gb_store *w=&s->program[i];
+        RF_GB_TRY(rf_gb_write(s,o,w->unit,w->at,w->value,w->mask));
+    }
+    RF_GB_TRY(o->audit(o->context,s->phase));
+    /* Fresh zero is verified immediately before the sole reset release. */
+    RF_GB_TRY(rf_gb_read(s,o,RF_GB_GMU,0x14070,&s->init));
+    if(s->init){error=EAGAIN;goto done;}
+    s->stage=3;
+    RF_GB_TRY(o->guard(o->context,RF_GB_HELD));
+    s->phase=RF_GB_FW_WAIT;
+    s->last_unit=RF_GB_GMU;s->last_offset=0x14000;s->wanted=0;s->observed=0;
+    ++s->stores;s->released=1;
+    RF_GB_TRY(o->write(o->context,RF_GB_GMU,0x14000,0));
+    uint64_t first=o->time_ns(o->context);
+    error=ETIMEDOUT;
+    for(unsigned i=0;i<5000;++i) {
+        RF_GB_TRY(rf_gb_read(s,o,RF_GB_GMU,0x14070,&s->init));
+        ++s->polls;
+        if(c->core_version>0x20010004u && (s->init&0xe00u)){error=EIO;goto done;}
+        if(redfin_gmu_started(c->core_version,s->init)){error=0;break;}
+        if(o->time_ns(o->context)-first>=RF_GB_WAIT_NS){error=ETIMEDOUT;goto done;}
+        RF_GB_TRY(o->delay(o->context,100));
+        error=ETIMEDOUT;
+    }
+    if(error)goto done;
+    s->firmware=1;s->phase=RF_GB_FW_LIVE;s->stage=4;
+    RF_GB_TRY(o->audit(o->context,s->phase));
+    s->phase=RF_GB_HFI_WAIT;
+    RF_GB_TRY(rf_gb_write(s,o,RF_GB_GMU,0x14618,1,1));
+    RF_GB_TRY(rf_gb_poll(s,o,RF_GB_GMU,0x14600,1,1,&s->hfi_status));
+    s->hfi=1;s->phase=RF_GB_HFI_LIVE;s->stage=5;
+    RF_GB_TRY(o->exchange(o->context,&s->version));
+    if((s->version>>28)!=2u){error=EPROTO;goto done;}
+    s->ack=1;
+    RF_GB_TRY(o->audit(o->context,s->phase));
+    s->stage=6;error=0;
+done:
+    s->error=error;
+#undef RF_GB_TRY
+    return error;
+}
+
+/* HFI v2 ACK: reply type1, original full request header, status, version.
+ * ID126 is a v1 convention and is not required for a v2 response. */
+static inline int rf_gb_version_ack(const uint32_t *words,unsigned count,uint32_t request,
+    uint32_t expected,uint32_t *version)
+{
+    if(!words || !version || count<4 || count>255 || ((words[0]>>8)&255u)!=count ||
+        ((words[0]>>16)&15u)!=1 || words[1]!=request)return EPROTO;
+    if(words[2])return EIO;
+    if((words[3]>>28)!=(expected>>28) ||
+        ((words[3]>>16)&0xfffu)<((expected>>16)&0xfffu))return EPROTONOSUPPORT;
+    *version=words[3];return 0;
+}
+#endif
