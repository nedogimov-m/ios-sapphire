diff --git a/bsd/dev/redfin_gmu_probe.c b/bsd/dev/redfin_gmu_probe.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_probe.c
@@ -0,0 +1,456 @@
+/* SPDX-License-Identifier: MIT */
+/* Exact md0/UP adapter for the separately proved, held-CX GMU TCM leaf. */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <machine/machine_routines.h>
+#include "redfin_gmu_probe.h"
+#include "redfin_gmu_tcm.h"
+#include "redfin_gpu_smmu.h"
+
+extern int redfin_spmi_return_ready(void);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+static bool gm_attempted;
+
+struct gm_binding { const void *live, *expected; unsigned bytes; };
+struct gm_context {
+    vm_offset_t base[3], gic, smmu;
+    const char *parent_args;
+    void *parent_context;
+    redfin_gmu_parent_valid_fn parent_valid;
+    unsigned args_bytes;
+    char args[608];
+    struct gm_binding bindings[14];
+    uint64_t breadcrumbs;
+    unsigned binding_count, dtcm_writes, smmu_reads, smmu_guard, smmu_breadcrumbs;
+    bool active, smmu_requested, smmu_ready;
+};
+
+static const uint64_t gm_reg[] = {
+    0x00100000, 0x1f0000, 0x03d90000, 0x9000,
+    0x03d6a000, 0x30000, 0x17a00000, 0x4000
+};
+static const uint64_t gm_dram_base = 0x180000000ULL, gm_dram_size = 0x80000000ULL;
+static const uint32_t gm_chip = 0x06020001;
+static const uint32_t gm_clock[] = {200000000, 31, 0x4000, 2, 6, 2};
+static const uint32_t gm_tcm[] = {1, 0x10004000, 0x7000, 2, 1, 1000};
+static const uint32_t gm_parent[] = {0x30000, 64, 65535, 7, 416};
+static const uint32_t gm_irqs[] = {336, 337};
+static const uint64_t gm_smmu_reg[] = {0x03da0000, 0x10000};
+static const uint32_t gm_smmu_streams[] = {4, 0x400, 5, 0x400};
+static const uint32_t gm_smmu_format[] = {0x1000, 0x8000, 128, 8, 39, 36};
+static const uint32_t gm_smmu_clocks[][4] = {
+    {RF_GT_GCC, 0x7100c, 0x80000001u, 1},
+    {RF_GT_GCC, 0x71018, 0x80000001u, 1},
+    {RF_GT_GPUCC, 0x1078, 1, 1}, /* Native AHB HALT_DELAY: enable bit only. */
+    {RF_GT_GPUCC, 0x5000, 0x80000001u, 1}
+};
+static const uint32_t gm_smmu_irqs[] = {705, 710, 711, 712, 713, 714, 715, 716, 717};
+
+static bool
+gm_property(struct gm_context *context, const char *path, const char *key,
+    const void *expected, unsigned size)
+{
+    DTEntry node;
+    const void *raw = NULL;
+    unsigned bytes = 0;
+    if (SecureDTLookupEntry(NULL, path, &node) != kSuccess ||
+        SecureDTGetProperty(node, key, &raw, &bytes) != kSuccess ||
+        !raw || bytes != size || memcmp(raw, expected, size))
+        return false;
+    if (context) {
+        if (context->binding_count >= sizeof(context->bindings) / sizeof(context->bindings[0]))
+            return false;
+        struct gm_binding *binding = &context->bindings[context->binding_count++];
+        binding->live = raw;
+        binding->expected = expected;
+        binding->bytes = bytes;
+    }
+    return true;
+}
+
+static bool
+gm_contract(struct gm_context *context, bool smmu)
+{
+    bool base = gm_property(context, "/chosen", "dram-base", &gm_dram_base, sizeof(gm_dram_base)) &&
+        gm_property(context, "/chosen", "dram-size", &gm_dram_size, sizeof(gm_dram_size)) &&
+        gm_property(context, "/redfin-gmu", "reg", gm_reg, sizeof(gm_reg)) &&
+        gm_property(context, "/redfin-gmu", "chip-id", &gm_chip, sizeof(gm_chip)) &&
+        gm_property(context, "/redfin-gmu", "clock-policy", gm_clock, sizeof(gm_clock)) &&
+        gm_property(context, "/redfin-gmu", "tcm-policy", gm_tcm, sizeof(gm_tcm)) &&
+        gm_property(context, "/redfin-gmu", "cx-parent", gm_parent, sizeof(gm_parent)) &&
+        gm_property(context, "/redfin-gmu", "gic-intids", gm_irqs, sizeof(gm_irqs));
+    if (!base || !smmu)
+        return base;
+    return gm_property(context, "/redfin-gpu-smmu", "reg", gm_smmu_reg, sizeof(gm_smmu_reg)) &&
+        gm_property(context, "/redfin-gpu-smmu", "chip-id", &gm_chip, sizeof(gm_chip)) &&
+        gm_property(context, "/redfin-gpu-smmu", "stream-map", gm_smmu_streams, sizeof(gm_smmu_streams)) &&
+        gm_property(context, "/redfin-gpu-smmu", "format-policy", gm_smmu_format, sizeof(gm_smmu_format)) &&
+        gm_property(context, "/redfin-gpu-smmu", "clock-policy", gm_smmu_clocks, sizeof(gm_smmu_clocks)) &&
+        gm_property(context, "/redfin-gpu-smmu", "gic-intids", gm_smmu_irqs, sizeof(gm_smmu_irqs));
+}
+
+int
+redfin_gmu_probe_contract(const char *frozen_args, unsigned args_bytes)
+{
+    const char *live = PE_boot_args();
+    bool smmu = false;
+    if (!redfin_gmu_args_select(frozen_args, args_bytes, &smmu) || !live ||
+        memcmp(live, frozen_args, args_bytes))
+        return ENOTSUP;
+    return gm_contract(NULL, smmu) ? 0 : ENXIO;
+}
+
+static uint32_t
+gm_read32(vm_offset_t address)
+{
+    uint32_t value = *(volatile const uint32_t *)address;
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+static void
+gm_write32(vm_offset_t address, uint32_t value)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)address = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+gm_valid(void *argument)
+{
+    struct gm_context *context = argument;
+    const char *live = PE_boot_args();
+    if (!context || !context->active || !context->args_bytes || !context->parent_args ||
+        !context->parent_context || !context->parent_valid || !live ||
+        memcmp(live, context->args, context->args_bytes) ||
+        memcmp(context->parent_args, context->args, context->args_bytes) ||
+        __builtin_arm_rsr64("CurrentEL") != 4 ||
+        (__builtin_arm_rsr64("MPIDR_EL1") & 0xff00ffffffULL) ||
+        redfin_spmi_return_ready() != 1 || !context->parent_valid(context->parent_context))
+        return false;
+    for (unsigned i = 0; i < context->binding_count; i++) {
+        const struct gm_binding *binding = &context->bindings[i];
+        if (memcmp(binding->live, binding->expected, binding->bytes))
+            return false;
+    }
+    if (context->base[RF_GT_GCC] &&
+        (gm_read32(context->base[RF_GT_GCC] + 0x71004) & 0x80000001u) != 1)
+        return false;
+    if (context->base[RF_GT_GPUCC] &&
+        ((gm_read32(context->base[RF_GT_GPUCC] + 0x106c) & 3u) ||
+         !(gm_read32(context->base[RF_GT_GPUCC] + 0x1540) & 0x80000000u)))
+        return false;
+    if (context->gic) {
+        const uint32_t mask = 3u << 16;
+        if ((gm_read32(context->gic + 0x128) | gm_read32(context->gic + 0x228) |
+                gm_read32(context->gic + 0x328)) & mask)
+            return false;
+        if (context->smmu_requested &&
+            ((gm_read32(context->gic + 0x158) | gm_read32(context->gic + 0x258) |
+                gm_read32(context->gic + 0x358)) & 0x3fc2u))
+            return false;
+    }
+    return true;
+}
+
+/* One message per first register access; no polling-loop log stream. */
+static bool
+gm_breadcrumb(struct gm_context *context, unsigned unit, uint32_t at, bool writing)
+{
+    unsigned index;
+    if (unit == RF_GT_GCC) {
+        switch (at) {
+        case 0: index = 0; break;
+        case 4: index = 1; break;
+        case 0xc: index = 2; break;
+        case 0x40: index = 3; break;
+        case 0x71028: index = 4; break;
+        case 0x52010: index = 5; break;
+        case 0x52000: index = 6; break;
+        case 0x71154: index = 7; break;
+        case 0x7100c: index = 8; break;
+        case 0x71018: index = 9; break;
+        default: return false;
+        }
+    } else if (unit == RF_GT_GPUCC) {
+        switch (at) {
+        case 0x1120: index = 10; break;
+        case 0x1124: index = 11; break;
+        case 0x1078: index = 12; break;
+        case 0x5000: index = 13; break;
+        case 0x1098: index = 14; break;
+        case 0x100c: index = 15; break;
+        case 0x1064: index = 16; break;
+        default: return false;
+        }
+    } else if (unit == RF_GT_GMU) {
+        switch (at) {
+        case 0x14000: index = 17; break;
+        case 0x14070: index = 18; break;
+        case 0x14600: index = 19; break;
+        case 0x14220: index = 20; break;
+        case 0x7000: index = 21; break;
+        case 0x7004: index = 22; break;
+        default: return false;
+        }
+    } else {
+        return false;
+    }
+    if (writing)
+        index += 32;
+    uint64_t bit = UINT64_C(1) << index;
+    if (context->breadcrumbs & bit)
+        return false;
+    context->breadcrumbs |= bit;
+    printf("REDFIN GMU ACCESS: unit=%u offset=%#x first-%s\n", unit, at, writing ? "write" : "read");
+    return true;
+}
+
+static int
+gm_read(void *argument, unsigned unit, uint32_t at, uint32_t *value)
+{
+    struct gm_context *context = argument;
+    if (!value || unit >= 3 || !context->base[unit] || !rf_gt_allowed(unit, at, false))
+        return EINVAL;
+    if (!gm_valid(context))
+        return ECANCELED;
+    if (gm_breadcrumb(context, unit, at, false) && !gm_valid(context))
+        return ECANCELED;
+    *value = gm_read32(context->base[unit] + at);
+    return 0;
+}
+
+static int
+gm_write(void *argument, unsigned unit, uint32_t at, uint32_t value)
+{
+    struct gm_context *context = argument;
+    if (unit >= 3 || !context->base[unit] || !rf_gt_allowed(unit, at, true) ||
+        (unit == RF_GT_GMU && at == 0x14000 && value != 1))
+        return EINVAL;
+    if (!gm_valid(context))
+        return ECANCELED;
+    bool logged = gm_breadcrumb(context, unit, at, true);
+    if (unit == RF_GT_GMU && (at == 0x7000 || at == 0x7004)) {
+        if (context->dtcm_writes++ == 2) {
+            printf("REDFIN GMU STEP: DTCM restore begins; reset held\n");
+            logged = true;
+        }
+    }
+    if (logged && !gm_valid(context))
+        return ECANCELED;
+    gm_write32(context->base[unit] + at, value);
+    return 0;
+}
+
+static void
+gm_delay(void *argument, unsigned microseconds)
+{
+    (void)argument;
+    delay((int)microseconds); /* Leaf delays are bounded to at most 1000us. */
+}
+
+static uint64_t
+gm_time_ns(void *argument)
+{
+    uint64_t nanoseconds;
+    (void)argument;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+    return nanoseconds;
+}
+
+static bool
+gm_smmu_valid(void *argument)
+{
+    struct gm_context *context = argument;
+    struct rf_gt_report source = {0};
+    uint32_t value;
+    if (!context)
+        return false;
+    context->smmu_guard = 1;
+    if (!context->smmu_requested || !context->smmu_ready || !gm_valid(context))
+        return false;
+    const struct rf_gt_ops ops = {.context = context, .valid = gm_valid, .read = gm_read};
+    context->smmu_guard = 2;
+    if (rf_gt_source_live(&ops, &source, true))
+        return false;
+    context->smmu_guard = 3;
+    if (gm_read(context, RF_GT_GCC, 0x71028, &value) || (value & 3u) != 3)
+        return false;
+    for (unsigned i = 0; i < sizeof(gm_smmu_clocks) / sizeof(gm_smmu_clocks[0]); i++) {
+        const uint32_t *clock = gm_smmu_clocks[i];
+        if (gm_read(context, clock[0], clock[1], &value) || (value & clock[2]) != clock[3])
+            return false;
+    }
+    context->smmu_guard = 4;
+    if (gm_read(context, RF_GT_GMU, 0x14000, &value) || value != 1 ||
+        gm_read(context, RF_GT_GMU, 0x14070, &value) || value != 0 ||
+        gm_read(context, RF_GT_GMU, 0x14600, &value) || value != 0)
+        return false;
+    context->smmu_guard = 5;
+    return true;
+}
+
+static bool
+gm_smmu_step(struct gm_context *context, unsigned bit, const char *phase, uint32_t at)
+{
+    if (context->smmu_breadcrumbs & (1u << bit))
+        return false;
+    context->smmu_breadcrumbs |= 1u << bit;
+    printf("REDFIN SMMU ACCESS: phase=%s first-offset=%#x; global-only\n", phase, at);
+    return true;
+}
+
+static int
+gm_smmu_read(void *argument, uint32_t at, uint32_t *value)
+{
+    struct gm_context *context = argument;
+    static const struct rf_gs_snapshot limits = {
+        .page_bytes = 0x1000, .global_bytes = 0x8000,
+        .streams = RF_GS_MAX_STREAMS, .contexts = RF_GS_MAX_CONTEXTS
+    };
+    if (!context || !value || !context->smmu || !rf_gs_read_allowed(at, &limits))
+        return EINVAL;
+    if (!gm_smmu_valid(context))
+        return ECANCELED;
+    bool logged = false;
+    if (at == 0x20)
+        logged = context->smmu_reads ? gm_smmu_step(context, 4, "recheck", at) :
+            gm_smmu_step(context, 0, "ids", at);
+    else if (at == 0)
+        logged = gm_smmu_step(context, 1, "globals", at);
+    else if (at == 0x800)
+        logged = gm_smmu_step(context, 2, "routes", at);
+    else if (at == 0x1000)
+        logged = gm_smmu_step(context, 3, "gr1-metadata", at);
+    if (logged && !gm_smmu_valid(context))
+        return ECANCELED;
+    /* Explicit scalar LDR for HYP-intercepted globals; never a CB page. */
+    uint32_t raw;
+    vm_offset_t address = context->smmu + at;
+    __asm__ volatile("ldr %w0, [%1]" : "=r"(raw) : "r"(address) : "memory");
+    __asm__ volatile("dmb oshld" ::: "memory");
+    *value = raw;
+    context->smmu_reads++;
+    return 0;
+}
+
+static int
+gm_smmu_run(struct gm_context *context, const struct rf_gt_report *gmu)
+{
+    struct rf_gs_snapshot snapshot = {0};
+    int result = EPERM;
+    if (!gmu->error && gmu->stage == RF_GT_DONE && gmu->reset_held && gmu->source_200m &&
+        gmu->counter_live && gmu->dtcm_restored && !gmu->dtcm_dirty) {
+        context->smmu_ready = true;
+        printf("REDFIN SMMU STEP: fresh GMU DONE; recheck held parent/source/reset/IRQs\n");
+        if (!gm_smmu_valid(context)) {
+            result = ECANCELED;
+        } else {
+            context->smmu = ml_io_map(RF_GS_PHYS, RF_GS_BYTES / 2);
+            if (!context->smmu) {
+                result = ENOMEM;
+            } else {
+                const struct rf_gs_ops ops = {context, gm_smmu_valid, gm_smmu_read};
+                result = rf_gs_snapshot_run(&ops, gm_chip, &snapshot);
+            }
+        }
+    }
+    printf("REDFIN SMMU: result=%d stage=%u guard=%u reads=%u completed=%u stable=%u format=%u changed=%#x; no CB/write/table ownership\n",
+        result, snapshot.stage, context->smmu_guard, snapshot.reads, context->smmu_reads,
+        snapshot.stable, snapshot.map_format_supported, snapshot.changed_offset);
+    printf("REDFIN SMMU IDS: complete=%u IDR=%#x/%#x/%#x/%#x page=%#x global=%#x streams=%u contexts=%u stage2=%u bits=%u/%u/%u/%u\n",
+        context->smmu_reads >= 4, snapshot.id0, snapshot.id1, snapshot.id2, snapshot.id7,
+        snapshot.page_bytes, snapshot.global_bytes, snapshot.streams, snapshot.contexts,
+        snapshot.stage2_contexts, snapshot.sid_bits, snapshot.input_bits,
+        snapshot.output_bits, snapshot.virtual_bits);
+    if (snapshot.stage >= 3) {
+        printf("REDFIN SMMU GLOBAL: first-pass CR0=%#x GFSR=%#x syndrome=%#x/%#x/%#x\n",
+            snapshot.control, snapshot.fault, snapshot.syndrome[0], snapshot.syndrome[1], snapshot.syndrome[2]);
+        for (unsigned i = 0; i < snapshot.streams && i < RF_GS_MAX_STREAMS; i++)
+            printf("REDFIN SMMU ROUTE: first-pass slot=%u SMR=%#x S2CR=%#x\n", i, snapshot.smr[i], snapshot.s2cr[i]);
+        for (unsigned i = 0; i < snapshot.contexts && i < RF_GS_MAX_CONTEXTS; i++)
+            printf("REDFIN SMMU GR1: first-pass bank=%u CBAR=%#x CBA2R=%#x\n", i, snapshot.cbar[i], snapshot.cba2r[i]);
+    }
+    if (snapshot.stable)
+        printf("REDFIN SMMU ANALYSIS: stream4=%u/%u stream5=%u/%u unreferenced=%#x malformed=%u; unreferenced is not owned\n",
+            snapshot.gmu_matches[0], snapshot.gmu_slot[0], snapshot.gmu_matches[1], snapshot.gmu_slot[1],
+            snapshot.unreferenced_mask, snapshot.malformed_routes);
+    return result;
+}
+
+int
+redfin_gmu_probe(const char *frozen_args, unsigned args_bytes,
+    void *held_cx_context, redfin_gmu_parent_valid_fn held_cx_valid)
+{
+    struct gm_context context = {0};
+    struct rf_gt_report report = {0};
+    int result;
+    if (__atomic_exchange_n(&gm_attempted, true, __ATOMIC_ACQ_REL))
+        return EBUSY;
+    result = redfin_gmu_probe_contract(frozen_args, args_bytes);
+    if (result)
+        return result;
+    if (!held_cx_context || !held_cx_valid)
+        return EINVAL;
+    context.parent_args = frozen_args;
+    context.parent_context = held_cx_context;
+    context.parent_valid = held_cx_valid;
+    context.args_bytes = args_bytes;
+    memcpy(context.args, frozen_args, args_bytes);
+    if (!redfin_gmu_args_select(frozen_args, args_bytes, &context.smmu_requested))
+        return ENOTSUP;
+    context.active = true;
+    if (!gm_contract(&context, context.smmu_requested) || !gm_valid(&context))
+        return EPERM;
+    context.base[RF_GT_GCC] = ml_io_map(0x100000, 0x1f0000);
+    if (!context.base[RF_GT_GCC])
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    context.base[RF_GT_GPUCC] = ml_io_map(0x3d90000, 0x9000);
+    if (!context.base[RF_GT_GPUCC])
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    context.gic = ml_io_map(0x17a00000, 0x4000);
+    if (!context.gic)
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    context.base[RF_GT_GMU] = ml_io_map(0x3d6a000, 0x30000);
+    if (!context.base[RF_GT_GMU])
+        return ENOMEM;
+    if (!gm_valid(&context))
+        return EAGAIN;
+    const struct rf_gt_ops ops = {&context, gm_valid, gm_read, gm_write, gm_delay, gm_time_ns};
+    printf("REDFIN GMU STEP: clock preflight begins; CM3 release is forbidden\n");
+    result = rf_gt_run(&ops, gm_chip, &report);
+    if (!context.smmu_requested || result)
+        context.active = false;
+    printf("REDFIN GMU: result=%d stage=%u reads=%u writes=%u polls=%u source200=%u counter=%u restored=%u dirty=%u; no firmware/DMA/GX\n",
+        result, report.stage, report.reads, report.writes, report.polls, report.source_200m,
+        report.counter_live, report.dtcm_restored, report.dtcm_dirty);
+    printf("REDFIN GMU CLOCK: MODE=%#x L=%#x USER=%#x ALPHA=%#x MISC=%#x source=%#x/%#x branch=%#x/%#x CX=%#x HW=%#x GX=%#x\n",
+        report.pll_mode, report.pll_l, report.pll_user, report.pll_alpha, report.misc,
+        report.source_before, report.source_after, report.gmu_clock_before,
+        report.gmu_clock_after, report.cx, report.cx_hw, report.gx);
+    printf("REDFIN GMU RESET: before=%#x after=%#x asserted=%u INIT=%#x HFI=%#x counter=%#x/%#x delta=%u elapsed-ns=%llu\n",
+        report.reset_before, report.reset_after, report.reset_held, report.result_before,
+        report.hfi_before, report.counter_before, report.counter_after, report.counter_delta,
+        (unsigned long long)report.counter_elapsed_ns);
+    printf("REDFIN GMU TCM: saved=%#x/%#x pattern=%#x/%#x restored=%#x/%#x\n",
+        report.saved[0], report.saved[1], report.pattern_read[0], report.pattern_read[1],
+        report.restored[0], report.restored[1]);
+    if (context.smmu_requested && !result)
+        result = gm_smmu_run(&context, &report);
+    context.active = false;
+    return result;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/redfin_gmu_probe.h b/bsd/dev/redfin_gmu_probe.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_probe.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: MIT */
+/* Synchronous Redfin reset-held GMU probe; no standalone power authority. */
+#ifndef REDFIN_GMU_PROBE_H
+#define REDFIN_GMU_PROBE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+typedef bool (*redfin_gmu_parent_valid_fn)(void *);
+
+/*
+ * bytes includes the NUL; every word and the nonzero boot nonce is unique.
+ * The optional read-only SMMU mode adds exactly one redfinsmmu=1. A rejected
+ * argument list leaves the optional selection output unchanged.
+ */
+static inline bool
+redfin_gmu_args_select(const char *args, unsigned bytes, bool *smmu_requested)
+{
+    static const char *const required[] = {
+        "debug=0xc", "serial=3", "cpus=1", "keepsyms=1", "-noprogress", "rd=md0",
+        "sweettouch=0", "sweetkeys=0", "sweetusb=0", "sweetcpufreq=0", "sweetbattery=0",
+        "modem=0", "wifi=0", "gpu=0", "redfingpu=2", "redfingpupower=1",
+        "redfinrpmh=1", "redfinspmi=1", "redfinreturn=1", "redfingmu=1"
+    };
+    uint32_t seen = 0;
+    bool nonce_seen = false, trace_seen = false, smmu_seen = false;
+    unsigned at = 0;
+    if (!args || !bytes || bytes > 608 || args[bytes - 1])
+        return false;
+    while (at < bytes - 1) {
+        unsigned first, n, i;
+        bool known = false;
+        if (args[at] == ' ') { at++; continue; }
+        first = at;
+        while (at < bytes - 1 && args[at] != ' ') {
+            if ((unsigned char)args[at] < 33 || (unsigned char)args[at] > 126)
+                return false;
+            at++;
+        }
+        n = at - first;
+        for (i = 0; i < sizeof(required) / sizeof(required[0]); i++) {
+            unsigned length = 0;
+            while (required[i][length]) length++;
+            if (length != n) continue;
+            unsigned j;
+            for (j = 0; j < n && args[first + j] == required[i][j]; j++) {}
+            if (j != n) continue;
+            if (seen & (1u << i)) return false;
+            seen |= 1u << i;
+            known = true;
+            break;
+        }
+        if (known) continue;
+        static const char smmu[] = "redfinsmmu=1";
+        if (n == sizeof(smmu) - 1) {
+            for (i = 0; i < n && args[first + i] == smmu[i]; i++) {}
+            if (i == n) {
+                if (smmu_seen) return false;
+                smmu_seen = true;
+                continue;
+            }
+        }
+        static const char trace[] = "-enable_kprintf_spam";
+        if (n == sizeof(trace) - 1) {
+            for (i = 0; i < n && args[first + i] == trace[i]; i++) {}
+            if (i == n) {
+                if (trace_seen) return false;
+                trace_seen = true;
+                continue;
+            }
+        }
+        static const char prefix[] = "redfinbootid=0x";
+        if (n == 31) {
+            for (i = 0; i < sizeof(prefix) - 1 && args[first + i] == prefix[i]; i++) {}
+            if (i == sizeof(prefix) - 1) {
+                uint64_t nonce = 0;
+                if (nonce_seen) return false;
+                for (; i < n; i++) {
+                    unsigned digit = (unsigned)(args[first + i] - '0');
+                    if (digit > 9) {
+                        if (args[first + i] < 'a' || args[first + i] > 'f') return false;
+                        digit = (unsigned)(args[first + i] - 'a' + 10);
+                    }
+                    nonce = (nonce << 4) | digit;
+                }
+                if (!nonce) return false;
+                nonce_seen = true;
+                continue;
+            }
+        }
+        return false;
+    }
+    if (seen != (1u << (sizeof(required) / sizeof(required[0]))) - 1 || !nonce_seen)
+        return false;
+    if (smmu_requested)
+        *smmu_requested = smmu_seen;
+    return true;
+}
+
+static inline bool
+redfin_gmu_args_valid(const char *args, unsigned bytes)
+{
+    return redfin_gmu_args_select(args, bytes, NULL);
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Read-only DT/argument validation before the parent's first power write.
+ * A selected SMMU mode additionally requires its complete exact ADT leaf.
+ */
+int redfin_gmu_probe_contract(const char *frozen_args, unsigned args_bytes);
+
+/*
+ * Call only after successful RF_GP_OK/parent_held/cx_on in the same exact mode.
+ * The parent's callback must revalidate that owned result and its original
+ * frozen argument/context lifetime. No callback or argument is retained after
+ * this synchronous function returns. It never releases the parent's ARC vote.
+ * A selected read-only SMMU snapshot runs only after this call's successful
+ * reset-held TCM leaf and fresh parent/source/reset/IRQ proofs; no SMMU
+ * write, context-bank access, table install or firmware start is provided.
+ */
+int redfin_gmu_probe(const char *frozen_args, unsigned args_bytes,
+    void *held_cx_context, redfin_gmu_parent_valid_fn held_cx_valid);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* REDFIN_GMU_PROBE_H */
diff --git a/bsd/dev/redfin_gmu_tcm.h b/bsd/dev/redfin_gmu_tcm.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gmu_tcm.h
@@ -0,0 +1,390 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Lito-only, reset-held GMU clock/counter/TCM experiment. References: GMU.md.
+ * This does not start CM3, configure SMMU/GX/PDC/RSC, or load firmware.
+ * The caller must own a bounded single-CPU md0 session, fresh CX power and
+ * its held ARC floor, exclusive GCC/GPUCC/GMU clock access and reset return.
+ * Added votes/clocks stay held until that platform reset. Only the two DTCM
+ * words and the RCG's initial force-enable bit are restored here.
+ */
+#ifndef REDFIN_GMU_TCM_H
+#define REDFIN_GMU_TCM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/errno.h>
+
+enum { RF_GT_GCC, RF_GT_GPUCC, RF_GT_GMU };
+enum {
+    RF_GT_PREFLIGHT = 1, RF_GT_BUS_CLOCKS, RF_GT_RESET, RF_GT_SOURCE,
+    RF_GT_CORE_CLOCK, RF_GT_COUNTER, RF_GT_SAVE, RF_GT_PATTERN,
+    RF_GT_RESTORE, RF_GT_DONE
+};
+
+struct rf_gt_ops {
+    void *context;
+    /* Recheck the exact A620/UP/md0/power/clock/return lifetime each time. */
+    bool (*valid)(void *);
+    /* Ordered 32-bit Device MMIO; return positive errno on failure. */
+    int (*read)(void *, unsigned, uint32_t, uint32_t *);
+    int (*write)(void *, unsigned, uint32_t, uint32_t);
+    /* Bounded busy wait in microseconds; no thread sleep or rescheduling. */
+    void (*delay)(void *, unsigned);
+    /* CPU monotonic time; no Device MMIO or scheduling in this callback. */
+    uint64_t (*time_ns)(void *);
+};
+
+struct rf_gt_report {
+    uint32_t stage, error, reads, writes, polls;
+    uint32_t pll_mode, pll_l, pll_user, pll_alpha;
+    uint32_t pll_vote_before, feed_before, misc, cx, cx_hw, gx;
+    uint32_t rcg_before, source_before, gmu_clock_before;
+    uint32_t reset_before, result_before, hfi_before;
+    uint32_t reset_after, source_after, gmu_clock_after;
+    uint32_t counter_before, counter_after, counter_delta;
+    uint32_t saved[2], pattern_read[2], restored[2];
+    uint64_t counter_elapsed_ns;
+    bool reset_held, source_200m, counter_live, dtcm_dirty, dtcm_restored;
+};
+
+/* Narrow callback allowlist; the adapter must enforce its own bound lease. */
+static inline bool
+rf_gt_allowed(unsigned unit, uint32_t at, bool writing)
+{
+    if (unit == RF_GT_GCC) {
+        switch (at) {
+        case 0x52010: case 0x52000: case 0x71154: case 0x7100c: case 0x71018:
+            return true;
+        case 0: case 4: case 0xc: case 0x40: case 0x71004: case 0x71028:
+            return !writing;
+        default: return false;
+        }
+    }
+    if (unit == RF_GT_GPUCC) {
+        switch (at) {
+        case 0x1078: case 0x109c: case 0x5000: case 0x1120: case 0x1124: case 0x1098:
+            return true;
+        case 0x106c: case 0x1540: case 0x100c: case 0x1064:
+            return !writing;
+        default: return false;
+        }
+    }
+    if (unit == RF_GT_GMU) {
+        switch (at) {
+        case 0x14000: case 0x7000: case 0x7004:
+            return true;
+        case 0x14070: case 0x14600: case 0x14220:
+            return !writing;
+        default: return false;
+        }
+    }
+    return false;
+}
+
+static inline int
+rf_gt_rd(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t *value)
+{
+    if (!rf_gt_allowed(unit, at, false))
+        return EINVAL;
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    r->reads++;
+    return ops->read(ops->context, unit, at, value);
+}
+
+static inline int
+rf_gt_wr(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t value)
+{
+    if (!rf_gt_allowed(unit, at, true) ||
+        (unit == RF_GT_GMU && at == 0x14000 && value != 1))
+        return EINVAL;
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    r->writes++;
+    return ops->write(ops->context, unit, at, value);
+}
+
+static inline int
+rf_gt_delay(const struct rf_gt_ops *ops, unsigned us)
+{
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    ops->delay(ops->context, us);
+    return ops->valid(ops->context) ? 0 : ECANCELED;
+}
+
+static inline int
+rf_gt_poll(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t mask, uint32_t expected, unsigned limit)
+{
+    uint32_t value;
+    unsigned i;
+    int error;
+    for (i = 0; i < limit; i++) {
+        error = rf_gt_rd(ops, r, unit, at, &value);
+        if (error)
+            return error;
+        r->polls++;
+        if ((value & mask) == expected)
+            return 0;
+        error = rf_gt_delay(ops, 1);
+        if (error)
+            return error;
+    }
+    return ETIMEDOUT;
+}
+
+static inline int
+rf_gt_update(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, uint32_t mask, uint32_t value)
+{
+    uint32_t before, after;
+    int error = rf_gt_rd(ops, r, unit, at, &before);
+    if (error)
+        return error;
+    error = rf_gt_wr(ops, r, unit, at, (before & ~mask) | (value & mask));
+    if (error)
+        return error;
+    error = rf_gt_rd(ops, r, unit, at, &after);
+    if (error)
+        return error;
+    return (after & mask) == (value & mask) ? 0 : EIO;
+}
+
+static inline bool
+rf_gt_pll_identity(uint32_t mode, uint32_t l, uint32_t user, uint32_t alpha)
+{
+    /* Locked/active FSM, all native outputs on, even postdivision /2. */
+    return (mode & 0xc0100000u) == 0xc0100000u && l == 31 &&
+        (user & 0xf07u) == 0x107u && alpha == 0x4000;
+}
+
+static inline int
+rf_gt_source_live(const struct rf_gt_ops *ops, struct rf_gt_report *r, bool running)
+{
+    uint32_t v[15];
+    static const struct { unsigned unit; uint32_t at; } registers[15] = {
+        {RF_GT_GCC, 0x71004}, {RF_GT_GPUCC, 0x106c},
+        {RF_GT_GCC, 0}, {RF_GT_GCC, 4}, {RF_GT_GCC, 0xc}, {RF_GT_GCC, 0x40},
+        {RF_GT_GCC, 0x52010}, {RF_GT_GCC, 0x52000},
+        {RF_GT_GPUCC, 0x1124}, {RF_GT_GPUCC, 0x1120},
+        {RF_GT_GPUCC, 0x1098}, {RF_GT_GPUCC, 0x109c},
+        {RF_GT_GPUCC, 0x100c}, {RF_GT_GPUCC, 0x1064}, {RF_GT_GPUCC, 0x1540}
+    };
+    unsigned i;
+    int error;
+    for (i = 0; i < 15; i++) {
+        error = rf_gt_rd(ops, r, registers[i].unit, registers[i].at, &v[i]);
+        if (error)
+            return error;
+    }
+    if ((v[0] & 0x80000001u) != 1 || (v[1] & 3u) || !(v[14] & 0x80000000u) ||
+        !rf_gt_pll_identity(v[2], v[3], v[4], v[5]) ||
+        !(v[6] & 1) || !(v[7] & 0x10000u) || (v[11] & 0x80000001u) != 1 ||
+        (v[12] & 0x80000001u) != 1 ||
+        (v[13] & 0x80000001u) != 0x80000000u)
+        return EAGAIN;
+    if (!running && (v[10] & 0x80000001u) != 0x80000000u)
+        return EBUSY;
+    if (running && ((v[8] & 0x10371fu) != 0x602 ||
+            (v[9] & 0x80000001u) != 0 || (v[10] & 0x80000001u) != 1))
+        return EAGAIN;
+    return 0;
+}
+
+/* CSR access with fresh power/source proof; data access also verifies reset. */
+static inline int
+rf_gt_gmu_rd(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    uint32_t at, uint32_t *value, bool running, bool data)
+{
+    uint32_t reset;
+    int error = rf_gt_source_live(ops, r, running);
+    if (error)
+        return error;
+    if (data) {
+        error = rf_gt_rd(ops, r, RF_GT_GMU, 0x14000, &reset);
+        if (error)
+            return error;
+        if (reset != 1)
+            return EAGAIN;
+    }
+    return rf_gt_rd(ops, r, RF_GT_GMU, at, value);
+}
+
+static inline int
+rf_gt_gmu_wr(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    uint32_t at, uint32_t value, bool running, bool data)
+{
+    uint32_t reset;
+    int error = rf_gt_source_live(ops, r, running);
+    if (error)
+        return error;
+    if (data) {
+        error = rf_gt_rd(ops, r, RF_GT_GMU, 0x14000, &reset);
+        if (error)
+            return error;
+        if (reset != 1)
+            return EAGAIN;
+    }
+    return rf_gt_wr(ops, r, RF_GT_GMU, at, value);
+}
+
+static inline int
+rf_gt_branch(const struct rf_gt_ops *ops, struct rf_gt_report *r,
+    unsigned unit, uint32_t at, bool halt_delay)
+{
+    uint32_t before;
+    int error = rf_gt_rd(ops, r, unit, at, &before);
+    if (error)
+        return error;
+    error = rf_gt_wr(ops, r, unit, at, before | 1u);
+    if (error)
+        return error;
+    /* Native GPUCC AHB completion is a delay, not a reliable HALT bit. */
+    if (halt_delay)
+        return rf_gt_delay(ops, 10);
+    return rf_gt_poll(ops, r, unit, at, 0x80000001u, 1, 200);
+}
+
+static inline int
+rf_gt_run(const struct rf_gt_ops *ops, uint32_t chip, struct rf_gt_report *output)
+{
+    struct rf_gt_report r = {0};
+    uint32_t value, gmu_gx, cfg, command, reset;
+    uint64_t time_before, time_after, expected_ticks;
+    static const uint32_t pattern[2] = {0x62a00d01u, 0xa062f00du};
+    unsigned i;
+    int error = EINVAL, pattern_error = 0;
+
+    if (!output)
+        return EINVAL;
+    if (chip != 0x06020001u || !ops || !ops->valid || !ops->read ||
+        !ops->write || !ops->delay || !ops->time_ns)
+        goto done;
+    r.stage = RF_GT_PREFLIGHT;
+#define RF_GT_TRY(action) do { error = (action); if (error) goto done; } while (0)
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x71004, &value));
+    if ((value & 0x80000001u) != 1) { error = EAGAIN; goto done; }
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x106c, &r.cx));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1540, &r.cx_hw));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x100c, &r.gx));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1064, &gmu_gx));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1098, &r.gmu_clock_before));
+    if ((r.cx & 3u) || !(r.cx_hw & 0x80000000u) ||
+        (r.gx & 0x80000001u) != 1 ||
+        (gmu_gx & 0x80000001u) != 0x80000000u ||
+        (r.gmu_clock_before & 0x80000001u) != 0x80000000u) {
+        error = EBUSY; goto done;
+    }
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0, &r.pll_mode));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 4, &r.pll_l));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0xc, &r.pll_user));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x40, &r.pll_alpha));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x71028, &r.misc));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x52010, &r.pll_vote_before));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GCC, 0x52000, &r.feed_before));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1120, &r.rcg_before));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1124, &r.source_before));
+    if (!rf_gt_pll_identity(r.pll_mode, r.pll_l, r.pll_user, r.pll_alpha) ||
+        (r.misc & 3u) != 3 || (r.rcg_before & 0xf1u)) {
+        error = EAGAIN; goto done;
+    }
+
+    r.stage = RF_GT_BUS_CLOCKS;
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GCC, 0x52010, 1, 1));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GCC, 0x52000, 0x10000, 0x10000));
+    RF_GT_TRY(rf_gt_delay(ops, 10)); /* Divided feed uses BRANCH_HALT_DELAY. */
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GCC, 0x71154, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GCC, 0x7100c, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GCC, 0x71018, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x109c, false));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x1078, true));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x5000, false));
+
+    /* Do not clock an ambiguous inherited processor before holding reset. */
+    r.stage = RF_GT_RESET;
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14000, &r.reset_before, false, false));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14070, &r.result_before, false, false));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14600, &r.hfi_before, false, false));
+    if (r.reset_before > 1 || r.result_before != 0 || r.hfi_before != 0) {
+        error = EBUSY; goto done;
+    }
+    RF_GT_TRY(rf_gt_gmu_wr(ops, &r, 0x14000, 1, false, false));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14000, &r.reset_after, false, false));
+    if (r.reset_after != 1) { error = EIO; goto done; }
+    r.reset_held = true;
+
+    r.stage = RF_GT_SOURCE;
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1120, 2, 2));
+    RF_GT_TRY(rf_gt_poll(ops, &r, RF_GT_GPUCC, 0x1120, 0x80000000u, 0, 500));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1124, 0x10371f, 0x602));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1120, &command));
+    RF_GT_TRY(rf_gt_wr(ops, &r, RF_GT_GPUCC, 0x1120, command | 1));
+    RF_GT_TRY(rf_gt_poll(ops, &r, RF_GT_GPUCC, 0x1120, 1, 0, 500));
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1120, 2, r.rcg_before & 2u));
+
+    r.stage = RF_GT_CORE_CLOCK;
+    RF_GT_TRY(rf_gt_update(ops, &r, RF_GT_GPUCC, 0x1098, 0xff0, 0xff0));
+    RF_GT_TRY(rf_gt_branch(ops, &r, RF_GT_GPUCC, 0x1098, false));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1124, &r.source_after));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1098, &r.gmu_clock_after));
+    RF_GT_TRY(rf_gt_source_live(ops, &r, true));
+    r.source_200m = true;
+
+    r.stage = RF_GT_COUNTER;
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14220, &r.counter_before, true, true));
+    time_before = ops->time_ns(ops->context);
+    RF_GT_TRY(rf_gt_delay(ops, 1000));
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14220, &r.counter_after, true, true));
+    time_after = ops->time_ns(ops->context);
+    r.counter_delta = r.counter_after - r.counter_before;
+    if (time_after <= time_before || time_after - time_before < 1000000 ||
+        time_after - time_before > 10000000) {
+        error = ETIMEDOUT; goto done;
+    }
+    r.counter_elapsed_ns = time_after - time_before;
+    expected_ticks = r.counter_elapsed_ns * 192u / 10000u;
+    if ((uint64_t)r.counter_delta * 5 < expected_ticks * 4 ||
+        (uint64_t)r.counter_delta * 5 > expected_ticks * 6) {
+        error = ETIMEDOUT; goto done;
+    }
+    r.counter_live = true;
+
+    r.stage = RF_GT_SAVE;
+    for (i = 0; i < 2; i++)
+        RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x7000 + 4*i, &r.saved[i], true, true));
+    r.stage = RF_GT_PATTERN;
+    for (i = 0; i < 2; i++) {
+        r.dtcm_dirty = true; /* A failed write may have partially completed. */
+        RF_GT_TRY(rf_gt_gmu_wr(ops, &r, 0x7000 + 4*i, pattern[i], true, true));
+    }
+    for (i = 0; i < 2; i++) {
+        RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x7000 + 4*i, &r.pattern_read[i], true, true));
+        if (r.pattern_read[i] != pattern[i])
+            pattern_error = EIO;
+    }
+    r.stage = RF_GT_RESTORE;
+    for (i = 0; i < 2; i++)
+        RF_GT_TRY(rf_gt_gmu_wr(ops, &r, 0x7000 + 4*i, r.saved[i], true, true));
+    for (i = 0; i < 2; i++) {
+        RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x7000 + 4*i, &r.restored[i], true, true));
+        if (r.restored[i] != r.saved[i]) { error = EIO; goto done; }
+    }
+    r.dtcm_dirty = false;
+    r.dtcm_restored = true;
+    if (pattern_error) { error = pattern_error; goto done; }
+    RF_GT_TRY(rf_gt_gmu_rd(ops, &r, 0x14000, &reset, true, false));
+    RF_GT_TRY(rf_gt_rd(ops, &r, RF_GT_GPUCC, 0x1124, &cfg));
+    if (reset != 1 || (cfg & 0x10371fu) != 0x602) { error = EAGAIN; goto done; }
+    r.stage = RF_GT_DONE;
+    error = 0;
+done:
+#undef RF_GT_TRY
+    r.error = (uint32_t)error;
+    *output = r;
+    return error;
+}
+
+#endif /* REDFIN_GMU_TCM_H */
diff --git a/bsd/dev/redfin_gpu_smmu.h b/bsd/dev/redfin_gpu_smmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gpu_smmu.h
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * A620 GPU-SMMUv2 read-only global snapshot. Native Google msm and preferred
+ * HackiOS references are pinned in ../GPU-SMMU.md. No context-bank registers,
+ * TCU/TBU registers, fault acknowledgements, TLB operations or writes exist
+ * in this interface. A stable snapshot is not an ownership grant.
+ */
+#ifndef REDFIN_GPU_SMMU_H
+#define REDFIN_GPU_SMMU_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/errno.h>
+
+#define RF_GS_CHIP 0x06020001u
+#define RF_GS_PHYS 0x03da0000u
+#define RF_GS_BYTES 0x10000u
+#define RF_GS_MAX_STREAMS 128u
+#define RF_GS_MAX_CONTEXTS 8u
+
+struct rf_gs_ops {
+    void *context;
+    /* Held CX/clocks, reset-held GMU/GX, exact mode and IRQ/return lifetime. */
+    bool (*valid)(void *);
+    /* Ordered, explicit scalar LDR; positive errno, no implicit mappings. */
+    int (*read)(void *, uint32_t, uint32_t *);
+};
+
+struct rf_gs_snapshot {
+    uint32_t stage, error, reads, changed_offset;
+    uint32_t id0, id1, id2, id7, control, fault, syndrome[3];
+    uint32_t page_bytes, global_bytes, streams, contexts, stage2_contexts;
+    uint32_t sid_bits, input_bits, output_bits, virtual_bits;
+    uint32_t smr[RF_GS_MAX_STREAMS], s2cr[RF_GS_MAX_STREAMS];
+    uint32_t cbar[RF_GS_MAX_CONTEXTS], cba2r[RF_GS_MAX_CONTEXTS];
+    uint32_t references[RF_GS_MAX_CONTEXTS], active_references[RF_GS_MAX_CONTEXTS];
+    uint32_t gmu_matches[2], gmu_slot[2], unreferenced_mask;
+    uint32_t malformed_routes;
+    bool stable, map_format_supported;
+};
+
+static inline uint32_t
+rf_gs_address_bits(uint32_t code)
+{
+    static const uint32_t bits[] = {32, 36, 40, 42, 44, 48};
+    return code < sizeof(bits) / sizeof(bits[0]) ? bits[code] : 0;
+}
+
+static inline bool
+rf_gs_read_allowed(uint32_t at, const struct rf_gs_snapshot *s)
+{
+    switch (at) {
+    case 0: case 0x20: case 0x24: case 0x28: case 0x3c:
+    case 0x48: case 0x50: case 0x54: case 0x58:
+        return true;
+    default: break;
+    }
+    if (!s || (at & 3) || s->streams > RF_GS_MAX_STREAMS ||
+        s->contexts > RF_GS_MAX_CONTEXTS || s->page_bytes != 0x1000 ||
+        s->global_bytes != 0x8000)
+        return false;
+    if ((at >= 0x800 && at - 0x800 < s->streams * 4) ||
+        (at >= 0xc00 && at - 0xc00 < s->streams * 4))
+        return true;
+    /* GR1 metadata only; the first context's own page starts at +0x8000. */
+    return (at >= 0x1000 && at - 0x1000 < s->contexts * 4) ||
+        (at >= 0x1800 && at - 0x1800 < s->contexts * 4);
+}
+
+static inline int
+rf_gs_read(const struct rf_gs_ops *ops, struct rf_gs_snapshot *s,
+    uint32_t at, uint32_t *value)
+{
+    if (!rf_gs_read_allowed(at, s))
+        return EINVAL;
+    if (!ops->valid(ops->context))
+        return ECANCELED;
+    s->reads++;
+    return ops->read(ops->context, at, value);
+}
+
+static inline bool
+rf_gs_stream_matches(uint32_t smr, uint32_t stream)
+{
+    uint32_t mask = (smr >> 16) & 0x7fffu;
+    return (smr & 0x80000000u) && !((stream ^ (smr & 0x7fffu)) & ~mask & 0x7fffu);
+}
+
+static inline int
+rf_gs_compare(const struct rf_gs_ops *ops, struct rf_gs_snapshot *s,
+    uint32_t at, uint32_t previous)
+{
+    uint32_t now;
+    int error = rf_gs_read(ops, s, at, &now);
+    if (error)
+        return error;
+    if (now != previous) {
+        s->changed_offset = at;
+        return EAGAIN;
+    }
+    return 0;
+}
+
+static inline int
+rf_gs_snapshot_run(const struct rf_gs_ops *ops, uint32_t chip,
+    struct rf_gs_snapshot *s)
+{
+    unsigned i, which;
+    uint32_t reference_mask = 0;
+    int error = EINVAL;
+    if (!s)
+        return EINVAL;
+    *s = (struct rf_gs_snapshot){0};
+    if (chip != RF_GS_CHIP || !ops || !ops->valid || !ops->read)
+        goto done;
+#define RF_GS_TRY(action) do { error = (action); if (error) goto done; } while (0)
+    s->stage = 1;
+    RF_GS_TRY(rf_gs_read(ops, s, 0x20, &s->id0));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x24, &s->id1));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x28, &s->id2));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x3c, &s->id7));
+    s->page_bytes = (s->id1 & 0x80000000u) ? 0x10000u : 0x1000u;
+    s->global_bytes = s->page_bytes << (((s->id1 >> 28) & 7u) + 1);
+    s->streams = s->id0 & 0xffu;
+    s->contexts = s->id1 & 0xffu;
+    s->stage2_contexts = (s->id1 >> 16) & 0xffu;
+    s->sid_bits = (s->id0 >> 9) & 15u;
+    s->input_bits = rf_gs_address_bits(s->id2 & 15u);
+    s->output_bits = rf_gs_address_bits((s->id2 >> 4) & 15u);
+    s->virtual_bits = rf_gs_address_bits((s->id2 >> 8) & 15u);
+    if (!(s->id0 & (1u << 30)) || !(s->id0 & (1u << 27)) || (s->id0 & (1u << 8)) ||
+        s->page_bytes != 0x1000 || s->global_bytes != RF_GS_BYTES / 2 ||
+        !s->streams || s->streams > RF_GS_MAX_STREAMS ||
+        !s->contexts || s->contexts > RF_GS_MAX_CONTEXTS ||
+        s->stage2_contexts > s->contexts || !s->sid_bits)
+    { error = ENOTSUP; goto done; }
+    s->stage = 2;
+    RF_GS_TRY(rf_gs_read(ops, s, 0, &s->control));
+    RF_GS_TRY(rf_gs_read(ops, s, 0x48, &s->fault));
+    for (i = 0; i < 3; i++)
+        RF_GS_TRY(rf_gs_read(ops, s, 0x50 + 4*i, &s->syndrome[i]));
+    for (i = 0; i < s->streams; i++) {
+        RF_GS_TRY(rf_gs_read(ops, s, 0x800 + 4*i, &s->smr[i]));
+        /* Include latent invalid-SMR references; none can imply a free bank. */
+        RF_GS_TRY(rf_gs_read(ops, s, 0xc00 + 4*i, &s->s2cr[i]));
+    }
+    for (i = 0; i < s->contexts; i++) {
+        RF_GS_TRY(rf_gs_read(ops, s, 0x1000 + 4*i, &s->cbar[i]));
+        RF_GS_TRY(rf_gs_read(ops, s, 0x1800 + 4*i, &s->cba2r[i]));
+    }
+    s->stage = 3;
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x20, s->id0));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x24, s->id1));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x28, s->id2));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x3c, s->id7));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0, s->control));
+    RF_GS_TRY(rf_gs_compare(ops, s, 0x48, s->fault));
+    for (i = 0; i < 3; i++)
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x50 + 4*i, s->syndrome[i]));
+    for (i = 0; i < s->streams; i++) {
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x800 + 4*i, s->smr[i]));
+        RF_GS_TRY(rf_gs_compare(ops, s, 0xc00 + 4*i, s->s2cr[i]));
+    }
+    for (i = 0; i < s->contexts; i++) {
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x1000 + 4*i, s->cbar[i]));
+        RF_GS_TRY(rf_gs_compare(ops, s, 0x1800 + 4*i, s->cba2r[i]));
+    }
+    s->gmu_slot[0] = s->gmu_slot[1] = UINT32_MAX;
+    for (i = 0; i < s->streams; i++) {
+        uint32_t type = (s->s2cr[i] >> 16) & 3u, bank = s->s2cr[i] & 0xffu;
+        if (type == 3 || (s->smr[i] & 0x8000u) || (type == 0 && bank >= s->contexts))
+            s->malformed_routes++;
+        if (type == 0 && bank < s->contexts) {
+            s->references[bank]++;
+            reference_mask |= 1u << bank;
+            if (s->smr[i] & 0x80000000u)
+                s->active_references[bank]++;
+        }
+        for (which = 0; which < 2; which++) {
+            if (!rf_gs_stream_matches(s->smr[i], 4u + which))
+                continue;
+            s->gmu_matches[which]++;
+            s->gmu_slot[which] = i;
+        }
+    }
+    for (which = 0; which < 2; which++)
+        if (s->gmu_matches[which] != 1)
+            s->gmu_slot[which] = UINT32_MAX;
+    s->unreferenced_mask = ((1u << s->contexts) - 1u) & ~reference_mask;
+    s->map_format_supported = (s->id2 & (1u << 12)) && s->output_bits >= 36 &&
+        s->virtual_bits >= 39 && s->sid_bits >= 11 && !s->malformed_routes;
+    if (!ops->valid(ops->context)) { error = ECANCELED; goto done; }
+    s->stable = true;
+    s->stage = 4;
+    error = 0;
+done:
+#undef RF_GS_TRY
+    if (error)
+        s->map_format_supported = false;
+    s->error = (uint32_t)error;
+    return error;
+}
+
+#endif /* REDFIN_GPU_SMMU_H */
