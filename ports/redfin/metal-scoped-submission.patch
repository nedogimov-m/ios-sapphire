+int redwood_drm_cpu_range(int fd,uint32_t handle,uint32_t op,uint64_t offset,uint64_t bytes,int64_t seconds,int64_t nanos)
+{
+   (void)fd;struct rf_gw_cpu_range request={handle,op,offset,bytes,seconds,nanos};
+   int error=call(RF_GW_CPU_RANGE,&request,sizeof(request));
+   if(error){errno=error;return -1;}return 0;
+}
+int redwood_drm_submit_scoped(int fd,void *request,size_t bytes,const struct rf_gw_submit_range *ranges,uint32_t count)
+{
+   (void)fd;
+   if(!request||bytes!=72||!ranges||!count||count>RF_GW_MAX_RANGES){errno=EINVAL;return -1;}
+   struct {uint8_t native[72];struct rf_gw_submit_extension scope;} wire={0};
+   _Static_assert(sizeof(wire)==88,"native retained scoped submit ABI");
+   memcpy(wire.native,request,72);wire.scope.ranges=(uint64_t)(uintptr_t)ranges;wire.scope.count=count;
+   int error=call(RF_GW_SUBMIT,&wire,sizeof(wire));
+   if(error){errno=error;return -1;}memcpy(request,wire.native,72);return 0;
+}
