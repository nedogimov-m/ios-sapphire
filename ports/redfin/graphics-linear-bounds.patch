+/* FDL allocates four-row backing for native linear textures. IOSurface
+ * imports can provide only the actual rows; GMEM restore/resolve must never
+ * over-fetch into their guard. Direct GPU sysmem rendering remains valid. */
+static bool
+redfin_gmem_surface_fits(struct pipe_surface *surface)
+{
+   if (!surface) return true;
+   struct fd_resource *rsc=fd_resource(surface->texture);
+   unsigned level=surface->u.tex.level;
+   if (fd_resource_tile_mode(surface->texture,level)!=0) return true;
+   uint64_t offset=fd_resource_offset(rsc,level,surface->u.tex.first_layer);
+   unsigned rows=util_format_get_nblocksy(rsc->b.b.format,u_minify(rsc->b.b.height0,level));
+   uint64_t available=redfin_linear_render_bytes(fd_bo_size(rsc->bo),offset,
+      rsc->layout.slices[level].size0,rsc->b.is_shared);
+   bool fits=redfin_linear_gmem_fits(available,offset,fd_resource_pitch(rsc,level),rows);
+   if (!fits) {
+      static unsigned notices;
+      unsigned n=__atomic_fetch_add(&notices,1,__ATOMIC_RELAXED);
+      if(n<8) fprintf(stderr,"REDFIN FD620 LINEAR BOUNDS: width=%u height=%u pitch=%u bytes=%u offset=%llu real-GPU-sysmem=1\n",
+         rsc->b.b.width0,rsc->b.b.height0,fd_resource_pitch(rsc,level),fd_bo_size(rsc->bo),(unsigned long long)offset);
+   }
+   return fits;
+}
