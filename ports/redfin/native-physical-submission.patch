diff --git a/bsd/dev/redfin_gpu_physical.h b/bsd/dev/redfin_gpu_physical.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gpu_physical.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef REDFIN_GPU_PHYSICAL_H
+#define REDFIN_GPU_PHYSICAL_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/errno.h>
+#include "redfin_gpu_runtime.h"
+
+/* Two retained publications, four generation-owned timestamp slots. All
+ * slots are within the actual owned4KiB native scratch page, after startup
+ * proof words and the existing common cache-flush fence/timestamp fields. */
+#define RF_GI_DEPTH 2u
+#define RF_GI_SLOTS 4u
+#define RF_GI_TIME_BASE 0x300u
+#define RF_GI_TIME_STEP 32u
+#define RF_GI_SCRATCH_BYTES 0x1000u
+
+struct rf_gi_publication {uint32_t fence,ibs;uint64_t published_ns;};
+
+static inline uint32_t rf_gi_time_offset(uint32_t fence)
+{return RF_GI_TIME_BASE+(fence%RF_GI_SLOTS)*RF_GI_TIME_STEP;}
+
+static inline bool rf_gi_ring_room(uint32_t read,uint32_t write,uint32_t capacity,uint32_t need)
+{
+    if(capacity<2||capacity>UINT32_MAX/2||read>=capacity||write>=capacity||!need||need>=capacity)return false;
+    return (read+capacity-write-1)%capacity>=need;
+}
+static inline int rf_gi_counter(uint32_t issued,uint32_t completed,uint32_t observed,
+    uint32_t target,bool *done)
+{
+    if(!done||completed>issued||target>issued||observed>issued||observed<completed)return EPROTO;
+    *done=observed>=target;return 0;
+}
+static inline bool rf_gi_can_publish(uint32_t issued,uint32_t completed)
+{return issued>=completed&&issued!=UINT32_MAX&&issued-completed<RF_GI_DEPTH;}
+
+/* Reuse the exact validated native packet builder, changing only the two
+ * private timestamp destinations. The common CACHE_FLUSH_TS fence stays
+ * unchanged. Generation ownership prevents a later publication overwriting
+ * a timestamp pair that has not actually been read after its GPU fence. */
+static inline unsigned rf_gi_submit_words(const struct rf_gr_arena *arena,
+    const uint64_t *addresses,const uint32_t *words,unsigned count,uint32_t fence,
+    uint32_t *out,unsigned room)
+{
+    unsigned n=rf_gr_submit_words(arena,addresses,words,count,fence,out,room);
+    if(!n||n!=4*count+18||out[2]!=0x01200000u+RF_GR_TIME_AT||
+       out[n-7]!=0x01200000u+RF_GR_TIME_AT+8)return 0;
+    uint32_t offset=rf_gi_time_offset(fence);
+    if(offset<RF_GR_TIME_AT+16||offset>RF_GI_SCRATCH_BYTES-16)return 0;
+    out[2]=0x01200000u+offset;out[n-7]=0x01200000u+offset+8;
+    return n;
+}
+#endif
diff --git a/bsd/dev/redfin_gpu_physical.inc b/bsd/dev/redfin_gpu_physical.inc
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_gpu_physical.inc
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: MIT
+ * The hardware mutex and current-thread lease cover every call. Publication
+ * does not retire a client or release memory. All CPU-visible success still
+ * requires the actual ordered cache-flush fence and complete native audit.
+ */
+static int gr_physical_collect(uint32_t observed)
+{
+    if(observed<gr.completed||observed>gr.fence)return EPROTO;
+    for(uint32_t fence=gr.completed;fence<observed;) {
+        ++fence;
+        struct rf_gi_publication *slot=&gr.physical[fence%RF_GI_SLOTS];
+        if(slot->fence!=fence)return EPROTO;
+        unsigned offset=rf_gi_time_offset(fence);
+        uint64_t start=(uint64_t)gm_scalar_read(gx.scratch+offset+4)<<32|
+            gm_scalar_read(gx.scratch+offset);
+        uint64_t end=(uint64_t)gm_scalar_read(gx.scratch+offset+12)<<32|
+            gm_scalar_read(gx.scratch+offset+8);
+        if(end<start)return EPROTO;
+        gr.gpu_ticks+=end-start;slot->fence=0;gr.completed=fence;
+    }
+    return 0;
+}
+static int gr_physical_wait(uint32_t fence,bool idle)
+{
+    if(fence>gr.fence)return EINVAL;
+    if(!idle&&fence<=gr.completed)return gr_live();
+    uint64_t first=gm_time_ns(gx.context);
+    struct gr_wait_sample observed={fence,0,0,0,idle};unsigned polls=0;
+    const struct rf_gr_wait_ops ops={&observed,gr_wait_sample,gm_time_ns,gr_wait_pause};
+    int error=rf_gr_wait(&ops,RF_A6_WAIT_NS,&polls);gr.polls+=polls;
+    gr.wait_ns+=gm_time_ns(gx.context)-first;
+    if(!error) {
+        uint64_t audit_at=gm_time_ns(gx.context);error=gr_audit(false);
+        gr.audit_ns+=gm_time_ns(gx.context)-audit_at;
+        if(!error)error=gr_physical_collect(observed.done);
+    }
+    if(!error) {
+        if(fence&&gr.completed&&(fence<=8||!(fence%256)))
+            printf("REDFIN GPU PHYSICAL DONE: fence=%u observed=%u issued=%u idle=%u polls=%u real-audit=1\n",
+                fence,observed.done,gr.fence,idle,polls);
+        return 0;
+    }
+    printf("REDFIN GPU WAIT FAILED: wanted=%u observed=%u prior=%u rptr=%#x wptr=%#x status=%#x error=%d polls=%u elapsed-us=%llu\n",
+        fence,observed.done,gr.completed,observed.rptr,gx.wptr,observed.status,error,polls,
+        (unsigned long long)((gm_time_ns(gx.context)-first)/1000));
+    gx_diagnostic(gx.context);redfin_gpu_poison("physical FIFO did not complete");
+    return error;
+}
+int redfin_gpu_wait(uint32_t fence)
+{return gr_physical_wait(fence,false);}
+/* Nonblocking hardware observation only. It never grants client completion;
+ * finish/wait must still perform the complete native audit and timestamps. */
+int redfin_gpu_poll(uint32_t fence)
+{
+    if(!fence||fence>gr.fence)return EINVAL;
+    if(fence<=gr.completed)return gr_live();
+    struct gr_wait_sample observed={fence,0,0,0,false};bool done=false;
+    int error=gr_wait_sample(&observed,&done);
+    if(!error&&done)return 0;
+    struct rf_gi_publication *slot=&gr.physical[fence%RF_GI_SLOTS];
+    uint64_t now=gm_time_ns(gx.context);
+    if(!error&&(slot->fence!=fence||now<slot->published_ns))error=EPROTO;
+    if(!error&&now-slot->published_ns>=RF_A6_WAIT_NS)error=ETIMEDOUT;
+    if(!error)return EAGAIN;
+    gx_diagnostic(gx.context);redfin_gpu_poison("physical poll lost fence/ownership/deadline");
+    return error;
+}
+int redfin_gpu_quiesce(void)
+{
+    int error=gr_live();if(error)return error;
+    /* Once all published fences have been audited and no new publication
+     * exists, a guarded actual idle observation needs no duplicate audit. */
+    uint32_t rptr=gm_scalar_read(gx.gpu+4*0x806),status=gm_scalar_read(gx.gpu+4*0x210);
+    if(gm_scalar_read(gx.gpu+4*0x821)||(gm_scalar_read(gx.gpu+4*0x823)&0xf7u)) {
+        redfin_gpu_poison("physical idle observation has an actual GPU fault");return EIO;
+    }
+    if(gr.completed==gr.fence&&rptr==gx.wptr&&!(status&~1u))return gr_live();
+    return gr_physical_wait(gr.fence,true);
+}
+int redfin_gpu_publish(const uint64_t *addresses,const uint32_t *words,unsigned count,uint32_t *fence)
+{
+    if(!fence||gr.fence==UINT32_MAX)return EINVAL;
+    *fence=0;
+    int error=gr_live();if(error)return error;
+    if(!rf_gi_can_publish(gr.fence,gr.completed)) {
+        error=redfin_gpu_wait(gr.completed+1);if(error)return error;
+    }
+    uint32_t next=gr.fence+1,packets[RF_GR_PACKET_WORDS];
+    struct rf_gi_publication *slot=&gr.physical[next%RF_GI_SLOTS];
+    if(slot->fence){redfin_gpu_poison("physical timestamp slot still owned");return EBUSY;}
+    unsigned n=rf_gi_submit_words(&gr.arena,addresses,words,count,next,packets,RF_GR_PACKET_WORDS);
+    if(!n)return EINVAL;
+    uint64_t audit_at=gm_time_ns(gx.context);
+    error=gr_audit(false);if(error)return error;
+    gr.audit_ns+=gm_time_ns(gx.context)-audit_at;
+    error=redfin_gpu_mapped();if(error)return error;
+    error=gr_dvfs(true);
+    if(error==EBUSY) {
+        error=redfin_gpu_quiesce();if(!error)error=gr_dvfs(true);
+    }
+    if(error)return error;
+    uint32_t ring_words=RF_A6_RING_BYTES/4;
+    uint32_t rptr=gm_scalar_read(gx.gpu+4*0x806);
+    if(!rf_gi_ring_room(rptr,gx.wptr,ring_words,n)) {
+        error=redfin_gpu_quiesce();if(error)return error;
+        rptr=gm_scalar_read(gx.gpu+4*0x806);
+        if(!rf_gi_ring_room(rptr,gx.wptr,ring_words,n)) {
+            redfin_gpu_poison("physical ring room unavailable after real idle");return EBUSY;
+        }
+    }
+    uint32_t actual_before=gm_scalar_read(gx.scratch+RF_GR_FENCE_AT);bool ignored=false;
+    error=rf_gi_counter(gr.fence,gr.completed,actual_before,gr.completed,&ignored);
+    if(error){redfin_gpu_poison("physical fence counter changed");return error;}
+    uint64_t publish_at=gm_time_ns(gx.context);uint32_t *ring=gx.data[0].host;
+    for(unsigned i=0;i<n;++i)ring[(gx.wptr+i)%ring_words]=packets[i];
+    unsigned first_words=n<ring_words-gx.wptr?n:ring_words-gx.wptr;
+    redfin_gpu_sync(ring+gx.wptr,4*first_words,false);
+    if(first_words<n)redfin_gpu_sync(ring,4*(n-first_words),false);
+    if(gr_live())return ECANCELED;
+    *slot=(struct rf_gi_publication){next,count,publish_at};
+    gr.fence=next;gx.wptr=(gx.wptr+n)%ring_words;
+    gm_memory_store(gx.gpu+4*0x807,gx.wptr);*fence=next;
+    gr.publish_ns+=gm_time_ns(gx.context)-publish_at;
+    /* Observe AFTER the doorbell. A pre-publication sample alone cannot
+     * prove overlap: the predecessor could finish while the CPU copies the
+     * ring words. This counter never substitutes for audited retirement. */
+    uint32_t actual_after=gm_scalar_read(gx.scratch+RF_GR_FENCE_AT);
+    error=actual_after<actual_before?EPROTO:
+        rf_gi_counter(gr.fence,gr.completed,actual_after,gr.completed,&ignored);
+    if(error){redfin_gpu_poison("post-publication physical counter changed");return error;}
+    bool overlap=actual_after+1<next;
+    if(overlap)++gr.physical_overlap;
+    unsigned pending=next-actual_after;
+    if(pending>gr.physical_max_pending)gr.physical_max_pending=pending;
+    if(next<=8||!(next%256)||(overlap&&gr.physical_overlap<=4))
+        printf("REDFIN GPU PHYSICAL PUB: fence=%u IBs=%u prior-done=%u post-done=%u pending=%u overlap=%llu max-pending=%u ring=%u/%u owned-slots=1\n",
+            next,count,actual_before,actual_after,pending,gr.physical_overlap,gr.physical_max_pending,rptr,gx.wptr);
+    return 0;
+}
+/* Kernel display commands/stage storage remain synchronous and may be reused
+ * only after the exact prior/current hardware work has really become idle. */
+int redfin_gpu_submit(const uint64_t *addresses,const uint32_t *words,unsigned count,uint32_t *fence)
+{
+    if(!fence)return EINVAL;
+    int error=redfin_gpu_quiesce();if(error)return error;
+    uint32_t published=0;error=redfin_gpu_publish(addresses,words,count,&published);
+    if(!error)error=redfin_gpu_quiesce();
+    if(!error)*fence=published;return error;
+}
diff --git a/iokit/Kernel/arm/RedfinGPUPhysicalWorker.inc b/iokit/Kernel/arm/RedfinGPUPhysicalWorker.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/RedfinGPUPhysicalWorker.inc
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: MIT
+ * One FIFO owner, at most two physical render publications. Native output
+ * remains serialized. Client/CPU consumers wake only after the real fence,
+ * cache handoff and original FIFO retirement, with hardware already unlocked.
+ */
+static gpu_queued_job *gpuPhysicalPopLocked(void)
+{
+    gpu_queued_job *job=gGPUQueue.head;
+    if(job){gGPUQueue.head=job->next;if(!gGPUQueue.head)gGPUQueue.tail=NULL;job->next=NULL;}
+    return job;
+}
+static void redfinGpuQueueWorker(void *,wait_result_t)
+{
+    gpu_queued_job *first=NULL,*last=NULL;unsigned count=0;bool failed_publication=false;
+    for(;;) {
+        IOLockLock(gGPUQueue.lock);
+        bool stopped=gGPUQueue.stopping||!redfin_gpu_ready();
+        gpu_queued_job *head=gGPUQueue.head,*job=NULL;
+        bool kernel_next=head&&!head->owner;
+        if(head&&(!count||(!stopped&&!failed_publication&&head->owner&&count<REDFIN_GPU_PUBLISH_DEPTH)))
+            job=gpuPhysicalPopLocked();
+        IOLockUnlock(gGPUQueue.lock);
+        if(job) {
+            job->dequeued=gpuNow();
+            if(!job->owner||stopped) {
+                /* Kernel output owns one mutable command/stage set. It can
+                 * execute only after every earlier retained render retired. */
+                IOReturn result=kIOReturnNotReady;
+                {
+                    GPUTransaction hardware;job->locked=gpuNow();
+                    if(!stopped&&redfin_gpu_ready())result=job->kernel_execute(job->kernel_argument);
+                    job->ran=gpuNow();
+                }
+                job->released=gpuNow();gpuPhysicalRetire(job,result);continue;
+            }
+            {
+                GPUTransaction hardware;job->locked=gpuNow();
+                job->publication_status=redfin_gpu_ready()?job->owner->executeQueued(job):kIOReturnNotReady;
+            }
+            job->published=gpuNow();
+            if(last)last->next=job;else first=job;last=job;++count;
+            failed_publication|=job->publication_status!=kIOReturnSuccess;
+            continue;
+        }
+        if(first) {
+            int observation=0;
+            if(first->publication_status==kIOReturnSuccess&&redfin_gpu_ready()) {
+                GPUTransaction hardware;observation=redfin_gpu_poll(first->physical_fence);
+            }
+            /* While one render is on the GPU, give newly admitted work a
+             * chance to fill the second slot. This is a bounded1ms condition
+             * sleep, never a client completion or a hardware-busy success. */
+            if(observation==EAGAIN&&count<REDFIN_GPU_PUBLISH_DEPTH&&!kernel_next&&
+               !stopped&&!failed_publication) {
+                IOLockLock(gGPUQueue.lock);
+                if(!gGPUQueue.head&&!gGPUQueue.stopping&&redfin_gpu_ready()) {
+                    uint64_t wake=0;clock_interval_to_deadline(1,NSEC_PER_MSEC,&wake);
+                    (void)IOLockSleepDeadline(gGPUQueue.lock,&gGPUQueue.head,wake,THREAD_UNINT);
+                }
+                IOLockUnlock(gGPUQueue.lock);continue;
+            }
+            job=first;first=job->next;if(!first)last=NULL;--count;
+            IOReturn result=job->publication_status;job->wait_began=gpuNow();
+            {
+                GPUTransaction hardware;
+                if(result==kIOReturnSuccess)
+                    result=redfin_gpu_ready()?job->owner->finishQueued(job):kIOReturnNotReady;
+                job->ran=gpuNow();
+            }
+            job->released=gpuNow();
+            if(!count)failed_publication=false;
+            if(job->sequence<=4||!(job->sequence&(job->sequence-1))||!(job->sequence%120))
+                IOLog("REDFIN GPU PIPE: s=%llu pf=%u pub=%x pub-us=%llu before-wait-us=%llu wait-us=%llu FIFO=1 depth=2\n",
+                    job->sequence,job->physical_fence,job->publication_status,
+                    (job->published-job->locked)/1000,(job->wait_began-job->published)/1000,
+                    (job->ran-job->wait_began)/1000);
+            gpuPhysicalRetire(job,result);continue;
+        }
+        IOLockLock(gGPUQueue.lock);
+        if(!gGPUQueue.head&&(gGPUQueue.stopping||!redfin_gpu_ready())) {
+            IOLockUnlock(gGPUQueue.lock);break;
+        }
+        if(!gGPUQueue.head) {
+            uint64_t wake=0;clock_interval_to_deadline(100,NSEC_PER_MSEC,&wake);
+            (void)IOLockSleepDeadline(gGPUQueue.lock,&gGPUQueue.head,wake,THREAD_UNINT);
+        }
+        bool idle=!gGPUQueue.head&&!gGPUQueue.stopping;
+        IOLockUnlock(gGPUQueue.lock);
+        if(idle&&redfin_gpu_ready()){GPUTransaction hardware;(void)redfin_gpu_dvfs_idle();}
+    }
+    IOLockLock(gGPUQueue.lock);gGPUQueue.stopping=true;
+    IOLockWakeup(gGPUQueue.lock,&gGPUQueue.budget,false);IOLockWakeup(gGPUQueue.lock,&gGPUQueue.retired,false);
+    IOLockUnlock(gGPUQueue.lock);thread_terminate(current_thread());
+}
