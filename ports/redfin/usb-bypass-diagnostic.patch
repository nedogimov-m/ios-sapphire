- if (error) return error;
- if (memcmp(&rf_usb_context_images[0],&rf_usb_bypass.expected,sizeof(rf_usb_bypass.expected))) return EAGAIN;
+ if (error) {
+  printf("REDFIN USB BYPASS: cached-snapshot warm=%u error=%d stores=%u; comparison skipped\n",
