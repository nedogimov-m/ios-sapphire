+extern void redfin_wifi_gui_start(void);
 int redfin_touch_start_initial(void);
 bool redfin_touch_boot_lease_valid(unsigned mode);
+bool redfin_touch_boot_lease_held(unsigned mode);
 /* 0=unclaimed, 1=claimed/unpublished, 2=permanently published. */
 static uint32_t redfin_initial_touch_owner;
 static unsigned redfin_touch_boot_mode;
@@ -120,6 +122,15 @@
 {
  return redfin_touch_boot_owned(&redfin_touch_boot_caller, &redfin_initial_touch_owner, mode);
 }
+/* Lifetime proof only, for the GUI/WLAN handoff after full validation.
+ * Its caller separately retains the frozen GUI arguments, CPU0 and epoch.
+ * No path releases/reassigns this boot's permanent DRV2/SE0 owner. */
+bool
+redfin_touch_boot_lease_held(unsigned mode)
+{
+ return __atomic_load_n(&redfin_initial_touch_owner, __ATOMIC_ACQUIRE) == 2 &&
+     mode == REDFIN_TOUCH_UFS_EVENTS && mode == redfin_touch_boot_mode;
+}
 int
 redfin_touch_start_initial(void)
 {
@@ -158,6 +169,7 @@
  } else if (mode == REDFIN_TOUCH_UFS_EVENTS) {
   error = redfin_touch_events_start();
   printf("REDFIN TOUCH START: asynchronous HID worker result=%d\n", error);
+  if (!error) redfin_wifi_gui_start();
  }
  return error;
 }
