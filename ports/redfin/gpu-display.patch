+static inline bool rf_gd_rect_valid(const struct rf_gd_surface *s, const struct rf_gd_rect *r)
+{
+    return rf_gd_surface_valid(s) && r && r->w && r->h && r->x < s->width &&
+        r->y < s->height && r->w <= s->width - r->x && r->h <= s->height - r->y;
