+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+
+/* REDFIN_STACK_PROC_TEST_BEGIN: fixed names, no proc transition waits/allocations. */
+extern void redfin_stack_task(const char *name, int pid, task_t task, uint64_t deadline);
+void redfin_userspace_stacks(void);
+void
+redfin_userspace_stacks(void)
+{
+	uint32_t enabled = 0, cpus = 0;
+	if (!PE_parse_boot_argn("redfinstacks", &enabled, sizeof(enabled)) || enabled != 1 ||
+	    !PE_parse_boot_argn("cpus", &cpus, sizeof(cpus)) || cpus != 1) return;
+	const char *names[3] = { "SpringBoard", "backboardd", "launchd" };
+	proc_t selected[3] = { PROC_NULL, PROC_NULL, PROC_NULL };
+	uint64_t interval, now = mach_absolute_time();
+	nanoseconds_to_absolutetime(2ULL * NSEC_PER_SEC, &interval);
+	if (now > UINT64_MAX - interval) return;
+	uint64_t deadline = now + interval;
+	if (!lck_mtx_try_lock(&proc_list_mlock)) {
+		printf("RSTACK SKIP reason=proc-list-busy\n");
+		return;
+	}
+	proc_t p;
+	unsigned scanned = 0;
+	ALLPROC_FOREACH(p) {
+		if (scanned++ == 512) break;
+		for (unsigned i = 0; i < 3; i++) {
+			if (selected[i] != PROC_NULL || strncmp(p->p_comm, names[i], sizeof(p->p_comm))) continue;
+			uint32_t bits = proc_ref_try_fast(p);
+			if (!bits) continue;
+			if (proc_ref_needs_wait_for_exec(bits)) { proc_rele(p); continue; }
+			selected[i] = p;
+		}
+	}
+	proc_list_unlock();
+	printf("RSTACK BEGIN cap_processes=3 cap_threads=16 cap_frames=8 budget_ms=2000 resident_only=1\n");
+	for (unsigned i = 0; i < 3; i++) {
+		if (selected[i] == PROC_NULL) {
+			printf("RSTACK SKIP name=%s reason=not-found-or-exec\n", names[i]);
+			continue;
+		}
+		p = selected[i];
+		/* The proc ref prevents exec from replacing proc_task while sampled. */
+		redfin_stack_task(names[i], proc_pid(p), proc_task(p), deadline);
+		proc_rele(p);
+	}
+	printf("RSTACK DONE\n");
+}
+/* REDFIN_STACK_PROC_TEST_END */
+#endif
