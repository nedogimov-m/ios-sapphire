+#include <kern/task_ref.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <vm/pmap.h>
+
+/* REDFIN_STACK_TASK_TEST_BEGIN: live, observational saved state; no thread stop. */
+extern int redfin_user_frame_read(pmap_t pmap, uint64_t source, uint64_t frame[2]);
+void redfin_stack_task(const char *name, int pid, task_t task, uint64_t deadline);
+void
+redfin_stack_task(const char *name, int pid, task_t task, uint64_t deadline)
+{
+	thread_t threads[16];
+	unsigned count = 0;
+	vm_map_t map = VM_MAP_NULL;
+	if (task == TASK_NULL || task == kernel_task || mach_absolute_time() >= deadline) return;
+	task_reference(task);
+	if (!task_lock_try(task)) {
+		printf("RSTACK SKIP name=%s pid=%d reason=task-busy\n", name, pid);
+		task_deallocate(task);
+		return;
+	}
+	uint64_t slide = task->task_shared_region_slide;
+	uint64_t mh = task->mach_header_vm_address;
+	if (task->active && (map = get_task_map(task)) != VM_MAP_NULL) {
+		vm_map_reference(map);
+		thread_t thread;
+		queue_iterate(&task->threads, thread, thread_t, task_threads) {
+			if (count == 16) break;
+			thread_reference(thread);
+			threads[count++] = thread;
+		}
+	}
+	task_unlock(task);
+	printf("RSTACK TASK name=%s pid=%d slide=0x%llx slide_valid=%u mh=0x%llx threads=%u\n",
+	    name, pid, slide, slide != UINT32_MAX, mh, count);
+	for (unsigned t = 0; t < count; t++) {
+		thread_t thread = threads[t];
+		if (mach_absolute_time() >= deadline) break;
+		uint64_t pc = 0, lr = 0, sp = 0, fp = 0, wait = 0, continuation = 0;
+		unsigned state;
+		/* cpus=1: another user thread cannot change its PCB in this window.
+		 * No print, allocation, lock acquisition or user read while preempt-disabled. */
+		disable_preemption();
+		state = thread->state;
+		wait = thread->wait_event;
+		continuation = (uint64_t)(uintptr_t)thread->continuation;
+		arm_saved_state_t *ss = find_user_regs(thread);
+		if (ss && is_saved_state64(ss)) {
+			pc = get_saved_state_pc(ss); lr = get_saved_state_lr(ss);
+			sp = get_saved_state_sp(ss); fp = get_saved_state_fp(ss);
+		}
+		enable_preemption();
+		uint64_t tid = thread_tid(thread);
+		printf("RSTACK THREAD name=%s pid=%d tid=0x%llx state=0x%x wait=0x%llx continuation=0x%llx pc=0x%llx lr=0x%llx sp=0x%llx fp=0x%llx\n",
+		    name, pid, tid, state, wait, continuation, pc, lr, sp, fp);
+		unsigned frames = 0;
+		const char *stop = "cap";
+		uint64_t base = fp;
+		for (; frames < 8; frames++) {
+			if (mach_absolute_time() >= deadline) { stop = "budget"; break; }
+			if (!fp) { stop = "end"; break; }
+			if ((fp & 15) || fp < base || fp - base > (8ULL << 20)) { stop = "invalid-fp"; break; }
+			uint64_t frame[2] __attribute__((aligned(16)));
+			if (!redfin_user_frame_read(vm_map_pmap(map), fp, frame)) { stop = "unmapped-or-busy"; break; }
+			printf("RSTACK FRAME name=%s pid=%d tid=0x%llx index=%u fp=0x%llx lr=0x%llx next_fp=0x%llx\n",
+			    name, pid, tid, frames, fp, frame[1], frame[0]);
+			if (frame[0] && (frame[0] <= fp || frame[0] - fp > (1ULL << 20))) {
+				frames++; stop = "invalid-fp"; break;
+			}
+			fp = frame[0];
+		}
+		printf("RSTACK END name=%s pid=%d tid=0x%llx frames=%u stop=%s\n", name, pid, tid, frames, stop);
+	}
+	for (unsigned t = 0; t < count; t++) thread_deallocate(threads[t]);
+	if (map != VM_MAP_NULL) vm_map_deallocate(map);
+	task_deallocate(task);
+}
+/* REDFIN_STACK_TASK_TEST_END */
+
