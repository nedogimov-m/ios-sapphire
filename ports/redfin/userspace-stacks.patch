+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* REDFIN_STACK_RESIDENT_TEST_BEGIN: one resident frame; never fault or touch I/O. */
+int redfin_user_frame_read(pmap_t pmap, uint64_t source, uint64_t frame[2]);
+int
+redfin_user_frame_read(pmap_t pmap, uint64_t source, uint64_t frame[2])
+{
+#if XNU_MONITOR
+	(void)pmap; (void)source; (void)frame;
+	return 0;
+#else
+	if (!pmap || pmap == kernel_pmap || !source || (source & 15) ||
+	    source > MACH_VM_MAX_ADDRESS - 16 || ((uintptr_t)frame & 15) ||
+	    (source & PAGE_MASK) > PAGE_SIZE - 16 ||
+	    ((uintptr_t)frame & PAGE_MASK) > PAGE_SIZE - 16)
+		return 0;
+	if (!pmap_try_lock(pmap, PMAP_LOCK_SHARED)) return 0;
+	pmap_paddr_t src = pmap_vtophys(pmap, source);
+	pmap_paddr_t dst = kvtophys((vm_offset_t)frame);
+	int valid = src && dst && pmap_valid_address(src) && pmap_valid_address(dst) &&
+	    (pmap_cache_attributes((ppnum_t)atop(src)) & VM_WIMG_MASK) == VM_WIMG_DEFAULT &&
+	    (pmap_cache_attributes((ppnum_t)atop(dst)) & VM_WIMG_MASK) == VM_WIMG_DEFAULT;
+	if (valid) bcopy_phys(src, dst, 16);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return valid;
+#endif
+}
+/* REDFIN_STACK_RESIDENT_TEST_END */
+#endif
