+
+/* Active gadget may change its own controller/ring, never the leased route. */
+int
+redfin_usb_owned_route_retained_bypass(const void *caller_id)
+{
+ lck_mtx_lock(&rf_usb_lock);
+ int error=0;
+ if (!caller_id || caller_id!=rf_usb_owner.caller) error=EPERM;
+ else if (rf_usb_owner.state!=RF_USB_CONTEXT_ROUTED) error=EBUSY;
+ else { error=rf_usb_bypass_verify(false);if (error) error=rf_usb_quarantine(error); }
+ lck_mtx_unlock(&rf_usb_lock);
+ return error;
+}
+/* Route uncertainty must not prevent the sole controller owner from halting.
+ * Only physical power/clock proof is returned, never route or DMA authority. */
+int
+redfin_usb_owned_quiesce_bypass(const void *caller_id)
+{
+ lck_mtx_lock(&rf_usb_lock);
+ int error=0;
+ uint64_t base=0,bytes=0;
+ if (!caller_id || caller_id!=rf_usb_owner.caller || !rf_usb_bypass.lease ||
+     (rf_usb_owner.state!=RF_USB_CONTEXT_ROUTED && rf_usb_owner.state!=RF_USB_QUARANTINED) ||
+     !rf_usb_bypass_contract(&base,&bytes) || base!=rf_usb_bypass.base || bytes!=rf_usb_bypass.bytes) error=EPERM;
+ else error=rf_usb_power_ready();
  lck_mtx_unlock(&rf_usb_lock);
  return error;
 }
