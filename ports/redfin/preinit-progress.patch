+/* Bounded CPU-only progress for the isolated Redfin md0 diagnostics. */
+static void
+redfin_preinit_mark(const char *stage)
+{
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+ int gpu=0,wifi=0;
+ (void)PE_parse_boot_argn("redfingpu",&gpu,sizeof(gpu));
+ (void)PE_parse_boot_argn("redfinwifi",&wifi,sizeof(wifi));
+ if(gpu==2 || gpu==3 || wifi==2)printf("REDFIN PREINIT: %s\n",stage);
+#else
