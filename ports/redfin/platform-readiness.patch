+		/* DER SET order, then native no-passcode/unlocked state. Preferred
+		 * MiniAppleKeyStore uses ss6/sls3 and includes the sr field. */
+		{ "sb", 0 }, { "sr", 0 }, { "ss", SWEET_AKS_LOCK_STATE },
+		{ "sas", 0 }, { "sfa", 0 }, { "sgs", 0 }, { "sls", 3 },
+		{ "sgpe", 0 }, { "srcd", 0 },
 	};
 	uint8_t buf[128];
