+	if (count<=4 || !(count&(count-1))) {
+		char name[32]={0};
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x count=%llu\n", name, selector,
