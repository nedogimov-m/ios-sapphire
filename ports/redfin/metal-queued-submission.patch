+#ifdef __APPLE__
+static void redfin_fd_fence_completed(struct fd_pipe *pipe,uint32_t fence)
+{
+   uint32_t old=__atomic_load_n(&pipe->redfin_retired_fence,__ATOMIC_ACQUIRE);
+   while(old<fence&&!__atomic_compare_exchange_n(&pipe->redfin_retired_fence,&old,fence,
+         true,__ATOMIC_RELEASE,__ATOMIC_ACQUIRE)) {}
+}
+#endif
+bool redfin_fd_fence_retired(struct fd_fence *f)
+{
+#ifdef __APPLE__
+   /* Also called under fence_lock: do not flush or acquire submit_lock here. */
+   if(!util_queue_fence_is_signalled(&f->ready)||!f->kfence)return false;
+   if(__atomic_load_n(&f->pipe->redfin_retired_fence,__ATOMIC_ACQUIRE)>=f->kfence)return true;
+   if(f->pipe->funcs->wait(f->pipe,f,0))return false;
+   redfin_fd_fence_completed(f->pipe,f->kfence);return true;
+#else
+   return !fd_fence_before(f->pipe->control->fence,f->ufence);
+#endif
+}
