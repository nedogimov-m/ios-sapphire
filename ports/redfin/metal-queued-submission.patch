+   int result=pipe->funcs->wait(pipe,fence,timeout);
+   if(!result)redfin_fd_fence_completed(pipe,fence->kfence);
+   return result;
+#else
    if (!fd_fence_after(fence->ufence, pipe->control->fence))
       return 0;
 
