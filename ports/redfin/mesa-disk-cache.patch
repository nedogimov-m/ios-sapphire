+/* Validate the whole bounded record before allocating from its metadata or
+ * changing a live variant. Truncated/stale entries are ordinary cache misses. */
+static bool redfin_ir3_cached_variant(struct blob_reader *reader,bool binning)
+{
+   if(reader->overrun||(size_t)(reader->end-reader->current)<VARIANT_CACHE_SIZE)return false;
+   struct ir3_shader_variant saved={0};
+   blob_copy_bytes(reader,VARIANT_CACHE_PTR(&saved),VARIANT_CACHE_SIZE);
+   if(!saved.info.size||saved.info.size>REDFIN_MESA_DISK_ITEM||
+      saved.info.size>(size_t)(reader->end-reader->current))return false;
+   blob_read_bytes(reader,saved.info.size);
+   if(!binning) {
+      if((size_t)(reader->end-reader->current)<sizeof(struct ir3_const_state))return false;
+      struct ir3_const_state state;
+      blob_copy_bytes(reader,&state,sizeof(state));
+      if(state.immediates_size>(size_t)(reader->end-reader->current)/sizeof(uint32_t))return false;
+      blob_read_bytes(reader,(size_t)state.immediates_size*sizeof(uint32_t));
+   }
+   return !reader->overrun;
+}
