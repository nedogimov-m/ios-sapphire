+static void
+store_raster_output(struct air_ctx *c, nir_variable *var, nir_def *value)
+{
+   unsigned transport_bits = glsl_get_bit_size(var->type);
+   if (value->bit_size != transport_bits) {
+      enum glsl_base_type base = glsl_get_base_type(var->type);
+      value = (base == GLSL_TYPE_FLOAT || base == GLSL_TYPE_FLOAT16) ?
+         nir_f2fN(&c->b, value, transport_bits) : nir_u2uN(&c->b, value, transport_bits);
+   }
+   nir_store_var(&c->b, var, value, BITFIELD_MASK(value->num_components));
+}
