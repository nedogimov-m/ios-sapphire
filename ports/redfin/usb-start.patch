--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -124,3 +124,4 @@
 bsd/dev/redfin_usb.c			standard
 bsd/dev/redfin_usb_owned.c			standard
+bsd/dev/redfin_usb_start.c			standard
 bsd/dev/mem.c				standard
