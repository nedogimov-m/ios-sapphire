+#ifdef __APPLE__
+/* One immutable capability read per retained device. Unsupported/changed
+ * replies keep the real MADVISE ioctl. No completion or CPU access is granted. */
+static void
+msm_redfin_retention_init(struct msm_device *device,int fd)
+{
+   if(device->base.version<FD_VERSION_MADVISE)return;
+   struct drm_msm_param request={.pipe=0x10,.param=RF_GM_PARAM};
+   STATIC_ASSERT(sizeof(request)==24);
+   device->redfin_retention_queries=1;
+   int error=drmCommandWriteRead(fd,DRM_MSM_GET_PARAM,&request,sizeof(request));
+   device->redfin_retained=!error && request.pipe==0x10 && request.param==RF_GM_PARAM &&
+      request.value==RF_GM_ABI && !request.len && !request.pad;
+}
+#endif
