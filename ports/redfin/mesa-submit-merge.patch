--- a/src/freedreno/drm/msm/msm_pipe.c
+++ b/src/freedreno/drm/msm/msm_pipe.c
@@ -272,6 +272,10 @@
    if(query_param(pipe,RF_GW_PARAM,&scoped_abi)||scoped_abi!=RF_GW_ABI) {
       ERROR_MSG("native physical range dependency ABI 1 required");goto fail;
    }
+   /* Retained global FIFO, physical-alias CPU barriers and explicit final
+    * publication provide native synchronization. Shared IOSurface batches
+    * can use Mesa's ordinary deferred merge until that publication. */
+   pipe->no_implicit_sync = true;
 #endif
 
 
