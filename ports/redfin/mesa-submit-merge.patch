+#endif
+
 static bool
 should_defer(struct fd_submit *submit)
 {
    struct fd_submit_sp *fd_submit = to_fd_submit_sp(submit);
+#ifdef __APPLE__
+   if(submit->pipe->no_implicit_sync)
+      return redfin_msm_merge_fits(submit->pipe->dev,NULL);
+#endif
 
    /* if too many bo's, it may not be worth the CPU cost of submit merging: */
    if (fd_submit->nr_bos > 30)
@@ -360,6 +368,15 @@
        (last_submit(&dev->deferred_submits)->pipe != submit->pipe)) {
       flush_deferred_submits(dev);
    }
+
+#ifdef __APPLE__
+   /* Flush the old group BEFORE accepting a candidate that would exceed
+    * the real native IB/BO/range bounds. Queue/priority changes above keep
+    * their original ordering. CPU prep and final fence publication still
+    * flush through fd_pipe_sp_flush before asking the kernel to wait. */
+   if(pipe->no_implicit_sync && !redfin_msm_merge_fits(dev,submit))
+      flush_deferred_submits(dev);
+#endif
 
    list_addtail(&fd_submit_ref(submit)->node, &dev->deferred_submits);
 
