    IOLog("REDFIN BOOT ID: %016llx\n", (unsigned long long)boot_id);
  }
+ /* REDFIN_EARLY_RETURN_DISPATCH_BEGIN */
+ const char *early_args=PE_boot_args();
+ bool early_requested=false;
+ for(unsigned pos=0;early_args && pos<608 && early_args[pos];) {
+  if(early_args[pos]==' ' || early_args[pos]=='\t' || early_args[pos]=='\r' || early_args[pos]=='\n') {
+   ++pos; continue;
+  }
+  unsigned start=pos;
+  while(pos<608 && early_args[pos] && early_args[pos]!=' ' && early_args[pos]!='\t' &&
+        early_args[pos]!='\r' && early_args[pos]!='\n') ++pos;
+  if(pos-start>=17 && !memcmp(early_args+start,"redfinearlyreturn",17) &&
+     (pos-start==17 || early_args[start+17]=='=')) early_requested=true;
+ }
+ if(early_requested) {
+  static uint32_t attempted_early;
+  if(!__atomic_exchange_n(&attempted_early,1,__ATOMIC_RELAXED))
+   IOLog("REDFIN EARLY RETURN: probe result=%d\n",redfin_early_return_probe());
+  return; /* A malformed requested test also blocks all competing writers. */
+ }
+ /* REDFIN_EARLY_RETURN_DISPATCH_END */
