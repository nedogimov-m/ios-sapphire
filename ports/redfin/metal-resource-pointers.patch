+{
+   if (!type || type->kind != AIR_TYPE_POINTER || !type->elem ||
+       type->elem->kind != AIR_TYPE_STRUCT || !type->elem->opaque ||
+       !type->elem->name)
+      return AIR_PTR_NONE;
