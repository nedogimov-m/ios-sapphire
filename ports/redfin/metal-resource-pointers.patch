+/* Serialize read-only numeric globals without a per-invocation array of
+ * stores. Preserve scalar bits (including NaN payloads), ABI member offsets,
+ * array strides and vector padding. Undefined/padding bytes may be zero.
+ */
+static bool
+serialize_initializer(struct air_ctx *c, const struct air_type *type,
+                       const struct air_value *value, uint8_t *bytes)
+{
+   const struct air_constant *k = value ? air_value_as_constant(value) : NULL;
+   if (!k)
+      return air_error(c, "interface: a numeric global initializer is not a constant");
+   if (k->ckind == AIR_CONST_NULL || k->ckind == AIR_CONST_UNDEF ||
+       k->ckind == AIR_CONST_POISON)
+      return true;
+   if (type->kind == AIR_TYPE_STRUCT || type->kind == AIR_TYPE_ARRAY ||
+       type->kind == AIR_TYPE_VECTOR) {
+      unsigned count = type->kind == AIR_TYPE_STRUCT ? type->num_members : type->count;
+      if (k->num_elems != count ||
+          (k->ckind != AIR_CONST_AGGREGATE && k->ckind != AIR_CONST_DATA))
+         return air_error(c, "interface: a global initializer has an invalid aggregate shape");
+      for (unsigned i = 0; i < count; i++) {
+         const struct air_type *elem = type->kind == AIR_TYPE_STRUCT ? type->members[i] : type->elem;
+         uint64_t offset = type->kind == AIR_TYPE_STRUCT ? air_struct_member_offset(c->m, type, i) :
+            i * (type->kind == AIR_TYPE_ARRAY ? air_type_alloc_size(c->m, elem) :
+                 MAX2(air_type_bit_size(elem) / 8, 1));
+         if (k->ckind == AIR_CONST_DATA) {
+            struct air_constant scalar = { .base = { .kind = AIR_VALUE_CONSTANT, .type = elem },
+               .ckind = air_type_is_float(elem) ? AIR_CONST_FLOAT : AIR_CONST_INT,
+               .u = k->data[i],
+            };
+            if (!serialize_initializer(c, elem, &scalar.base, bytes + offset))
+               return false;
+         } else if (!serialize_initializer(c, elem, k->elems[i], bytes + offset)) {
+            return false;
+         }
+      }
+      return true;
