+   if (v->kind == AIR_VAL_SSA) {
+      declare_call_def(fn, v->def, index);
+   } else if (v->kind == AIR_VAL_PTR) {
+      if (call_def_is_parameter(v->ptr.offset))
+         declare_call_def(fn, v->ptr.offset, index);
+      if (call_def_is_parameter(v->ptr.binding_index))
+         declare_call_def(fn, v->ptr.binding_index, index);
+   } else {
+      if (v->kind == AIR_VAL_PTR_SELECT)
