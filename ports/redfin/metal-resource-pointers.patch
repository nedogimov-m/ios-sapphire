+/* Carry every caller-owned SSA component through a real NIR parameter. Static
+ * resource identities remain specialized, and constant offsets are rebuilt in
+ * the callee. No caller def may be smuggled in through a pointer or aggregate.
+ */
+static unsigned
+call_value_parameters(const struct air_val *v)
+{
+   if (!v)
+      return 0;
+   if (v->kind == AIR_VAL_SSA)
+      return 1;
+   if (v->kind == AIR_VAL_PTR)
+      return call_def_is_parameter(v->ptr.offset) +
+             call_def_is_parameter(v->ptr.binding_index);
+   unsigned n = v->kind == AIR_VAL_PTR_SELECT ? 1 : 0;
+   for (unsigned i = 0; i < v->num_elems; i++)
+      n += call_value_parameters(v->elems[i]);
+   return n;
