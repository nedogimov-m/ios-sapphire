+/* Stop software ingress before halt, including lost route/power proof.
+ * The static ifnet/callbacks and permanent DMA slab outlive both workers. */
+static void
+ud_redfin_network_stop(void)
+{
+ if (!ud.guard.redfin || ud.guard.enum_only ||
+     __atomic_exchange_n(&ud.network_stopped,true,__ATOMIC_ACQ_REL)) return;
+ if (ud.lock) lck_mtx_lock(ud.lock);
+ ud.configured=false;
+ while (ud.txq_count) {
+  mbuf_t m=ud.txq[ud.txq_head];
+  ud.txq[ud.txq_head]=NULL;
+  ud.txq_head=(ud.txq_head+1)%UD_TXQ;
+  ud.txq_count--;
+  if (m) mbuf_freem(m);
+ }
+ ud.txq_head=0;ud.tx_busy=false;
+ if (ud.lock) lck_mtx_unlock(ud.lock);
+ if (ud.ifp) ifnet_set_flags(ud.ifp,0,IFF_UP|IFF_RUNNING);
+}
+
 /* Only QUIESCE proof may bypass the sticky failure latch, solely to halt.
  * DMA slab remains permanently allocated, including uncertain halt failures. */
 static bool
 ud_redfin_stop(void)
 {
  if (!ud.guard.redfin) return false;
+ ud_redfin_network_stop();
  if (!ud.guard.policy.authorize ||
      ud.guard.policy.authorize(ud.guard.caller,ud.guard.policy.context,RF_USB_QUIESCE)) return false;
  uint32_t control=usb_rd(ud.dwc,DCTL);
