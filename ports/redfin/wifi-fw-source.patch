+ * No destination mapping, PAS, power, SMEM or firmware start. */
+void redfin_wifi_fw_source_probe(void);
+/* Separate native PAS4 startup. Requires the exact firmware/power/bus contract. */
+void redfin_wifi_fw_start(void);
