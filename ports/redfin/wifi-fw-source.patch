+/* SPDX-License-Identifier: MIT
+ * Immutable bounded WLAN assets, for the host-owned RAM-only TFTP service.
+ * Include after the existing native wifi_firmware.h planner/SHA ABI.
+ */
+#ifndef REDFIN_WIFI_ASSETS_H
+#define REDFIN_WIFI_ASSETS_H
+#include <string.h>
+struct rf_wlan_asset { char name[64]; const uint8_t *data; uint32_t bytes; };
+struct rf_wlan_assets { uint32_t count; struct rf_wlan_asset file[16]; };
+static inline int rf_wlan_assets_open(struct rf_wlan_assets *out, const uint8_t *data, size_t bytes,
+    const uint8_t expected[32], redfin_mpss_sha256_fn sha, void *context)
+{
+    if (!out) return -1;
+    out->count = 0;
+    if (!data || !expected || !sha || bytes < 64 || bytes > 16u * 1024u * 1024u) return -1;
+    uint8_t digest[32];
+    if (sha(context, data, bytes, digest) || !redfin_mpss_equal(digest, expected, 32) ||
+        !redfin_mpss_equal(data, (const uint8_t *)"RFWAS01\0", 8) || redfin_mpss_u32(data + 8) != 1 ||
+        redfin_mpss_u64(data + 16) != bytes || redfin_mpss_u64(data + 24) != 128) return -1;
+    for (unsigned i = 32; i < 64; ++i) if (data[i]) return -1;
+    uint32_t count = redfin_mpss_u32(data + 12);
+    if (!count || count > 16 || 64u + count * 128u > bytes) return -1;
+    size_t cursor = 64u + count * 128u;
+    for (unsigned i = 0; i < count; ++i) {
+        const uint8_t *record = data + 64u + i * 128u;
+        size_t name = 0;
+        while (name < 64 && record[name]) {
+            unsigned c = record[name];
+            if (!(c == '/' || c == '-' || c == '_' || c == '.' || (c >= 'a' && c <= 'z') ||
+                (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) return -1;
+            ++name;
+        }
+        if (name < 7 || name >= 64 || memcmp(record, "image/", 6)) return -1;
+        for (size_t j = name; j < 64; ++j) if (record[j]) return -1;
+        for (size_t j = 0; j + 1 < name; ++j) if (record[j] == '.' && record[j + 1] == '.') return -1;
+        uint64_t offset = redfin_mpss_u64(record + 64), length = redfin_mpss_u64(record + 72);
+        if (offset != cursor || !length || length > 8u * 1024u * 1024u || offset > bytes || length > bytes - offset)
+            return -1;
+        for (unsigned j = 112; j < 128; ++j) if (record[j]) return -1;
+        if (sha(context, data + cursor, (size_t)length, digest) || !redfin_mpss_equal(digest, record + 80, 32)) return -1;
+        for (unsigned j = 0; j < i; ++j) if (!memcmp(out->file[j].name, record, 64)) return -1;
+        memcpy(out->file[i].name, record, 64); out->file[i].data = data + cursor; out->file[i].bytes = (uint32_t)length;
+        cursor = (size_t)((offset + length + 15u) & ~UINT64_C(15));
+        if (cursor > bytes) return -1;
+        for (uint64_t j = offset + length; j < cursor; ++j) if (data[(size_t)j]) return -1;
+    }
+    if (cursor != bytes) return -1;
+    out->count = count;
+    return 0;
+}
+static inline int rf_wlan_asset_find(const struct rf_wlan_assets *assets, const char *name,
+    const uint8_t **data, uint32_t *bytes)
+{
+    if (!assets || !name || !data || !bytes || assets->count > 16) return -1;
+    for (unsigned i = 0; i < assets->count; ++i) if (!strcmp(assets->file[i].name, name)) {
+        *data = assets->file[i].data; *bytes = assets->file[i].bytes; return 0;
+    }
+    return -1;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_host.h b/iokit/Kernel/arm/redfin_wifi_host.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_host.h
@@ -0,0 +1,322 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded QRTR host services for native MPSS: servreg locator and RAM TFTP.
+ * Wire references: native servreg-locator QMI and tqftpserv; the legacy
+ * Sapphire host-service protocol was reviewed, with all partition tables,
+ * UFS/EFS/DMA access and unbounded request parsing omitted here.
+ */
+#ifndef REDFIN_WIFI_HOST_H
+#define REDFIN_WIFI_HOST_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdbool.h>
+#define RF_HOST_BLOCK 4096u
+#define RF_HOST_PATH 160u
+struct rf_host_ops {
+    void *context;
+    int (*check)(void *);
+    int (*lookup)(void *, const char *, const uint8_t **, uint32_t *);
+    int (*send)(void *, uint32_t from, uint32_t node, uint32_t to, const uint8_t *, uint32_t);
+    void (*event)(void *, unsigned kind, const char *name, uint32_t size);
+};
+struct rf_host_ram { char name[RF_HOST_PATH]; uint32_t used, bytes; uint8_t data[65536]; };
+struct rf_host_tftp {
+    uint32_t used, done, complete, write, node, port, local, block, block_bytes, offset, end;
+    int ram;
+    const uint8_t *data;
+    char name[RF_HOST_PATH];
+    uint32_t response_bytes;
+    uint8_t response[RF_HOST_BLOCK + 256];
+};
+struct rf_host {
+    uint32_t poisoned, serial, requests, pd_requests, reads, writes, missing, rmtfs_requests, rmtfs_message;
+    struct rf_host_ram ram[4];
+    struct rf_host_tftp session[8];
+    uint8_t qmi[512];
+};
+static inline uint16_t rf_host_le16(const uint8_t *p) { return (uint16_t)p[0] | (uint16_t)p[1] << 8; }
+static inline uint16_t rf_host_be16(const uint8_t *p) { return (uint16_t)p[1] | (uint16_t)p[0] << 8; }
+static inline void rf_host_le_put(uint8_t *p, uint32_t value, unsigned bytes)
+{ for (unsigned i = 0; i < bytes; ++i) p[i] = (uint8_t)(value >> (i * 8u)); }
+static inline void rf_host_be_put(uint8_t *p, uint16_t value) { p[0] = (uint8_t)(value >> 8); p[1] = (uint8_t)value; }
+static inline int rf_host_string(const uint8_t *data, uint32_t bytes, uint32_t *cursor,
+    char *out, unsigned capacity)
+{
+    if (!cursor || !out || !capacity || *cursor >= bytes) return -1;
+    unsigned used = 0;
+    while (*cursor < bytes && data[*cursor]) {
+        unsigned c = data[(*cursor)++];
+        if (c < 32 || c > 126 || used + 1u >= capacity) return -1;
+        out[used++] = (char)c;
+    }
+    if (*cursor == bytes) return -1;
+    ++*cursor; out[used] = 0;
+    return 0;
+}
+static inline int rf_host_decimal(const char *text, uint32_t *value)
+{
+    if (!text || !text[0] || !value) return -1;
+    uint32_t out = 0;
+    for (unsigned i = 0; text[i]; ++i) {
+        unsigned digit = (unsigned)(text[i] - '0');
+        if (i >= 10 || digit > 9 || out > (UINT32_MAX - digit) / 10u) return -1;
+        out = out * 10u + digit;
+    }
+    *value = out; return 0;
+}
+static inline int rf_host_path(const char *name)
+{
+    if (!name || !name[0]) return -1;
+    for (unsigned i = 0; name[i]; ++i) {
+        if (i + 1u >= RF_HOST_PATH || (name[i] == '.' && name[i + 1u] == '.') ||
+            (name[i] == '/' && name[i + 1u] == '/')) return -1;
+    }
+    return 0;
+}
+static inline int rf_host_gate(struct rf_host *h, const struct rf_host_ops *o)
+{
+    if (!h || !o || !o->check || !o->lookup || !o->send || !o->event || h->poisoned) return -1;
+    if (o->check(o->context)) { h->poisoned = 1; return -1; }
+    return 0;
+}
+static inline int rf_host_emit(struct rf_host *h, const struct rf_host_ops *o, struct rf_host_tftp *s)
+{
+    if (rf_host_gate(h, o)) return -1;
+    if (o->send(o->context, s->local, s->node, s->port, s->response, s->response_bytes)) {
+        h->poisoned = 1; return -1;
+    }
+    return 0;
+}
+static inline int rf_host_error(struct rf_host *h, const struct rf_host_ops *o,
+    struct rf_host_tftp *s, uint16_t code)
+{
+    rf_host_be_put(s->response, 5); rf_host_be_put(s->response + 2, code);
+    memcpy(s->response + 4, "unavailable", 12); s->response_bytes = 16; s->done = s->complete = 1;
+    return rf_host_emit(h, o, s);
+}
+static inline int rf_host_data(struct rf_host *h, const struct rf_host_ops *o, struct rf_host_tftp *s)
+{
+    if (s->offset > s->end || !s->block || s->block > 65535 || !s->data) return -1;
+    uint32_t bytes = s->end - s->offset;
+    if (bytes > s->block_bytes) bytes = s->block_bytes;
+    rf_host_be_put(s->response, 3); rf_host_be_put(s->response + 2, (uint16_t)s->block);
+    memcpy(s->response + 4, s->data + s->offset, bytes); s->response_bytes = bytes + 4u;
+    s->done = bytes < s->block_bytes;
+    return rf_host_emit(h, o, s);
+}
+static inline int rf_host_option(uint8_t *out, uint32_t *used, const char *name, uint32_t value)
+{
+    unsigned name_bytes = (unsigned)strlen(name) + 1u;
+    char digits[11]; unsigned count = 0;
+    do { digits[count++] = (char)('0' + value % 10u); value /= 10u; } while (value);
+    if (*used + name_bytes + count + 1u > RF_HOST_BLOCK + 256u) return -1;
+    memcpy(out + *used, name, name_bytes); *used += name_bytes;
+    while (count) out[(*used)++] = (uint8_t)digits[--count];
+    out[(*used)++] = 0;
+    return 0;
+}
+static inline int rf_host_tftp_request(struct rf_host *h, const struct rf_host_ops *o,
+    uint32_t node, uint32_t port, const uint8_t *data, uint32_t bytes)
+{
+    if (rf_host_gate(h, o) || bytes < 4 || bytes > 1024) return -1;
+    uint16_t command = rf_host_be16(data);
+    if (command != 1 && command != 2) return -1;
+    char name[RF_HOST_PATH], mode[16]; uint32_t cursor = 2;
+    if (rf_host_string(data, bytes, &cursor, name, sizeof(name)) || rf_host_path(name) ||
+        rf_host_string(data, bytes, &cursor, mode, sizeof(mode)) || strcmp(mode, "octet")) return -1;
+    for (unsigned i = 0; i < 8; ++i) if (h->session[i].used && h->session[i].node == node &&
+        h->session[i].port == port && !h->session[i].complete && !strcmp(h->session[i].name, name))
+        return rf_host_emit(h, o, &h->session[i]);
+    int slot = -1;
+    for (unsigned i = 0; i < 8; ++i) if (!h->session[i].used || h->session[i].complete) { slot = (int)i; break; }
+    if (slot < 0 || h->serial >= 4096) return -1;
+    struct rf_host_tftp *s = &h->session[slot];
+    memset(s, 0, sizeof(*s)); s->used = 1; s->write = command == 2; s->node = node; s->port = port;
+    s->local = 0x4100u + h->serial++; s->block_bytes = 512; s->ram = -1; memcpy(s->name, name, strlen(name) + 1u);
+    bool options = cursor < bytes; uint32_t seek = 0, requested = UINT32_MAX, flags = 0, timeout = 1000, transfer_size = 0;
+    for (unsigned count = 0; cursor < bytes; ++count) {
+        char option[24], text[16]; uint32_t value;
+        if (count >= 16 || rf_host_string(data, bytes, &cursor, option, sizeof(option)) ||
+            rf_host_string(data, bytes, &cursor, text, sizeof(text)) || rf_host_decimal(text, &value))
+            return rf_host_error(h, o, s, 8);
+        unsigned bit = !strcmp(option, "blksize") ? 1u : !strcmp(option, "wsize") ? 2u :
+            !strcmp(option, "seek") ? 4u : !strcmp(option, "rsize") ? 8u : !strcmp(option, "tsize") ? 16u :
+            !strcmp(option, "timeoutms") ? 32u : 0;
+        if (bit && (flags & bit)) return rf_host_error(h, o, s, 8);
+        flags |= bit;
+        if (bit == 1) {
+            if (value < 8 || value > 65535) return rf_host_error(h, o, s, 8);
+            s->block_bytes = value > RF_HOST_BLOCK ? RF_HOST_BLOCK : value;
+        } else if (bit == 2 && !value) return rf_host_error(h, o, s, 8);
+        else if (bit == 4) seek = value;
+        else if (bit == 8) requested = value ? value : UINT32_MAX;
+        else if (bit == 16) transfer_size = value;
+        else if (bit == 32) { if (!value || value > 10000) return rf_host_error(h, o, s, 8); timeout = value; }
+    }
+    bool writable = !strncmp(name, "/readwrite/", 11);
+    if (writable) {
+        for (unsigned i = 0; i < 4; ++i) if (h->ram[i].used && !strcmp(h->ram[i].name, name)) s->ram = (int)i;
+        if (s->ram < 0 && s->write) for (unsigned i = 0; i < 4; ++i) if (!h->ram[i].used) {
+            s->ram = (int)i; h->ram[i].used = 1; memcpy(h->ram[i].name, name, strlen(name) + 1u); break;
+        }
+        if (s->ram < 0) return rf_host_error(h, o, s, 1);
+        struct rf_host_ram *ram = &h->ram[s->ram];
+        if (s->write && !seek) ram->bytes = 0;
+        s->data = ram->data; s->end = ram->bytes;
+    } else {
+        if (s->write) return rf_host_error(h, o, s, 2);
+        const char *path = name;
+        if (!strncmp(path, "/readonly/firmware/", 19)) path += 19;
+        else if (!strncmp(path, "/vendor/firmware_mnt/", 21)) path += 21;
+        uint32_t length = 0;
+        if (strncmp(path, "image/", 6) || o->lookup(o->context, path, &s->data, &length)) {
+            ++h->missing; o->event(o->context, 3, name, 0); return rf_host_error(h, o, s, 1);
+        }
+        s->end = length;
+    }
+    uint32_t logical_size = s->end;
+    if (s->write) {
+        if (!writable || seek > sizeof(h->ram[0].data)) return rf_host_error(h, o, s, 3);
+        if ((flags & 16u) && transfer_size > sizeof(h->ram[0].data) - seek) return rf_host_error(h, o, s, 3);
+        logical_size = transfer_size;
+    } else {
+        if (seek > s->end) return rf_host_error(h, o, s, 0);
+        if (requested < s->end - seek) s->end = seek + requested;
+    }
+    s->offset = seek; ++h->requests; o->event(o->context, s->write ? 2 : 1, name, s->end);
+    options = options && flags != 0;
+    if (options) {
+        rf_host_be_put(s->response, 6); s->response_bytes = 2;
+        if ((flags & 1u) && rf_host_option(s->response, &s->response_bytes, "blksize", s->block_bytes)) return -1;
+        if ((flags & 2u) && rf_host_option(s->response, &s->response_bytes, "wsize", 1)) return -1;
+        if ((flags & 16u) && rf_host_option(s->response, &s->response_bytes, "tsize", logical_size)) return -1;
+        if ((flags & 32u) && rf_host_option(s->response, &s->response_bytes, "timeoutms", timeout)) return -1;
+        if ((flags & 4u) && seek && rf_host_option(s->response, &s->response_bytes, "seek", seek)) return -1;
+        if ((flags & 8u) && requested != UINT32_MAX &&
+            rf_host_option(s->response, &s->response_bytes, "rsize", requested)) return -1;
+    } else if (s->write) {
+        rf_host_be_put(s->response, 4); rf_host_be_put(s->response + 2, 0); s->response_bytes = 4;
+    } else { s->block = 1; return rf_host_data(h, o, s); }
+    return rf_host_emit(h, o, s);
+}
+static inline int rf_host_tftp_packet(struct rf_host *h, const struct rf_host_ops *o,
+    uint32_t node, uint32_t from, uint32_t to, const uint8_t *data, uint32_t bytes)
+{
+    if (rf_host_gate(h, o) || bytes < 4 || bytes > RF_HOST_BLOCK + 4u) return -1;
+    struct rf_host_tftp *s = NULL;
+    for (unsigned i = 0; i < 8; ++i) if (h->session[i].used && h->session[i].local == to &&
+        h->session[i].node == node && h->session[i].port == from) { s = &h->session[i]; break; }
+    if (!s) return -1;
+    uint16_t command = rf_host_be16(data), block = rf_host_be16(data + 2);
+    if (command == 5) { s->done = s->complete = 1; return 0; }
+    if (s->write) {
+        if (command != 3 || s->ram < 0 || bytes - 4u > s->block_bytes) return -1;
+        if (block == s->block) return rf_host_emit(h, o, s);
+        if (s->done || block != s->block + 1u || bytes - 4u > sizeof(h->ram[0].data) - s->offset)
+            return rf_host_error(h, o, s, 3);
+        memcpy(h->ram[s->ram].data + s->offset, data + 4u, bytes - 4u);
+        s->offset += bytes - 4u; s->block = block;
+        if (h->ram[s->ram].bytes < s->offset) h->ram[s->ram].bytes = s->offset;
+        s->done = s->complete = bytes - 4u < s->block_bytes; ++h->writes;
+        rf_host_be_put(s->response, 4); rf_host_be_put(s->response + 2, block); s->response_bytes = 4;
+        return rf_host_emit(h, o, s);
+    }
+    if (command != 4 || bytes != 4) return -1;
+    if (block + 1u == s->block) return rf_host_emit(h, o, s);
+    if (block != s->block) return -1;
+    if (s->block && s->done) { s->complete = 1; return 0; }
+    if (s->block) s->offset += s->response_bytes - 4u;
+    if (++s->block > 65535) return -1;
+    ++h->reads; return rf_host_data(h, o, s);
+}
+static inline int rf_host_pd(struct rf_host *h, const struct rf_host_ops *o, uint32_t node,
+    uint32_t from, const uint8_t *data, uint32_t bytes)
+{
+    if (rf_host_gate(h, o) || bytes < 7 || bytes > 512 || data[0] || rf_host_le16(data + 5) != bytes - 7u)
+        return -1;
+    uint8_t *out = h->qmi; memset(out, 0, 512); out[0] = 2;
+    memcpy(out + 1, data + 1, 4);
+    uint32_t used = 14; out[7] = 2; rf_host_le_put(out + 8, 4, 2);
+    uint16_t message = rf_host_le16(data + 3);
+    char name[80] = {0}; bool found = false;
+    if (message == 0x21) for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        uint32_t count = rf_host_le16(data + at + 1);
+        if (count > bytes - at - 3u) return -1;
+        if (data[at] == 1) {
+            if (found || !count || count >= sizeof(name)) return -1;
+            for (unsigned i = 0; i < count; ++i) if (data[at + 3u + i] < 32 || data[at + 3u + i] > 126) return -1;
+            memcpy(name, data + at + 3u, count); found = true;
+        }
+        at += 3u + count;
+    }
+    if (message == 0x21 && found) {
+        /* Captured modemr.jsn supplies root servreg/GPS; modemuw.jsn supplies
+         * WLAN servreg/ELF loader/fw. Absent PDR/dump services stay absent. */
+        bool wlan = !strcmp(name, "wlan/fw") || !strcmp(name, "kernel/elf_loader") || !strcmp(name, "tms/servreg");
+        bool root = !strcmp(name, "tms/servreg") || !strcmp(name, "gps/gps_service");
+        unsigned matched = (unsigned)wlan + (unsigned)root;
+        out[used++] = 0x10; rf_host_le_put(out + used, 2, 2); used += 2;
+        rf_host_le_put(out + used, matched, 2); used += 2;
+        out[used++] = 0x11; rf_host_le_put(out + used, 2, 2); used += 2;
+        rf_host_le_put(out + used, 1, 2); used += 2;
+        if (matched) {
+            static const char *const domain[2] = {"msm/modem/root_pd", "msm/modem/wlan_pd"};
+            uint32_t start = used;
+            out[used++] = 0x12; used += 2; out[used++] = (uint8_t)matched;
+            for (unsigned i = 0; i < 2; ++i) {
+                if (i == 0 ? !root : !wlan) continue;
+                unsigned length = (unsigned)strlen(domain[i]);
+                out[used++] = (uint8_t)length;
+                memcpy(out + used, domain[i], length); used += length;
+                rf_host_le_put(out + used, 180, 4); used += 4;
+                out[used++] = 0; memset(out + used, 0, 4); used += 4;
+            }
+            rf_host_le_put(out + start + 1u, used - start - 3u, 2);
+        }
+        ++h->pd_requests; o->event(o->context, 4, name, matched);
+    } else if (message != 0x20) {
+        rf_host_le_put(out + 10, 1, 2); rf_host_le_put(out + 12, 0x5e, 2);
+    }
+    rf_host_le_put(out + 5, used - 7u, 2);
+    if (o->send(o->context, 0x4001, node, from, out, used)) { h->poisoned = 1; return -1; }
+    return 0;
+}
+/* Observe real RMTFS demand without granting a file handle, buffer address,
+ * physical read/write or successful storage operation. Error values follow
+ * the native service: internal1, malformed2. No EFS backend is present. */
+static inline int rf_host_rmtfs_refuse(struct rf_host *h, const struct rf_host_ops *o, uint32_t node,
+    uint32_t from, const uint8_t *data, uint32_t bytes)
+{
+    if (rf_host_gate(h, o) || bytes < 7 || bytes > 4096 || data[0] || rf_host_le16(data + 5) != bytes - 7u)
+        return -1;
+    uint16_t message = rf_host_le16(data + 3), error = 1;
+    char name[128] = {0}; uint32_t requested = 0, seen = 0;
+    for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3u) { error = 2; break; }
+        uint32_t length = rf_host_le16(data + at + 1), kind = data[at];
+        if (length > bytes - at - 3u) { error = 2; break; }
+        const uint8_t *value = data + at + 3u;
+        if (message == 1 && kind == 1) {
+            if ((seen & 1u) || !length || length >= sizeof(name)) { error = 2; break; }
+            seen |= 1;
+            for (unsigned i = 0; i < length; ++i) {
+                if (value[i] < 32 || value[i] > 126) { error = 2; break; }
+                name[i] = (char)value[i];
+            }
+        } else if (message == 4 && kind == 2) {
+            if ((seen & 2u) || length != 4) { error = 2; break; }
+            seen |= 2;
+            for (unsigned i = 0; i < 4; ++i) requested |= (uint32_t)value[i] << (8u * i);
+        }
+        at += 3u + length;
+    }
+    if (message == 1 && !(seen & 1u)) error = 2;
+    ++h->rmtfs_requests; h->rmtfs_message = message;
+    o->event(o->context, 5u + message, name[0] ? name : "RMTFS unavailable", requested);
+    uint8_t response[14] = {2, 0, 0, 0, 0, 7, 0, 2, 4, 0, 1, 0, 0, 0};
+    memcpy(response + 1, data + 1, 4); rf_host_le_put(response + 12, error, 2);
+    if (o->send(o->context, 0x4003, node, from, response, sizeof(response))) { h->poisoned = 1; return -1; }
+    return 0;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_qmi.h b/iokit/Kernel/arm/redfin_wifi_qmi.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_qmi.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: MIT
+ * Legacy ICNSS WLFW capability framing, QMI service0x45/v1/message0x24.
+ * Pinned native icnss_qmi.c and preferred redwood_wlfw.c were reviewed.
+ */
+#ifndef REDFIN_WIFI_QMI_H
+#define REDFIN_WIFI_QMI_H
+#include <stdint.h>
+#include <string.h>
+struct rf_wlfw_cap {
+    uint32_t valid, chip, family, board, soc, firmware, chain;
+    uint16_t result, error;
+};
+static inline uint16_t rf_qmi_u16(const uint8_t *p) { return (uint16_t)p[0] | (uint16_t)p[1] << 8; }
+static inline uint32_t rf_qmi_u32(const uint8_t *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+static inline int rf_wlfw_cap_parse(struct rf_wlfw_cap *out, const uint8_t *data, uint32_t bytes, uint16_t transaction)
+{
+    if (!out || !data || bytes < 7 || bytes > 4096 || data[0] != 2 ||
+        rf_qmi_u16(data + 1) != transaction || rf_qmi_u16(data + 3) != 0x24 ||
+        rf_qmi_u16(data + 5) != bytes - 7u) return -1;
+    struct rf_wlfw_cap parsed;
+    memset(&parsed, 0, sizeof(parsed));
+    uint32_t seen = 0;
+    for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        uint32_t length = rf_qmi_u16(data + at + 1), type = data[at], bit = 0;
+        if (length > bytes - at - 3u) return -1;
+        const uint8_t *value = data + at + 3u;
+        if (type == 2) {
+            bit = 1;
+            if (length != 4) return -1;
+            parsed.result = rf_qmi_u16(value); parsed.error = rf_qmi_u16(value + 2);
+        } else if (type == 0x10) {
+            bit = 2;
+            if (length != 8) return -1;
+            parsed.chip = rf_qmi_u32(value); parsed.family = rf_qmi_u32(value + 4); parsed.valid |= 1;
+        } else if (type == 0x11 || type == 0x12) {
+            bit = type == 0x11 ? 4u : 8u;
+            if (length != 4) return -1;
+            if (type == 0x11) { parsed.board = rf_qmi_u32(value); parsed.valid |= 2; }
+            else { parsed.soc = rf_qmi_u32(value); parsed.valid |= 4; }
+        } else if (type == 0x13) {
+            bit = 16;
+            if (length < 4 || length > 128) return -1;
+            parsed.firmware = rf_qmi_u32(value); parsed.valid |= 8;
+        } else if (type == 0x1b) {
+            bit = 32;
+            if (length != 4) return -1;
+            parsed.chain = rf_qmi_u32(value); parsed.valid |= 16;
+        }
+        if (bit && (seen & bit)) return -1;
+        seen |= bit; at += 3u + length;
+    }
+    if (!(seen & 1u) || parsed.result > 1 || (!parsed.result && parsed.error)) return -1;
+    if (parsed.result) parsed.valid = 0;
+    *out = parsed;
+    return 0;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_rmtfs.h b/iokit/Kernel/arm/redfin_wifi_rmtfs.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_rmtfs.h
@@ -0,0 +1,214 @@
+/* SPDX-License-Identifier: MIT
+ * Native RMTFS QMI framing, with private snapshots and volatile RAM shadows.
+ * Wire reference: linux-msm/rmtfs b30a3eb38f9af283f18dbd3c7755653efc52c094.
+ * This implementation has no filesystem, block-device or arbitrary DMA API.
+ */
+#ifndef REDFIN_WIFI_RMTFS_H
+#define REDFIN_WIFI_RMTFS_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#define RF_RM_SHARED 0x280000u
+struct rf_rm_file {
+    const uint8_t *initial;
+    uint8_t *shadow;
+    uint32_t bytes, open, node, port;
+};
+struct rf_rmtfs {
+    struct rf_rm_file file[4];
+    const uint8_t *image;
+    size_t image_bytes;
+    volatile uint8_t *shared;
+    uint64_t physical;
+    uint32_t ready, poisoned, requests, opens, allocations, reads, writes, failures, last_message;
+};
+struct rf_rm_ops {
+    void *context;
+    int (*check)(void *);
+    int (*barrier)(void *);
+    int (*send)(void *, uint32_t node, uint32_t port, const uint8_t *, uint32_t);
+    void (*event)(void *, unsigned message, unsigned caller, unsigned bytes, unsigned error);
+};
+static const char *const rf_rm_names[4] = {
+    "/boot/modem_fs1", "/boot/modem_fs2", "/boot/modem_fsg", "/boot/modem_fsc"};
+static inline uint32_t rf_rm_u32(const uint8_t *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+static inline uint64_t rf_rm_u64(const uint8_t *p)
+{ return rf_rm_u32(p) | (uint64_t)rf_rm_u32(p + 4) << 32; }
+static inline void rf_rm_put(uint8_t *p, uint64_t value, unsigned bytes)
+{ for (unsigned i = 0; i < bytes; ++i) p[i] = (uint8_t)(value >> (8u * i)); }
+static inline int rf_rm_overlap(const void *a, size_t n, const void *b, size_t m)
+{
+    uintptr_t x = (uintptr_t)a, y = (uintptr_t)b;
+    return x > UINTPTR_MAX - n || y > UINTPTR_MAX - m || (x < y + m && y < x + n);
+}
+/* Include after wifi_firmware.h for the existing SHA-256 callback ABI. */
+static inline int rf_rm_image_open(struct rf_rmtfs *s, const uint8_t *data, size_t bytes,
+    const uint8_t expected[32], redfin_mpss_sha256_fn sha, void *opaque)
+{
+    if (!s || s->image || s->ready || !data || !expected || !sha || bytes < 576 || bytes > 12u * 1024u * 1024u ||
+        rf_rm_overlap(s, sizeof(*s), data, bytes)) return -1;
+    uint8_t digest[32];
+    if (memcmp(data, "RFRMS01\0", 8) || rf_rm_u32(data + 8) != 1 || rf_rm_u32(data + 12) != 4 ||
+        rf_rm_u64(data + 16) != bytes || rf_rm_u64(data + 24) != 128 || sha(opaque, data, bytes, digest) ||
+        memcmp(digest, expected, 32)) return -1;
+    for (unsigned i = 32; i < 64; ++i) if (data[i]) return -1;
+    size_t cursor = 576;
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint8_t *entry = data + 64u + i * 128u;
+        size_t length = strlen(rf_rm_names[i]);
+        if (memcmp(entry, rf_rm_names[i], length)) return -1;
+        for (size_t j = length; j < 64; ++j) if (entry[j]) return -1;
+        for (unsigned j = 112; j < 128; ++j) if (entry[j]) return -1;
+        uint64_t offset = rf_rm_u64(entry + 64), count = rf_rm_u64(entry + 72);
+        if (offset != cursor || !count || count > 4u * 1024u * 1024u || count % 4096u ||
+            offset > bytes || count > bytes - offset || sha(opaque, data + cursor, (size_t)count, digest) ||
+            memcmp(digest, entry + 80, 32)) return -1;
+        cursor += (size_t)count;
+    }
+    if (cursor != bytes) return -1;
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint8_t *entry = data + 64u + i * 128u;
+        s->file[i].initial = data + rf_rm_u64(entry + 64);
+        s->file[i].bytes = (uint32_t)rf_rm_u64(entry + 72);
+    }
+    s->image = data; s->image_bytes = bytes;
+    return 0;
+}
+static inline size_t rf_rm_shadow_bytes(const struct rf_rmtfs *s)
+{
+    size_t bytes = 0;
+    if (s && s->image && !s->poisoned) for (unsigned i = 0; i < 4; ++i) bytes += s->file[i].bytes;
+    return bytes;
+}
+static inline int rf_rm_shadow_open(struct rf_rmtfs *s, uint8_t *data, size_t bytes)
+{
+    if (!s || !s->image || s->ready || s->poisoned || s->file[0].shadow || !data ||
+        bytes != rf_rm_shadow_bytes(s) || rf_rm_overlap(s, sizeof(*s), data, bytes) ||
+        rf_rm_overlap(s->image, s->image_bytes, data, bytes)) return -1;
+    size_t cursor = 0;
+    for (unsigned i = 0; i < 4; ++i) {
+        s->file[i].shadow = data + cursor;
+        memcpy(data + cursor, s->file[i].initial, s->file[i].bytes); cursor += s->file[i].bytes;
+    }
+    return 0;
+}
+/* Called only after the platform owns, zeroes and successfully shares this
+ * exact buffer with HLOS3/MSS15, read-write, retaining it until full reset. */
+static inline int rf_rm_bind(struct rf_rmtfs *s, volatile uint8_t *shared, uint64_t physical, size_t bytes)
+{
+    if (!s || s->ready || s->poisoned || !s->image || !s->file[0].shadow || !shared || bytes != RF_RM_SHARED ||
+        physical < UINT64_C(0x80000000) || physical > UINT64_C(0x100000000) - bytes || physical % 16384u ||
+        rf_rm_overlap(s->image, s->image_bytes, (const void *)shared, bytes) ||
+        rf_rm_overlap(s->file[0].shadow, rf_rm_shadow_bytes(s), (const void *)shared, bytes) ||
+        rf_rm_overlap(s, sizeof(*s), (const void *)shared, bytes)) return -1;
+    s->shared = shared; s->physical = physical; s->ready = 1;
+    return 0;
+}
+static inline int rf_rm_gate(struct rf_rmtfs *s, const struct rf_rm_ops *o)
+{
+    if (!s || !o || !o->check || !o->barrier || !o->send || !o->event || !s->ready || s->poisoned) return -1;
+    if (o->check(o->context)) { s->poisoned = 1; return -1; }
+    return 0;
+}
+static inline int rf_rm_request(struct rf_rmtfs *s, const struct rf_rm_ops *o, uint32_t node,
+    uint32_t port, const uint8_t *data, uint32_t bytes)
+{
+    if (rf_rm_gate(s, o) || !data || bytes < 7 || bytes > 4096 || data[0] ||
+        ((uint32_t)data[5] | (uint32_t)data[6] << 8) != bytes - 7u) return -1;
+    uint32_t message = (uint32_t)data[3] | (uint32_t)data[4] << 8, error = 0, seen = 0;
+    const uint8_t *value[4] = {NULL, NULL, NULL, NULL}; uint32_t length[4] = {0};
+    uint8_t response[25] = {2, 0, 0, 0, 0, 7, 0, 2, 4, 0, 0, 0, 0, 0};
+    memcpy(response + 1, data + 1, 4);
+    uint32_t used = 14, caller = 0, transferred = 0;
+    struct rf_rm_file *file = NULL;
+    if (!message || message > 5) error = 0x5e;
+    for (uint32_t at = 7; !error && at < bytes;) {
+        if (bytes - at < 3) { error = 2; break; }
+        uint32_t kind = data[at], count = (uint32_t)data[at + 1] | (uint32_t)data[at + 2] << 8;
+        if (count > bytes - at - 3u || !kind || (kind > 4 && kind < 16)) { error = 2; break; }
+        if (kind <= 4) {
+            unsigned bit = 1u << (kind - 1u);
+            if (seen & bit) { error = 2; break; }
+            seen |= bit; value[kind - 1] = data + at + 3u; length[kind - 1] = count;
+        }
+        at += 3u + count;
+    }
+    uint32_t required = message == 3 ? 15u : message == 4 ? 3u : 1u;
+    if (!error && seen != required) error = 2;
+    if (!error && message == 1) {
+        for (unsigned i = 0; i < 4; ++i) if (length[0] == strlen(rf_rm_names[i]) &&
+            !memcmp(value[0], rf_rm_names[i], length[0])) { file = &s->file[i]; caller = i + 1u; break; }
+        if (!file || (file->open && file->node != node)) error = 1;
+        if (!error) {
+            file->open = 1; file->node = node; file->port = port;
+            response[14] = 16; rf_rm_put(response + 15, 4, 2); rf_rm_put(response + 17, caller, 4); used += 7;
+            ++s->opens;
+        }
+    } else if (!error) {
+        if (length[0] != 4) error = 2;
+        else {
+            caller = rf_rm_u32(value[0]);
+            if (caller >= 1 && caller <= 4) file = &s->file[caller - 1u];
+            /* Native handles belong to a QRTR node. MPSS can use another
+             * client socket/port for subsequent requests on the same handle. */
+            if (!file || !file->open || file->node != node) error = 1;
+        }
+        if (!error && message == 2) file->open = 0;
+        else if (!error && message == 4) {
+            if (length[1] != 4) error = 2;
+            else {
+                uint32_t requested = rf_rm_u32(value[1]);
+                transferred = requested;
+                if (requested > RF_RM_SHARED) error = 1;
+                else {
+                    /* rmtfs_mem_alloc returns the same fixed buffer even for
+                     * size0; it does not carve a per-request suballocation. */
+                    response[14] = 16; rf_rm_put(response + 15, 8, 2); rf_rm_put(response + 17, s->physical, 8);
+                    used += 11; ++s->allocations; transferred = requested;
+                }
+            }
+        } else if (!error && message == 5) {
+            response[14] = 16; rf_rm_put(response + 15, 1, 2); response[17] = 0; used += 4;
+        } else if (!error && message == 3) {
+            uint32_t count = length[2] ? value[2][0] : 0;
+            if (length[1] != 1 || value[1][0] > 1 || length[3] != 1 || value[3][0] > 1 ||
+                length[2] != 1u + 12u * count) error = 2;
+            /* Prevalidate the complete vector before copying any byte. */
+            for (uint32_t i = 0; !error && i < count; ++i) {
+                const uint8_t *entry = value[2] + 1u + 12u * i;
+                uint64_t sector = rf_rm_u32(entry), physical = rf_rm_u32(entry + 4), sectors = rf_rm_u32(entry + 8);
+                uint64_t size = sectors * 512u;
+                /* The native buffer is global to the service, not allocated
+                 * per partition handle. A zero-sector vector is a no-op. */
+                if (!sectors) continue;
+                if (sector * 512u > file->bytes || size > file->bytes - sector * 512u ||
+                    physical < s->physical || physical - s->physical > RF_RM_SHARED ||
+                    size > RF_RM_SHARED - (physical - s->physical) ||
+                    size > 16u * 1024u * 1024u - transferred) error = 1;
+                else transferred += (uint32_t)size;
+            }
+            if (!error && o->barrier(o->context)) { s->poisoned = 1; return -1; }
+            for (uint32_t i = 0; !error && i < count; ++i) {
+                const uint8_t *entry = value[2] + 1u + 12u * i;
+                uint32_t offset = rf_rm_u32(entry) * 512u, pool_offset = rf_rm_u32(entry + 4) - (uint32_t)s->physical;
+                uint32_t size = rf_rm_u32(entry + 8) * 512u;
+                for (uint32_t at = 0; at < size; ++at) {
+                    if (!(at % 4096u) && rf_rm_gate(s, o)) return -1;
+                    if (value[1][0]) file->shadow[offset + at] = s->shared[pool_offset + at];
+                    else s->shared[pool_offset + at] = file->shadow[offset + at];
+                }
+            }
+            if (!error && o->barrier(o->context)) { s->poisoned = 1; return -1; }
+            if (!error) { if (value[1][0]) s->writes += transferred / 512u; else s->reads += transferred / 512u; }
+        }
+    }
+    if (error) { used = 14; rf_rm_put(response + 10, 1, 2); rf_rm_put(response + 12, error, 2); ++s->failures; }
+    rf_rm_put(response + 5, used - 7u, 2);
+    ++s->requests; s->last_message = message;
+    o->event(o->context, message, caller, transferred, error);
+    if (rf_rm_gate(s, o) || o->send(o->context, node, port, response, used)) { s->poisoned = 1; return -1; }
+    return 0;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_hyp.h b/iokit/Kernel/arm/redfin_wifi_hyp.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_hyp.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: MIT
+ * One bounded HLOS3 -> HLOS3/MSS15 RW assignment, for the owned RMTFS buffer.
+ * Google msm 500b3a2059c1eec0fec08ec56add06320ea901a8 secure_buffer.c/scm.c.
+ * Include after redfin_scm_query.h and wifi_rmtfs.h. All memory is retained
+ * until platform reset after either success or an uncertain result.
+ */
+#ifndef REDFIN_WIFI_HYP_H
+#define REDFIN_WIFI_HYP_H
+static inline int rf_rm_hyp_prepare(uint8_t *scratch, uint64_t physical, uint64_t shared)
+{
+    if (!scratch || physical < UINT64_C(0x180000000) || physical > UINT64_C(0x200000000) - 16384u ||
+        physical % 16384u || shared < UINT64_C(0x80000000) || shared > UINT64_C(0x100000000) - RF_RM_SHARED ||
+        shared % 16384u) return EINVAL;
+    memset(scratch, 0, 16384);
+    rf_rm_put(scratch, shared, 8); rf_rm_put(scratch + 8, RF_RM_SHARED, 8);
+    rf_rm_put(scratch + 0x40, 3, 4);
+    rf_rm_put(scratch + 0x80, 3, 4); rf_rm_put(scratch + 0x84, 6, 4);
+    rf_rm_put(scratch + 0x98, 15, 4); rf_rm_put(scratch + 0x9c, 6, 4);
+    rf_rm_put(scratch + 0x100, 4, 8); rf_rm_put(scratch + 0x108, physical + 0x80, 8);
+    rf_rm_put(scratch + 0x110, 48, 8);
+    return 0;
+}
+static inline int rf_rm_hyp_run(const struct rf_sq_ops *o, uint64_t scratch, struct rf_sq_report *report)
+{
+    if (!o || !report || !o->valid || !o->invoke || !o->time_ns || !o->delay_us ||
+        scratch < UINT64_C(0x180000000) || scratch > UINT64_C(0x200000000) - 16384u || scratch % 16384u)
+        return EINVAL;
+    struct rf_sq_regs request = {{UINT64_C(0x42000c16), 0x1117, scratch, 16, scratch + 0x40, scratch + 0x100, 0, 0}};
+    struct rf_sq_regs live = request;
+#ifdef __cplusplus
+    *report = {};
+#else
+    *report = (struct rf_sq_report){0};
+#endif
+    report->convention = 64; report->function = request.x[0];
+    if (!o->valid(o->context)) return ECANCELED;
+    uint64_t first = o->time_ns(o->context);
+    for (;;) {
+        if (!o->valid(o->context)) return ECANCELED;
+        uint64_t now = o->time_ns(o->context);
+        if (now < first || now - first > UINT64_C(2000000000)) return ETIMEDOUT;
+        live.x[7] = 0;
+        int error = o->invoke(o->context, &live); ++report->calls;
+        if (error) return error;
+        if (!o->valid(o->context)) return ECANCELED;
+        now = o->time_ns(o->context);
+        if (now < first || now - first > UINT64_C(2000000000)) return ETIMEDOUT;
+        report->elapsed_ns = now - first; report->status = (int64_t)live.x[0];
+        for (unsigned i = 0; i < 3; ++i) report->value[i] = live.x[i + 1];
+        if (report->status == 1) { if (++report->resumes > 16) return ETIMEDOUT; continue; }
+        if (report->status == -12) {
+            if (report->busy_retries++ >= 3) return EBUSY;
+            o->delay_us(o->context, 30000); live = request; continue;
+        }
+        report->completed = true;
+        return report->status || report->value[0] ? EIO : 0;
+    }
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_wlfw.h b/iokit/Kernel/arm/redfin_wifi_wlfw.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_wlfw.h
@@ -0,0 +1,257 @@
+/* SPDX-License-Identifier: MIT
+ * Legacy Redfin ICNSS: indication registration -> MSA_INFO -> MSA_READY -> CAP.
+ * Wire reference: Google msm 500b3a2059c1eec0fec08ec56add06320ea901a8,
+ * icnss_qmi.c and wlan_firmware_service_v01.{c,h}. Include after wifi_qmi.h.
+ * This fixed-permission profile performs QMI only: no MSA CPU mapping,
+ * memory assignment, WLAN registers, supplies, mission mode or data DMA.
+ */
+#ifndef REDFIN_WIFI_WLFW_H
+#define REDFIN_WIFI_WLFW_H
+#define RF_WLFW_MSA_BASE UINT64_C(0x8ba00000)
+#define RF_WLFW_MSA_BYTES 0x200000u
+enum { RF_WLFW_IDLE, RF_WLFW_REGISTER, RF_WLFW_MSA_INFO, RF_WLFW_MSA_READY,
+       RF_WLFW_CAP, RF_WLFW_COMPLETE, RF_WLFW_FAILED };
+struct rf_wlfw_region { uint64_t base; uint32_t bytes, secure; };
+struct rf_wlfw_setup {
+    uint32_t stage, attempted, poisoned, registered, regions, msa_accepted, ready_indications, pin_indications;
+    uint32_t fw_ready, msa_ready_ind, responses, ignored, already_registered, notify_rejuvenate, rejuvenate;
+    uint32_t pin_valid, pin_value[3];
+    uint32_t hang_valid, hang_offset, hang_bytes;
+    uint16_t transaction, waiting, result, error;
+    uint64_t fw_status;
+    struct rf_wlfw_region region[2];
+    struct rf_wlfw_cap cap;
+};
+struct rf_wlfw_ops {
+    void *context;
+    int (*check)(void *);
+    int (*send)(void *, const uint8_t *, uint32_t);
+};
+static inline uint64_t rf_wlfw_u64(const uint8_t *p)
+{ return rf_qmi_u32(p) | (uint64_t)rf_qmi_u32(p + 4) << 32; }
+static inline void rf_wlfw_put(uint8_t *p, uint64_t value, unsigned bytes)
+{ for (unsigned i = 0; i < bytes; ++i) p[i] = (uint8_t)(value >> (8u * i)); }
+static inline int rf_wlfw_gate(struct rf_wlfw_setup *s, const struct rf_wlfw_ops *o)
+{
+    if (!s || !o || !o->check || !o->send || s->poisoned) return -1;
+    if (o->check(o->context)) { s->poisoned = 1; s->stage = RF_WLFW_FAILED; return -1; }
+    return 0;
+}
+static inline int rf_wlfw_send(struct rf_wlfw_setup *s, const struct rf_wlfw_ops *o, unsigned stage)
+{
+    if (rf_wlfw_gate(s, o) || !s->attempted) return -1;
+    if ((stage == RF_WLFW_REGISTER && (s->stage != RF_WLFW_IDLE || s->transaction)) ||
+        (stage == RF_WLFW_MSA_INFO && (s->stage != RF_WLFW_REGISTER || !s->registered || s->transaction != 1)) ||
+        (stage == RF_WLFW_MSA_READY && (s->stage != RF_WLFW_MSA_INFO || s->transaction != 2 || s->responses != 2)) ||
+        (stage == RF_WLFW_CAP && (s->stage != RF_WLFW_MSA_READY || !s->msa_accepted || s->transaction != 3))) return -1;
+    uint8_t data[48] = {0}; uint32_t used = 7;
+    uint16_t message = stage == RF_WLFW_REGISTER ? 0x20 : stage == RF_WLFW_MSA_INFO ? 0x2d :
+        stage == RF_WLFW_MSA_READY ? 0x2e : stage == RF_WLFW_CAP ? 0x24 : 0;
+    if (!message || s->transaction >= 4) return -1;
+    rf_wlfw_put(data + 1, ++s->transaction, 2); rf_wlfw_put(data + 3, message, 2);
+    if (stage == RF_WLFW_REGISTER) {
+        const uint8_t enables[] = {0x10, 0x13, 0x14};
+        for (unsigned i = 0; i < 3; ++i) {
+            data[used++] = enables[i]; data[used++] = 1; data[used++] = 0; data[used++] = 1;
+        }
+        data[used++] = 0x15; data[used++] = 4; data[used++] = 0;
+        rf_wlfw_put(data + used, UINT32_C(0x4b4e454c), 4); used += 4;
+        if (s->notify_rejuvenate) {
+            data[used++] = 0x19; data[used++] = 4; data[used++] = 0;
+            rf_wlfw_put(data + used, 1, 4); used += 4;
+        }
+    } else if (stage == RF_WLFW_MSA_INFO) {
+        data[used++] = 1; data[used++] = 8; data[used++] = 0;
+        rf_wlfw_put(data + used, RF_WLFW_MSA_BASE, 8); used += 8;
+        data[used++] = 2; data[used++] = 4; data[used++] = 0;
+        rf_wlfw_put(data + used, RF_WLFW_MSA_BYTES, 4); used += 4;
+    }
+    rf_wlfw_put(data + 5, used - 7u, 2);
+    s->stage = stage; s->waiting = message;
+    if (o->send(o->context, data, used) || rf_wlfw_gate(s, o)) {
+        s->poisoned = 1; s->stage = RF_WLFW_FAILED; return -1;
+    }
+    return 0;
+}
+static inline int rf_wlfw_begin_features(struct rf_wlfw_setup *s, const struct rf_wlfw_ops *o, unsigned rejuvenate)
+{
+    if (rejuvenate > 1 || rf_wlfw_gate(s, o) || s->attempted || s->stage != RF_WLFW_IDLE) return -1;
+    s->attempted = 1; s->notify_rejuvenate = rejuvenate;
+    return rf_wlfw_send(s, o, RF_WLFW_REGISTER);
+}
+static inline int rf_wlfw_begin(struct rf_wlfw_setup *s, const struct rf_wlfw_ops *o)
+{ return rf_wlfw_begin_features(s, o, 0); }
+/* 0 accepted, 1 unrelated/late response, -1 malformed or platform failure.
+ * A valid QMI error is recorded as FAILED without pretending it was success. */
+static inline int rf_wlfw_receive(struct rf_wlfw_setup *s, const struct rf_wlfw_ops *o,
+    const uint8_t *data, uint32_t bytes)
+{
+    if (rf_wlfw_gate(s, o) || !s->attempted || !data || bytes < 7 || bytes > 4096 ||
+        rf_qmi_u16(data + 5) != bytes - 7u) return -1;
+    uint16_t transaction = rf_qmi_u16(data + 1), message = rf_qmi_u16(data + 3);
+    if (data[0] != 2 && data[0] != 4) return -1;
+    if (data[0] == 4 && message == 0x39) {
+        /* Native rejuvenation means this WLAN epoch can no longer be used.
+         * This diagnostic retains resources and relies on full platform reset;
+         * it never acknowledges a recovery that it has not performed. */
+        if (bytes > 151) return -1;
+        for (uint32_t at = 7; at < bytes;) {
+            if (bytes - at < 3 || rf_qmi_u16(data + at + 1) > bytes - at - 3u) return -1;
+            at += 3u + rf_qmi_u16(data + at + 1);
+        }
+        s->rejuvenate = 1; s->poisoned = 1; s->stage = RF_WLFW_FAILED; return -1;
+    }
+    if (data[0] == 2 && (s->stage == RF_WLFW_COMPLETE || s->stage == RF_WLFW_FAILED ||
+        transaction != s->transaction || message != s->waiting)) { ++s->ignored; return 1; }
+    if (data[0] == 4 && message != 0x21 && message != 0x2b && message != 0x2c) { ++s->ignored; return 1; }
+    if (data[0] == 2 && s->stage == RF_WLFW_CAP) {
+        struct rf_wlfw_cap cap;
+        if (rf_wlfw_cap_parse(&cap, data, bytes, s->transaction)) return -1;
+        s->cap = cap; s->result = cap.result; s->error = cap.error; ++s->responses;
+        s->stage = cap.result ? RF_WLFW_FAILED : RF_WLFW_COMPLETE;
+        return 0;
+    }
+    uint32_t seen = 0, count = 0, offset = 0, length = 0, pins[3] = {0};
+    uint16_t result = 0, error = 0;
+    uint64_t status = 0;
+    struct rf_wlfw_region regions[2] = {{0, 0, 0}, {0, 0, 0}};
+    if (data[0] == 4 && message == 0x21) {
+        if (bytes != 7) return -1;
+        s->fw_ready = 1; ++s->ready_indications; return 0;
+    }
+    for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        uint32_t size = rf_qmi_u16(data + at + 1), kind = data[at], bit = 0;
+        const uint8_t *value = data + at + 3u;
+        if (size > bytes - at - 3u) return -1;
+        if (data[0] == 2 && kind == 2) {
+            bit = 1; if (size != 4) return -1;
+            result = rf_qmi_u16(value); error = rf_qmi_u16(value + 2);
+            if (result > 1 || (!result && error)) return -1;
+        } else if (data[0] == 2 && s->stage == RF_WLFW_REGISTER && kind == 0x10) {
+            bit = 2; if (size != 8) return -1; status = rf_wlfw_u64(value);
+        } else if (data[0] == 2 && s->stage == RF_WLFW_MSA_INFO && kind == 3) {
+            bit = 2;
+            if (!size || value[0] > 2 || size != 1u + 13u * value[0]) return -1;
+            count = value[0];
+            for (unsigned i = 0; i < count; ++i) {
+                const uint8_t *entry = value + 1u + 13u * i;
+                regions[i].base = rf_wlfw_u64(entry); regions[i].bytes = rf_qmi_u32(entry + 8); regions[i].secure = entry[12];
+                if (regions[i].base < RF_WLFW_MSA_BASE || regions[i].base >= RF_WLFW_MSA_BASE + RF_WLFW_MSA_BYTES ||
+                    regions[i].bytes > RF_WLFW_MSA_BASE + RF_WLFW_MSA_BYTES - regions[i].base || regions[i].secure > 1)
+                    return -1;
+                for (unsigned j = 0; j < i; ++j) if (regions[i].bytes && regions[j].bytes &&
+                    regions[i].base < regions[j].base + regions[j].bytes &&
+                    regions[j].base < regions[i].base + regions[i].bytes) return -1;
+            }
+        } else if (data[0] == 4 && message == 0x2b && kind == 0x10) {
+            bit = 1; if (size != 4) return -1; offset = rf_qmi_u32(value);
+        } else if (data[0] == 4 && message == 0x2b && kind == 0x11) {
+            bit = 2; if (size != 2) return -1; length = rf_qmi_u16(value);
+        } else if (data[0] == 4 && message == 0x2c && kind >= 0x10 && kind <= 0x12) {
+            bit = 1u << (kind - 0x10u); if (size != 4) return -1;
+            pins[kind - 0x10u] = rf_qmi_u32(value);
+        } else if (kind < 16) return -1;
+        if (bit && (seen & bit)) return -1;
+        seen |= bit; at += 3u + size;
+    }
+    if (data[0] == 4) {
+        if (message == 0x2b) {
+            if (offset > RF_WLFW_MSA_BYTES || length > RF_WLFW_MSA_BYTES - offset) return -1;
+            s->msa_ready_ind = 1;
+            s->hang_valid = seen; s->hang_offset = offset; s->hang_bytes = length;
+        } else { ++s->pin_indications; s->pin_valid = seen; memcpy(s->pin_value, pins, sizeof(pins)); }
+        return 0;
+    }
+    if (!(seen & 1u) || (!result && s->stage == RF_WLFW_MSA_INFO && !(seen & 2u))) return -1;
+    s->result = result; s->error = error; ++s->responses;
+    if (result) { s->stage = RF_WLFW_FAILED; return 0; }
+    if (s->stage == RF_WLFW_REGISTER) {
+        s->registered = 1; s->fw_status = status;
+        if (status & 1u) { s->stage = RF_WLFW_FAILED; s->already_registered = 1; return 0; }
+        if (status & 2u) s->fw_ready = 1;
+        if (status & 4u) s->msa_ready_ind = 1;
+        return rf_wlfw_send(s, o, RF_WLFW_MSA_INFO);
+    }
+    if (s->stage == RF_WLFW_MSA_INFO) {
+        s->regions = count; memcpy(s->region, regions, sizeof(regions));
+        return rf_wlfw_send(s, o, RF_WLFW_MSA_READY);
+    }
+    if (s->stage == RF_WLFW_MSA_READY) {
+        s->msa_accepted = 1;
+        return rf_wlfw_send(s, o, RF_WLFW_CAP);
+    }
+    return -1;
+}
+
+/* Pure plan for the optional native hang-data observer. A whole 16KiB
+ * mapping must fit inside one accepted nonsecure MSA region. No mapping,
+ * permission assignment or read is performed by this function.
+ * Return1 eligible,0 absent/disabled metadata,-1 invalid/unaccepted window. */
+struct rf_wlfw_hang_window { uint64_t physical; uint32_t mapped, offset, bytes; };
+static inline int rf_wlfw_hang_plan(const struct rf_wlfw_setup *s, struct rf_wlfw_hang_window *out)
+{
+    if (!out) return -1;
+    memset(out, 0, sizeof(*out));
+    if (!s || s->poisoned || s->stage != RF_WLFW_COMPLETE || !s->msa_accepted || !s->msa_ready_ind ||
+        s->result || s->error || s->regions > 2) return -1;
+    if (s->hang_valid != 3 || !s->hang_bytes) return 0;
+    if (s->hang_bytes > 400 || s->hang_offset >= RF_WLFW_MSA_BYTES ||
+        s->hang_bytes > RF_WLFW_MSA_BYTES - s->hang_offset) return -1;
+    uint64_t address = RF_WLFW_MSA_BASE + s->hang_offset;
+    uint64_t page = address & ~UINT64_C(16383);
+    uint32_t offset = (uint32_t)(address - page);
+    uint32_t mapped = (offset + s->hang_bytes + 16383u) & ~16383u;
+    unsigned matches = 0;
+    for (unsigned i = 0; i < s->regions; ++i) {
+        const struct rf_wlfw_region *r = &s->region[i];
+        if (r->secure > 1 || r->base < RF_WLFW_MSA_BASE || r->base >= RF_WLFW_MSA_BASE + RF_WLFW_MSA_BYTES ||
+            r->bytes > RF_WLFW_MSA_BASE + RF_WLFW_MSA_BYTES - r->base) return -1;
+        for (unsigned j = 0; j < i; ++j) if (r->bytes && s->region[j].bytes &&
+            r->base < s->region[j].base + s->region[j].bytes && s->region[j].base < r->base + r->bytes) return -1;
+        if (!r->secure && page >= r->base && page < r->base + r->bytes && mapped <= r->base + r->bytes - page)
+            ++matches;
+    }
+    if (matches != 1 || mapped > 32768u) return -1;
+    out->physical = page; out->mapped = mapped; out->offset = offset; out->bytes = s->hang_bytes;
+    return 1;
+}
+
+struct rf_wlfw_dynamic {
+    uint64_t previous, current;
+    uint32_t valid;
+    uint16_t result, error;
+};
+static inline void rf_wlfw_dynamic_request(uint8_t out[18])
+{
+    memset(out, 0, 18); rf_wlfw_put(out + 1, 5, 2); rf_wlfw_put(out + 3, 0x3b, 2);
+    rf_wlfw_put(out + 5, 11, 2); out[7] = 0x10; out[8] = 8;
+    rf_wlfw_put(out + 10, 1, 8); /* Native ICNSS default: FW_REJUVENATE. */
+}
+static inline int rf_wlfw_dynamic_parse(struct rf_wlfw_dynamic *out, const uint8_t *data, uint32_t bytes)
+{
+    if (!out || !data || bytes < 14 || bytes > 256 || data[0] != 2 || rf_qmi_u16(data + 1) != 5 ||
+        rf_qmi_u16(data + 3) != 0x3b || rf_qmi_u16(data + 5) != bytes - 7u) return -1;
+    struct rf_wlfw_dynamic parsed;
+    memset(&parsed, 0, sizeof(parsed)); uint32_t seen = 0;
+    for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        uint32_t length = rf_qmi_u16(data + at + 1), kind = data[at], bit = 0;
+        const uint8_t *value = data + at + 3u;
+        if (length > bytes - at - 3u) return -1;
+        if (kind == 2) {
+            bit = 1; if (length != 4) return -1;
+            parsed.result = rf_qmi_u16(value); parsed.error = rf_qmi_u16(value + 2);
+            if (parsed.result > 1 || (!parsed.result && parsed.error)) return -1;
+        } else if (kind == 0x10 || kind == 0x11) {
+            bit = kind == 0x10 ? 2u : 4u; if (length != 8) return -1;
+            parsed.valid |= kind == 0x10 ? 1u : 2u;
+            if (kind == 0x10) parsed.previous = rf_wlfw_u64(value); else parsed.current = rf_wlfw_u64(value);
+        } else if (kind < 16) return -1;
+        if (seen & bit) return -1;
+        seen |= bit; at += 3u + length;
+    }
+    if (!(seen & 1u)) return -1;
+    *out = parsed; return 0;
+}
+#endif
diff --git a/bsd/dev/redfin_wifi_pmic.inc b/bsd/dev/redfin_wifi_pmic.inc
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_wifi_pmic.inc
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: MIT
+ * Included at the end of redfin_spmi.c, after the existing rail observer.
+ * Google msm500b3a2: spmi-pmic-arb.c v5, qpnp-revid.h PM8150.
+ * Physical SID4 REVID2751 is authenticated on this Redfin; the live DT's
+ * pm8150l label does not establish its model name. Pin the observed identity.
+ * Qualcomm firmware20bb8ae: common LDO4000/stride100, pm_ldo_driver_init's
+ * type4/subtype>=30 unified layout and pm_pwr_alg VSET_VALID42/43.
+ * SID1 LDO ordering is already observed on Redfin. SID5 pages remain named
+ * candidates until independently attributed; no readiness policy uses them.
+ * Only the cached EE0 observer mapping is written, with EXT_READL commands.
+ * No PMIC write channel, new mapping, IRQ acknowledge or power command.
+ */
+static const unsigned redfin_wp_ppids[7] = {0x001, 0x401, 0x140, 0x14d, 0x541, 0x54a, 0x549};
+static struct {
+ unsigned busy, next_phase;
+ bool active, poisoned;
+ void *child;
+ int (*policy)(void *);
+ struct redfin_rail_target targets[7];
+} redfin_wp;
+struct redfin_wp_sample { uint16_t header, configured, valid, mode_enable, status; };
+
+static int
+redfin_wp_check(void)
+{
+ if (!redfin_wp.active || redfin_wp.poisoned || !redfin_wp.child || !redfin_wp.policy ||
+     !ml_get_interrupts_enabled() || __builtin_arm_rsr64("CurrentEL") != 4 ||
+     (__builtin_arm_rsr64("MPIDR_EL1") & 0xff00ffffffULL) ||
+     !redfin_spmi_return_ready() || !redfin_spmi_proof.ready ||
+     !redfin_spmi_proof.core || !redfin_spmi_proof.observer || !redfin_spmi_proof.config ||
+     redfin_spmi_proof.version < 0x50000000 || redfin_spmi_proof.version >= 0x70000000 ||
+     redfin_rail_attempted || redfin_rail_snapshot_busy || redfin_rail_poisoned ||
+     redfin_wp.policy(redfin_wp.child)) {
+  redfin_wp.poisoned = true;
+  return EPERM;
+ }
+ return 0;
+}
+
+static int
+redfin_wp_read(const struct redfin_rail_target *t, unsigned offset, unsigned count, uint16_t *out)
+{
+ bool allowed = false;
+ if (t) for (unsigned i = 0; i < 7; ++i) if (t == &redfin_wp.targets[i] && t->ppid == redfin_wp_ppids[i]) {
+  allowed = i < 2 ? offset == 4 && count == 2 :
+      ((offset == 4 || offset == 0x40 || offset == 0x42 || offset == 0x45) && count == 2) ||
+      (offset == 8 && count == 1);
+ }
+ if (!out || !allowed || redfin_wp_check()) return EINVAL;
+ if (!redfin_rail_mapping(t)) { redfin_wp.poisoned = true; return EAGAIN; }
+ unsigned channel = t->apid * 0x80;
+ uint32_t command = (1u << 27) | (offset << 4) | (count - 1u);
+ __asm__ volatile("dmb oshst" ::: "memory");
+ *(volatile uint32_t *)(redfin_spmi_proof.observer + channel) = command;
+ __asm__ volatile("dsb osh" ::: "memory");
+ for (unsigned us = 0; us < 1000; ++us) {
+  if (redfin_wp_check() || !redfin_rail_mapping(t)) { redfin_wp.poisoned = true; return EAGAIN; }
+  uint32_t status = redfin_spmi_rd(redfin_spmi_proof.observer, channel + 8);
+  if (status & 1) {
+   if (status & 0x0e) { redfin_wp.poisoned = true; return EIO; }
+   uint32_t data = redfin_spmi_rd(redfin_spmi_proof.observer, channel + 0x18);
+   if (redfin_wp_check() || !redfin_rail_mapping(t)) { redfin_wp.poisoned = true; return EAGAIN; }
+   *out = (uint16_t)(data & (count == 1 ? 255u : 65535u));
+   return 0;
+  }
+  delay(1);
+ }
+ redfin_wp.poisoned = true;
+ return ETIMEDOUT; /* No channel reuse, cleanup or retry before full reset. */
+}
+
+static bool redfin_wp_unified(uint16_t header)
+{ return (header & 255u) == 4 && (header >> 8) >= 0x30; }
+
+static int
+redfin_wp_sample(const struct redfin_rail_target *t, struct redfin_wp_sample *out)
+{
+ int error = redfin_wp_read(t, 4, 2, &out->header);
+ if (error || !redfin_wp_unified(out->header)) return error;
+ error = redfin_wp_read(t, 0x40, 2, &out->configured);
+ if (!error) error = redfin_wp_read(t, 0x42, 2, &out->valid);
+ if (!error) error = redfin_wp_read(t, 0x45, 2, &out->mode_enable);
+ if (!error) error = redfin_wp_read(t, 8, 1, &out->status);
+ return error;
+}
+
+int redfin_wifi_wlan_pmic_observe(unsigned phase, void *child, int (*policy)(void *));
+int
+redfin_wifi_wlan_pmic_observe(unsigned phase, void *child, int (*policy)(void *))
+{
+ if (phase > 2 || !child || !policy || redfin_wp.poisoned || phase != redfin_wp.next_phase ||
+     (phase && (child != redfin_wp.child || policy != redfin_wp.policy))) return EINVAL;
+ if (__atomic_exchange_n(&redfin_wp.busy, 1, __ATOMIC_ACQUIRE)) return EBUSY;
+ redfin_wp.child = child; redfin_wp.policy = policy; redfin_wp.active = true;
+ int error = redfin_wp_check();
+ if (error || !redfin_rail_platform()) { if (!error) error = ENXIO; goto out; }
+ if (!phase) {
+  for (unsigned i = 0; i < 7; ++i)
+   redfin_wp.targets[i] = (struct redfin_rail_target){redfin_wp_ppids[i], 512, 0, 0};
+  for (unsigned apid = 0; apid < 512; ++apid) {
+   if (redfin_wp_check()) { error = EPERM; goto out; }
+   uint32_t mapping = redfin_spmi_rd(redfin_spmi_proof.core, 0x900 + 4 * apid);
+   unsigned ppid = (mapping >> 8) & 0xfff;
+   if (!mapping) continue;
+   for (unsigned i = 0; i < 7; ++i) if (ppid == redfin_wp_ppids[i]) {
+    unsigned owner = redfin_spmi_rd(redfin_spmi_proof.config, 0x700 + 4 * apid) & 7;
+    if (redfin_wp.targets[i].apid == 512 || owner == 0)
+     redfin_wp.targets[i] = (struct redfin_rail_target){ppid, apid, owner, mapping};
+   }
+  }
+  for (unsigned i = 0; i < 7; ++i) if (redfin_wp.targets[i].apid == 512) {
+   printf("REDFIN WIFI PMIC: candidate PPID=%#x has no APID; physical absence unproven\n", redfin_wp_ppids[i]);
+   error = ENXIO; goto out;
+  }
+ }
+ for (unsigned i = 0; i < 2; ++i) {
+  uint16_t model = 0;
+  error = redfin_wp_read(&redfin_wp.targets[i], 4, 2, &model);
+  printf("REDFIN WIFI PMIC: phase=%u SID%u REVID=%#x result=%d\n", phase, i * 4u, model, error);
+  if (error) goto out;
+  if (model != (i ? 0x2751 : 0x1e51)) { error = ENOTSUP; goto out; }
+ }
+ for (unsigned i = 2; i < 7; ++i) {
+  const struct redfin_rail_target *t = &redfin_wp.targets[i];
+  struct redfin_wp_sample a = {0}, b = {0};
+  error = redfin_wp_sample(t, &a);
+  if (!error) {
+   if (redfin_wp_check()) { error = EPERM; goto out; }
+   delay(100);
+   error = redfin_wp_sample(t, &b);
+  }
+  if (error) goto out;
+  bool stable = a.header == b.header && a.configured == b.configured && a.valid == b.valid &&
+      a.mode_enable == b.mode_enable && a.status == b.status;
+  printf("REDFIN WIFI PMIC: phase=%u candidate PPID=%#x APID=%u owner=%u header=%#x unified=%u stable=%u configured_mV=%u valid_mV=%u MODE=%#x ENABLE=%#x STATUS=%#x ready=%u\n",
+      phase, t->ppid, t->apid, t->owner, a.header, redfin_wp_unified(a.header), stable,
+      a.configured, a.valid, a.mode_enable & 255u, a.mode_enable >> 8, a.status, !!(a.status & 0x80));
+  if (!stable) { error = EAGAIN; goto out; }
+ }
+ for (unsigned i = 0; i < 2; ++i) {
+  uint16_t model = 0;
+  error = redfin_wp_read(&redfin_wp.targets[i], 4, 2, &model);
+  if (error) goto out;
+  if (model != (i ? 0x2751 : 0x1e51)) { error = EAGAIN; goto out; }
+ }
+ ++redfin_wp.next_phase;
+out:
+ printf("REDFIN WIFI PMIC: phase=%u observation=%d; no PMIC writes, no supply-readiness claim\n", phase, error);
+ if (error) redfin_wp.poisoned = true;
+ redfin_wp.active = false;
+ __atomic_store_n(&redfin_wp.busy, 0, __ATOMIC_RELEASE);
+ return error;
+}
diff --git a/iokit/Kernel/arm/redfin_wifi_bdf.h b/iokit/Kernel/arm/redfin_wifi_bdf.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_bdf.h
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded Redfin CNSS DMON board-data exchange. Include after wifi_wlfw.h.
+ * Wire: Google msm500b3a2 wlan_firmware_service_v01.{c,h}. Redfin daemon
+ * reference9d38f1d7: DMON registration, MSA ready, CAP, BIN BDF, CAL_REPORT.
+ * This zero-cache profile subscribes only to FW/MSA ready, as ath10k does;
+ * it promises no calibration download/update or persistent calibration store.
+ * No MMIO, MSA assignment, mission mode, DMA or storage operation is here.
+ */
+#ifndef REDFIN_WIFI_BDF_H
+#define REDFIN_WIFI_BDF_H
+#define RF_BDF_CLIENT UINT32_C(0x444d4f4e)
+#define RF_BDF_PORT 0x4005u
+#define RF_BDF_BYTES 26328u
+#define RF_BDF_CHUNK 2048u
+#define RF_BDF_PACKET (RF_BDF_CHUNK + 64u)
+#define RF_BDF_SEGMENTS ((RF_BDF_BYTES + RF_BDF_CHUNK - 1u) / RF_BDF_CHUNK)
+#define RF_BDF_NAME "image/bdwlan-u-redfin.bin"
+enum { RF_BDF_IDLE, RF_BDF_REGISTER, RF_BDF_WAIT_MSA, RF_BDF_CAP,
+       RF_BDF_DOWNLOAD, RF_BDF_CAL_REPORT, RF_BDF_COMPLETE, RF_BDF_FAILED };
+struct rf_bdf_ops {
+    void *context;
+    int (*check)(void *);
+    int (*send)(void *, const uint8_t *, uint32_t);
+};
+struct rf_bdf_session {
+    const uint8_t *data;
+    uint32_t bytes, stage, attempted, poisoned, registered, msa_ready, fw_ready, skipped_ready;
+    uint32_t offset, segment, chunk, requests, responses, bdf_acks, cal_reported, ignored, indications;
+    uint16_t transaction, waiting, result, error, last_indication;
+    uint64_t fw_status;
+    struct rf_wlfw_cap expected, cap;
+    uint8_t packet[RF_BDF_PACKET];
+};
+static inline int rf_bdf_gate(struct rf_bdf_session *s, const struct rf_bdf_ops *o)
+{
+    if (!s || !o || !o->check || !o->send || s->poisoned) return -1;
+    if (o->check(o->context)) { s->poisoned = 1; s->stage = RF_BDF_FAILED; return -1; }
+    return 0;
+}
+static inline int rf_bdf_identity(const struct rf_wlfw_cap *cap)
+{
+    return cap && !cap->result && !cap->error && (cap->valid & 13u) == 13u &&
+        cap->chip == 0x4320 && cap->family == 0x4001 && cap->soc == 0x400b0000 &&
+        cap->firmware == 0x33197fff && (!(cap->valid & 2u) || cap->board == 0xff);
+}
+static inline void rf_bdf_number(struct rf_bdf_session *s, uint32_t *used, unsigned kind, uint64_t value, unsigned bytes)
+{
+    s->packet[(*used)++] = (uint8_t)kind;
+    rf_wlfw_put(s->packet + *used, bytes, 2); *used += 2;
+    rf_wlfw_put(s->packet + *used, value, bytes); *used += bytes;
+}
+static inline int rf_bdf_send(struct rf_bdf_session *s, const struct rf_bdf_ops *o, unsigned stage)
+{
+    if (rf_bdf_gate(s, o) || !s->attempted || !s->data || s->bytes != RF_BDF_BYTES || s->waiting ||
+        s->transaction >= RF_BDF_SEGMENTS + 3u) return -1;
+    uint16_t message = stage == RF_BDF_REGISTER ? 0x20 : stage == RF_BDF_CAP ? 0x24 :
+        stage == RF_BDF_DOWNLOAD ? 0x25 : stage == RF_BDF_CAL_REPORT ? 0x26 : 0;
+    if (!message ||
+        (stage == RF_BDF_REGISTER && (s->stage != RF_BDF_IDLE || s->transaction)) ||
+        (stage == RF_BDF_CAP && (s->stage != RF_BDF_WAIT_MSA || !s->registered || !s->msa_ready || s->transaction != 1)) ||
+        (stage == RF_BDF_DOWNLOAD && (!rf_bdf_identity(&s->cap) || s->chunk || s->segment >= RF_BDF_SEGMENTS ||
+            s->offset != s->segment * RF_BDF_CHUNK || s->offset >= s->bytes ||
+            !((s->stage == RF_BDF_CAP && s->transaction == 2 && !s->offset) ||
+              (s->stage == RF_BDF_DOWNLOAD && s->transaction == 2u + s->segment)))) ||
+        (stage == RF_BDF_CAL_REPORT && (s->stage != RF_BDF_DOWNLOAD || s->chunk || s->offset != s->bytes ||
+            s->segment != RF_BDF_SEGMENTS || s->transaction != 2u + RF_BDF_SEGMENTS))) return -1;
+    uint32_t used = 7;
+    memset(s->packet, 0, sizeof(s->packet));
+    rf_wlfw_put(s->packet + 1, ++s->transaction, 2); rf_wlfw_put(s->packet + 3, message, 2);
+    if (stage == RF_BDF_REGISTER) {
+        rf_bdf_number(s, &used, 0x10, 1, 1); /* FW_READY. */
+        rf_bdf_number(s, &used, 0x13, 1, 1); /* MSA_READY, no permission change. */
+        rf_bdf_number(s, &used, 0x15, RF_BDF_CLIENT, 4);
+    } else if (stage == RF_BDF_DOWNLOAD) {
+        s->chunk = s->bytes - s->offset < RF_BDF_CHUNK ? s->bytes - s->offset : RF_BDF_CHUNK;
+        rf_bdf_number(s, &used, 1, 1, 1);
+        rf_bdf_number(s, &used, 0x10, 0, 4); /* Native BIN file_id0. */
+        rf_bdf_number(s, &used, 0x11, s->bytes, 4); /* Full total, not remaining. */
+        rf_bdf_number(s, &used, 0x12, s->segment, 4);
+        s->packet[used++] = 0x13; rf_wlfw_put(s->packet + used, s->chunk + 2u, 2); used += 2;
+        rf_wlfw_put(s->packet + used, s->chunk, 2); used += 2;
+        memcpy(s->packet + used, s->data + s->offset, s->chunk); used += s->chunk;
+        rf_bdf_number(s, &used, 0x14, s->offset + s->chunk == s->bytes, 1);
+        rf_bdf_number(s, &used, 0x15, 0, 1); /* Native BIN type0. */
+    } else if (stage == RF_BDF_CAL_REPORT) {
+        rf_bdf_number(s, &used, 1, 0, 1); /* No cached calibration IDs. */
+        rf_bdf_number(s, &used, 0x11, 0, 1); /* Native cal_remove_supported0. */
+    }
+    if (used > sizeof(s->packet)) return -1;
+    rf_wlfw_put(s->packet + 5, used - 7u, 2);
+    s->stage = stage; s->waiting = message; ++s->requests;
+    if (o->send(o->context, s->packet, used) || rf_bdf_gate(s, o)) {
+        s->poisoned = 1; s->stage = RF_BDF_FAILED; return -1;
+    }
+    return 0;
+}
+static inline int rf_bdf_begin(struct rf_bdf_session *s, const struct rf_bdf_ops *o,
+    const uint8_t *data, uint32_t bytes, const struct rf_wlfw_cap *cap)
+{
+    if (rf_bdf_gate(s, o) || s->attempted || s->stage != RF_BDF_IDLE || !data ||
+        bytes != RF_BDF_BYTES || !rf_bdf_identity(cap)) return -1;
+    s->attempted = 1; s->data = data; s->bytes = bytes; s->expected = *cap;
+    return rf_bdf_send(s, o, RF_BDF_REGISTER);
+}
+/* Every accepted reply advances at most one pending request. Nonzero QMI
+ * results, including a final BDF CRC rejection, remain failures; no retry or
+ * upstream CRC-error exception is adopted. FW_READY is an independent fact. */
+static inline int rf_bdf_receive(struct rf_bdf_session *s, const struct rf_bdf_ops *o,
+    const uint8_t *data, uint32_t bytes)
+{
+    if (rf_bdf_gate(s, o) || !s->attempted || !data || bytes < 7 || bytes > 4096 ||
+        rf_qmi_u16(data + 5) != bytes - 7u || (data[0] != 2 && data[0] != 4)) return -1;
+    uint16_t transaction = rf_qmi_u16(data + 1), message = rf_qmi_u16(data + 3);
+    if (data[0] == 4 && message == 0x39) {
+        s->poisoned = 1; s->stage = RF_BDF_FAILED; return -1;
+    }
+    if (s->stage == RF_BDF_FAILED) { ++s->ignored; return 1; }
+    if (data[0] == 2 && (!s->waiting || s->stage == RF_BDF_COMPLETE ||
+        transaction != s->transaction || message != s->waiting)) { ++s->ignored; return 1; }
+    uint32_t seen = 0; uint16_t result = 0, error = 0; uint64_t status = 0;
+    if (data[0] == 4 && message == 0x21) {
+        if (bytes != 7) return -1;
+        s->fw_ready = 1; ++s->indications; s->last_indication = message; return 0;
+    }
+    for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        uint32_t length = rf_qmi_u16(data + at + 1), kind = data[at], bit = 0;
+        const uint8_t *value = data + at + 3u;
+        if (length > bytes - at - 3u) return -1;
+        if (data[0] == 2 && kind == 2) {
+            bit = 1; if (length != 4) return -1;
+            result = rf_qmi_u16(value); error = rf_qmi_u16(value + 2);
+            if (result > 1 || (!result && error)) return -1;
+        } else if (data[0] == 2 && kind == 0x10 && message != 0x24) {
+            bit = 2; if (length != 8) return -1; status = rf_wlfw_u64(value);
+        } else if (data[0] == 2 && kind < 16) return -1;
+        else if (data[0] == 4 && message == 0x2b && (kind == 0x10 || kind == 0x11)) {
+            bit = kind == 0x10 ? 1u : 2u;
+            if (length != (kind == 0x10 ? 4u : 2u)) return -1;
+        }
+        if (bit && (seen & bit)) return -1;
+        seen |= bit; at += 3u + length;
+    }
+    if (data[0] == 4) {
+        ++s->indications; s->last_indication = message;
+        if (message != 0x2b) { ++s->ignored; return 1; }
+        s->msa_ready = 1;
+        return s->stage == RF_BDF_WAIT_MSA ? rf_bdf_send(s, o, RF_BDF_CAP) : 0;
+    }
+    if (!(seen & 1u)) return -1;
+    s->result = result; s->error = error; s->waiting = 0; ++s->responses;
+    if (result) { s->stage = RF_BDF_FAILED; return 0; }
+    if (s->stage == RF_BDF_REGISTER) {
+        s->registered = 1; s->fw_status = status;
+        s->fw_ready |= (status & 2u) != 0; s->msa_ready |= (status & 4u) != 0;
+        if (s->fw_ready) { s->skipped_ready = 1; s->stage = RF_BDF_COMPLETE; return 0; }
+        if (status & 1u) { s->stage = RF_BDF_FAILED; return 0; }
+        s->stage = RF_BDF_WAIT_MSA;
+        return s->msa_ready ? rf_bdf_send(s, o, RF_BDF_CAP) : 0;
+    }
+    if (s->stage == RF_BDF_CAP) {
+        if (rf_wlfw_cap_parse(&s->cap, data, bytes, s->transaction) || !rf_bdf_identity(&s->cap) ||
+            s->cap.chip != s->expected.chip || s->cap.family != s->expected.family ||
+            s->cap.soc != s->expected.soc || s->cap.firmware != s->expected.firmware) return -1;
+        return rf_bdf_send(s, o, RF_BDF_DOWNLOAD);
+    }
+    if (s->stage == RF_BDF_DOWNLOAD) {
+        if (!s->chunk || s->offset > s->bytes || s->chunk > s->bytes - s->offset) return -1;
+        s->offset += s->chunk; s->chunk = 0; ++s->segment; ++s->bdf_acks;
+        return rf_bdf_send(s, o, s->offset == s->bytes ? RF_BDF_CAL_REPORT : RF_BDF_DOWNLOAD);
+    }
+    if (s->stage == RF_BDF_CAL_REPORT) { s->cal_reported = 1; s->stage = RF_BDF_COMPLETE; return 0; }
+    return -1;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_snoc.h b/iokit/Kernel/arm/redfin_wifi_snoc.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_snoc.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: MIT
+ * Redfin APPS SMMU evidence for the WCN3990-class SNOC transport.
+ * Native msm 500b3a2059c1eec0fec08ec56add06320ea901a8 arm-smmu{,-regs.h}.
+ * Read-only, fixed-layout snapshots. Neither an invalid SMR nor a blank CB
+ * grants ownership; no route, context, TLB, fault or CE write API exists here.
+ */
+#ifndef REDFIN_WIFI_SNOC_H
+#define REDFIN_WIFI_SNOC_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/errno.h>
+
+#define RF_SNOC_SMMU_BASE UINT64_C(0x15000000)
+#define RF_SNOC_SMMU_BYTES 0x100000u
+#define RF_SNOC_GLOBAL_BYTES 0x4000u
+#define RF_SNOC_CONTEXT_OFFSET 0x80000u
+#define RF_SNOC_CONTEXT_BYTES 0x40000u
+#define RF_SNOC_STREAMS 81u
+#define RF_SNOC_CONTEXTS 62u
+#define RF_SNOC_WLAN_SID 0xc0u
+
+struct rf_snoc_ops {
+    void *context;
+    int (*check)(void *);
+    /* block0 = GR0/GR1, block1 = CB pages; offsets are block relative. */
+    int (*read)(void *, unsigned, uint32_t, uint32_t *);
+};
+struct rf_snoc_bank { uint32_t sctlr, cbar, cba2r, fault; };
+struct rf_snoc_snapshot {
+    uint32_t stage, error, reads, changed_block, changed_offset;
+    uint32_t id[3], control, fault, syndrome[3];
+    uint32_t smr[RF_SNOC_STREAMS], s2cr[RF_SNOC_STREAMS];
+    struct rf_snoc_bank bank[RF_SNOC_CONTEXTS];
+    uint32_t references[RF_SNOC_CONTEXTS], active_references[RF_SNOC_CONTEXTS];
+    uint32_t wlan_matches[2], wlan_slot[2], ipa_matches, malformed_routes;
+    uint32_t blank_unreferenced;
+    bool stable;
+};
+
+static inline bool rf_snoc_read_allowed(unsigned block, uint32_t at)
+{
+    if (at & 3u) return false;
+    if (block == 1) return at < RF_SNOC_CONTEXTS * 0x1000u &&
+        ((at & 0xfffu) == 0 || (at & 0xfffu) == 0x58u);
+    if (block) return false;
+    if (at == 0 || at == 0x20 || at == 0x24 || at == 0x28 || at == 0x48 ||
+        at == 0x50 || at == 0x54 || at == 0x58) return true;
+    return (at >= 0x800 && at - 0x800 < RF_SNOC_STREAMS * 4u) ||
+        (at >= 0xc00 && at - 0xc00 < RF_SNOC_STREAMS * 4u) ||
+        (at >= 0x1000 && at - 0x1000 < RF_SNOC_CONTEXTS * 4u) ||
+        (at >= 0x1800 && at - 0x1800 < RF_SNOC_CONTEXTS * 4u);
+}
+static inline bool rf_snoc_stream_matches(uint32_t smr, uint32_t sid)
+{
+    return (smr & 0x80000000u) && !((sid ^ smr) & ~((smr >> 16) & 0x7fffu) & 0x7fffu);
+}
+static inline int rf_snoc_sample(const struct rf_snoc_ops *ops, struct rf_snoc_snapshot *s,
+    unsigned block, uint32_t at, uint32_t *saved, bool compare)
+{
+    uint32_t value = 0;
+    if (!saved || !rf_snoc_read_allowed(block, at)) return EINVAL;
+    int error = ops->check(ops->context);
+    if (error) return error;
+    ++s->reads;
+    error = ops->read(ops->context, block, at, &value);
+    if (error) return error;
+    if (value == UINT32_MAX) return EIO;
+    if (compare && *saved != value) {
+        s->changed_block = block; s->changed_offset = at;
+        return EAGAIN;
+    }
+    *saved = value;
+    return 0;
+}
+
+static inline int rf_snoc_observe(const struct rf_snoc_ops *ops, struct rf_snoc_snapshot *s)
+{
+    int error = EINVAL;
+    if (!s) return EINVAL;
+#ifdef __cplusplus
+    *s = rf_snoc_snapshot{};
+#else
+    *s = (struct rf_snoc_snapshot){0};
+#endif
+    s->wlan_slot[0] = s->wlan_slot[1] = UINT32_MAX;
+    if (!ops || !ops->check || !ops->read) goto done;
+#define RF_SNOC_SAMPLE(block, at, field, compare) do { \
+    error = rf_snoc_sample(ops, s, block, at, &(field), compare); if (error) goto done; \
+} while (0)
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        bool compare = pass != 0;
+        s->stage = pass ? 3 : 1;
+        for (unsigned i = 0; i < 3; ++i) RF_SNOC_SAMPLE(0, 0x20 + 4u*i, s->id[i], compare);
+        /* Exact IDs were observed by the isolated native USB context probe.
+         * Refuse different layouts before ever reaching context pages. */
+        if (s->id[0] != 0x4c017e51u || s->id[1] != 0x6000003eu || s->id[2] != 0x5111u)
+        { error = ENOTSUP; goto done; }
+        RF_SNOC_SAMPLE(0, 0, s->control, compare);
+        if ((s->control & 9u) || !(s->control & 0x400u)) { error = ENOTSUP; goto done; }
+        RF_SNOC_SAMPLE(0, 0x48, s->fault, compare);
+        for (unsigned i = 0; i < 3; ++i) RF_SNOC_SAMPLE(0, 0x50 + 4u*i, s->syndrome[i], compare);
+        if (!pass) s->stage = 2;
+        for (unsigned i = 0; i < RF_SNOC_STREAMS; ++i) {
+            RF_SNOC_SAMPLE(0, 0x800 + 4u*i, s->smr[i], compare);
+            RF_SNOC_SAMPLE(0, 0xc00 + 4u*i, s->s2cr[i], compare);
+        }
+        for (unsigned i = 0; i < RF_SNOC_CONTEXTS; ++i) {
+            RF_SNOC_SAMPLE(0, 0x1000 + 4u*i, s->bank[i].cbar, compare);
+            RF_SNOC_SAMPLE(0, 0x1800 + 4u*i, s->bank[i].cba2r, compare);
+            RF_SNOC_SAMPLE(1, 0x1000u*i, s->bank[i].sctlr, compare);
+            RF_SNOC_SAMPLE(1, 0x1000u*i + 0x58, s->bank[i].fault, compare);
+        }
+    }
+    for (unsigned i = 0; i < RF_SNOC_STREAMS; ++i) {
+        uint32_t type = (s->s2cr[i] >> 16) & 3u, bank = s->s2cr[i] & 255u;
+        if (type == 3 || (s->smr[i] & 0x8000u) || (!type && bank >= RF_SNOC_CONTEXTS))
+            ++s->malformed_routes;
+        /* Retain references even from invalid SMRs: never call a latent CB free. */
+        if (!type && bank < RF_SNOC_CONTEXTS) {
+            ++s->references[bank];
+            if (s->smr[i] & 0x80000000u) ++s->active_references[bank];
+        }
+        for (unsigned which = 0; which < 2; ++which) if (rf_snoc_stream_matches(s->smr[i], RF_SNOC_WLAN_SID + which)) {
+            ++s->wlan_matches[which]; s->wlan_slot[which] = i;
+        }
+        if (rf_snoc_stream_matches(s->smr[i], 0x521)) ++s->ipa_matches;
+    }
+    for (unsigned which = 0; which < 2; ++which)
+        if (s->wlan_matches[which] != 1) s->wlan_slot[which] = UINT32_MAX;
+    for (unsigned i = 0; i < RF_SNOC_CONTEXTS; ++i) {
+        const struct rf_snoc_bank *b = &s->bank[i];
+        if (!s->malformed_routes && !s->references[i] && !b->sctlr && !b->cbar && !b->cba2r && !b->fault)
+            ++s->blank_unreferenced;
+    }
+    error = ops->check(ops->context);
+    if (error) goto done;
+    s->stage = 4; s->stable = true;
+done:
+#undef RF_SNOC_SAMPLE
+    s->error = (uint32_t)error;
+    return error;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_snoc.inc b/iokit/Kernel/arm/redfin_wifi_snoc.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_snoc.inc
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: MIT
+ * Sole native WLAN worker, after real readiness. APPS SMMU is independently
+ * observable in the bounded USB profile; no WLAN/CE/TCU/TBU register is read.
+ * This adapter retains read-only local mappings until the platform reset.
+ */
+static int fw_start_snoc_check(void *opaque)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (context != &fw_start || fw_start_check(context) || !context->snoc_mode ||
+        !context->authenticated || context->reset || context->locked ||
+        !context->wlan_observed || !context->dynamic_received ||
+        context->wlfw_setup.stage != RF_WLFW_COMPLETE ||
+        !(context->wlfw_setup.fw_ready || context->bdf.fw_ready) ||
+        (context->bdf.attempted && (context->bdf.stage != RF_BDF_COMPLETE || !context->bdf.cal_reported)))
+        return EPERM;
+    for (unsigned i = 0; i < 2; ++i) {
+        const fw_start_map *entry = &context->snoc_maps[i];
+        if (!entry->memory && !entry->map && !entry->base) continue;
+        if (!entry->memory || !entry->map || !entry->base ||
+            entry->map->getVirtualAddress() != entry->base ||
+            entry->map->getLength() != (i ? RF_SNOC_CONTEXT_BYTES : RF_SNOC_GLOBAL_BYTES)) return EPERM;
+    }
+    return 0;
+}
+static int fw_start_snoc_read(void *opaque, unsigned block, uint32_t at, uint32_t *out)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (!out || !rf_snoc_read_allowed(block, at) || fw_start_snoc_check(context) ||
+        !context->snoc_maps[block].base) return EPERM;
+    uintptr_t address = context->snoc_maps[block].base + at;
+    uint32_t value;
+    __asm__ volatile("ldr %w0, [%1]\n\tdmb oshld" : "=r"(value) : "r"(address) : "memory");
+    *out = value;
+    return 0;
+}
+static int fw_start_snoc_observe(fw_start_context *context)
+{
+    if (fw_start_snoc_check(context) || context->snoc_attempted || redfin_wifi_power_audit()) return EPERM;
+    context->snoc_attempted = true;
+    for (unsigned i = 0; i < 2; ++i) {
+        if (fw_start_snoc_check(context)) return EPERM;
+        fw_start_map *entry = &context->snoc_maps[i];
+        uint64_t physical = RF_SNOC_SMMU_BASE + (i ? RF_SNOC_CONTEXT_OFFSET : 0);
+        uint64_t bytes = i ? RF_SNOC_CONTEXT_BYTES : RF_SNOC_GLOBAL_BYTES;
+        entry->memory = IOMemoryDescriptor::withPhysicalAddress(physical, bytes, kIODirectionIn);
+        entry->map = entry->memory ? entry->memory->map(kIOMapReadOnly | kIOMapInhibitCache) : NULL;
+        if (!entry->map || !entry->map->getVirtualAddress() || entry->map->getLength() != bytes) return ENOMEM;
+        entry->base = (uintptr_t)entry->map->getVirtualAddress();
+    }
+    const rf_snoc_ops ops = {context, fw_start_snoc_check, fw_start_snoc_read};
+    int error = rf_snoc_observe(&ops, &context->snoc);
+    const rf_snoc_snapshot *s = &context->snoc;
+    IOLog("REDFIN WIFI SNOC: observer=%d stage=%u reads=%u changed=%u/%#x stable=%u; no CE access or ownership grant\n",
+        error, s->stage, s->reads, s->changed_block, s->changed_offset, s->stable);
+    if (error) return error;
+    if (fw_start_snoc_check(context) || redfin_wifi_power_audit()) return EPERM;
+    IOLog("REDFIN WIFI SNOC: SMMU ID=%#x/%#x/%#x CR0=%#x GFSR=%#x syndrome=%#x/%#x/%#x WLAN=%u/%u slots=%u/%u IPA521=%u malformed=%u blank-unreferenced=%u ownership=0\n",
+        s->id[0], s->id[1], s->id[2], s->control, s->fault, s->syndrome[0], s->syndrome[1], s->syndrome[2],
+        s->wlan_matches[0], s->wlan_matches[1], s->wlan_slot[0], s->wlan_slot[1], s->ipa_matches,
+        s->malformed_routes, s->blank_unreferenced);
+    for (unsigned i = 0; i < RF_SNOC_STREAMS; ++i) {
+        if (!(s->smr[i] & 0x80000000u)) continue;
+        IOLog("REDFIN WIFI SNOC: slot=%u SMR=%#x S2CR=%#x type=%u bank=%u wlan=%u/%u\n", i,
+            s->smr[i], s->s2cr[i], (s->s2cr[i] >> 16) & 3u, s->s2cr[i] & 255u,
+            rf_snoc_stream_matches(s->smr[i], 0xc0), rf_snoc_stream_matches(s->smr[i], 0xc1));
+    }
+    for (unsigned i = 0; i < RF_SNOC_CONTEXTS; ++i) {
+        const rf_snoc_bank *b = &s->bank[i];
+        IOLog("REDFIN WIFI SNOC: bank=%u refs=%u/%u SCTLR=%#x CBAR=%#x CBA2R=%#x FSR=%#x ownership=0\n",
+            i, s->references[i], s->active_references[i], b->sctlr, b->cbar, b->cba2r, b->fault);
+    }
+    return 0;
+}
diff --git a/iokit/Kernel/arm/redfin_wifi_mission.h b/iokit/Kernel/arm/redfin_wifi_mission.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_mission.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: MIT
+ * WCN3990-class WLAN_CFG -> acknowledged mission mode, no CE/DMA operations.
+ * Wire: native Google msm500b3a2 wlan_firmware_service_v01.{c,h}; layout:
+ * Linux v6.12 adc21867 ath10k/snoc.c, also used by inherited TopazModem.cpp.
+ * Include after wifi_bdf.h and wifi_snoc.h.
+ */
+#ifndef REDFIN_WIFI_MISSION_H
+#define REDFIN_WIFI_MISSION_H
+#define RF_MISSION_CFG_BYTES 559u
+#define RF_MISSION_FIRST_TRANSACTION 6u
+enum { RF_MISSION_IDLE, RF_MISSION_CONFIG, RF_MISSION_MODE, RF_MISSION_COMPLETE, RF_MISSION_FAILED };
+static const uint32_t rf_mission_target[12][5] = {
+    {0, 2, 32, 2048, 0}, {1, 1, 32, 2048, 0}, {2, 1, 64, 2048, 0}, {3, 2, 32, 2048, 0},
+    {4, 2, 256, 256, 8}, {5, 2, 1024, 64, 8}, {6, 3, 32, 16384, 0}, {7, 4, 0, 0, 8},
+    {8, 1, 32, 2048, 0}, {9, 1, 32, 2048, 0}, {10, 1, 32, 2048, 0}, {11, 1, 32, 2048, 0}};
+static const uint32_t rf_mission_service[21][3] = {
+    {0x104, 2, 3}, {0x104, 1, 2}, {0x102, 2, 3}, {0x102, 1, 2}, {0x101, 2, 3}, {0x101, 1, 2},
+    {0x103, 2, 3}, {0x103, 1, 2}, {0x100, 2, 3}, {0x100, 1, 2}, {1, 2, 0}, {1, 1, 2},
+    {0xfe00, 2, 0}, {0xfe00, 1, 2}, {0x300, 2, 4}, {0x300, 1, 1}, {0xfe00, 2, 5},
+    {0x301, 1, 9}, {0x302, 1, 10}, {0x600, 1, 11}, {0, 0, 0}};
+static const uint16_t rf_mission_shadow[12][2] = {
+    {0, 0x3c}, {3, 0x3c}, {4, 0x3c}, {5, 0x3c}, {7, 0x3c}, {1, 0x40},
+    {2, 0x40}, {7, 0x40}, {8, 0x40}, {9, 0x40}, {10, 0x40}, {11, 0x40}};
+struct rf_mission_ops {
+    void *context;
+    int (*check)(void *);
+    int (*send)(void *, const uint8_t *, uint32_t);
+};
+struct rf_mission {
+    uint32_t attempted, stage, poisoned, requests, responses, ignored;
+    uint16_t transaction, waiting, result, error;
+    uint8_t packet[RF_MISSION_CFG_BYTES];
+};
+static inline int rf_mission_gate(struct rf_mission *s, const struct rf_mission_ops *o)
+{
+    if (!s || !o || !o->check || !o->send || s->poisoned) return -1;
+    if (o->check(o->context)) { s->poisoned = 1; s->stage = RF_MISSION_FAILED; return -1; }
+    return 0;
+}
+static inline int rf_mission_send(struct rf_mission *s, const struct rf_mission_ops *o, unsigned stage)
+{
+    if (rf_mission_gate(s, o) || !s->attempted || s->waiting ||
+        !((stage == RF_MISSION_CONFIG && s->stage == RF_MISSION_IDLE && !s->transaction) ||
+          (stage == RF_MISSION_MODE && s->stage == RF_MISSION_CONFIG && s->transaction == RF_MISSION_FIRST_TRANSACTION))) return -1;
+    memset(s->packet, 0, sizeof(s->packet));
+    uint32_t used = 7;
+    s->transaction = (uint16_t)(stage == RF_MISSION_CONFIG ? RF_MISSION_FIRST_TRANSACTION : RF_MISSION_FIRST_TRANSACTION + 1u);
+    s->waiting = (uint16_t)(stage == RF_MISSION_CONFIG ? 0x23 : 0x22);
+    rf_wlfw_put(s->packet + 1, s->transaction, 2); rf_wlfw_put(s->packet + 3, s->waiting, 2);
+    if (stage == RF_MISSION_CONFIG) {
+        /* Native arrays have a single-byte count; reserved host struct fields
+         * are not on the wire. host_version and v2 shadow/MSI stay absent. */
+        for (unsigned which = 0; which < 3; ++which) {
+            unsigned count = which == 1 ? 21u : 12u, columns = which == 0 ? 5u : which == 1 ? 3u : 2u;
+            unsigned width = which == 2 ? 2u : 4u;
+            s->packet[used++] = (uint8_t)(0x11u + which);
+            rf_wlfw_put(s->packet + used, 1u + count * columns * width, 2); used += 2;
+            s->packet[used++] = (uint8_t)count;
+            for (unsigned i = 0; i < count; ++i) for (unsigned j = 0; j < columns; ++j) {
+                uint32_t value = which == 0 ? rf_mission_target[i][j] : which == 1 ?
+                    rf_mission_service[i][j] : rf_mission_shadow[i][j];
+                rf_wlfw_put(s->packet + used, value, width); used += width;
+            }
+        }
+        if (used != RF_MISSION_CFG_BYTES) return -1;
+    } else {
+        /* Mission0, hw_debug_valid1/hw_debug0, exactly as native ICNSS. */
+        s->packet[used++] = 1; rf_wlfw_put(s->packet + used, 4, 2); used += 6;
+        s->packet[used++] = 0x10; rf_wlfw_put(s->packet + used, 1, 2); used += 3;
+    }
+    rf_wlfw_put(s->packet + 5, used - 7u, 2); s->stage = stage; ++s->requests;
+    if (o->send(o->context, s->packet, used) || rf_mission_gate(s, o)) {
+        s->poisoned = 1; s->stage = RF_MISSION_FAILED; return -1;
+    }
+    return 0;
+}
+static inline int rf_mission_begin(struct rf_mission *s, const struct rf_mission_ops *o,
+    const struct rf_wlfw_cap *cap, const struct rf_snoc_snapshot *snapshot)
+{
+    if (rf_mission_gate(s, o) || s->attempted || s->stage != RF_MISSION_IDLE || !rf_bdf_identity(cap) ||
+        !snapshot || !snapshot->stable || snapshot->stage != 4 || snapshot->error ||
+        snapshot->fault || snapshot->malformed_routes || snapshot->wlan_matches[0] || snapshot->wlan_matches[1]) return -1;
+    /* This entry deliberately leaves WLAN unmatched in a faulting SMMU:
+     * firmware can enter mission, but no inherited host route is granted. */
+    if ((snapshot->control & 9u) || !(snapshot->control & 0x400u)) return -1;
+    s->attempted = 1;
+    return rf_mission_send(s, o, RF_MISSION_CONFIG);
+}
+static inline int rf_mission_receive(struct rf_mission *s, const struct rf_mission_ops *o,
+    const uint8_t *data, uint32_t bytes)
+{
+    if (rf_mission_gate(s, o) || !s->attempted || !data || bytes < 7 || bytes > 4096 ||
+        data[0] != 2 || rf_qmi_u16(data + 5) != bytes - 7u) return -1;
+    if (s->stage == RF_MISSION_FAILED || !s->waiting || rf_qmi_u16(data + 1) != s->transaction ||
+        rf_qmi_u16(data + 3) != s->waiting) { ++s->ignored; return 1; }
+    unsigned seen = 0; uint16_t result = 0, error = 0;
+    for (uint32_t at = 7; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        unsigned kind = data[at], length = rf_qmi_u16(data + at + 1);
+        if (length > bytes - at - 3u) return -1;
+        if (kind == 2) {
+            if (seen || length != 4) return -1;
+            seen = 1; result = rf_qmi_u16(data + at + 3); error = rf_qmi_u16(data + at + 5);
+            if (result > 1 || (!result && error)) return -1;
+        } else if (kind < 16) return -1;
+        at += 3u + length;
+    }
+    if (!seen) return -1;
+    s->result = result; s->error = error; s->waiting = 0; ++s->responses;
+    if (result) { s->stage = RF_MISSION_FAILED; return 0; }
+    if (s->stage == RF_MISSION_CONFIG) return rf_mission_send(s, o, RF_MISSION_MODE);
+    if (s->stage == RF_MISSION_MODE) { s->stage = RF_MISSION_COMPLETE; return 0; }
+    return -1;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_mission.inc b/iokit/Kernel/arm/redfin_wifi_mission.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_mission.inc
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: MIT
+ * Native worker's acknowledged mission entry and bounded CE register reads.
+ * No SMMU/CE writes, interrupt registration, ring memory or RX posting.
+ */
+static int fw_start_mission_check(void *opaque)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (context != &fw_start || !context->mission_mode || fw_start_glink_check(context) ||
+        fw_start_snoc_check(context) || !context->snoc.stable) return EPERM;
+    if (context->packets_mode && context->packet_lease.leased)
+        return rf_snoc_lease_verify(&context->packet_lease, &context->packet_lease_ops);
+    const rf_snoc_ops ops = {context, fw_start_snoc_check, fw_start_snoc_read};
+    int error = rf_snoc_observe(&ops, &context->snoc_fresh);
+    if (error) return error;
+    const rf_snoc_snapshot *before = &context->snoc, *now = &context->snoc_fresh;
+    if (before->control != now->control || before->fault != now->fault ||
+        memcmp(before->id, now->id, sizeof(now->id)) ||
+        memcmp(before->syndrome, now->syndrome, sizeof(now->syndrome)) ||
+        memcmp(before->smr, now->smr, sizeof(now->smr)) ||
+        memcmp(before->s2cr, now->s2cr, sizeof(now->s2cr)) ||
+        memcmp(before->bank, now->bank, sizeof(now->bank))) return EAGAIN;
+    return !now->fault && !now->malformed_routes && !now->wlan_matches[0] && !now->wlan_matches[1] ? 0 : EPERM;
+}
+static int fw_start_mission_send(void *opaque, const uint8_t *data, uint32_t bytes)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (!data || bytes < 7 || bytes > RF_MISSION_CFG_BYTES || fw_start_mission_check(context)) return EPERM;
+    return fw_start_qrtr_queue(context, 1, 0x4004, context->wlfw_node, context->wlfw_port, data, bytes);
+}
+static int fw_start_ce_check(void *opaque)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (context != &fw_start || fw_start_glink_check(context) || fw_start_snoc_check(context) ||
+        !context->mission_mode || context->mission.poisoned || context->mission.stage != RF_MISSION_COMPLETE ||
+        context->mission.waiting || context->mission.responses != 2 || !context->mission_settle_ns ||
+        fw_start_ns(context) < context->mission_settle_ns) return EPERM;
+    const fw_start_map *entry = &context->ce_map;
+    if (!entry->memory && !entry->map && !entry->base) return 0;
+    return entry->memory && entry->map && entry->base && entry->map->getVirtualAddress() == entry->base &&
+        entry->map->getLength() == RF_CE_MAP_BYTES ? 0 : EPERM;
+}
+static int fw_start_ce_read(void *opaque, uint32_t at, uint32_t *out)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (!out || !rf_ce_read_allowed(at) || fw_start_ce_check(context) || !context->ce_map.base) return EPERM;
+    uintptr_t address = context->ce_map.base + at;
+    uint32_t value;
+    __asm__ volatile("ldr %w0, [%1]\n\tdmb oshld" : "=r"(value) : "r"(address) : "memory");
+    *out = value; return 0;
+}
+static int fw_start_ce_observe(fw_start_context *context)
+{
+    if (fw_start_ce_check(context) || context->ce_map.memory || context->ce_map.map || context->ce_map.base ||
+        fw_start_mission_check(context) || redfin_wifi_power_audit()) return EPERM;
+    fw_start_map *entry = &context->ce_map;
+    entry->memory = IOMemoryDescriptor::withPhysicalAddress(RF_CE_BASE, RF_CE_MAP_BYTES, kIODirectionIn);
+    entry->map = entry->memory ? entry->memory->map(kIOMapReadOnly | kIOMapInhibitCache) : NULL;
+    if (!entry->map || !entry->map->getVirtualAddress() || entry->map->getLength() != RF_CE_MAP_BYTES) return ENOMEM;
+    entry->base = (uintptr_t)entry->map->getVirtualAddress();
+    const rf_ce_ops ops = {context, fw_start_ce_check, fw_start_ce_read};
+    int error = rf_ce_observe(&ops, &context->ce);
+    const rf_ce_snapshot *s = &context->ce;
+    IOLog("REDFIN WIFI CE: observer=%d stage=%u stable=%u reads=%u changed=%#x WRAP=%#x RRI=%#x/%#x; no CE writes or DMA\n",
+        error, s->stage, s->stable, s->reads, s->changed_offset, s->wrapper[0], s->wrapper[1], s->wrapper[2]);
+    if (error) return error;
+    for (unsigned i = 0; i < RF_CE_COUNT; ++i) {
+        const uint32_t *v = s->ce[i];
+        IOLog("REDFIN WIFI CE: engine=%u SRC=%#x/%#x/%u DST=%#x/%#x/%u CTRL=%#x IE=%#x IS=%#x misc=%#x/%#x index=%u/%u/%u/%u WM=%#x/%#x\n",
+            i, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10],
+            v[11], v[12], v[13], v[14], v[15], v[16]);
+    }
+    if (fw_start_mission_check(context) || redfin_wifi_power_audit()) return EPERM;
+    return 0;
+}
diff --git a/iokit/Kernel/arm/redfin_wifi_ce.h b/iokit/Kernel/arm/redfin_wifi_ce.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_ce.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: MIT
+ * Read-only WCN3990-class CE state. Linux v6.12 adc21867 ath10k/hw.c.
+ * Offsets are relative to WLAN+240000. Include after wifi_snoc.h.
+ */
+#ifndef REDFIN_WIFI_CE_H
+#define REDFIN_WIFI_CE_H
+#define RF_CE_BASE UINT64_C(0x18a40000)
+#define RF_CE_MAP_BYTES 0x10000u
+#define RF_CE_COUNT 12u
+#define RF_CE_OBSERVED_REGS 17u
+static const uint32_t rf_ce_observed_offsets[RF_CE_OBSERVED_REGS] = {
+    0, 4, 8, 0x0c, 0x10, 0x14, 0x18, 0x2c, 0x30, 0x34, 0x38,
+    0x3c, 0x40, 0x44, 0x48, 0x4c, 0x50};
+struct rf_ce_snapshot {
+    uint32_t stage, reads, error, changed_offset;
+    uint32_t wrapper[3], ce[RF_CE_COUNT][RF_CE_OBSERVED_REGS];
+    bool stable;
+};
+struct rf_ce_ops {
+    void *context;
+    int (*check)(void *);
+    int (*read)(void *, uint32_t, uint32_t *);
+};
+static inline bool rf_ce_read_allowed(uint32_t at)
+{
+    if (at & 3u) return false;
+    if (at >= 0xc000) return at == 0xc000 || at == 0xc004 || at == 0xc008;
+    for (unsigned i = 0; i < RF_CE_OBSERVED_REGS; ++i)
+        if ((at & 0xfffu) == rf_ce_observed_offsets[i]) return true;
+    return false;
+}
+static inline int rf_ce_sample(const struct rf_ce_ops *o, struct rf_ce_snapshot *s,
+    uint32_t at, uint32_t *saved, bool compare)
+{
+    uint32_t value = 0;
+    if (!rf_ce_read_allowed(at)) return EINVAL;
+    int error = o->check(o->context);
+    if (error) return error;
+    ++s->reads; error = o->read(o->context, at, &value);
+    if (error) return error;
+    if (value == UINT32_MAX) return EIO;
+    if (compare && value != *saved) { s->changed_offset = at; return EAGAIN; }
+    *saved = value; return 0;
+}
+static inline int rf_ce_observe(const struct rf_ce_ops *o, struct rf_ce_snapshot *s)
+{
+    int error = EINVAL;
+    if (!s) return EINVAL;
+#ifdef __cplusplus
+    *s = rf_ce_snapshot{};
+#else
+    *s = (struct rf_ce_snapshot){0};
+#endif
+    if (!o || !o->check || !o->read) goto done;
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        s->stage = pass + 1u;
+        for (unsigned i = 0; i < 3; ++i) {
+            error = rf_ce_sample(o, s, 0xc000 + 4u*i, &s->wrapper[i], pass != 0);
+            if (error) goto done;
+        }
+        for (unsigned ce = 0; ce < RF_CE_COUNT; ++ce) for (unsigned r = 0; r < RF_CE_OBSERVED_REGS; ++r) {
+            error = rf_ce_sample(o, s, 0x1000u*ce + rf_ce_observed_offsets[r], &s->ce[ce][r], pass != 0);
+            if (error) goto done;
+        }
+    }
+    error = o->check(o->context);
+    if (!error) { s->stage = 3; s->stable = true; }
+done:
+    s->error = (uint32_t)error; return error;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_snoc_lease.h b/iokit/Kernel/arm/redfin_wifi_snoc_lease.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_snoc_lease.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: MIT
+ * Sole-worker APPS SMMU lease for WLANc0/mask1, adapted from the native
+ * non-static NS allocator and the proven Redfin USB AArch64 bypass context.
+ * Include after wifi_snoc.h. No memory allocator or CE/DMA authority here.
+ */
+#ifndef REDFIN_WIFI_SNOC_LEASE_H
+#define REDFIN_WIFI_SNOC_LEASE_H
+#include <string.h>
+#define RF_SNOC_CONTEXT_FAULT 0xc00001feu
+#define RF_SNOC_LEASE_STORES 5u
+struct rf_snoc_lease_ops {
+    void *context;
+    int (*check)(void *);
+    int (*sample)(void *, struct rf_snoc_snapshot *);
+    int (*read)(void *, unsigned, uint32_t, uint32_t *);
+    int (*write)(void *, unsigned, uint32_t, uint32_t);
+    int (*delay)(void *, unsigned);
+};
+struct rf_snoc_lease {
+    unsigned attempted, leased, active, poisoned, stores, bank, slot, polls;
+    struct rf_snoc_snapshot expected, fresh;
+};
+/* First difference in the already sampled hardware state, with no new MMIO.
+ * Keep owned and foreign changes equally visible; neither is auto-accepted. */
+static inline bool rf_snoc_lease_difference(const struct rf_snoc_lease *s,
+    unsigned *block, uint32_t *at, uint32_t *expected, uint32_t *observed)
+{
+    if (!s || !block || !at || !expected || !observed) return false;
+#define RF_SNOC_DIFF(b, offset, field) do { \
+    if (s->expected.field != s->fresh.field) { \
+        *block = b; *at = offset; *expected = s->expected.field; *observed = s->fresh.field; return true; \
+    } \
+} while (0)
+    RF_SNOC_DIFF(0, 0, control); RF_SNOC_DIFF(0, 0x48, fault);
+    for (unsigned i = 0; i < 3; ++i) {
+        RF_SNOC_DIFF(0, 0x20 + 4u*i, id[i]);
+        RF_SNOC_DIFF(0, 0x50 + 4u*i, syndrome[i]);
+    }
+    for (unsigned i = 0; i < RF_SNOC_STREAMS; ++i) {
+        RF_SNOC_DIFF(0, 0x800 + 4u*i, smr[i]); RF_SNOC_DIFF(0, 0xc00 + 4u*i, s2cr[i]);
+    }
+    for (unsigned i = 0; i < RF_SNOC_CONTEXTS; ++i) {
+        RF_SNOC_DIFF(0, 0x1000 + 4u*i, bank[i].cbar); RF_SNOC_DIFF(0, 0x1800 + 4u*i, bank[i].cba2r);
+        RF_SNOC_DIFF(1, 0x1000u*i, bank[i].sctlr); RF_SNOC_DIFF(1, 0x1000u*i + 0x58, bank[i].fault);
+    }
+#undef RF_SNOC_DIFF
+    return false;
+}
+static inline bool rf_snoc_raw_equal(const struct rf_snoc_snapshot *a, const struct rf_snoc_snapshot *b)
+{
+    return a && b && a->stable && b->stable && a->stage == 4 && b->stage == 4 && !a->error && !b->error &&
+        a->control == b->control && a->fault == b->fault &&
+        !memcmp(a->id, b->id, sizeof(a->id)) && !memcmp(a->syndrome, b->syndrome, sizeof(a->syndrome)) &&
+        !memcmp(a->smr, b->smr, sizeof(a->smr)) && !memcmp(a->s2cr, b->s2cr, sizeof(a->s2cr)) &&
+        !memcmp(a->bank, b->bank, sizeof(a->bank));
+}
+static inline int rf_snoc_lease_gate(struct rf_snoc_lease *s, const struct rf_snoc_lease_ops *o)
+{
+    if (!s) return EINVAL;
+    if (!o || !o->check || !o->sample || !o->read || !o->write || !o->delay || s->poisoned) {
+        s->poisoned = 1; s->active = 0; return EINVAL;
+    }
+    int error = o->check(o->context);
+    if (error) { s->poisoned = 1; s->active = 0; }
+    return error;
+}
+static inline int rf_snoc_lease_verify(struct rf_snoc_lease *s, const struct rf_snoc_lease_ops *o)
+{
+    int error = rf_snoc_lease_gate(s, o);
+    if (error) return error;
+    if (!s->attempted || !s->leased) return EPERM;
+    error = o->sample(o->context, &s->fresh);
+    if (!error && !rf_snoc_raw_equal(&s->expected, &s->fresh)) error = EAGAIN;
+    if (!error) error = rf_snoc_lease_gate(s, o);
+    if (error) { s->poisoned = 1; s->active = 0; }
+    return error;
+}
+/* A typed step is the only write address/value the adapter may accept. */
+static inline int rf_snoc_lease_step(const struct rf_snoc_lease *s, unsigned step,
+    unsigned *block, uint32_t *at, uint32_t *value)
+{
+    if (!s || !s->leased || !block || !at || !value || step >= RF_SNOC_LEASE_STORES ||
+        s->bank >= RF_SNOC_CONTEXTS || s->slot >= RF_SNOC_STREAMS) return EINVAL;
+    *block = 0;
+    switch (step) {
+    case 0: *block = 1; *at = 0x1000u*s->bank; *value = 0; break;
+    case 1: *at = 0x1800 + 4u*s->bank; *value = 1; break;
+    case 2: *at = 0x1000 + 4u*s->bank; *value = 0x10000; break;
+    case 3: *at = 0xc00 + 4u*s->slot; *value = 0x300u | s->bank; break;
+    default: *at = 0x800 + 4u*s->slot; *value = 0x800100c0; break;
+    }
+    return 0;
+}
+static inline int rf_snoc_lease_claim(struct rf_snoc_lease *s, const struct rf_snoc_lease_ops *o,
+    const struct rf_snoc_snapshot *initial)
+{
+    bool reserved[RF_SNOC_CONTEXTS] = {false};
+    int error = rf_snoc_lease_gate(s, o);
+    if (error) return error;
+    if (s->attempted) return EBUSY;
+    s->attempted = 1;
+    if (!initial || !initial->stable || initial->stage != 4 || initial->error || initial->fault ||
+        initial->malformed_routes || initial->wlan_matches[0] || initial->wlan_matches[1] ||
+        initial->id[0] != 0x4c017e51u || initial->id[1] != 0x6000003eu || initial->id[2] != 0x5111u ||
+        (initial->control & 9u) || !(initial->control & 0x400u)) { error = EPERM; goto failed; }
+    s->expected = *initial; s->bank = RF_SNOC_CONTEXTS; s->slot = RF_SNOC_STREAMS;
+    for (unsigned i = 0; i < RF_SNOC_STREAMS; ++i) {
+        uint32_t smr = initial->smr[i], type = (initial->s2cr[i] >> 16) & 3u, bank = initial->s2cr[i] & 255u;
+        if (type == 3 || (smr & 0x8000u) || (!type && bank >= RF_SNOC_CONTEXTS) ||
+            rf_snoc_stream_matches(smr, 0xc0) || rf_snoc_stream_matches(smr, 0xc1)) { error = EPERM; goto failed; }
+        if (!type) reserved[bank] = true;
+        if (!(smr & 0x80000000u) && s->slot == RF_SNOC_STREAMS) s->slot = i;
+    }
+    for (unsigned i = 0; i < RF_SNOC_CONTEXTS; ++i) {
+        const struct rf_snoc_bank *b = &initial->bank[i];
+        if (!reserved[i] && !(b->sctlr & 1u) && !b->cbar && !b->cba2r &&
+            !(b->fault & RF_SNOC_CONTEXT_FAULT)) { s->bank = i; break; }
+    }
+    if (s->bank == RF_SNOC_CONTEXTS || s->slot == RF_SNOC_STREAMS) { error = ENOSPC; goto failed; }
+    /* Permanently consumed software lease. Never release or retry, including
+     * failed readbacks. Every inherited foreign route/context stays exact. */
+    s->leased = 1;
+    for (unsigned step = 0; step < RF_SNOC_LEASE_STORES; ++step) {
+        unsigned block = 0; uint32_t at = 0, value = 0, observed = 0;
+        error = rf_snoc_lease_verify(s, o); if (error) goto failed;
+        error = rf_snoc_lease_step(s, step, &block, &at, &value); if (error) goto failed;
+        ++s->stores;
+        error = o->write(o->context, block, at, value); if (error) goto failed;
+        for (unsigned us = 0; us < 1000; ++us) {
+            error = rf_snoc_lease_gate(s, o); if (error) goto failed;
+            ++s->polls; error = o->read(o->context, block, at, &observed); if (error) goto failed;
+            if (observed == value) break;
+            error = o->delay(o->context, 1); if (error) goto failed;
+        }
+        if (observed != value) { error = EIO; goto failed; }
+        switch (step) {
+        case 0: s->expected.bank[s->bank].sctlr = value; break;
+        case 1: s->expected.bank[s->bank].cba2r = value; break;
+        case 2: s->expected.bank[s->bank].cbar = value; break;
+        case 3: s->expected.s2cr[s->slot] = value; break;
+        default: s->expected.smr[s->slot] = value; break;
+        }
+    }
+    error = rf_snoc_lease_verify(s, o); if (error) goto failed;
+    s->active = 1;
+    return 0;
+failed:
+    s->poisoned = 1; s->active = 0;
+    return error;
+}
+#endif
diff --git a/iokit/Kernel/arm/redfin_wifi_packets.inc b/iokit/Kernel/arm/redfin_wifi_packets.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/redfin_wifi_packets.inc
@@ -0,0 +1,217 @@
+/* SPDX-License-Identifier: MIT
+ * Native Redfin hardware owner for the complete ath10k-compatible packet and
+ * station engine. One bound worker owns routes, MMIO and fresh DMA32 memory.
+ * The retained RMTFS allocation is never used by the packet engine.
+ */
+static uint64_t fw_start_packet_phys(const fw_start_context *context, unsigned i)
+{
+    const uint64_t physical[4] = {RF_SNOC_SMMU_BASE, RF_SNOC_SMMU_BASE + RF_SNOC_CONTEXT_OFFSET,
+        RF_CE_BASE, UINT64_C(0x18830000)};
+    return i < 4 ? physical[i] : context->packet_pool[0];
+}
+static uint64_t fw_start_packet_bytes(const fw_start_context *context, unsigned i)
+{
+    const uint64_t bytes[4] = {RF_SNOC_GLOBAL_BYTES, RF_SNOC_CONTEXT_BYTES, RF_CE_MAP_BYTES, 16384};
+    return i < 4 ? bytes[i] : context->packet_pool[1];
+}
+static int fw_start_packet_owner(void *opaque)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (context != &fw_start || !context->packets_mode || fw_start_glink_check(context) ||
+        fw_start_snoc_check(context) || context->mission.stage != RF_MISSION_COMPLETE || !context->ce.stable)
+        return EPERM;
+    for (unsigned i = 0; i < 5; ++i) {
+        const fw_start_map *m = &context->packet_maps[i];
+        if (!m->memory && !m->map && !m->base) continue;
+        if (!m->memory || !m->map || !m->base || m->map->getVirtualAddress() != m->base ||
+            m->map->getLength() != fw_start_packet_bytes(context, i)) return EPERM;
+    }
+    return 0;
+}
+static int fw_start_packet_sample(void *opaque, rf_snoc_snapshot *out)
+{
+    if (!out || fw_start_packet_owner(opaque)) return EPERM;
+    const rf_snoc_ops ops = {opaque, fw_start_snoc_check, fw_start_snoc_read};
+    return rf_snoc_observe(&ops, out);
+}
+static __attribute__((noinline)) void fw_start_packet_store(uintptr_t address, uint32_t value)
+{
+    /* Force a GPR even for zero: the reviewed Qualcomm global-register trap
+     * cannot decode stores using architectural register31. */
+    __asm__ volatile("dmb oshst\n\tstr %w0, [%1]\n\tdsb osh" : : "r"(value), "r"(address) : "memory");
+}
+static int fw_start_packet_route_write(void *opaque, unsigned block, uint32_t at, uint32_t value)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    unsigned expected_block = 0; uint32_t expected_at = 0, expected_value = 0;
+    if (fw_start_packet_owner(context) || !context->packet_lease.stores || block > 1 ||
+        rf_snoc_lease_step(&context->packet_lease, context->packet_lease.stores - 1u,
+            &expected_block, &expected_at, &expected_value) ||
+        block != expected_block || at != expected_at || value != expected_value || !context->packet_maps[block].base)
+        return EPERM;
+    ++context->packet_stores;
+    fw_start_packet_store(context->packet_maps[block].base + at, value);
+    return 0;
+}
+static int fw_start_packet_route_delay(void *opaque, unsigned us)
+{ return us == 1 ? fw_start_pause(opaque, 1) : EINVAL; }
+static int fw_start_packet_bus_check(void *opaque)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (fw_start_packet_owner(context) || !context->packet_lease.active || context->packet_lease.poisoned) return EPERM;
+    const rf_snoc_lease *lease = &context->packet_lease;
+    uint32_t value = 0;
+    const unsigned block[5] = {0, 0, 1, 0, 0};
+    const uint32_t at[5] = {0x800 + 4u*lease->slot, 0xc00 + 4u*lease->slot, 0x1000u*lease->bank,
+        0x1800 + 4u*lease->bank, 0x1000 + 4u*lease->bank};
+    const uint32_t expected[5] = {0x800100c0, 0x300u | lease->bank, 0, 1, 0x10000};
+    for (unsigned i = 0; i < 5; ++i)
+        if (fw_start_snoc_read(context, block[i], at[i], &value) || value != expected[i]) return EPERM;
+    return 0;
+}
+static void *fw_start_packet_allocate(void *opaque, uint64_t bytes, uint64_t *physical)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (!physical || !bytes || bytes > 0x1000000 || fw_start_packet_bus_check(context) ||
+        !context->packet_maps[4].base) return NULL;
+    bytes = (bytes + 4095u) & ~UINT64_C(4095);
+    if (context->packet_used > context->packet_buffer[1] || bytes > context->packet_buffer[1] - context->packet_used) return NULL;
+    *physical = context->packet_buffer[0] + context->packet_used;
+    uintptr_t base = context->packet_maps[4].base + 16384u + context->packet_used;
+    context->packet_used += bytes;
+    bzero((void *)base, (size_t)bytes);
+    __asm__ volatile("dsb sy" ::: "memory");
+    return (void *)base;
+}
+static int fw_start_packet_ce_read(void *opaque, uint32_t at, uint32_t *out)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (!out || !rf_ce_read_allowed(at) || fw_start_packet_bus_check(context) || !context->ce_map.base) return EPERM;
+    uintptr_t address = context->ce_map.base + at; uint32_t value;
+    __asm__ volatile("ldr %w0, [%1]\n\tdmb oshld" : "=r"(value) : "r"(address) : "memory");
+    *out = value;
+    return value == UINT32_MAX ? EIO : 0;
+}
+static const uint32_t fw_packet_source_entries[12] = {16, 0, 0, 32, 2048, 0, 0, 2, 0, 0, 0, 0};
+static const uint32_t fw_packet_dest_entries[12] = {0, 512, 64, 0, 0, 512, 0, 2, 128, 512, 512, 512};
+static bool fw_start_packet_address(const fw_start_context *context, uint32_t value)
+{
+    return value >= context->packet_buffer[0] && value < context->packet_buffer[0] + context->packet_used && !(value & 15u);
+}
+static int fw_start_packet_ce_write(void *opaque, uint32_t at, uint32_t value)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if (fw_start_packet_bus_check(context) || !context->packet_maps[2].base || (at & 3u)) return EPERM;
+    unsigned ce = at / 0x1000u, offset = at & 0xfffu, index = RF_CE_OBSERVED_REGS;
+    bool allowed = false;
+    if (ce == 12) {
+        allowed = (offset == 4 && fw_start_packet_address(context, value)) || (offset == 8 && !value);
+    } else if (ce < 12) {
+        for (unsigned i = 0; i < RF_CE_OBSERVED_REGS; ++i) if (rf_ce_observed_offsets[i] == offset) index = i;
+        if (offset == 0 && fw_packet_source_entries[ce]) allowed = fw_start_packet_address(context, value);
+        else if (offset == 4 && fw_packet_source_entries[ce]) allowed = !value;
+        else if (offset == 8 && fw_packet_source_entries[ce]) allowed = value == fw_packet_source_entries[ce];
+        else if (offset == 0x0c && fw_packet_dest_entries[ce]) allowed = fw_start_packet_address(context, value);
+        else if (offset == 0x10 && fw_packet_dest_entries[ce]) allowed = !((value ^ context->packet_expected[ce][4]) & ~0x1fu) && !(value & 0x1fu);
+        else if (offset == 0x14 && fw_packet_dest_entries[ce]) allowed = value == fw_packet_dest_entries[ce];
+        else if (offset == 0x18) allowed = !((value ^ context->packet_expected[ce][6]) & ~(0xffffu | (7u << 17)));
+        else if (offset == 0x4c && fw_packet_source_entries[ce]) allowed = value == fw_packet_source_entries[ce];
+        else if (offset == 0x50 && fw_packet_dest_entries[ce]) allowed = value == fw_packet_dest_entries[ce];
+        else if (offset == 0x40 && fw_packet_dest_entries[ce] && ce != 7) allowed = value < fw_packet_dest_entries[ce];
+    }
+    if (!allowed) return EPERM;
+    ++context->packet_stores;
+    fw_start_packet_store(context->packet_maps[2].base + at, value);
+    if (ce < 12 && index < RF_CE_OBSERVED_REGS) context->packet_expected[ce][index] = value;
+    if (ce == 12) context->packet_rri[offset == 4 ? 0 : 1] = value;
+    return 0;
+}
+static int fw_start_packet_shadow(void *opaque, unsigned ce, uint32_t value)
+{
+    fw_start_context *context = (fw_start_context *)opaque;
+    if ((ce != 0 && ce != 3 && ce != 4) || value >= fw_packet_source_entries[ce] ||
+        fw_start_packet_bus_check(context) || !context->packet_maps[3].base) return EPERM;
+    ++context->packet_stores;
+    fw_start_packet_store(context->packet_maps[3].base + 0x2000 + 4u*ce, value);
+    return 0;
+}
+static int fw_start_packet_guards(fw_start_context *context, bool initial)
+{
+    if (fw_start_packet_owner(context) || !context->packet_maps[4].base) return EPERM;
+    const volatile uint64_t *pool = (const volatile uint64_t *)context->packet_maps[4].base;
+    for (uint64_t i = 0; i < context->packet_pool[1] / 8u; ++i) {
+        bool guard = i < 2048u || i >= (16384u + context->packet_buffer[1]) / 8u;
+        if (guard) { if (pool[(size_t)i] != UINT64_C(0xd3d3d3d3d3d3d3d3)) return EIO; }
+        else if (initial) { if (pool[(size_t)i]) return EBUSY; }
+        else i = (16384u + context->packet_buffer[1]) / 8u - 1u;
+    }
+    return 0;
+}
+static int fw_start_packets_start(fw_start_context *context)
+{
+    if (fw_start_packet_owner(context) || context->packets_started || context->packet_lease.attempted ||
+        fw_start_mission_check(context) || redfin_wifi_power_audit()) return EPERM;
+    for (unsigned i = 0; i < 5; ++i) {
+        if (fw_start_packet_owner(context)) return EPERM;
+        fw_start_map *m = &context->packet_maps[i];
+        if (m->memory || m->map || m->base) return EBUSY;
+        uint64_t bytes = fw_start_packet_bytes(context, i);
+        m->memory = IOMemoryDescriptor::withPhysicalAddress(fw_start_packet_phys(context, i), bytes, kIODirectionInOut);
+        m->map = m->memory ? m->memory->map(i == 4 ? kIOMapWriteCombineCache : kIOMapInhibitCache) : NULL;
+        if (!m->map || !m->map->getVirtualAddress() || m->map->getLength() != bytes) return ENOMEM;
+        m->base = (uintptr_t)m->map->getVirtualAddress();
+    }
+    int error = fw_start_packet_guards(context, true);
+    if (error) return error;
+    context->packet_lease_ops = {context, fw_start_packet_owner, fw_start_packet_sample, fw_start_snoc_read,
+        fw_start_packet_route_write, fw_start_packet_route_delay};
+    error = rf_snoc_lease_claim(&context->packet_lease, &context->packet_lease_ops, &context->snoc);
+    IOLog("REDFIN WIFI PACKETS: context lease=%d bank=%u slot=%u stores=%u retained=1\n", error,
+        context->packet_lease.bank, context->packet_lease.slot, context->packet_lease.stores);
+    if (error) {
+        unsigned block = 0; uint32_t at = 0, expected = 0, observed = 0;
+        bool changed = rf_snoc_lease_difference(&context->packet_lease, &block, &at, &expected, &observed);
+        const rf_snoc_snapshot *fresh = &context->packet_lease.fresh;
+        IOLog("REDFIN WIFI PACKETS: lease refusal sample=%u/%u stable=%u changed=%u block=%u at=%#x expected=%#x observed=%#x unstable=%u/%#x\n",
+            fresh->stage, fresh->error, fresh->stable, changed, block, at, expected, observed,
+            fresh->changed_block, fresh->changed_offset);
+        return error;
+    }
+    memcpy(context->packet_expected, context->ce.ce, sizeof(context->packet_expected));
+    const redfin_wifi_radio_ops ops = {context, fw_start_packet_bus_check, fw_start_packet_allocate,
+        fw_start_packet_ce_read, fw_start_packet_ce_write, fw_start_packet_shadow};
+    error = redfin_wifi_radio_start(&ops);
+    if (error) return error;
+    context->packets_started = true;
+    context->packet_epoch = fw_start_ns(context); context->packet_audit = context->packet_epoch + UINT64_C(1000000000);
+    IOLog("REDFIN WIFI PACKETS: native CE/HTC/WMI/HTT engine started, DMA bytes=%llu; station and iOS networking follow readiness\n",
+        (unsigned long long)context->packet_used);
+    return 0;
+}
+static int fw_start_packets_poll(fw_start_context *context, uint64_t now)
+{
+    if (fw_start_packet_bus_check(context)) return EPERM;
+    int error = redfin_wifi_radio_poll((uint32_t)((now - context->packet_epoch) / 1000000u));
+    if (error) return error;
+    if (now >= context->packet_audit) {
+        error = rf_snoc_lease_verify(&context->packet_lease, &context->packet_lease_ops);
+        if (!error) error = fw_start_packet_guards(context, false);
+        if (!error) error = redfin_wifi_power_audit();
+        for (unsigned ce = 0; !error && ce < RF_CE_COUNT; ++ce) {
+            for (unsigned i = 0; i < 7; ++i) {
+                uint32_t value = 0;
+                error = fw_start_packet_ce_read(context, 0x1000u*ce + rf_ce_observed_offsets[i], &value);
+                if (!error && value != context->packet_expected[ce][i]) error = EAGAIN;
+                if (error) break;
+            }
+        }
+        if (error) return error;
+        struct redfin_wifi_radio_state state = {};
+        redfin_wifi_radio_state(&state);
+        IOLog("REDFIN WIFI PACKETS: HTC=%u WMI=%u interface=%u scan=%u station=%u error=%u RX=%u TX=%u DMA=%llu stores=%u\n",
+            state.htc, state.wmi, state.ready, state.scanning, state.phase, state.last_error,
+            state.received, state.transmitted, (unsigned long long)context->packet_used, context->packet_stores);
+        context->packet_audit = now + UINT64_C(1000000000);
+    }
+    return 0;
+}
