+/* REDFIN_RW_IO_TEST_BEGIN: never touch DMA again after an uncertain command. */
+static void
+redfin_rw_poison(void)
+{
+	redfin_ufs_submit_poisoned = true;
+	redfin_ufs_rw_armed = false;
+	redfin_ufs_rw_preparing = false;
+	su.writable = false;
+	su.ready = false;
+}
+static int
+redfin_rw_io_ready(void)
+{
+	if (redfin_ufs_submit_poisoned) return EIO;
+	if (redfin_ufs_root_read_only && (ufs_rd(REG_UTRLDBR) || ufs_rd(0x78))) {
+		redfin_rw_poison();
+		return EBUSY;
+	}
+	if (redfin_ufs_root_read_only && (!(ufs_rd(REG_HCE) & 1) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1) || (ufs_rd(REG_HCS) & 0xf) != 0xf ||
+	    ufs_rd(REG_UTRLBA) != (uint32_t)(su.dma_pa + DMA_UTRL) ||
+	    ufs_rd(REG_UTRLBAU) != (uint32_t)((su.dma_pa + DMA_UTRL) >> 32))) {
+		redfin_rw_poison();
+		return EIO;
+	}
+	return 0;
+}
+/* REDFIN_RW_IO_TEST_END */
 
