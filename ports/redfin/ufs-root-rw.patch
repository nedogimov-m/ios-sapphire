+/* REDFIN_RW_TEST_BEGIN: fixed 16 GiB filesystem, never the userdata tail. */
+#define REDFIN_RW_BLOCKS (0x400000ULL)
+static int
+redfin_rw_flags(uint32_t rw, uint32_t rootrw, uint32_t log, bool *requested)
+{
+	if (!requested) return EINVAL;
+	*requested = false;
+	if (log || rw > 1 || rootrw > 1 || rw != rootrw) return EROFS;
+	*requested = rw == 1;
+	return 0;
+}
+static bool
+redfin_rw_window(uint64_t first, uint64_t partition, uint64_t exposed, uint64_t disk)
+{
+	return first >= 6 && first < disk && disk <= UINT32_MAX &&
+	    partition >= REDFIN_RW_BLOCKS && partition <= disk - first &&
+	    exposed == REDFIN_RW_BLOCKS;
+}
+static bool
+redfin_rw_command(const uint8_t *cdb, unsigned bytes, uint32_t len, bool write,
+    uint8_t lun, bool armed, uint64_t first, uint64_t partition,
+    uint64_t exposed, uint64_t disk)
+{
+	if (!armed || !cdb || bytes != 10 || lun ||
+	    !redfin_rw_window(first, partition, exposed, disk)) return false;
+	if (cdb[0] == 0x35 && !write && !len) {
+		for (unsigned i = 1; i < 10; i++) if (cdb[i]) return false;
+		return true; /* SYNCHRONIZE CACHE(10), IMMED=0, whole LUN. */
+	}
+	if (cdb[0] != 0x2a || !write || cdb[1] || cdb[6] || cdb[9]) return false;
+	uint64_t lba = (uint32_t)cdb[2] << 24 | (uint32_t)cdb[3] << 16 |
+	    (uint32_t)cdb[4] << 8 | cdb[5];
+	uint32_t count = (uint32_t)cdb[7] << 8 | cdb[8];
+	return count && count <= BOUNCE_SIZE / UFS_BLOCK && len == count * UFS_BLOCK &&
+	    lba >= first && lba - first < exposed && count <= exposed - (lba - first);
+}
+static uint32_t
+redfin_rw_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+static bool
+redfin_rw_hfs(const uint8_t *primary, unsigned pn, const uint8_t *alternate, unsigned an)
+{
+	if (!primary || !alternate || pn != 512 || an != 512) return false;
+	const uint8_t *headers[2] = {primary, alternate};
+	uint32_t block = 0, total = 0, journal = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		const uint8_t *h = headers[i];
+		if (h[0] != 'H' || h[1] != 'X' || h[2] || h[3] != 5) return false;
+		uint32_t attributes = redfin_rw_be32(h + 4);
+		if (!(attributes & (1u << 13)) || (attributes & ((1u << 7) | (1u << 11) | (1u << 15))) ||
+		    (!i && !(attributes & (1u << 8)))) return false;
+		uint32_t b = redfin_rw_be32(h + 40), n = redfin_rw_be32(h + 44);
+		uint32_t j = redfin_rw_be32(h + 12);
+		if (b < UFS_BLOCK || b > BOUNCE_SIZE || (b & (b - 1)) ||
+		    (uint64_t)b * n != REDFIN_RW_BLOCKS * UFS_BLOCK || !j || j >= n) return false;
+		if (i && (b != block || n != total || j != journal)) return false;
+		block = b; total = n; journal = j;
+	}
+	return true; /* Only primary supplies clean-unmount bit; alternate may be stale. */
+}
+static bool
+redfin_rw_response(const uint8_t *r, unsigned size, uint32_t ocs, uint8_t lun, uint8_t tag)
+{
+	if (!r || size < 34 || ocs || r[0] != 0x21 || r[1] || r[2] != lun || r[3] != tag ||
+	    r[4] || r[5] || r[6] || r[7] || r[8] || (r[9] & ~1u) ||
+	    (r[10] || (r[11] != 0 && r[11] != 2)) || redfin_rw_be32(r + 12) || r[32] || r[33])
+		return false;
+	for (unsigned i = 16; i < 32; i++) if (r[i]) return false;
+	return true; /* EE bit may be set; exact block transfers cannot have residuals. */
+}
+/* REDFIN_RW_TEST_END */
 
