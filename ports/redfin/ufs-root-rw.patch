+/* REDFIN_RW_ARM_TEST_BEGIN: read both on-device headers while still read-only. */
+static int
+redfin_rw_prepare(void)
+{
+	if (redfin_ufs_rw_armed || su.writable || redfin_ufs_submit_poisoned ||
+	    !redfin_rw_window(su.first_block, redfin_ufs_partition_blocks,
+	    REDFIN_RW_BLOCKS, redfin_ufs_root_blocks)) return EROFS;
+	uint8_t primary[512];
+	redfin_ufs_rw_preparing = true;
+	int error = ufs_read_blocks(su.first_block, 1);
+	if (!error) {
+		memcpy(primary, (const uint8_t *)(su.dma + DMA_BOUNCE) + 1024, sizeof(primary));
+		error = ufs_read_blocks(su.first_block + REDFIN_RW_BLOCKS - 1, 1);
+	}
+	if (!error) {
+		const uint8_t *alternate = (const uint8_t *)(su.dma + DMA_BOUNCE) + UFS_BLOCK - 1024;
+		if (!redfin_rw_hfs(primary, sizeof(primary), alternate, 512)) error = EINVAL;
+	}
+	redfin_ufs_rw_preparing = false;
+	if (error) return error;
+	su.nblocks = REDFIN_RW_BLOCKS;
+	return 0; /* Caller arms only after device registration also succeeds. */
+}
+/* REDFIN_RW_ARM_TEST_END */
