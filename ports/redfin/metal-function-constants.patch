+      if (comps > 4 || comps * bits > 256)
+         return air_error(c, "interface: function constant exceeds four native scalar components"), NULL;
       nir_def *fields[NIR_MAX_VEC_COMPONENTS];
       for (unsigned i = 0; i < comps; i++) {
          uint64_t mask = bits >= 64 ? ~0ull : (1ull << bits) - 1;
