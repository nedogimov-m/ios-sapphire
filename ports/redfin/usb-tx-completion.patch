+/* ud.lock is held. A completion event alone does not release DMA ownership.
+ * Native DWC3 event status bits0/1 are BUSERR/SHORT; bits2/3 are IOC/LST.
+ * Require our exact single normal TRB, hardware ownership released, successful
+ * status and zero residual before the next frame can overwrite its buffer.
+ * These counters do not identify a particular UDP marker or prove host ACK. */
+static bool
+ud_redfin_tx_complete(uint32_t status)
+{
+ if (!ud_redfin_proof()) return false;
+ if (!ud.tx_busy || !ud.configured || !ud.tx_bytes || ud.tx_bytes > UD_FRAME_MAX || (status & 3u)) {
+  rf_usb_gadget_fail(&ud.guard,EIO);return false;
+ }
+ ud_sync(UD_TRB_TX,16);
+ if (!ud_redfin_proof()) return false;
+ volatile uint32_t *trb=(volatile uint32_t *)(ud.dma+UD_TRB_TX);
+ const uint32_t low=trb[0],high=trb[1],remaining=trb[2],control=trb[3];
+ const uint64_t buffer=ud.dma_pa+UD_TX;
+ const uint32_t mask=TRB_HWO|TRB_LST|TRB_IOC|(0x3fu<<4);
+ if (low!=(uint32_t)buffer || high!=(uint32_t)(buffer>>32) || remaining ||
+     (control&mask)!=(TRB_LST|TRB_IOC|TRBCTL_NORMAL)) {
+  rf_usb_gadget_fail(&ud.guard,EIO);return false;
+ }
+ ud.tx_completed_frames++;
+ ud.tx_completed_bytes+=ud.tx_bytes;
+ ud.tx_bytes=0;
+ return true;
+}
+
 static void
 ud_event(uint32_t ev)
 {
