+/* No caller in this patch. Trusted md0 owner must first claim the route and
+ * supply real WARM/ACTIVE/QUIESCE proofs using the identical stable caller ID. */
+int
+redfin_usb_gadget_start(const void *caller_id,const struct redfin_usb_gadget_policy *policy)
+{
+ static bool attempted;
+ extern bool redfin_usb_platform(void);
+ uint32_t mode=0,seconds=30,network=0;
+ (void)PE_parse_boot_argn("redfinusb",&mode,sizeof(mode));
+ (void)PE_parse_boot_argn("redfinusbsecs",&seconds,sizeof(seconds));
+ (void)PE_parse_boot_argn("redfinusbnet",&network,sizeof(network));
+ if (!caller_id || !policy || !policy->authorize || mode!=3 || !redfin_usb_platform()) return ENOTSUP;
+ if (seconds<1 || seconds>120 || network>1) return EINVAL;
+ if (policy->authorize(caller_id,policy->context,RF_USB_WARM)) return EPERM;
+ if (__atomic_exchange_n(&attempted,true,__ATOMIC_ACQ_REL)) return EBUSY;
+ DTEntry chosen;const void *value=NULL;unsigned bytes=0;
+ uint64_t ram_base=0,ram_size=0;
+ if (SecureDTLookupEntry(NULL,"/chosen",&chosen)!=kSuccess ||
+     SecureDTGetProperty(chosen,"dram-base",&value,&bytes)!=kSuccess || !value || bytes!=8) return ENXIO;
+ memcpy(&ram_base,value,8);
+ if (SecureDTGetProperty(chosen,"dram-size",&value,&bytes)!=kSuccess || !value || bytes!=8) return ENXIO;
+ memcpy(&ram_size,value,8);
+ if (ram_base<0x80000000ULL || ram_base>=(1ULL<<36) || !ram_size || ram_size>(1ULL<<36)-ram_base) return ENXIO;
+ ud.guard=(struct rf_usb_gadget_guard){.redfin=true,.enum_only=!network,.caller=caller_id,.policy=*policy,
+     .ram_base=ram_base,.ram_size=ram_size};
+ clock_interval_to_deadline(seconds,NSEC_PER_SEC,&ud.guard.deadline);
+ if (!ud_redfin_proof()) return ud.guard.error;
+ vm_offset_t gcc=ml_io_map(0x10c000,0x4000);
+ vm_offset_t core=ml_io_map(0xa60c000,0x4000);
+ vm_offset_t qs=ml_io_map(0xa6f8000,0x4000);
+ if (!gcc || !core || !qs) { rf_usb_gadget_fail(&ud.guard,ENOMEM);return ENOMEM; }
+ ud.dwc=core-0xc000;ud.redfin_qs=qs+0x800;
+ if (!ud_redfin_proof()) return ud.guard.error;
+ uint32_t power=usb_rd(gcc,0x3004),reset=usb_rd(gcc,0x3000);
+ if (!(power&0x80000000u) || (power&1) || (reset&1)) { rf_usb_gadget_fail(&ud.guard,EBUSY);return EBUSY; }
+ const unsigned clocks[]={0x3010,0x307c,0x3080,0x3018,0x301c};
+ for (unsigned i=0;i<5;i++) {
+  if (!ud_redfin_proof()) return ud.guard.error;
+  uint32_t clock=usb_rd(gcc,clocks[i]);
+  if (!(clock&1) || (clock&0x80000000u)) { rf_usb_gadget_fail(&ud.guard,EBUSY);return EBUSY; }
+ }
+ if (dwc_rd(0xc120)!=0x5533330au || (dwc_rd(0xc140)>>24)!=64 ||
+     ((dwc_rd(GCTL)>>12)&3)!=2 || (dwc_rd(GCTL)&0x800u) ||
+     (dwc_rd(DCTL)&(DCTL_RUN_STOP|DCTL_CSFTRST|DCTL_LSFTRST)) || !(dwc_rd(DSTS)&DSTS_DEVCTRLHLT)) {
+  rf_usb_gadget_fail(&ud.guard,EBUSY);return EBUSY;
+ }
+ if (!ud_redfin_proof()) return ud.guard.error;
+ sweet_usb_gadget_start(ud.dwc);
+ int error=__atomic_load_n(&ud.guard.error,__ATOMIC_ACQUIRE);
+ if (error) {
+  bool halted=ud_redfin_stop();
+  printf("REDFIN USB GADGET: start failed error=%d halted=%u; DMA slab retained\n",error,halted);
+ }
+ return error;
+}
