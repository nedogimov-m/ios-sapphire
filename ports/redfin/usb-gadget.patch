+/* Only QUIESCE proof may bypass the sticky failure latch, solely to halt.
+ * DMA slab remains permanently allocated, including uncertain halt failures. */
+static bool
+ud_redfin_stop(void)
+{
+ if (!ud.guard.redfin) return false;
+ if (!ud.guard.policy.authorize ||
+     ud.guard.policy.authorize(ud.guard.caller,ud.guard.policy.context,RF_USB_QUIESCE)) return false;
+ uint32_t control=usb_rd(ud.dwc,DCTL);
+ if (control==0xffffffffu || (control&(DCTL_CSFTRST|DCTL_LSFTRST))) return false;
+ if (ud.guard.policy.authorize(ud.guard.caller,ud.guard.policy.context,RF_USB_QUIESCE)) return false;
+ *(volatile uint32_t *)(ud.dwc+DCTL)=control&~DCTL_RUN_STOP;
+ __asm__ volatile("dsb sy" ::: "memory");
+ for (unsigned us=0;us<500000;us+=1000) {
+  if (ud.guard.policy.authorize(ud.guard.caller,ud.guard.policy.context,RF_USB_QUIESCE)) return false;
+  uint32_t status=usb_rd(ud.dwc,DSTS);
+  if (status==0xffffffffu) return false;
+  if (status&DSTS_DEVCTRLHLT) return true;
+  delay(1000);
+ }
+ return false;
+}
