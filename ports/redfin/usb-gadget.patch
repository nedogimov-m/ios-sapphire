diff --git a/bsd/dev/redfin_usb_gadget.h b/bsd/dev/redfin_usb_gadget.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_usb_gadget.h
@@ -0,0 +1,25 @@
+/* Trusted unhooked Redfin gadget experiment. No user-controlled callbacks. */
+#ifndef REDFIN_USB_GADGET_H
+#define REDFIN_USB_GADGET_H
+#include <stdbool.h>
+/* WARM: manager strict revalidate, sole owner and halted ABL core.
+ * ACTIVE: manager route_retained plus continuing sole controller ownership
+ * and live power/clocks for every requested MMIO/cache/DMA operation.
+ * QUIESCE: continuing sole controller ownership and live power/clocks; only
+ * clearing RUN_STOP/polling HALT is authorized even if the route was lost.
+ * Never return success from a boot argument or a cached boolean. Policy and
+ * caller identity/context must remain valid until the bounded worker exits.
+ */
+enum redfin_usb_gadget_phase { RF_USB_WARM, RF_USB_ACTIVE, RF_USB_QUIESCE };
+struct redfin_usb_gadget_policy {
+ int (*authorize)(const void *caller_id,void *context,enum redfin_usb_gadget_phase);
+ void *context;
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+int redfin_usb_gadget_start(const void *caller_id,const struct redfin_usb_gadget_policy *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/redfin_usb_gadget_guard.h b/bsd/dev/redfin_usb_gadget_guard.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/redfin_usb_gadget_guard.h
@@ -0,0 +1,75 @@
+/* Pure bounded guards shared by the real gadget and host fault models. */
+#ifndef REDFIN_USB_GADGET_GUARD_H
+#define REDFIN_USB_GADGET_GUARD_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/errno.h>
+#include "redfin_usb_gadget.h"
+struct rf_usb_gadget_guard {
+ bool redfin,active,enum_only;
+ int error;
+ const void *caller;
+ struct redfin_usb_gadget_policy policy;
+ uint64_t ram_base,ram_size,deadline;
+};
+static inline void
+rf_usb_gadget_fail(struct rf_usb_gadget_guard *g,int error)
+{
+ if (!g->redfin) return;
+ int expected=0;
+ (void)__atomic_compare_exchange_n(&g->error,&expected,error?error:EIO,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE);
+}
+static inline bool
+rf_usb_gadget_proof(struct rf_usb_gadget_guard *g,uint64_t now)
+{
+ if (!g->redfin) return true;
+ if (__atomic_load_n(&g->error,__ATOMIC_ACQUIRE)) return false;
+ if (now>=g->deadline) { rf_usb_gadget_fail(g,ETIMEDOUT);return false; }
+ if (!g->caller || !g->policy.authorize ||
+     g->policy.authorize(g->caller,g->policy.context,g->active?RF_USB_ACTIVE:RF_USB_WARM)) {
+  rf_usb_gadget_fail(g,EPERM);return false;
+ }
+ return true;
+}
+static inline bool
+rf_usb_gadget_dma(uint64_t va,uint64_t pa,uint64_t size,uint64_t page_size,uint64_t ram_base,uint64_t ram_size)
+{
+ const uint64_t limit=1ULL<<36;
+ return page_size==0x4000 && size==0x4000 && va && pa && !((va|pa)&0x3fff) &&
+     ram_base>=0x80000000ULL && ram_size && ram_base<limit && ram_size<=limit-ram_base &&
+     pa>=ram_base && size<=ram_size && pa-ram_base<=ram_size-size && pa<=limit-size;
+}
+static inline bool
+rf_usb_gadget_buffer(unsigned offset,unsigned length)
+{
+ return offset<=0x4000u && length<=0x4000u-offset;
+}
+static inline bool
+rf_usb_gadget_trb(unsigned ep,unsigned trb,unsigned buf,unsigned len)
+{
+ unsigned expected=ep==0?0x1000:ep==1?0x1010:ep==2?0x1020:ep==3?0x1030:ep==5?0x1050:0;
