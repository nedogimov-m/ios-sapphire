diff --git a/src/compiler/air/air_metal.c b/src/compiler/air/air_metal.c
--- a/src/compiler/air/air_metal.c
+++ b/src/compiler/air/air_metal.c
@@ -76,6 +76,7 @@
 #define RWA_MAX_TEXTURES 16
 
 #include "redfin_metal_command_scope.h"
+extern void redfin_freedreno_raster_stats(struct pipe_context *,uint64_t[2]);
 
 struct rwa_device {
    struct pipe_screen *screen;
@@ -582,6 +583,19 @@
    device->screen->destroy(device->screen);
    free(device);
    glsl_type_singleton_decref();
+}
+
+/* Read actual freedreno route counters after the caller's real final fence.
+ * This is a native FD620-only diagnostic, never a rendering-rate estimate. */
+int
+rwa_redfin_raster_stats(struct rwa_device *device, uint64_t *counts, size_t words)
+{
+   if (!device || !counts || words!=2 || device->software ||
+       strcmp(rwa_device_name(device),"FD620")) return -1;
+   redfin_freedreno_raster_stats(device->pipe,counts);
+   /* The paired FD620 implementation reads the actual native counters. */
+
+   return 0;
 }
 
 const char *
@@ -6483,14 +6497,11 @@
    struct pipe_context *pipe = device->pipe;
    if (redfin_metal_scope_prepare(&device->command_scope,render->raster_only,
                                  command_scope_finish,device,why,why_size)) return -1;
-   /* Preserve GPU producer/consumer ordering without a CPU round trip. FD6
-    * implements this as actual CCU/cache flush/invalidate packets. */
-   if (device->command_scope.active && device->command_scope.pending) {
-      if (pipe->memory_barrier)
-         pipe->memory_barrier(pipe,PIPE_BARRIER_FRAMEBUFFER|PIPE_BARRIER_TEXTURE|PIPE_BARRIER_IMAGE);
-      else if (redfin_metal_scope_drain(&device->command_scope,command_scope_finish,device,why,why_size))
-         return -1;
-   }
+   /* Ordinary render-target writes/sampler reads use Gallium's resource
+    * dependency graph, including FD6's tile restore/resolve/cache packets.
+    * Unconditionally issuing a shader-memory barrier after every raster-only
+    * draw forces batch flushes and defeats GMEM. Memory-writing stages and
+    * CPU validation still drain through command_scope_prepare above. */
    const char *fname = render->finfo.entry_point ? render->finfo.entry_point
                                                  : "the fragment shader";
 
diff --git a/src/compiler/air/air_metal.h b/src/compiler/air/air_metal.h
