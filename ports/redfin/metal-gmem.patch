diff --git a/src/gallium/drivers/freedreno/freedreno_context.c b/src/gallium/drivers/freedreno/freedreno_context.c
--- a/src/gallium/drivers/freedreno/freedreno_context.c
+++ b/src/gallium/drivers/freedreno/freedreno_context.c
@@ -23,6 +23,19 @@
 #include "freedreno_tracepoints.h"
 #include "util/u_trace_gallium.h"
 
+/* Kept within the native driver so AIR does not depend on private driver
+ * headers/include directories. The caller serializes the paired context. */
+void redfin_freedreno_raster_stats(struct pipe_context *pipe,uint64_t counts[2]);
+void
+redfin_freedreno_raster_stats(struct pipe_context *pipe,uint64_t counts[2])
+{
+   struct fd_context *ctx=fd_context(pipe);
+   fd_context_access_begin(ctx);
+   counts[0]=ctx->stats.batch_gmem;
+   counts[1]=ctx->stats.batch_sysmem;
+   fd_context_access_end(ctx);
+}
+
 static void
 fd_context_flush(struct pipe_context *pctx, struct pipe_fence_handle **fencep,
                  unsigned flags) in_dt
