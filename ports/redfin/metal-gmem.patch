 int rwa_commands_begin(struct rwa_device *device,char *why,size_t why_size);
 int rwa_commands_end(struct rwa_device *device,char *why,size_t why_size);
+/* Counts actual GMEM/sysmem batches; caller serializes the device. */
+int rwa_redfin_raster_stats(struct rwa_device *device,uint64_t *counts,size_t words);
 
 /* What the driver should call the GPU, as Mesa knows it ("Adreno 7c+ Gen 3"). Never NULL. */
