 		IOLog("REDFIN SPMI: observer probe result=%d\n", result);
 	}
+	uint32_t redfin_return = 0;
+	if (PE_parse_boot_argn("redfinreturn", &redfin_return, sizeof(redfin_return)) && redfin_return == 1) {
+		extern int redfin_spmi_arm_return(void);
+		int result = redfin_spmi_arm_return();
+		IOLog("REDFIN RETURN: arm result=%d\n", result);
+	}
 	uint32_t redfin_publish = 0;
